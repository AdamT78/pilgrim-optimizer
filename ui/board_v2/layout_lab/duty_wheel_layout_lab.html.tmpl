       + '<input type=file data-aco="' + p + '" accept="image/png,image/webp,image/jpeg,image/svg+xml">'
       + '</span></div>';
    if (nm) a += '<div class=hint style="margin-left:74px">' + esc(nm)
               + (haveImage(key) ? "" : ' <b style="color:var(--warn)">not loaded</b>')
               + ' <button data-acoclr="' + p + '" style="padding:1px 5px">clear</button></div>';
  });
  a += '<div class=btns><button id=acoAll>reuse ' + PLAYER_IDS[0] + "'s asset for all</button></div>";
  el("acoCtl").innerHTML = a;
  [].forEach.call(el("acoCtl").querySelectorAll("[data-sty]"), function(b){
    b.onclick = function(){ A.style = b.dataset.sty; commitPanels(); };
  });
  var an = el("acoNum"), ar = el("acoRange");
  function setAco(v){
    A.height = clamp(Math.round(v), ACO_RANGE[0], ACO_RANGE[1]);
    an.value = A.height; ar.value = A.height;
    render(); recordSoon(); save(true);
  }
  an.oninput = function(){ setAco(an.value); };
  ar.oninput = function(){ setAco(ar.value); };
  el("ratCity").oninput = function(){ A.ratios.city = clamp(Math.round(this.value), 20, 150);
                                      render(); recordSoon(); save(true); };
  el("ratHand").oninput = function(){ A.ratios.inHand = clamp(Math.round(this.value), 20, 150);
                                      render(); recordSoon(); save(true); };
  [].forEach.call(el("acoCtl").querySelectorAll("[data-aco]"), function(inp){
    inp.onchange = function(){ readImage(inp, function(key, name){
