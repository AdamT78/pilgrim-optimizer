    + '<input type=range id=hpArtWR min=' + HELPERS.artW[0] + ' max=' + HELPERS.artW[1]
    + ' step=1 value="' + aL.width + '">'
    + '<div class=row><span>both h</span><input type=number id=hpArtHN min=' + HELPERS.artH[0]
    + ' max=' + HELPERS.artH[1] + ' value="' + aL.height + '"></div>'
    + '<input type=range id=hpArtHR min=' + HELPERS.artH[0] + ' max=' + HELPERS.artH[1]
    + ' step=1 value="' + aL.height + '">'
    + '<div class=hint>a width change re-lays the row at the gap below · Tithe and the City keep '
    + 'their own height</div>'

    + '<div class=sub>action row</div>'
    + '<div class=row><span>gap</span><input type=number id=hpGapN min=' + HELPERS.gap[0]
    + ' max=' + HELPERS.gap[1] + ' value="' + helperGap() + '"></div>'
    + '<input type=range id=hpGapR min=' + HELPERS.gap[0] + ' max=' + HELPERS.gap[1]
    + ' step=1 value="' + helperGap() + '">'
