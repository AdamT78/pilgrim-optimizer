  el("acoAll").onclick = function(){
    var first = PLAYER_IDS[0];
    var bank = A.style === "painted" ? A.painted : A.colored;
    var names = A.style === "painted" ? A.paintedNames : A.coloredNames;
    if (!bank[first]){ say("load an asset for " + first + " first", true); return; }
    PLAYER_IDS.forEach(function(p){ bank[p] = bank[first]; names[p] = names[first]; });
    commitPanels(); say("reusing " + names[first] + " for all four players");
