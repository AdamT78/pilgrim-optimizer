<!doctype html>
<meta charset="utf-8">
<title>Duty Wheel Layout Lab</title>
<style>
/* ---- application chrome ------------------------------------------------------------------
   Deliberately plain. Everything with a colour in it competes with the composition being
   judged, so the tool is grey and the stage is the only lit thing on the page. */
:root{
  --ink:#b9b2a5; --dim:#6e675b; --line:#2a2823; --panel:#161512; --chrome:#0e0d0b;
  --hot:#c9b27a; --warn:#e0705f; --ok:#8fae6a;
  --stage-bg:#000000;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--chrome);color:var(--ink);
  font:12px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;overflow:hidden}
#app{display:grid;grid-template-columns:1fr 340px;grid-template-rows:auto 1fr;height:100%}
#bar{grid-column:1/-1;display:flex;align-items:center;gap:6px;flex-wrap:wrap;
  padding:7px 10px;background:var(--panel);border-bottom:1px solid var(--line)}
#bar .sp{flex:1}
#bar .gap{width:6px}
#wrap{position:relative;overflow:auto;display:grid;place-items:safe center;
  background:var(--stage-bg);padding:12px}
#side{background:var(--panel);border-left:1px solid var(--line);overflow-y:auto;padding:10px}
body.full #bar,body.full #side{display:none}
body.full #app{grid-template-columns:1fr;grid-template-rows:1fr}

button,select,input[type=text],input[type=number]{font:inherit;color:var(--ink);
  background:#1c1a16;border:1px solid #33302a;border-radius:3px;padding:3px 7px}
button{cursor:pointer}
button:hover{border-color:#4a453b}
button[aria-pressed=true]{background:var(--hot);border-color:var(--hot);color:#12100c}
button:disabled{opacity:.35;cursor:default}
input[type=number]{width:62px;padding:2px 4px}
input[type=text]{width:100%}
input[type=range]{width:100%;accent-color:var(--hot)}
input[type=file]{max-width:100%;font-size:10px}
label.chk{display:inline-flex;align-items:center;gap:4px;cursor:pointer;white-space:nowrap}
.tag{color:var(--dim)}
#bView button{font-weight:700}

/* ---- the stage ---------------------------------------------------------------------------
   ALWAYS 1400x1200, made to fit only by a CSS transform, so every number stored, shown and
   exported is a true design coordinate. See toDesign() and relayout(). */
#fit{position:relative;flex:none}
#stage{position:relative;width:__CANVAS_W__px;height:__CANVAS_H__px;background:var(--stage-bg);
  transform-origin:0 0;overflow:hidden;outline:1px solid #262420}
.obj{position:absolute}
#wheelObj svg{width:100%;height:100%;display:block}
/* A LOADED ASSET IS CONTAINED, NEVER STRETCHED. Its shape has no say over the box, so one that
   does not match the 32 degree ratio is shown at its own proportions inside the box -- which is
   how a person sees that the file is wrong for the layout. Stretching would hide exactly that. */
#wheelObj img{width:100%;height:100%;display:block;object-fit:contain}
/* THE ASSET CARRIES ITS OWN GROUND, a dark rectangle filling its whole viewBox with 5 units of
   bare board outside the ellipse. Inside a layout module that rectangle is a claim about the
   board's colour that only applies to the wheel's own bounding box, which is not a thing the
   real board will have -- so it is hidden unless asked for, and the stage background is where
   the board's colour is actually decided. Selected by attribute rather than by #ground so the
   rule cannot be confused with a lab element of the same name. */
#wheelObj.noground [id="ground"]{display:none}

/* Editing chrome, all hung off body.clean so Clean Preview is one class away. */
.box{outline:1px dashed #6a6252;outline-offset:0}
.box .nm{position:absolute;left:0;top:-15px;font-size:10px;color:#7d7566;white-space:nowrap}
body.clean .box,body.clean .sel,body.clean .oob{outline:none !important}
body.clean .nm,body.clean .h,body.clean #guides,body.clean .oobtag,
body.clean .anchor{display:none !important}
body.clean .ghost{display:none !important}
.sel{outline:1px solid var(--hot) !important}
.ghost{opacity:.22;outline:1px dashed #4b6a7d !important}
.h{position:absolute;width:9px;height:9px;background:var(--hot);border:1px solid #12100c;
  border-radius:1px;z-index:5}
.h.nw{left:-5px;top:-5px;cursor:nwse-resize} .h.ne{right:-5px;top:-5px;cursor:nesw-resize}
.h.sw{left:-5px;bottom:-5px;cursor:nesw-resize} .h.se{right:-5px;bottom:-5px;cursor:nwse-resize}
.h.n{left:50%;top:-5px;margin-left:-4px;cursor:ns-resize}
.h.s{left:50%;bottom:-5px;margin-left:-4px;cursor:ns-resize}
.h.w{left:-5px;top:50%;margin-top:-4px;cursor:ew-resize}
.h.e{right:-5px;top:50%;margin-top:-4px;cursor:ew-resize}

.oob{outline:1px solid var(--warn) !important}
.oobtag{position:absolute;left:0;top:-15px;font-size:10px;color:var(--warn);white-space:nowrap;
  background:#1a0f0d;padding:0 3px;border-radius:2px;z-index:6}
.oobtag.low{top:auto;bottom:-15px}

#guides{position:absolute;inset:0;pointer-events:none;z-index:90}
#guides .l{position:absolute;background:#c9b27a2e}
#guides .safe{position:absolute;outline:1px dashed #c9b27a33}
#guides .grid{position:absolute;inset:0;
  background-image:linear-gradient(#ffffff08 1px,transparent 1px),
                   linear-gradient(90deg,#ffffff08 1px,transparent 1px);
  background-size:50px 50px}
#guides .wc{position:absolute;width:16px;height:16px;margin:-8px 0 0 -8px;
  border:1px solid #c9b27a66;border-radius:50%}
#guides .wc::after{content:"";position:absolute;inset:6px;background:#c9b27a66;border-radius:50%}

/* ---- the composition ---------------------------------------------------------------------- */
.fig{position:absolute;bottom:0;transform:translateX(-50%);line-height:0}
.fig svg,.fig img{display:block;height:100%;width:auto}
.fig{height:var(--fh)}
/* THE COUNT GOES INSIDE THE FIGURE, not beside it as "x7". Four seats and four counts have to
   fit one row of a 379-wide box, and a number on the robe costs no width at all. */
.fig .ct{position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);
  font:700 var(--cs)/1 ui-monospace,monospace;color:#12100c;
  text-shadow:0 1px 0 #ffffff55;pointer-events:none}
.fig.lt .ct{color:#f4ecdc;text-shadow:0 1px 2px #000a}
.anchor{position:absolute;left:50%;top:50%;width:9px;height:9px;margin:-5px 0 0 -5px;
  border:1px solid #c9b27a99;border-radius:50%;background:#c9b27a22}

/* Band 1: one line of instruction. No parchment, no frame, nothing to compete with the wheel. */
#statusObj{display:flex;align-items:center;padding:0 10px}
#statusObj .main{width:100%;font:400 var(--main-size)/1.2 Georgia,serif;color:#ece2cb;
  letter-spacing:.01em}

/* Band 2: the eight duty reference cards. Reference, not controls -- clicking one previews and
   chooses nothing. The panel is an editing affordance and goes in Clean Preview. */
.card{padding:9px 10px;border-radius:4px;background:#ffffff06;border:1px solid #ffffff12;
  display:flex;flex-direction:column;gap:7px;overflow:hidden}
.card h4{margin:0;font:600 14px/1.1 Georgia,serif;letter-spacing:.11em;text-transform:uppercase;
  color:#d8cdb4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .act{display:flex;align-items:center;gap:8px;flex:1;min-height:0}
.card .act span{font:400 12px/1.25 Georgia,serif;color:#b6ab94;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
body.clean .card{background:none;border-color:transparent;border-radius:0;padding:7px 3px}
body.clean .card h4{color:#e6dcc2}
body.clean .card .act span{color:#c6bba3}
/* HOVER ONLY WHERE A CLICK DOES SOMETHING. Cards preview in READY and SOWING and are inert in
   ACTION SELECTION, so only the first two get the affordance -- a card that brightens under the
   cursor and then ignores the click is the interface making a promise it does not keep. The
   class is set in render() from the view, so the two cannot disagree. */
body.clean .card.previewable:hover{filter:brightness(1.12);cursor:pointer}
/* The card whose duty the sow reached. Only in ACTION SELECTION -- in the other two states
   nothing has been reached and a highlight would be claiming otherwise. */
.card.reached{background:#c9b27a14;border-color:#c9b27a55}
body.clean .card.reached{background:#c9b27a12;border-color:#c9b27a44;border-radius:4px;
  padding:7px 8px}
/* The card being previewed, which is a different and quieter thing: you are reading, not doing. */
.card.previewing{border-color:#8fae6a66}
body.clean .card.previewing{border-color:#8fae6a44;border-radius:4px;padding:7px 8px}

.seal{flex:none;width:__SEAL_SIZE__px;height:__SEAL_SIZE__px;border-radius:50%;display:grid;
  place-items:center;background:radial-gradient(70% 70% at 35% 30%,#8f3f36,#5e241f);
  border:1px solid #3a1512;color:#e8cdb0;font:700 13px/1 ui-monospace,monospace;
  box-shadow:0 1px 2px #0008}
.seal img{width:100%;height:100%;object-fit:contain;display:block;border-radius:50%}

/* Band 3a: the two scenic action artworks. They fade into black at their edges, so no border
   and no radius -- the art is the edge. */
.art{overflow:hidden}
.art img{width:100%;height:100%;display:block}
.art.contain img{object-fit:contain} .art.cover img{object-fit:cover}
.art .ph{width:100%;height:100%;display:grid;place-items:center;text-align:center;padding:10px;
  color:#6a6250;font:400 13px/1.6 Georgia,serif;letter-spacing:.06em;
  background:radial-gradient(72% 72% at 50% 45%,#1a1713,#000 80%)}
.art .ph b{display:block;font:600 19px/1.3 Georgia,serif;color:#9a8f77;letter-spacing:.09em;
  text-transform:uppercase}
.art.missing .ph{color:#d3b06a}
.art .cap{position:absolute;left:0;right:0;bottom:0;padding:6px 10px;
  font:600 var(--cap)/1.2 Georgia,serif;letter-spacing:.11em;text-transform:uppercase;
  color:#e2d7bc;background:linear-gradient(transparent,#000000cc 62%)}
/* PREVIEW is informational. It says so, and it does not respond to the pointer the way a choice
   does -- the brief's point is that reading about a duty must not look like taking it. */
.art .pv{position:absolute;left:8px;top:8px;font:600 10px/1 ui-monospace,monospace;
  letter-spacing:.18em;color:#9fc49a;background:#0d140c;border:1px solid #8fae6a44;
  border-radius:2px;padding:3px 6px}
body.clean .art.choice:hover{filter:brightness(1.08);cursor:pointer}
body.clean .art.choice:hover::after{content:"";position:absolute;inset:0;
  box-shadow:inset 0 0 0 1px #c9b27a44}

/* Band 3b: Tithe. The alternative to the two actions, and visibly a different kind of card --
   no scenic art, a plain field, its three resources as a pyramid. No "OR" anywhere: the card
   being a separate card is the separation. */
#titheObj{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
  border-radius:5px;background:#ffffff08;border:1px solid #ffffff1c;padding:10px;
  /* room for the caption pinned at the bottom, so the tokens centre in what is left */
  padding-bottom:36px}
/* THE SAME TYPOGRAPHY AS THE ACTION ARTWORK'S CAPTION -- Georgia 600 at 17px with .11em of
   tracking, matching `.art .cap` -- so TAKE TITHE and GAIN COINS read as the same kind of thing
   said about the same kind of choice. It sits at the BOTTOM of the card and centred, where the
   captions sit, rather than heading the card from the top.
   No scrim: the caption over artwork needs one to stay legible, this card is plain dark. */
#titheObj .tl{position:absolute;left:0;right:0;bottom:10px;text-align:center;
  font:600 17px/1.2 Georgia,serif;letter-spacing:.11em;text-transform:uppercase;
  color:#e2d7bc}
/* THE ARRANGEMENT IS A TRIANGLE, NOT A STACK OF ROWS. Flex rows can only space tokens by the
   gap BETWEEN their boxes, so every step of the size control also shoved the tokens apart and
   the two controls fought each other: you could not make them bigger without spreading them,
   or closer without shrinking them. Here the three CENTRES sit on the vertices of an invisible
   equilateral triangle, apex up, and each token is centred on its vertex by translate(-50%,-50%).
   Spread moves the vertices; size grows the tokens where they stand; neither touches the other,
   and at a large enough size they are free to overlap. */
#titheObj .pyr{position:relative}
  .slot{position:absolute;display:grid;place-items:center;transform:translate(-50%,-50%)}
  .res{border-radius:50%;display:grid;place-items:center;
    background:radial-gradient(70% 70% at 35% 30%,#3c3527,#241d14);
    border:1px solid #6b5c3e;color:#e4d6b4;font:700 13px/1 ui-monospace,monospace}
  /* THE PNG IS THE COMPLETE TOKEN -- rim, disc and motif are painted into it -- so it gets no
     disc behind it and no border around it. Either would give it a second rim. */
  .tok{display:block;object-fit:contain;background:none;border:0;border-radius:0}
body.clean #titheObj.choice:hover{filter:brightness(1.1);cursor:pointer}

/* Band 3c: the City, and the acolytes in hand that borrow its region while sowing. */
#cityObj{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
  border-radius:5px;background:#ffffff05;border:1px solid #ffffff10;padding:9px}
body.clean #cityObj{background:#ffffff04}
#cityObj .cl{font:600 13px/1.1 Georgia,serif;letter-spacing:.16em;text-transform:uppercase;
  color:#b9ae96}
#cityObj .row{display:flex;align-items:flex-end;justify-content:center;gap:14px;flex:1;
  min-height:0}
#cityObj .row .fig{position:static;transform:none}
#cityObj.hand .cl{color:#cdbf9f}

/* The selected-duty highlight: an overlay, never a change to the imported asset. */
.hl{position:absolute;pointer-events:none;z-index:22}
.hl.glow{border-radius:50%;
  background:radial-gradient(58% 58% at 50% 50%,var(--hl) 0%,transparent 74%);filter:blur(2px)}
.hl.ring{border-radius:50%;border:2px solid var(--hl);box-shadow:0 0 18px var(--hl)}

/* Inspector */
#side h3{margin:12px 0 5px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--dim);border-bottom:1px solid var(--line);padding-bottom:3px;cursor:pointer;
  display:flex;justify-content:space-between}
#side h3:first-child{margin-top:0}
#side h3::after{content:"–";color:var(--dim)}
#side h3.shut::after{content:"+"}
#side h3.shut + div{display:none}
.row{display:grid;grid-template-columns:70px 1fr;gap:5px;align-items:center;margin:3px 0}
.row.two{grid-template-columns:70px 1fr 1fr}
.row.four{grid-template-columns:70px repeat(4,1fr)}
.row span{color:var(--dim);text-align:right}
.btns{display:flex;gap:5px;flex-wrap:wrap;margin:5px 0}
#status{color:var(--dim);min-height:17px;margin-top:8px;font-size:11px}
#status.ok{color:var(--ok)} #status.bad{color:var(--warn)}
#scaleTag{color:var(--dim)}
.hint{color:var(--dim);font-size:11px;line-height:1.5;margin:4px 0}
/* The metrics readout. A two-column grid rather than a table so it stays aligned while a slider
   is being dragged and the numbers are changing width underneath the cursor. */
.met{display:grid;grid-template-columns:86px 1fr;gap:1px 8px;font-size:11px;margin:4px 0}
.met i{color:var(--dim);font-style:normal;text-align:right}
.met b{font-weight:400;color:#b6ab94;font-variant-numeric:tabular-nums}
.met b.mix{color:var(--hot)}
.met b.bad{color:var(--warn)}
.sub{color:var(--dim);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
  margin:9px 0 3px}
.sw{display:inline-block;width:11px;height:11px;border-radius:2px;vertical-align:-1px;
  border:1px solid #0008}
</style>

<div id=app>
  <div id=bar>
    <span id=bView></span>
    <span class=gap></span>
    <button id=bMode aria-pressed="true">EDIT MODE</button>
    <span class=gap></span>
    <button id=bUndo title="Ctrl/Cmd+Z">undo</button>
    <button id=bRedo title="Ctrl/Cmd+Shift+Z">redo</button>
    <span class=gap></span>
    <span class=tag>zoom</span>
    <span id=zoomBtns></span>
    <span class=gap></span>
    <span class=tag>bg</span>
    <span id=bgBtns></span>
    <span class=gap></span>
    <span class=tag id=scaleTag></span>
    <span class=tag>· 1 / 2 / 3 state · f full screen</span>
    <span class=tag id=buildTag></span>
    <span class=sp></span>
    <button id=bReset>reset lab</button>
    <button id=bExport>export lab session</button>
    <button id=bImport>import lab session</button>
    <button id=bGame>export game layout</button>
    <button id=bCopy>copy game layout</button>
    <button id=bPng>export png</button>
    <input id=fImport type=file accept=".json,application/json" hidden>
  </div>

  <div id=wrap>
    <div id=fit>
      <div id=stage>
        <div id=guides></div>
      </div>
    </div>
  </div>

  <div id=side>
    <h3>view</h3>          <div id=viewCtl></div>
    <h3>layout helpers</h3><div id=helpCtl></div><div id=metCtl></div>
    <h3>selection</h3>     <div id=insp><div class=hint>Click an object on the stage.</div></div>
    <h3>status</h3>        <div id=statusCtl></div>
    <h3>duty actions</h3>  <div id=actionCtl></div>
    <h3>action artwork</h3><div id=artCtl></div>
    <h3>tithe</h3>         <div id=titheCtl></div>
    <h3>acolytes</h3>      <div id=acoCtl></div>
    <h3>duty occupancy</h3><div id=duties></div>
    <h3>players</h3>       <div id=playerCtl></div>
    <h3>city &amp; in hand</h3><div id=cityCtl></div>
    <h3>wheel attachment</h3><div id=attachCtl></div>
    <h3>guides</h3>        <div id=guideCtl></div>
    <h3>the module in a full board</h3><div id=fitInfo class=hint></div>
    <div id=status></div>
  </div>
</div>

<script>
"use strict";
// =============================================================================================
// CONSTANTS FROM THE GENERATOR. Facts about the design, not about the page, so they are
// substituted in rather than written here twice.
// =============================================================================================
var CANVAS_W     = __CANVAS_W__;
var CANVAS_H     = __CANVAS_H__;
var DUTY_ORDER   = __DUTY_ORDER__;            // north, then clockwise -- the ribbon's order too
var ACTIONS      = __DUTY_ACTIONS__;
var FULL_BOARDS  = __FULL_BOARDS__;
var SAFE_MARGIN  = __SAFE_MARGIN__;
var WHEEL_RATIO  = __WHEEL_RATIO__;            // the built-in wheel's own viewBox ratio
var WHEEL_VIEWBOX = __WHEEL_VIEWBOX__;
// FOR SAYING SO, NOT FOR COMPUTING WITH. The elevation is derived from the ratio by the
// generator; nothing here turns it back into one.
var ELEVATION    = __ELEVATION__;
var HELPERS      = __HELPER_RANGES__;          // studio-only control ranges, never game state
var STATE_VERSION = __STATE_VERSION__;
var BUILD_VERSION = __BUILD_VERSION__;
var ACO_RANGE    = __ACOLYTE_RANGE__;
var ACO_ASPECT   = __ACOLYTE_ASPECT__;
var BACKGROUNDS  = __BACKGROUNDS__;
var ZOOM_STEPS   = __ZOOM_STEPS__;
var PLAYER_IDS   = __PLAYER_IDS__;
var VIEW_STATES  = __VIEW_STATES__;           // ready, sow, action
var SEAL_SIZE    = __SEAL_SIZE__;
var DEFAULT_STATE = __DEFAULT_STATE__;

var STORE_KEY = "duty_wheel_layout_lab_v4";
var MIN_SIZE = 20;
var HIST_MAX = 50;
var WHEEL_Z = 20;                        // the one z value nothing else may take

var S = null;                            // the live state; the only source of truth
var sel = null;                          // {kind, id} of the selected object
var scale = 1;                           // stage display scale, CSS px per design px

// =============================================================================================
// THE IMAGE POOL. An asset field stores a KEY and a filename; the bytes live here, outside the
// state, and are never cloned with it. That is why the autosave carries no image data, fifty
// undo snapshots cost kilobytes, a Lab Session exports with or without bytes from the same
// object, and a lost asset can say which file to reload.
// =============================================================================================
var IMAGES = {};
var IMG_SEQ = 0;
function putImage(url){ var k = "im" + (++IMG_SEQ); IMAGES[k] = url; return k; }

// EVERY KEY THE STATE STILL CLAIMS, whether or not its bytes survived.
//
// THE BUG THIS EXISTS TO PREVENT, because it is not obvious and it was live: the pool counter
// starts at 0 on every page load, while the autosave keeps image KEYS and strips only the BYTES.
// Reload a lab that had two action artworks and the state still says actionA is "im1" -- with
// nothing behind it -- but the counter says the next key to hand out is "im1". So the very next
// image loaded, a tithe token say, was handed "im1" and INSTANTLY BECAME the action artwork as
// well: one file, two owners, and a wheat token filling the Gain Piety slot.
//
// importSession already did this for keys whose bytes were in the file. That was the narrow
// case. The broad one is any state that outlives its pool -- an autosave, a geometry-only
// session, a hand-written file -- so the reservation belongs where the state arrives.
function reserveImageKeys(d){
  var max = 0;
  JSON.stringify(d).replace(/"im(\d+)"/g, function(m, n){
    n = +n; if (n > max) max = n; return m;
  });
  if (max > IMG_SEQ) IMG_SEQ = max;
}
function imgSrc(key){ return (key && IMAGES[key]) || null; }
function haveImage(key){ return !!(key && IMAGES[key]); }

// PIXEL DIMENSIONS, cached beside the pool for the same reason the bytes are: they are a fact
// about the image, not a layout decision, so they have no business in the state, in an undo
// snapshot or in a saved session. An image restored from a session arrives with no entry here,
// so the first ask probes it once and repaints.
// The Tithe card's own furniture: 10px padding top and bottom, the TAKE TITHE line, and the
// 10px gap between that line and the pyramid. What is left is what the tokens have to live in.
var TITHE_CHROME = 10 + 36 + 4;
var TITHE_SIDES = 20;

var IMG_DIMS = {};
var DIM_PENDING = {};
function noteDims(key, w, h){ if (key && w && h) IMG_DIMS[key] = {w: w, h: h}; }
function dimsOf(key){
  if (!key) return null;
  if (IMG_DIMS[key]) return IMG_DIMS[key];
  var url = imgSrc(key);
  // `Image` is a browser thing. The source-level guards run this file's logic under Node, where
  // asking for one throws -- and a readout that cannot be filled in is not worth taking the page
  // down for, so the probe is simply skipped and the panel shows no dimensions.
  if (!url || DIM_PENDING[key] || typeof Image === "undefined") return null;
  DIM_PENDING[key] = true;
  var p = new Image();
  p.onload = function(){ DIM_PENDING[key] = false;
                         noteDims(key, p.naturalWidth, p.naturalHeight); panels(); };
  p.onerror = function(){ DIM_PENDING[key] = false; };
  p.src = url;
  return null;
}
function ratioText(w, h){ return h ? (w / h).toFixed(3) : "--"; }

// WHICH DISPLAY SLOT IS SHOWING AN ACTION. The slots own geometry and the actions own artwork,
// so this is a lookup rather than a stored link -- and it answers honestly when both slots have
// been pointed at the same action.
function slotForAction(key){
  var sides = ["left", "right"], i;
  for (i = 0; i < sides.length; i++){ if (artOf(sides[i]).slot === key) return artOf(sides[i]); }
  return null;
}

// HOW MUCH `cover` WILL EAT. Informational only: nothing here resizes a slot or touches a file.
function coverCrop(imgW, imgH, slotW, slotH){
  if (!imgW || !imgH || !slotW || !slotH) return null;
  var ir = imgW / imgH, sr = slotW / slotH;
  var lost = ir > sr ? 1 - sr / ir : 1 - ir / sr;
  return {pct: lost * 100, imgRatio: ir, slotRatio: sr,
          // 2.000 against the slot's 2.038 is 1.9% and must not read as a problem; a 1.50
          // image in a 2.04 slot loses a quarter of its width and must.
          word: lost < 0.05 ? "minimal" : lost < 0.15 ? "slight" : "substantial",
          bad: lost >= 0.15};
}

function clone(o){ return JSON.parse(JSON.stringify(o)); }
function clamp(v, lo, hi){ v = +v; if (!isFinite(v)) return lo; return Math.min(hi, Math.max(lo, v)); }
function el(id){ return document.getElementById(id); }
function esc(s){ return String(s === null || s === undefined ? "" : s).replace(/[&<>"]/g,
  function(c){ return ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c]; }); }

// =============================================================================================
// COORDINATE CONVERSION.
//
// (1) SCREEN TO DESIGN. The stage is 1400x1200 scaled by a CSS transform, so a design coordinate
// is (client - stage origin) / scale, with both read from getBoundingClientRect() each time so a
// scroll, a resize or a zoom step cannot put the model out of step with the pointer.
//
// (2) DESIGN TO WHEEL-RELATIVE. The duty figure anchors store u and v as fractions of the
// wheel's box, so they keep their place on it when it moves or scales. Values outside 0..1 are
// ordinary and nothing is clamped. Both representations are kept current: moveTo writes x/y and
// u/v, and any change to the wheel re-derives x/y.
//
// V4 NOTE: the anchors are now the ONLY wheel-relative objects. The in-hand pool and Tithe both
// left the wheel's centre -- in-hand borrows the City's region while sowing, Tithe is a card in
// the band -- so the centre-anchor mode V3.1 needed for them has gone with them.
// =============================================================================================
function toDesign(ev){
  var r = el("stage").getBoundingClientRect();
  var k = r.width / CANVAS_W;
  return {x: (ev.clientX - r.left) / k, y: (ev.clientY - r.top) / k};
}
function fromUV(u, v){ var w = S.wheel; return {x: w.x + u * w.width, y: w.y + v * w.height}; }
function toUV(x, y){ var w = S.wheel; return {u: (x - w.x) / w.width, v: (y - w.y) / w.height}; }

function attachable(kind){ return kind === "figs"; }
function attachedOf(kind, id){
  if (!attachable(kind) || !S.attachToWheel) return false;
  var o = objOf(kind, id);
  return !!(o && o.attached);
}
function eachAttachable(fn){ DUTY_ORDER.forEach(function(s){ fn(objOf("figs", s)); }); }
function writeUV(o){ var uv = toUV(o.x, o.y); o.u = +uv.u.toFixed(4); o.v = +uv.v.toFixed(4); }
function placeFromUV(o){ var p = fromUV(o.u, o.v); o.x = Math.round(p.x); o.y = Math.round(p.y); }
// THE WHEEL MOVED: re-derive x/y from u/v. Guarded by the global switch as well as the
// per-object flag, so "all free" really does mean the wheel can move without dragging anything.
function syncAttached(){
  if (!S.attachToWheel) return;
  eachAttachable(function(o){ if (o && o.attached) placeFromUV(o); });
}
// THE SWITCH WENT ON: re-derive u/v from where things are, so attaching records the present
// composition rather than restoring an older one. The opposite direction, hence both.
function reanchorAll(){ eachAttachable(function(o){ if (o) writeUV(o); }); }

function relayout(){
  var w = el("wrap").clientWidth - 26, h = el("wrap").clientHeight - 26;
  scale = (S.zoom === "fit") ? Math.min(w / CANVAS_W, h / CANVAS_H, 1) : (+S.zoom / 100);
  if (!isFinite(scale) || scale <= 0) scale = 1;
  el("stage").style.transform = "scale(" + scale + ")";
  el("fit").style.width  = (CANVAS_W * scale) + "px";
  el("fit").style.height = (CANVAS_H * scale) + "px";
  el("scaleTag").textContent = "stage " + CANVAS_W + " × " + CANVAS_H + " · "
    + (S.zoom === "fit" ? "fit " : "") + Math.round(scale * 1000) / 10 + "%";
  paintZoom();
}
addEventListener("resize", function(){ if (S) relayout(); });

// =============================================================================================
// THE OBJECT MODEL. Every editable thing answers the same questions, so drag, resize, nudge,
// the inspector and the boundary check are each written once rather than once per kind.
// =============================================================================================
function actionOf(slug, slot){ var d = S.duties[slug]; return d && d[slot]; }
function artOf(side){ return side === "left" ? S.display.artLeft : S.display.artRight; }
function reachedDuty(){ return S.duties[S.selectedDuty] ? S.selectedDuty : DUTY_ORDER[0]; }

// WHICH DUTY THE TWO ARTWORK BOXES ARE SHOWING, which is the hinge of the whole V4 interaction.
//
// In ACTION SELECTION it is the duty the sow reached, and the player did not have to ask for it.
// In READY and SOWING it is whichever reference card was clicked, or nothing -- the artwork is
// not on screen until somebody wants to read about a duty. Those are different things and the
// page says so: a preview is badged and inert, a choice is not.
function shownDuty(){
  if (S.view === "action") return reachedDuty();
  return (S.previewDuty && S.duties[S.previewDuty]) ? S.previewDuty : null;
}
function previewing(){ return S.view !== "action" && !!shownDuty(); }
function artLabel(side){
  var d = shownDuty();
  if (!d) return "";
  var a = actionOf(d, artOf(side).slot);
  return (a && (a.name || a.shortLabel)) || artOf(side).slot;
}

function objOf(kind, id){
  if (kind === "wheel")  return S.wheel;
  if (kind === "status") return S.status;
  if (kind === "card")   return S.duties[id] && S.duties[id].card;
  if (kind === "figs")   return S.duties[id] && S.duties[id].figures;
  if (kind === "art")    return artOf(id);
  if (kind === "tithe")  return S.tithe;
  if (kind === "city")   return S.city;
  return null;
}
function posOf(kind, id){
  var o = objOf(kind, id);
  if (attachedOf(kind, id)) return fromUV(o.u, o.v);
  return {x: o.x, y: o.y};
}
// Figure anchors are a point, not a box. Giving them a rect here keeps the drag code from
// growing a special case.
function rectOf(kind, id){
  var o = objOf(kind, id), p = posOf(kind, id);
  if (kind === "figs") return {x: p.x - 8, y: p.y - 8, width: 16, height: 16};
  return {x: p.x, y: p.y, width: o.width, height: o.height};
}
function moveTo(kind, id, x, y){
  var o = objOf(kind, id);
  if (kind === "figs"){ x += 8; y += 8; }
  o.x = Math.round(x); o.y = Math.round(y);
  if (attachable(kind)) writeUV(o);
}
function lockedOf(kind, id){ var o = objOf(kind, id); return !!(o && o.locked); }
function resizableOf(kind){
  return kind === "wheel" || kind === "status" || kind === "card" || kind === "art"
      || kind === "tithe" || kind === "city";
}
// The wheel is the one object whose proportions are not the layout's to change: it arrives drawn
// at 32 degrees of elevation and re-shaping it would be re-projecting it.
function aspectLockedOf(kind){ return kind === "wheel"; }

// WHICH STATES AN OBJECT APPEARS IN -- the single table the whole three-state design hangs off,
// so render, Clean Preview and the ghosting all agree by construction.
//
// The wheel, the cards, the acolytes, the status line and the City are in ALL THREE, and the
// wheel and the City are not merely present in all three but IDENTICAL: nothing in this file
// writes their geometry per state, which is what makes the three comparable.
//
// The artwork is the conditional one -- present whenever a duty is being shown, which is always
// in ACTION and only on request before it -- so it answers through shownDuty() rather than
// through a fixed list.
function statesOf(kind){
  if (kind === "tithe") return ["action"];
  if (kind === "art")   return shownDuty() ? ["ready", "sow", "action"] : [];
  return ["ready", "sow", "action"];
}
function activeHere(kind){ return statesOf(kind).indexOf(S.view) >= 0; }

// =============================================================================================
// THE LAYOUT HELPERS: GROUP READINGS.
//
// Every one of these is DERIVED from the objects, and none of them is stored. A `groupHeight` or
// a `rowGap` kept in the state is a second opinion about geometry that is already there, and the
// moment somebody drags one card it is a lie -- so the panel asks the eight cards what height
// they are rather than remembering what it last set them to.
//
// That is also why these report MIXED honestly instead of showing the first card's numbers as if
// they spoke for all eight. The whole point of the panel is to tell you what the composition is
// actually doing.
// =============================================================================================
function spread(values){
  var lo = Math.min.apply(null, values), hi = Math.max.apply(null, values);
  return {lo: lo, hi: hi, uniform: lo === hi};
}
function cardGroup(){
  var ws = [], hs = [], ys = [];
  DUTY_ORDER.forEach(function(s){
    var c = S.duties[s].card; ws.push(c.width); hs.push(c.height); ys.push(c.y);
  });
  return {w: spread(ws), h: spread(hs), y: spread(ys)};
}

// THE THREE HORIZONTAL GAPS OF THE ACTION ROW, left to right, measured rather than remembered.
function rowGaps(){
  var L = artOf("left"), R = artOf("right"), T = S.tithe, C = S.city;
  return [Math.round(R.x - (L.x + L.width)),
          Math.round(T.x - (R.x + R.width)),
          Math.round(C.x - (T.x + T.width))];
}
function rowGapCommon(){
  var g = rowGaps();
  return (g[0] === g[1] && g[1] === g[2]) ? g[0] : null;
}
// What the slider opens at. The median rather than the mean, because one wild gap should not
// drag the suggestion away from the two that agree. IT IS A SUGGESTION AND NOTHING MORE: reading
// it changes nothing, and the gaps are only levelled when somebody moves the control.
function rowGapSuggested(){
  var c = rowGapCommon();
  if (c !== null) return c;
  var s = rowGaps().slice().sort(function(a, b){ return a - b; });
  return Math.round(s[1]);
}
// THE VERTICAL SQUEEZE, which is the whole reason the card height is worth experimenting with.
// Negative means the cards have grown into the action row. Reported, never corrected: deciding
// whether that composition works is what the lab is for.
function cardsToRowGap(){
  var top = Math.min(artOf("left").y, artOf("right").y, S.tithe.y, S.city.y);
  var bottom = Math.max.apply(null, DUTY_ORDER.map(function(s){
    var c = S.duties[s].card; return c.y + c.height;
  }));
  return Math.round(top - bottom);
}

// =============================================================================================
// THE LAYOUT HELPERS: OPERATIONS.
//
// SHORTCUTS, NOT LINKS. Each one writes the existing geometry once and then lets go; nothing
// stays coupled afterwards. Resizing one card by hand after using the group slider is allowed
// and is reported as mixed rather than silently corrected.
//
// NOTHING HERE CASCADES. Taller cards do not push the action row down, taller artwork does not
// move the wheel. The module is a fixed 1400 x 1200 and the point of the exercise is to see how
// these bands compete for it; automatic reflow would hide exactly that.
// =============================================================================================
// A LOCKED OBJECT'S GEOMETRY CANNOT BE CHANGED -- and a group helper is not an exception to
// that, however convenient it would be. The drag code and the arrow keys already honour the
// lock; these write the objects directly, so without this they were a back door through it.
//
// ALL OR NOTHING. A group operation that skipped the locked member would resize seven cards and
// leave the eighth, which is precisely the mixed geometry these helpers exist to repair --
// the tool would be creating the mess it is meant to clean up.
//
// WHAT AN OPERATION WRITES IS WHAT IT REQUIRES, and nothing more. The row gap does not touch the
// left artwork, so a locked left artwork does not block it; the linked height does not touch
// Tithe or the City, so theirs is irrelevant. Anything else would make the lock mean "near this"
// rather than "this".
function requireUnlocked(needed){
  var stuck = [];
  needed.forEach(function(o){
    if (lockedOf(o.kind, o.id)) stuck.push(o.label);
  });
  if (!stuck.length) return true;
  // No geometry is touched and no history entry is made: a refusal is not an edit.
  //
  // THE VERB COMES OFF `needed`, NOT OFF `stuck`. They are different arrays -- stuck is built
  // here out of the labels -- and reading it from the wrong one produced "cannot undefined ·
  // Ordination's card is locked", which every test still passed because they were checking for
  // the lock and the object name rather than reading the sentence.
  say("cannot " + needed.verb + " · " + stuck.join(" and ") + (stuck.length > 1
        ? " are locked" : " is locked"), true);
  return false;
}
// The message reads better with the operation's own verb, and threading it through the array is
// less noise at every call site than a second argument everywhere.
function needs(verb, list){ list.verb = verb; return list; }

function ART_L(){ return {kind: "art", id: "left", label: "the left artwork"}; }
function ART_R(){ return {kind: "art", id: "right", label: "the right artwork"}; }
function TITHE_O(){ return {kind: "tithe", id: null, label: "Tithe"}; }
function CITY_O(){ return {kind: "city", id: null, label: "the City"}; }
function WHEEL_O(){ return {kind: "wheel", id: null, label: "the wheel"}; }
function ALL_CARDS(){
  return DUTY_ORDER.map(function(s){
    return {kind: "card", id: s, label: S.duties[s].name + "'s card"};
  });
}

function setWheelWidth(w, soon){
  if (!requireUnlocked(needs("resize the wheel", [WHEEL_O()]))) return;
  var W = S.wheel;
  W.width = clamp(Math.round(w), HELPERS.wheelW[0], HELPERS.wheelW[1]);
  // The ratio is the design invariant, so the height follows rather than being offered.
  W.height = Math.round(W.width * WHEEL_RATIO);
  // AND THE HELPER CENTRES IT, because resizing from a corner handle leaves the wheel off
  // centre and re-centring by hand is the fiddly part this panel exists to remove. Y is left
  // alone: how far down the module the wheel sits is a composition decision, not arithmetic.
  W.x = Math.round((CANVAS_W - W.width) / 2);
  syncAttached();
  commit(soon);
}
// THE REPAIR OPERATION, separate on purpose: the wheel can still be dragged and resized by hand,
// and this puts it back on the module's centre line without touching anything else.
function centreWheelX(){
  if (!requireUnlocked(needs("centre the wheel", [WHEEL_O()]))) return;
  S.wheel.x = Math.round((CANVAS_W - S.wheel.width) / 2);
  syncAttached();
  commit();
}

function setCardHeights(h, soon){
  if (!requireUnlocked(needs("resize the duty cards", ALL_CARDS()))) return;
  var v = clamp(Math.round(h), HELPERS.cardH[0], HELPERS.cardH[1]);
  DUTY_ORDER.forEach(function(s){ S.duties[s].card.height = v; });
  commit(soon);
}
function alignCardTops(){
  // ALL EIGHT, even though Clerical's own y does not move: a partial alignment -- level the
  // seven you can, leave the locked one where it is -- is not an alignment.
  if (!requireUnlocked(needs("align the duty cards", ALL_CARDS()))) return;
  // Clerical is the row anchor, as it is everywhere else in this file.
  var y = S.duties[DUTY_ORDER[0]].card.y;
  DUTY_ORDER.forEach(function(s){ S.duties[s].card.y = y; });
  commit();
}

// THE LEFT ARTWORK IS THE ROW'S ANCHOR. Everything downstream is rebuilt from it so the reading
// order -- two actions, then the alternative to them, then the reserve -- survives any resize.
function layoutActionRow(gap){
  var L = artOf("left"), R = artOf("right"), T = S.tithe, C = S.city;
  R.x = Math.round(L.x + L.width + gap);
  T.x = Math.round(R.x + R.width + gap);
  C.x = Math.round(T.x + T.width + gap);
}
function setArtWidth(w, soon){
  // The widths move both boxes and the new widths move Tithe and the City along the row, so all
  // four are written and all four are required.
  if (!requireUnlocked(needs("resize the action artwork",
                             [ART_L(), ART_R(), TITHE_O(), CITY_O()]))) return;
  var v = clamp(Math.round(w), HELPERS.artW[0], HELPERS.artW[1]);
  // THE GAP IS READ BEFORE THE WIDTHS MOVE, which is the whole subtlety here. rowGapSuggested()
  // measures the distances between the boxes, so asking it afterwards asks about a row that is
  // already half-rebuilt: shrinking the artwork opens a huge hole where the second box still is,
  // and the median of that nonsense becomes the new spacing. Widening does the reverse and packs
  // the row at a negative gap.
  var gap = rowGapSuggested();
  artOf("left").width = v; artOf("right").width = v;
  layoutActionRow(gap);
  commit(soon);
}
function setArtHeight(h, soon){
  // ONLY THE TWO BOXES. Tithe and the City keep their own height, so their locks say nothing
  // about this operation -- which is the check that proves the rule is "what it writes".
  if (!requireUnlocked(needs("resize the action artwork", [ART_L(), ART_R()]))) return;
  var v = clamp(Math.round(h), HELPERS.artH[0], HELPERS.artH[1]);
  var L = artOf("left"), R = artOf("right");
  L.height = v; R.height = v;
  R.y = L.y;
  // TITHE AND THE CITY ARE LEFT ALONE. Scenic art taller than the utility cards is a legitimate
  // thing to want to look at, and making them follow would answer that question by fiat.
  commit(soon);
}
function setRowGap(g, soon){
  // The left artwork is the anchor and is not written, so it may stay locked.
  if (!requireUnlocked(needs("re-space the action row",
                             [ART_R(), TITHE_O(), CITY_O()]))) return;
  layoutActionRow(clamp(Math.round(g), HELPERS.gap[0], HELPERS.gap[1]));
  commit(soon);
}
function alignRowTop(){
  if (!requireUnlocked(needs("align the action row",
                             [ART_R(), TITHE_O(), CITY_O()]))) return;
  var y = artOf("left").y;
  artOf("right").y = y; S.tithe.y = y; S.city.y = y;
  commit();
}
// THE ROW CAN BE MADE TOO WIDE, and this is the way back. The two scenic boxes are the only
// things that give: Tithe and the City keep their widths because they hold fixed content, and
// the gap keeps whatever the person chose. Refused rather than applied when the answer would be
// a box too small to judge anything by -- silently producing a 40px artwork slot would look like
// the button being broken.
function fitActionRow(){
  if (!requireUnlocked(needs("fit the action row",
                             [ART_L(), ART_R(), TITHE_O(), CITY_O()]))) return;
  var L = artOf("left"), R = artOf("right"), T = S.tithe, C = S.city;
  // CLAMPED, UNLIKE THE ORDINARY RESIZE. This button is restorative: it exists to put a row that
  // has been experimented into a mess back into a valid fit. Manual experimentation can leave
  // gaps like -20 / -10 / 12, whose median is negative, and rebuilding the row at a negative gap
  // would be a repair that deliberately kept the overlap.
  //
  // setArtWidth does NOT do this, and must not: an ordinary resize preserves the composition
  // somebody is in the middle of making, overlaps and all.
  var raw = rowGapSuggested();
  var gap = clamp(raw, HELPERS.gap[0], HELPERS.gap[1]);
  var available = CANVAS_W - L.x - HELPERS.rowRight - T.width - C.width - 3 * gap;
  var w = Math.floor(available / 2);
  if (w < HELPERS.artW[0]){
    say("the row cannot fit: Tithe, the City and the gaps leave " + Math.max(0, available)
        + " px for two artworks, under the " + (HELPERS.artW[0] * 2) + " px minimum", true);
    return;
  }
  w = Math.min(w, HELPERS.artW[1]);
  L.width = w; R.width = w;
  layoutActionRow(gap);
  commit();
  say("action row fitted · artwork " + L.width + " px each, gap " + gap + " px"
      + (raw !== gap ? " · normalised from " + raw : ""));
}

// =============================================================================================
// THE MODULE BOUNDARY. Nothing is clamped: composing something that bleeds off the edge is a
// legitimate thing to try, and a tool that silently prevented it would be answering a design
// question on the designer's behalf. So the overshoot is measured and shown instead.
// =============================================================================================
function overflowOf(r){
  var o = {};
  if (r.x < 0) o.left = Math.round(-r.x);
  if (r.y < 0) o.top = Math.round(-r.y);
  if (r.x + r.width  > CANVAS_W) o.right  = Math.round(r.x + r.width  - CANVAS_W);
  if (r.y + r.height > CANVAS_H) o.bottom = Math.round(r.y + r.height - CANVAS_H);
  return Object.keys(o).length ? o : null;
}
function overflowText(o){
  return Object.keys(o).map(function(k){ return k + " +" + o[k]; }).join("  ");
}

// =============================================================================================
// RENDER. One pass rebuilds the stage from state.
// =============================================================================================
function figureSvg(colour, painted){
  var body = painted ? "#7d7568" : colour;
  var trim = painted ? "#57514a" : "#00000055";
  return '<svg viewBox="0 0 42 100" xmlns="http://www.w3.org/2000/svg">'
    + '<ellipse cx="21" cy="95" rx="15" ry="5" fill="' + trim + '"/>'
    + '<path d="M21 14c-6 0-9 5-9 11 0 5 2 8 2 11l-6 40c-1 7-2 12-2 15h30c0-3-1-8-2-15l-6-40'
    + 'c0-3 2-6 2-11 0-6-3-11-9-11z" fill="' + body + '"/>'
    + '<circle cx="21" cy="11" r="8" fill="' + body + '"/>'
    + '<path d="M21 3a8 8 0 0 0-8 8c0 2 1 4 2 5 1-5 3-8 6-8s5 3 6 8c1-1 2-3 2-5a8 8 0 0 0-8-8z"'
    + ' fill="' + trim + '"/>'
    + '<ellipse cx="21" cy="92" rx="13" ry="4.5" fill="' + body + '" opacity=".85"/>'
    + '</svg>';
}
function seatColour(pid){
  var p = S.players.filter(function(q){ return q.id === pid; })[0];
  return (p && p.colour) || S.players[0].colour;
}
// Is a colour dark enough that a dark number on it would disappear? Cheap relative luminance:
// the four seats are all mid-tone today, but a person can set any colour they like in the panel
// and a count that vanishes into a dark robe is a count nobody can read.
function darkSeat(hex){
  var m = /^#?([0-9a-f]{6})$/i.exec(hex || "");
  if (!m) return false;
  var n = parseInt(m[1], 16);
  var r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  return (0.2126 * r + 0.7152 * g + 0.0722 * b) < 118;
}
// One acolyte. `count` draws the number ON the figure rather than beside it -- see the .ct rule.
function acolyteHtml(pid, h, count){
  var A = S.acolytes, key = A.style === "painted" ? A.painted[pid] : A.colored[pid];
  var src = imgSrc(key);
  var col = seatColour(pid);
  var inner = src ? '<img src="' + src + '" alt="">'
                  : figureSvg(col, A.style === "painted");
  var ct = (count === undefined || count === null) ? ""
         : '<b class=ct style="--cs:' + Math.max(9, Math.round(h * 0.30)) + 'px">'
           + esc(count) + '</b>';
  var lt = (A.style === "painted" || darkSeat(col)) ? " lt" : "";
  return '<div class="fig' + lt + '" style="--fh:' + h + 'px;height:' + h + 'px;position:relative">'
       + inner + ct + '</div>';
}
function acolyteHeight(which){
  var A = S.acolytes;
  return Math.max(6, Math.round(A.height * (A.ratios[which] || 100) / 100));
}
function figureRowHtml(seats, n, spacing, arrangement, h){
  if (n <= 0) return "";
  var out = "", per = arrangement === "compact" ? spacing * 0.58 : spacing;
  var span = (n - 1) * per;
  for (var i = 0; i < n; i++){
    var dx = -span / 2 + i * per, dy = 0;
    if (arrangement === "compact") dy = (i % 2 === 1) ? -Math.round(h * 0.10) : 0;
    if (arrangement === "arc" && n > 1){
      var t = (i / (n - 1)) * 2 - 1;
      dy = Math.round((1 - t * t) * h * 0.16);
    }
    out += '<div style="position:absolute;left:' + dx + 'px;bottom:' + dy + 'px">'
         + acolyteHtml(seats[i] || seats[0] || PLAYER_IDS[0], h) + '</div>';
  }
  return out;
}
// A wax seal, or a stand-in that says which action it is. The cards have to stay readable before
// any final art exists, which is why the placeholder carries a letter.
function sealHtml(asset, letter){
  var src = imgSrc(asset);
  return '<span class="seal">'
       + (src ? '<img src="' + src + '" alt="">' : esc(letter)) + '</span>';
}

function render(){
  var st = el("stage");
  [].slice.call(st.querySelectorAll(".obj, .hl")).forEach(function(e){ e.remove(); });
  var frag = document.createDocumentFragment();
  var editing = S.mode !== "clean";

  function make(kind, id, rect, cls, inner, z, ghost){
    var d = document.createElement("div");
    d.className = "obj " + cls + " box" + (ghost ? " ghost" : "");
    d.dataset.kind = kind; if (id) d.dataset.id = id;
    d.style.cssText = "left:" + rect.x + "px;top:" + rect.y + "px;width:" + rect.width
                    + "px;height:" + rect.height + "px;z-index:" + z;
    d.innerHTML = inner;
    if (sel && sel.kind === kind && (sel.id || null) === (id || null)) d.classList.add("sel");
    var ov = (S.guides.warnings && !ghost) ? overflowOf(rect) : null;
    if (ov){
      d.classList.add("oob");
      var t = document.createElement("span");
      t.className = "oobtag" + (rect.y < 18 ? " low" : "");
      t.textContent = "OUTSIDE MODULE  " + overflowText(ov);
      d.appendChild(t);
    }
    frag.appendChild(d);
    return d;
  }
  function handles(d, kind){
    var names = aspectLockedOf(kind) ? ["nw","ne","sw","se"]
              : ["nw","ne","sw","se","n","s","e","w"];
    names.forEach(function(n){
      var h = document.createElement("div"); h.className = "h " + n; h.dataset.handle = n;
      d.appendChild(h);
    });
  }
  // Shown, hidden, or shown faintly as a ghost. A ghost is editing chrome: it lets an object
  // that belongs to another state be composed without leaving this one, and Clean Preview -- the
  // view that exists to show one state honestly -- never contains one.
  function shows(kind){
    if (activeHere(kind)) return "yes";
    return (editing && S.showGhosts) ? "ghost" : "no";
  }

  // ---- 1. the wheel --------------------------------------------------------------------------
  // IDENTICAL IN ALL THREE STATES. Nothing in this file writes wheel geometry per view state.
  // Its centre is deliberately empty: nothing is drawn there at all.
  var w = S.wheel;
  var wheelInner = haveImage(w.image)
    ? '<img src="' + imgSrc(w.image) + '" alt="">'
    : builtinWheel();
  var dw = make("wheel", null, rectOf("wheel", null), w.ground ? "" : "noground",
                '<span class=nm>wheel</span>' + wheelInner, WHEEL_Z);
  dw.id = "wheelObj";
  dw.style.opacity = w.opacity;
  if (!w.locked) handles(dw, "wheel");

  // ---- 2. the reached duty's highlight -------------------------------------------------------
  // An overlay at that duty's own anchor, in ACTION SELECTION only -- before then nothing has
  // been reached and a highlight would be claiming otherwise. Never a change to the wheel asset.
  var H = S.display.highlight;
  if (S.view === "action" && H.visible){
    var fa = rectOf("figs", reachedDuty());
    var hd = document.createElement("div");
    hd.className = "hl " + H.style;
    hd.style.cssText = "left:" + Math.round(fa.x + 8 - H.width / 2) + "px;top:"
      + Math.round(fa.y + 8 + H.dy - H.height / 2) + "px;width:" + H.width + "px;height:"
      + H.height + "px;opacity:" + H.opacity + ";--hl:" + H.colour;
    frag.appendChild(hd);
  }

  // ---- 3. the acolytes on the wheel ----------------------------------------------------------
  var fh = acolyteHeight("duty");
  DUTY_ORDER.forEach(function(slug){
    var f = S.duties[slug].figures;
    var d = make("figs", slug, rectOf("figs", slug), "",
                 '<span class=nm>' + esc(S.duties[slug].name) + ' figures</span>'
                 + '<span class=anchor></span>', WHEEL_Z + 25);
    d.style.overflow = "visible";
    var holder = document.createElement("div");
    holder.style.cssText = "position:absolute;left:8px;bottom:8px;width:0;height:0";
    holder.innerHTML = figureRowHtml(f.seats, f.count, f.spacing, f.arrangement, fh);
    d.appendChild(holder);
  });

  // ---- 4. the two scenic artworks ------------------------------------------------------------
  var shown = shownDuty(), isPreview = previewing();
  var artMode = shows("art");
  if (artMode !== "no"){
    ["left", "right"].forEach(function(side){
      var e = artOf(side);
      if (!e.visible) return;
      var a = shown ? (actionOf(shown, e.slot) || {}) : {};
      var cls = "art " + e.fit + (isPreview ? "" : " choice");
      var inner;
      if (haveImage(a.scenic)) inner = '<img src="' + imgSrc(a.scenic) + '" alt="">';
      else if (a.scenic && a.scenicName){
        cls += " missing";
        inner = '<div class=ph><b>' + esc(a.name || e.slot) + '</b>Reload: '
              + esc(a.scenicName) + '</div>';
      } else {
        inner = '<div class=ph><b>' + esc(a.name || e.slot) + '</b>scenic artwork</div>';
      }
      var d = make("art", side, rectOf("art", side), cls,
                   '<span class=nm>artwork ' + side + ' · ' + esc(e.slot) + '</span>' + inner,
                   WHEEL_Z - 5, artMode === "ghost");
      d.style.opacity = e.opacity;
      if (e.labelVisible && artLabel(side)){
        var cap = document.createElement("div");
        cap.className = "cap"; cap.style.setProperty("--cap", e.labelSize + "px");
        cap.textContent = artLabel(side);
        d.appendChild(cap);
      }
      // THE BADGE IS THE POINT OF THE PREVIEW. Reading about a duty must not look like taking it.
      if (isPreview){
        var pv = document.createElement("span");
        pv.className = "pv"; pv.textContent = "PREVIEW";
        d.appendChild(pv);
      }
      if (!e.locked && artMode === "yes") handles(d, "art");
    });
  }

  // ---- 5. Tithe ------------------------------------------------------------------------------
  // ACTION SELECTION only, and never in a preview: it is not something a duty offers, it is the
  // alternative to taking what a duty offers, so it has no business on screen while you are
  // still reading.
  var titheMode = shows("tithe");
  if (titheMode !== "no" && S.tithe.visible){
    var T = S.tithe;
    var res = (T.resources || []);
    // The vertices are measured from the triangle box's own middle, so the three land exactly
    // on its corners and apex however big the tokens themselves are.
    var tb = tokenTriangle(), tp = tokenPoints();
    var pyr = '<div class=pyr style="width:' + tb.width + 'px;height:' + tb.height + 'px">'
            + res.slice(0, 3).map(function(r, i){ return tokenHTML(r, tp[i], tb); }).join("")
            + '</div>';
    var dt = make("tithe", null, rectOf("tithe", null),
                  S.view === "action" ? "choice" : "",
                  '<span class=nm>tithe</span>' + pyr + '<div class=tl>' + esc(T.label)
                    + '</div>',
                  WHEEL_Z + 15, titheMode === "ghost");
    dt.id = "titheObj";
    if (!T.locked && titheMode === "yes") handles(dt, "tithe");
  }

  // ---- 6. the City, which is the acolytes in hand while sowing --------------------------------
  // ONE REGION, TWO JOBS. The count in hand used to sit in the wheel's centre; it reads better
  // here, beside the other reserve, and it leaves the centre quiet.
  if (S.city.visible){
    var c = S.city, hand = (S.view === "sow");
    var body;
    if (hand){
      var ih = S.inHand;
      body = '<div class=cl>' + esc(ih.label) + '</div><div class=row>'
           + acolyteHtml(ih.seat, acolyteHeight("inHand"), ih.count) + '</div>';
    } else {
      var ch = acolyteHeight("city");
      body = '<div class=cl>' + esc(c.label) + '</div><div class=row>'
           + PLAYER_IDS.filter(function(p){ return c.shown[p]; }).map(function(p){
               return acolyteHtml(p, ch, c.counts[p] || 0); }).join("")
           + '</div>';
    }
    var dc = make("city", null, rectOf("city", null), hand ? "hand" : "",
                  '<span class=nm>' + (hand ? "acolytes in hand" : "city") + '</span>' + body,
                  WHEEL_Z + 30);
    dc.id = "cityObj";
    if (!c.locked) handles(dc, "city");
  }

  // ---- 7. the duty reference cards ------------------------------------------------------------
  // Eight, in the wheel's own order. Reference in every state: clicking one previews and chooses
  // nothing. Nothing here knows which side of the row a duty is on.
  DUTY_ORDER.forEach(function(slug){
    var D = S.duties[slug], cd = D.card;
    if (!cd.visible) return;
    var acts = ACTIONS.map(function(a, i){
      var act = D[a.key] || {};
      return '<div class=act>' + sealHtml(act.seal, i === 0 ? "A" : "B")
           + '<span>' + esc(act.shortLabel || act.name || a.label) + '</span></div>';
    }).join("");
    // `previewable` is the affordance and nothing else: it says a click here will do something,
    // which is true in READY and SOWING and false in ACTION SELECTION. It is deliberately not
    // the same class as `reached`, which is a statement about the game rather than the pointer.
    var cls = "card";
    if (S.view !== "action") cls += " previewable";
    if (S.view === "action" && slug === reachedDuty()) cls += " reached";
    else if (slug === shown && isPreview) cls += " previewing";
    var d = make("card", slug, rectOf("card", slug), cls,
                 '<span class=nm>' + esc(D.name) + ' card</span>'
                 + '<h4>' + esc(D.name) + '</h4>' + acts, WHEEL_Z + 12);
    if (!cd.locked) handles(d, "card");
  });

  // ---- 8. the instruction ---------------------------------------------------------------------
  if (S.status.visible){
    var T2 = S.status;
    var ds = make("status", null, rectOf("status", null), "",
                  '<span class=nm>instruction</span>', WHEEL_Z + 45);
    ds.id = "statusObj";
    ds.style.opacity = T2.opacity;
    ds.style.setProperty("--main-size", T2.size + "px");
    var mn = document.createElement("div");
    mn.className = "main"; mn.style.textAlign = T2.align;
    mn.textContent = statusText();
    ds.appendChild(mn);
    if (!T2.locked) handles(ds, "status");
  }

  st.appendChild(frag);
  drawGuides();
  // LAST, AND FROM HERE RATHER THAN FROM EACH CONTROL. Every path that changes geometry ends in
  // a render, so hanging these off this one place is what makes "always current" true by
  // construction instead of by remembering to call them: drag, resize, the inspector, an arrow
  // key, a helper, undo, redo, a reset and an import all arrive here.
  paintMetrics();
  syncHelperInputs();
  syncTokenInputs();
}

// ONE LINE, and the sow line counts down with what is in hand. {n} is substituted rather than
// typed so the instruction and the figure in the City's region cannot disagree.
// =============================================================================================
// THE DIMENSIONS READOUT. Repainted from render(), which is what makes it live: every drag,
// resize, inspector edit, slider, reset, import and undo ends in a render, so none of them can
// leave this stale.
//
// IT NEVER SHOWS ONE CARD AS IF IT SPOKE FOR EIGHT. A panel that reported 159 x 150 while three
// cards were 184 would be worse than no panel, because it would be believed.
// =============================================================================================
function dim(w, h){ return Math.round(w) + " × " + Math.round(h); }
function spreadText(s){
  return s.uniform ? String(Math.round(s.lo))
                   : Math.round(s.lo) + "–" + Math.round(s.hi);
}
function paintMetrics(){
  var host = el("metCtl"); if (!host) return;
  var cg = cardGroup(), L = artOf("left"), R = artOf("right");
  var gaps = rowGaps(), common = rowGapCommon(), v = cardsToRowGap();
  var mixedCards = !(cg.w.uniform && cg.h.uniform);
  var mixedArt = !(L.width === R.width && L.height === R.height);

  function row(label, value, cls){
    return '<i>' + label + '</i><b' + (cls ? ' class="' + cls + '"' : '') + '>' + value + '</b>';
  }
  var h = '<div class=met>'
        + row("duty cards", spreadText(cg.w) + " × " + spreadText(cg.h)
              + (mixedCards ? " mixed" : " each"), mixedCards ? "mix" : "")
        + row("action left", dim(L.width, L.height), mixedArt ? "mix" : "")
        + row("action right", dim(R.width, R.height), mixedArt ? "mix" : "")
        + row("take tithe", dim(S.tithe.width, S.tithe.height))
        + row("city", dim(S.city.width, S.city.height))
        + row("wheel", dim(S.wheel.width, S.wheel.height))
        // A NEGATIVE GAP IS NOT A VARIATION, IT IS AN OVERLAP, so it reads as bad news rather
        // than as merely uneven -- the same treatment the cards-to-row squeeze gets, for the
        // same reason. Reported and not corrected: an artwork wider than its slot is a
        // legitimate thing to try, and the row is only re-laid when a helper is used.
        + row("action gaps", common !== null ? common + " px"
              : gaps.join(" / ") + " px mixed",
              Math.min.apply(null, gaps) < 0 ? "bad" : common !== null ? "" : "mix")
        // THE ONE THAT IS ALLOWED TO BE BAD NEWS. Growing the cards into the action row is a
        // legitimate thing to try, so it is measured and coloured rather than prevented.
        + row("cards → row", v < 0 ? "overlap " + (-v) + " px" : v + " px", v < 0 ? "bad" : "")
        + '</div>';
  if (!cg.y.uniform) h += '<div class=hint>card tops vary by ' + (cg.y.hi - cg.y.lo)
                        + ' px · <b>align card tops</b> levels them</div>';
  host.innerHTML = h;
}

// =============================================================================================
// THE HELPER CONTROLS FOLLOW THE GEOMETRY, wherever the change came from.
//
// The metrics were already live because they are derived. The SLIDERS were not: drag the wheel's
// corner handle down to 1100 and the helper still read 1372, so the next touch of that control
// would haul the wheel back to a number nobody had asked for since. A stale control is worse
// than no control, because it is armed.
//
// IN PLACE, NEVER BY REBUILDING. Calling panels() to refresh a value would destroy and recreate
// the very input being dragged, which ends the gesture mid-sweep.
//
// AND NEVER THE ONE IN YOUR HANDS. An input being typed into is left alone: rewriting it after
// every keystroke makes "1500" impossible to type, because the 1 is clamped to the minimum
// before the 5 arrives. Direct use of a control settles it separately -- see pair().
// =============================================================================================
function syncHelperInputs(){
  if (!el("hpWheelN")) return;              // the panel has not been built yet
  function set(id, v){
    var e = el(id);
    if (!e || e === document.activeElement) return;
    if (String(e.value) !== String(v)) e.value = v;
  }
  var cg = cardGroup(), L = artOf("left");
  set("hpWheelN", S.wheel.width);  set("hpWheelR", S.wheel.width);
  set("hpCardN", cg.h.lo);         set("hpCardR", cg.h.lo);
  set("hpArtWN", L.width);         set("hpArtWR", L.width);
  set("hpArtHN", L.height);        set("hpArtHR", L.height);
  var gp = helperGap();
  set("hpGapN", gp);               set("hpGapR", gp);
}
// TWO DIFFERENT QUESTIONS, deliberately given two different answers:
//
//   THE METRICS        report the actual geometry -- what the row IS, overlaps and all.
//   THE HELPER CONTROL reports the nearest value this control could legally apply.
//
// So with gaps of -20 / -10 / 12 the readout says "-20 / -10 / 12 px mixed" and colours it as a
// warning, while the gap control shows 0: the slider's range is 0-80 and a number box reading
// -10 beside a slider that cannot reach -10 is a trap, since touching either one would then jump
// the row somewhere nobody asked for.
//
// DISPLAYING 0 CHANGES NOTHING. This is a reading, not an edit: the row keeps its overlap until
// the control is actually operated. That is also why it is not rowGapSuggested() itself that is
// clamped -- FIT ACTION ROW and the row-gap operation each decide separately what to do with a
// negative suggestion, and only the fit normalises it.
function helperGap(){ return clamp(rowGapSuggested(), HELPERS.gap[0], HELPERS.gap[1]); }

// THE TOKEN READINGS. Derived from the state every time, never stored alongside it.
function tokenSize(){ return clamp(Math.round(S.tithe.tokenSize), HELPERS.tokenSize[0],
                                   HELPERS.tokenSize[1]); }
function tokenSpread(){ return clamp(Math.round(S.tithe.tokenSpread), HELPERS.tokenSpread[0],
                                     HELPERS.tokenSpread[1]); }

// THE TRIANGLE THE THREE CENTRES SIT ON: equilateral, apex up, side = spread. Offsets are from
// the arrangement's own centre, so nothing here depends on how big a token is -- which is the
// entire point. Change the size and the centres do not move; change the spread and the sizes do
// not change.
function tokenPoints(){
  var s = tokenSpread(), h = s * Math.sqrt(3) / 2;
  return [{x: 0, y: -h / 2}, {x: -s / 2, y: h / 2}, {x: s / 2, y: h / 2}];
}
// THE CONTAINER IS THE TRIANGLE ITSELF, and the tokens overhang it by half their own size on
// every side. The obvious alternative -- size it to the whole arrangement -- would put the token
// size back into the container's dimensions, and a container that outgrows the Tithe card stops
// being centred by the flex column and slides against one edge: the tokens would drift sideways
// as you scaled them, which is the one thing this layout exists to prevent. The two boxes share
// a centre, so while the arrangement fits there is nothing to choose between them on screen.
function tokenTriangle(){
  var s = tokenSpread();
  return {width: s, height: s * Math.sqrt(3) / 2};
}
// The box the arrangement actually needs: the triangle plus half a token beyond each vertex.
// Reported, not laid out -- see tokenOverflow().
function tokenBounds(){
  var s = tokenSpread(), box = tokenSize();
  return {width: s + box, height: s * Math.sqrt(3) / 2 + box};
}

// HOW FAR THE PYRAMID OVERRUNS THE CARD, in pixels, or 0 when it fits. Informational only --
// nothing here shrinks a token or grows the box. The whole point of a fixed Tithe region is that
// the trade-off stays visible; resizing the card to hide it would answer the question the
// designer is asking.
function tokenOverflow(){
  var b = tokenBounds();
  var overV = b.height - (S.tithe.height - TITHE_CHROME);
  var overH = b.width - (S.tithe.width - TITHE_SIDES);
  var worst = Math.max(overV, overH);
  return worst > 0 ? Math.ceil(worst) : 0;
}

// NONE OF THESE REBUILD THE PANEL, and that is the whole point of them being separate from the
// loaders. `panels()` replaces titheCtl.innerHTML, which throws away the very slider the mouse
// is holding: the element leaves the document, the browser loses the drag target, and the
// gesture ends after ONE step. It looked like a broken slider; it was a destroyed one.
//
// So they end in commit(), which renders, and render() syncs the controls in place -- the same
// arrangement the layout helpers use, for the same reason.
function setTokenSize(v, soon){
  S.tithe.tokenSize = clamp(Math.round(v), HELPERS.tokenSize[0], HELPERS.tokenSize[1]);
  commit(soon);
}
function setTokenSpread(v, soon){
  S.tithe.tokenSpread = clamp(Math.round(v), HELPERS.tokenSpread[0], HELPERS.tokenSpread[1]);
  commit(soon);
}
function clearTokenIcon(i){
  var r = S.tithe.resources[i];
  if (!r) return;
  if (!r.icon && !r.iconName){ say("no icon on that resource to clear"); return; }
  var was = r.iconName || "the icon";
  r.icon = null;
  r.iconName = null;
  commitPanels();
  say("cleared " + was + " from " + (r.name || r.key) + " · the letter returns");
}

// A number box and its slider, kept in step, reading the geometry back the way the layout
// helpers' own pairs do.
function pairNum(numId, rangeId, apply, read){
  var n = el(numId), r = el(rangeId);
  if (!n || !r) return;
  function go(v){
    apply(v, true);
    var actual = read();
    r.value = actual;
    if (document.activeElement !== n) n.value = actual;
  }
  n.oninput = function(){ go(n.value); };
  n.onchange = function(){ go(n.value); n.value = read(); };
  r.oninput = function(){ go(r.value); };
}

// ONE RESOURCE, either as its artwork or as the letter that stands in for it. The letter is not
// a degraded mode: the tool has to stay usable with no assets loaded at all, which is why a
// missing token is a disc with `W` in it rather than a broken image.
//
// ALL THREE ARE THE SAME SIZE, and there is no per-resource correction any more. There was one,
// and it was the wrong place for it: silver read about a ninth smaller than the others because
// its PNG had more transparent margin, and a slider in the studio would have papered over a
// fault in the artwork that the production pipeline would then have had to reproduce. The three
// masters were re-exported to the same disc fraction instead, and the control went away with
// the problem.
function tokenHTML(r, pt, tb){
  var box = tokenSize();
  var slot = '<span class=slot style="left:' + (tb.width / 2 + pt.x) + 'px;top:'
           + (tb.height / 2 + pt.y) + 'px;width:' + box + 'px;height:' + box + 'px">';
  if (haveImage(r.icon)){
    return slot + '<img class=tok src="' + imgSrc(r.icon) + '" alt="' + esc(r.name || r.key)
         + '" title="' + esc(r.name || r.key) + '" style="width:' + box + 'px;height:' + box
         + 'px"></span>';
  }
  // The stand-in letter tracks the disc it is in: at the top of the size range a fixed 13px
  // would be a speck in a 160px circle, which reads as a bug rather than as a placeholder.
  return slot + '<span class=res title="' + esc(r.name || r.key) + '" style="width:' + box
       + 'px;height:' + box + 'px;font-size:' + Math.max(10, Math.round(box * 0.34))
       + 'px">' + esc(r.key) + '</span></span>';
}


// The one phrasing of what the two controls add up to, so the panel and the live re-sync cannot
// drift apart: what the arrangement needs is a derived box, not a stored one.
function tokenReadout(){
  var b = tokenBounds();
  return 'triangle side <b>' + tokenSpread() + ' px</b> · token <b>' + tokenSize()
       + ' px</b> · needs ' + Math.ceil(b.width) + ' × ' + Math.ceil(b.height) + ' px';
}

// The tithe controls, refreshed from render() without rebuilding them -- see setTokenSize.
function syncTokenInputs(){
  if (!el("tkSizeN")) return;                  // the panel has not been built yet
  function set(e, v){
    if (!e || e === document.activeElement) return;
    if (String(e.value) !== String(v)) e.value = v;
  }
  set(el("tkSizeN"), tokenSize());     set(el("tkSizeR"), tokenSize());
  set(el("tkSpreadN"), tokenSpread()); set(el("tkSpreadR"), tokenSpread());
  // The reading under the two sliders is text, not a control, so it is simply rewritten.
  var read = document.querySelector('#titheCtl [data-tread]');
  if (read) read.innerHTML = tokenReadout();
  var warn = document.querySelector('#titheCtl [data-tover]');
  if (warn){
    var over = tokenOverflow();
    warn.innerHTML = over ? 'resource tokens exceed the Tithe content area by ' + over
                          + ' px · nothing is resized for you' : '';
    warn.style.display = over ? "" : "none";
  }
}

function statusText(){
  var b = (S.status.byView || {})[S.view] || {};
  return String(b.main || "").replace("{n}", S.inHand.count);
}

// THE BUILT-IN WHEEL, inlined by the generator from the vendored copy of
// tools/ui_debug/prototypes/duty_wheel_v2.svg. Not a stand-in any more: this is the drawing the
// board is being composed around, which is why nothing here redraws, recolours or re-projects
// it. Its own geometry names the nine faces by WHERE THEY ARE -- north_west, north, centre --
// and it carries no text at all, so nothing in it says which duty stands on which space. That
// is the same absence the rest of V4 keeps; see the note on statesOf().
//
// Written into the page as markup rather than as a data: URL so it inherits the page's own
// colours if it is ever given any, and so the acceptance run can look inside it.
var WHEEL_SVG = __WHEEL_SVG__;

function builtinWheel(){ return WHEEL_SVG; }

function drawGuides(){
  var g = el("guides"), G = S.guides, h = "";
  if (G.grid) h += '<div class=grid></div>';
  if (G.safe) h += '<div class=safe style="left:' + SAFE_MARGIN + 'px;top:' + SAFE_MARGIN
                +  'px;right:' + SAFE_MARGIN + 'px;bottom:' + SAFE_MARGIN + 'px"></div>';
  if (G.centreH) h += '<div class=l style="left:0;right:0;top:' + (CANVAS_H/2) + 'px;height:1px"></div>';
  if (G.centreV) h += '<div class=l style="top:0;bottom:0;left:' + (CANVAS_W/2) + 'px;width:1px"></div>';
  if (G.wheelCentre){
    var w = S.wheel;
    h += '<div class=wc style="left:' + (w.x + w.width/2) + 'px;top:' + (w.y + w.height/2) + 'px"></div>';
  }
  g.style.outline = G.bounds ? "1px solid #c9b27a55" : "none";
  g.innerHTML = h;
}

// =============================================================================================
// HISTORY. Snapshots are cheap because the images are not in the state, which is what makes
// "clone the whole thing" the right answer instead of a diff or a command log.
//
// ONE ENTRY PER GESTURE: a drag writes the model on every pointermove, and pushing each would
// fill the stack with one motion. Sliders record on a short debounce for the same reason.
//
// SELECTION IS NOT HISTORY, and neither is the view state, the preview, the mode or the zoom.
// =============================================================================================
var HIST = [], HPOS = -1, gesture = false, histTimer = null;

function histReset(){ HIST = [JSON.stringify(S)]; HPOS = 0; paintHistory(); }
function record(){
  if (gesture) return;
  clearTimeout(histTimer); histTimer = null;
  var snap = JSON.stringify(S);
  if (HPOS >= 0 && HIST[HPOS] === snap) return;
  HIST = HIST.slice(0, HPOS + 1);
  HIST.push(snap);
  if (HIST.length > HIST_MAX) HIST.shift();
  HPOS = HIST.length - 1;
  paintHistory();
}
function recordSoon(){
  if (gesture) return;
  clearTimeout(histTimer);
  histTimer = setTimeout(function(){ histTimer = null; record(); }, 400);
}
function stepHistory(d){
  clearTimeout(histTimer); histTimer = null;
  var n = HPOS + d;
  if (n < 0 || n >= HIST.length) return false;
  HPOS = n;
  // THE VIEW IS NOT UNDONE. Mode, zoom, which state is on screen and which card is being
  // previewed are all how the layout is being LOOKED at rather than part of it -- they are among
  // the fields the Game Layout export leaves out for the same reason. So they are carried over
  // rather than restored; otherwise undoing a move would also throw the page into another state.
  var view = {mode: S.mode, zoom: S.zoom, view: S.view, previewDuty: S.previewDuty};
  S = JSON.parse(HIST[HPOS]);
  S.mode = view.mode; S.zoom = view.zoom; S.view = view.view; S.previewDuty = view.previewDuty;
  rebuild();
  paintHistory();
  return true;
}
function paintHistory(){
  var u = el("bUndo"), r = el("bRedo");
  if (u) u.disabled = HPOS <= 0;
  if (r) r.disabled = HPOS < 0 || HPOS >= HIST.length - 1;
}
function rebuild(){
  setBackground(S.background, true);
  setMode(S.mode === "clean" ? "clean" : "edit");
  render(); inspector(); panels(); relayout(); save(true);
}

// =============================================================================================
// DRAG AND RESIZE.
//
// NO CUMULATIVE DELTAS: the object's origin and the pointer's design position are recorded once
// at pointerdown and every move sets the object from those plus the CURRENT pointer, so rounding
// error in the conversion cannot accumulate over a long drag.
//
// Pointer capture keeps the gesture alive when the cursor leaves the element, which it always
// does on a fast drag, and means there is no document-level listener to leak.
// =============================================================================================
var drag = null;

el("stage").addEventListener("pointerdown", function(ev){
  var handle = ev.target.closest ? ev.target.closest(".h") : null;
  var node = ev.target.closest ? ev.target.closest(".obj") : null;

  // CLEAN PREVIEW IS THE GAME, so the pointer means what it will mean in the game: a duty card
  // opens or closes its preview, the background closes it, and nothing can be dragged. Edit Mode
  // is the studio and the pointer means selection and geometry, with the preview driven from the
  // panel instead -- two jobs that would fight over the same click if they shared a mode.
  if (document.body.classList.contains("clean")){
    // THREE OUTCOMES, AND THE THIRD IS DOING NOTHING.
    //
    // A card opens, switches or closes a preview. EMPTY STAGE closes it. Anything else -- the
    // preview artwork, the wheel, the City, an acolyte, Tithe -- is left alone, because a
    // preview is something you are reading and clicking the thing you are reading is not a
    // request to put it away. The earlier version closed on "anything that is not a card",
    // which made the artwork dismiss itself the moment you touched it.
    if (node && node.dataset.kind === "card" && S.view !== "action"){
      togglePreview(node.dataset.id);
    } else if (!node){
      if (S.previewDuty){ S.previewDuty = null; render(); panels(); save(true); }
    }
    return;
  }

  if (!node){ select(null); return; }
  var kind = node.dataset.kind, id = node.dataset.id || null;
  select(kind, id);
  if (lockedOf(kind, id)) return;

  var p = toDesign(ev), r = rectOf(kind, id);
  drag = {kind: kind, id: id, handle: handle ? handle.dataset.handle : null,
          px: p.x, py: p.y, ox: r.x, oy: r.y, ow: r.width, oh: r.height,
          ratio: r.height / r.width};
  node.setPointerCapture(ev.pointerId);
  drag.node = node; drag.pid = ev.pointerId;
  gesture = true;
  ev.preventDefault();
  ev.stopPropagation();
});

el("stage").addEventListener("pointermove", function(ev){
  if (!drag) return;
  var p = toDesign(ev), dx = p.x - drag.px, dy = p.y - drag.py;
  if (!drag.handle){
    moveTo(drag.kind, drag.id, drag.ox + dx, drag.oy + dy);
  } else {
    var o = objOf(drag.kind, drag.id);
    var x = drag.ox, y = drag.oy, w = drag.ow, h = drag.oh, k = drag.handle;
    if (k.indexOf("e") >= 0) w = drag.ow + dx;
    if (k.indexOf("s") >= 0) h = drag.oh + dy;
    if (k.indexOf("w") >= 0){ w = drag.ow - dx; x = drag.ox + dx; }
    if (k.indexOf("n") >= 0){ h = drag.oh - dy; y = drag.oy + dy; }
    if (aspectLockedOf(drag.kind)){
      // Uniform only. The corner being dragged decides which dimension leads; the other follows
      // from the asset's own ratio, so the wheel can never be squashed.
      var lead = Math.abs(dx) > Math.abs(dy) ? "w" : "h";
      if (lead === "w") h = w * drag.ratio; else w = h / drag.ratio;
      if (k.indexOf("w") >= 0) x = drag.ox + (drag.ow - w);
      if (k.indexOf("n") >= 0) y = drag.oy + (drag.oh - h);
    }
    if (w < MIN_SIZE){ if (k.indexOf("w") >= 0) x = drag.ox + drag.ow - MIN_SIZE; w = MIN_SIZE; }
    if (h < MIN_SIZE){ if (k.indexOf("n") >= 0) y = drag.oy + drag.oh - MIN_SIZE; h = MIN_SIZE; }
    o.x = Math.round(x); o.y = Math.round(y);
    o.width = Math.round(w); o.height = Math.round(h);
    if (attachable(drag.kind)) writeUV(o);
  }
  // THE WHEEL CARRIES ITS PASSENGERS: moving or scaling it re-derives every attached anchor, and
  // the full rebuild is what puts them on screen -- which is why the wheel is the one kind that
  // does not take the cheap in-place path.
  if (drag.kind === "wheel"){
    syncAttached();
    render();
    drag.node = el("wheelObj");
    try { drag.node.setPointerCapture(drag.pid); } catch (e){}
  } else {
    applyGeom(drag.node, drag.kind, drag.id);
  }
  drawGuides(); inspector();
});

function applyGeom(node, kind, id){
  var r = rectOf(kind, id);
  node.style.left = r.x + "px";
  node.style.top = r.y + "px";
  node.style.width = r.width + "px";
  node.style.height = r.height + "px";
  var ov = (S.guides.warnings && !node.classList.contains("ghost")) ? overflowOf(r) : null;
  node.classList.toggle("oob", !!ov);
  var tag = node.querySelector(".oobtag");
  if (ov && !tag){ tag = document.createElement("span"); tag.className = "oobtag";
                   node.appendChild(tag); }
  if (tag){
    if (!ov) tag.remove();
    else { tag.textContent = "OUTSIDE MODULE  " + overflowText(ov);
           tag.classList.toggle("low", r.y < 18); }
  }
}

function endDrag(ev){
  if (!drag) return;
  try { drag.node.releasePointerCapture(drag.pid); } catch (e){}
  drag = null;
  gesture = false;
  render();
  record();
  save(true);
}
el("stage").addEventListener("pointerup", endDrag);
el("stage").addEventListener("pointercancel", endDrag);

// THE PREVIEW, which is the one interaction V4 adds.
//
// Same card again closes it, another card switches straight to it, the background closes it, and
// changing state closes it -- because the artwork then means something different and a stale
// preview would be indistinguishable from a choice.
function togglePreview(slug){
  if (S.view === "action") return;
  S.previewDuty = (S.previewDuty === slug) ? null : slug;
  render(); panels(); save(true);
}

// =============================================================================================
// SELECTION, KEYBOARD
// =============================================================================================
function select(kind, id){
  sel = kind ? {kind: kind, id: id || null} : null;
  paintSelection(); inspector();
}
// SELECTION IS A CLASS, NOT A REBUILD. Rebuilding on pointerdown detached the very node the
// gesture had just captured, so a drag stopped after its first frame.
function paintSelection(){
  [].forEach.call(el("stage").querySelectorAll(".obj"), function(n){
    var mine = sel && n.dataset.kind === sel.kind && (n.dataset.id || null) === sel.id;
    n.classList.toggle("sel", !!mine);
  });
}

addEventListener("keydown", function(ev){
  var t = ev.target, typing = t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA"
                                    || t.tagName === "SELECT" || t.isContentEditable);
  // Undo carries a modifier, cannot be typed by accident, and is the one shortcut a person
  // expects to work everywhere -- so it is not behind the caret guard.
  if ((ev.ctrlKey || ev.metaKey) && (ev.key === "z" || ev.key === "Z")){
    ev.preventDefault();
    var ok = ev.shiftKey ? stepHistory(1) : stepHistory(-1);
    say(ok ? (ev.shiftKey ? "redo" : "undo")
           : (ev.shiftKey ? "nothing to redo" : "nothing to undo"));
    return;
  }
  if ((ev.ctrlKey || ev.metaKey) && (ev.key === "y" || ev.key === "Y")){
    ev.preventDefault(); say(stepHistory(1) ? "redo" : "nothing to redo"); return;
  }
  if (typing) return;
  if (ev.ctrlKey || ev.metaKey || ev.altKey) return;
  // 1, 2 and 3 flip between the three compositions, which is the comparison this version is for.
  for (var i = 0; i < VIEW_STATES.length; i++){
    if (ev.key === String(i + 1)){ ev.preventDefault(); setView(VIEW_STATES[i].key); return; }
  }
  if (ev.key === "f" || ev.key === "F"){ ev.preventDefault(); toggleFull(); return; }
  if (ev.key === "Escape" && S.previewDuty){ S.previewDuty = null; render(); panels(); return; }
  if (!sel || ev.key.indexOf("Arrow") !== 0) return;
  if (lockedOf(sel.kind, sel.id)) return;
  var step = ev.shiftKey ? 10 : 1;
  var r = rectOf(sel.kind, sel.id);
  var dx = (ev.key === "ArrowLeft" ? -step : ev.key === "ArrowRight" ? step : 0);
  var dy = (ev.key === "ArrowUp"   ? -step : ev.key === "ArrowDown"  ? step : 0);
  moveTo(sel.kind, sel.id, r.x + dx, r.y + dy);
  ev.preventDefault();
  if (sel.kind === "wheel"){ syncAttached(); render(); }
  else {
    var n = el("stage").querySelector('.obj[data-kind="' + sel.kind + '"]'
              + (sel.id ? '[data-id="' + sel.id + '"]' : ":not([data-id])"));
    if (n) applyGeom(n, sel.kind, sel.id); else render();
  }
  drawGuides(); inspector(); recordSoon(); save(true);
});

// =============================================================================================
// SMALL CONTROL BUILDERS
// =============================================================================================
function field(value, oninput, attrs){
  var id = "f_" + Math.random().toString(36).slice(2, 8);
  var a = attrs || {};
  setTimeout(function(){
    var e = el(id); if (!e) return;
    e.oninput = function(){ oninput(e.value); };
  }, 0);
  return '<input id=' + id + ' type=' + (a.type || "number")
       + (a.min !== undefined ? ' min=' + a.min : '')
       + (a.max !== undefined ? ' max=' + a.max : '')
       + (a.step !== undefined ? ' step=' + a.step : '')
       + ' value="' + esc(value) + '">';
}
function btn(text, fn, pressed){
  var id = "b_" + Math.random().toString(36).slice(2, 8);
  setTimeout(function(){ var e = el(id); if (e) e.onclick = fn; }, 0);
  return '<button id=' + id + (pressed !== undefined ? ' aria-pressed=' + pressed : '') + '>'
       + text + '</button>';
}
function commit(soon){
  render(); inspector();
  if (soon) recordSoon(); else record();
  save(true);
}
function commitPanels(soon){ commit(soon); panels(); }

// =============================================================================================
// INSPECTOR
// =============================================================================================
function inspector(){
  var host = el("insp");
  if (!sel){ host.innerHTML = '<div class=hint>Click an object on the stage.</div>'; return; }
  var kind = sel.kind, id = sel.id, o = objOf(kind, id);
  if (!o){ sel = null; host.innerHTML = '<div class=hint>Click an object on the stage.</div>'; return; }
  var r = rectOf(kind, id), h = "";
  var title = kind === "card" ? S.duties[id].name + " · card"
            : kind === "figs" ? S.duties[id].name + " · figures"
            : kind === "art" ? "artwork " + id
            : kind === "status" ? "instruction" : kind;
  h += '<div class=hint style="color:#c9b27a">' + esc(title) + '</div>';
  if (!activeHere(kind))
    h += '<div class=hint style="color:#5c7f93">not on screen in this state · shown as a ghost</div>';

  if (kind === "figs"){
    h += '<div class="row two"><span>anchor</span>'
       + field(Math.round(r.x + 8), function(v){ moveTo(kind, id, clamp(v, -400, CANVAS_W + 400) - 8, r.y); commit(true); })
       + field(Math.round(r.y + 8), function(v){ moveTo(kind, id, r.x, clamp(v, -400, CANVAS_H + 400) - 8); commit(true); })
       + '</div>';
    if (attachedOf(kind, id))
      h += '<div class=row><span>u / v</span><span style="text-align:left;color:var(--hot)">'
         + o.u.toFixed(4) + ' , ' + o.v.toFixed(4) + '</span></div>';
    h += '<div class=row><span>count</span>'
       + field(o.count, function(v){ o.count = clamp(Math.round(v), 0, 4); commitPanels(); },
               {min: 0, max: 4}) + '</div>';
    h += '<div class=row><span>spacing</span>'
       + field(o.spacing, function(v){ o.spacing = clamp(v, 4, 400); commit(true); }) + '</div>';
    h += '<div class=btns>' + ["row","compact","arc"].map(function(a){
           return btn(a, function(){ o.arrangement = a; commit(); }, o.arrangement === a);
         }).join("") + '</div>';
    h += '<div class=hint>seats · which player each figure belongs to</div>';
    h += '<div class="row four"><span>1-4</span>' + [0,1,2,3].map(function(i){
           var pid = o.seats[i] || PLAYER_IDS[0];
           return '<select data-seat="' + i + '">' + PLAYER_IDS.map(function(p){
             return '<option value="' + p + '"' + (p === pid ? " selected" : "") + '>'
                  + p + '</option>'; }).join("") + '</select>';
         }).join("") + '</div>';
    h += '<div class=btns>' + PLAYER_IDS.map(function(p){
           return btn("all " + p, function(){ o.seats = [p,p,p,p]; commitPanels(); });
         }).join("") + '</div>';
    h += '<div class=btns>' + btn(o.attached ? "on the wheel" : "free",
           function(){ o.attached = !o.attached; if (o.attached) writeUV(o); commit(); },
           !!o.attached) + '</div>';
  } else {
    h += '<div class="row two"><span>x / y</span>'
       + field(r.x, function(v){ moveTo(kind, id, clamp(v, -800, CANVAS_W + 800), r.y); commit(true); })
       + field(r.y, function(v){ moveTo(kind, id, r.x, clamp(v, -800, CANVAS_H + 800)); commit(true); })
       + '</div>';
    if (resizableOf(kind)){
      h += '<div class="row two"><span>w / h</span>'
         + field(o.width, function(v){
             o.width = clamp(Math.round(v), MIN_SIZE, 4000);
             if (aspectLockedOf(kind)){ o.height = Math.round(o.width * S.wheel.naturalRatio);
                                        syncAttached(); }
             commit(true); })
         + field(o.height, function(v){
             o.height = clamp(Math.round(v), MIN_SIZE, 4000);
             if (aspectLockedOf(kind)){ o.width = Math.round(o.height / S.wheel.naturalRatio);
                                        syncAttached(); }
             commit(true); })
         + '</div>';
    }
    if (o.opacity !== undefined){
      h += '<div class=row><span>opacity</span>'
         + field(o.opacity, function(v){ o.opacity = clamp(v, 0, 1); commit(true); },
                 {min: 0, max: 1, step: 0.05}) + '</div>';
    }
  }

  var ov = overflowOf(r);
  if (ov) h += '<div class=hint style="color:var(--warn)">outside the module · '
             + overflowText(ov) + '</div>';

  if (kind === "art"){
    h += '<div class=row><span>shows</span><select id=selSlot>'
       + ACTIONS.map(function(a){ return '<option value="' + a.key + '"'
           + (o.slot === a.key ? " selected" : "") + '>' + a.label + '</option>'; }).join("")
       + '</select></div>';
    h += '<div class=row><span>fit</span><select id=selFit>'
       + '<option value=cover' + (o.fit === "cover" ? " selected" : "") + '>cover</option>'
       + '<option value=contain' + (o.fit === "contain" ? " selected" : "") + '>contain</option>'
       + '</select></div>';
    h += '<div class="row two"><span>caption</span>'
       + btn(o.labelVisible ? "on" : "off",
             function(){ o.labelVisible = !o.labelVisible; commit(); }, !!o.labelVisible)
       + field(o.labelSize, function(v){ o.labelSize = clamp(Math.round(v), 8, 60); commit(true); })
       + '</div>';
    h += '<div class=hint>the picture comes from whichever duty is on screen ('
       + esc(shownDuty() ? S.duties[shownDuty()].name : "none") + ') — load it in '
       + '<b>duty actions</b></div>';
  }
  if (kind === "card"){
    h += '<div class=hint>the name, the seals and the action text come from this duty — edit '
       + 'them in <b>duty actions</b>. The card is reference: clicking it in Clean Preview '
       + 'previews the two artworks and selects nothing.</div>';
  }
  if (kind === "status"){
    h += '<div class=hint>one line per state, in <b>status</b></div>';
  }
  if (kind === "tithe"){
    h += '<div class=row><span>label</span>'
       + '<input type=text id=tiLabel value="' + esc(o.label) + '"></div>'
       + '<div class=hint>the three resources are edited in <b>tithe</b></div>';
  }
  if (kind === "city"){
    h += '<div class=row><span>label</span>'
       + '<input type=text id=ciLabel value="' + esc(o.label) + '"></div>'
       + '<div class=hint>this region becomes <b>acolytes in hand</b> while sowing · counts and '
       + 'seats are in <b>city &amp; in hand</b></div>';
  }
  if (kind === "wheel"){
    h += '<div class=hint>uniform scale only · layout ratio ' + WHEEL_RATIO.toFixed(4)
       + ' · ' + ELEVATION + '° of elevation, from the built-in wheel\'s viewBox '
       + WHEEL_VIEWBOX + '</div>';
    h += '<div class=hint>a loaded asset is <b>art placed in this box</b> · it never changes the '
       + 'wheel\'s size, its ratio or where the acolytes stand</div>';
    if (o.image && typeof o.assetRatio === "number"){
      h += ratioMatches(o.assetRatio)
        ? '<div class=hint>asset ratio ' + o.assetRatio.toFixed(4) + ' · <b style="color:#8fae6a">'
          + 'matches the ' + ELEVATION + '° wheel</b></div>'
        : '<div class=hint><b style="color:var(--warn)">asset ratio ' + o.assetRatio.toFixed(4)
          + ' differs from the ' + ELEVATION + '° wheel ratio ' + WHEEL_RATIO.toFixed(4)
          + '</b> · drawn contained inside the box rather than stretched to fill it</div>';
    }
    h += '<div class=hint>identical in all three states · nothing writes wheel geometry per '
       + 'state, which is what makes the three comparable</div>';
    if (!o.image){
      h += '<div class=btns>'
         + btn(o.ground ? "asset ground on" : "asset ground off",
               function(){ o.ground = !o.ground; commit(); }, !!o.ground)
         + '</div>'
         + '<div class=hint>the built-in wheel carries a dark rectangle filling its own box. '
         + 'Off by default: that rectangle is the board\'s colour inside the wheel\'s bounding '
         + 'box only, and the board\'s colour belongs to <b>preview background</b></div>';
    }
    h += '<div class=btns><input id=fWheel type=file accept="image/svg+xml,image/png,image/webp">'
       + (o.image ? btn("clear svg", function(){
            // Back to the built-in drawing. The box is untouched, because loading the asset did
            // not move it either.
            o.image = null; o.imageName = null;
            o.assetRatio = null; o.assetRatioSource = null;
            commit(); }) : "")
       + '</div>';
    if (o.imageName) h += '<div class=hint>' + esc(o.imageName)
       + (haveImage(o.image) ? "" : ' <b style="color:var(--warn)">not loaded</b>') + '</div>';
  }
  h += '<div class=btns>'
     + btn(o.locked ? "locked" : "unlocked", function(){ o.locked = !o.locked; commit(); }, !!o.locked)
     + (o.visible !== undefined
        ? btn(o.visible ? "visible" : "hidden", function(){ o.visible = !o.visible; commit(); }, !!o.visible)
        : "")
     + btn("reset", function(){ resetOne(kind, id); })
     + '</div>';
  host.innerHTML = h;
  wireInspector(kind, id, o);
}

function wireInspector(kind, id, o){
  var host = el("insp");
  [].forEach.call(host.querySelectorAll("[data-seat]"), function(s){
    s.onchange = function(){ o.seats[+s.dataset.seat] = s.value; commitPanels(); };
  });
  var ss = el("selSlot");
  if (ss) ss.onchange = function(){ o.slot = ss.value; commitPanels(); };
  var sf = el("selFit");
  if (sf) sf.onchange = function(){ o.fit = sf.value; commit(); };
  var tl = el("tiLabel");
  if (tl) tl.oninput = function(){ o.label = tl.value; render(); recordSoon(); save(true); };
  var cl = el("ciLabel");
  if (cl) cl.oninput = function(){ o.label = cl.value; render(); recordSoon(); save(true); };
  var fw = el("fWheel");
  if (fw) fw.onchange = function(){ readImage(fw, function(key, name, ratio, src){
    // THE LAYOUT IS THE AUTHORITY AND THE FILE IS ART PLACED INTO IT.
    //
    // This used to work the other way round: the incoming file's ratio became the wheel's, and
    // the height was recomputed from it. That made LOADING A PICTURE a layout edit -- the wheel
    // grew or shrank, its lower edge could leave the module, every attached acolyte moved with
    // it, and the 32 degree projection the whole composition is built on quietly became
    // whatever the file happened to be. Nothing in the page said so.
    //
    // So the box does not move. The file's own ratio is still read, because it is worth
    // knowing, but it is recorded as information and reported rather than adopted.
    var vb = (name && /\.svg$/i.test(name)) ? svgViewBoxRatio(src) : 0;
    o.image = key; o.imageName = name;
    o.assetRatio = vb > 0 ? vb : (ratio > 0 ? ratio : null);
    o.assetRatioSource = vb > 0 ? "viewBox" : (ratio > 0 ? "natural" : null);
    commit();
    if (o.assetRatio === null){
      say("loaded " + name + " · its shape could not be read", true);
    } else if (ratioMatches(o.assetRatio)){
      say("loaded " + name + " · ratio " + o.assetRatio.toFixed(4) + " · matches the "
          + ELEVATION + "° wheel");
    } else {
      say("loaded " + name + " · ratio " + o.assetRatio.toFixed(4) + " differs from the "
          + ELEVATION + "° wheel ratio " + WHEEL_RATIO.toFixed(4)
          + " · shown contained, the layout is unchanged", true);
    }
  }); };
}

// THE VIEWBOX IS THE AUTHORITATIVE ASPECT RATIO of an SVG, read from the file's own text rather
// than inferred from how a browser chose to lay the element out. Split in three because only the
// middle step needs a browser: decoding and judging are ordinary string work and are where the
// interesting refusals live. Every one returns 0 rather than a guess, and 0 is what makes the
// caller fall back instead of adopting a nonsense shape.
// HOW CLOSE COUNTS AS MATCHING. 0.005 of ratio is about 7px of height on a 1372px wheel --
// under that an asset is drawn at the same elevation and the difference is rounding; over it,
// the file was drawn for a different projection and the person should be told.
var RATIO_TOLERANCE = 0.005;
function ratioMatches(r){ return typeof r === "number" && Math.abs(r - WHEEL_RATIO) <= RATIO_TOLERANCE; }

function svgTextOf(dataUrl){
  try {
    var m = /^data:image\/svg\+xml[^,]*,([\s\S]*)$/.exec(dataUrl || "");
    if (!m) return "";
    return /;base64/.test(dataUrl) ? atob(m[1]) : decodeURIComponent(m[1]);
  } catch (e){ return ""; }
}
function ratioFromViewBox(vb){
  if (!vb || typeof vb !== "string") return 0;
  var n = vb.trim().split(/[\s,]+/).map(Number);
  if (n.length !== 4) return 0;
  if (!isFinite(n[2]) || !isFinite(n[3]) || n[2] <= 0 || n[3] <= 0) return 0;
  return n[3] / n[2];
}
function svgViewBoxRatio(dataUrl){
  try {
    var text = svgTextOf(dataUrl);
    if (!text) return 0;
    var doc = new DOMParser().parseFromString(text, "image/svg+xml");
    var svg = doc.documentElement;
    if (!svg || doc.getElementsByTagName("parsererror").length) return 0;
    return ratioFromViewBox(svg.getAttribute("viewBox"));
  } catch (e){ return 0; }
}

function readImage(input, done){
  var f = input.files && input.files[0];
  if (!f) return;
  readImageFile(f, done);
  input.value = "";
}
// THE SAME READ, from a File rather than from a live input. DUTY ART PAIR holds its chosen files
// in `pairPick` across panel repaints, by which time the input that produced them has been
// rebuilt and is empty.
function readImageFile(f, done){
  if (!f) return;
  var rd = new FileReader();
  rd.onload = function(){
    // A data URL into the POOL, not into the state. The state gets the key back.
    var url = rd.result;
    var key = putImage(url);
    var probe = new Image();
    probe.onload = function(){
      noteDims(key, probe.naturalWidth, probe.naturalHeight);
      done(key, f.name, probe.naturalWidth ? probe.naturalHeight / probe.naturalWidth : 0, url);
    };
    probe.onerror = function(){ done(key, f.name, 0, url); };
    probe.src = url;
  };
  rd.readAsDataURL(f);
}

function resetOne(kind, id){
  var d = DEFAULT_STATE;
  if (kind === "wheel"){
    // RESETTING THE GEOMETRY IS NOT REMOVING THE ARTWORK. The box, the size and the layout ratio
    // all go back to the defaults; a loaded asset stays loaded, because it is art in that box
    // and has no say in its shape. The ratio is NOT preserved from the asset -- it is the
    // design invariant, and an earlier build kept an asset-derived one here, which is how a
    // reset could leave the wheel at somebody else's projection.
    var keepImg = S.wheel.image, keepName = S.wheel.imageName;
    var keepAR = S.wheel.assetRatio, keepARS = S.wheel.assetRatioSource;
    S.wheel = clone(d.wheel);
    S.wheel.image = keepImg; S.wheel.imageName = keepName;
    S.wheel.assetRatio = keepAR === undefined ? null : keepAR;
    S.wheel.assetRatioSource = keepARS === undefined ? null : keepARS;
    syncAttached();
  }
  else if (kind === "card") S.duties[id].card = clone(d.duties[id].card);
  else if (kind === "figs") S.duties[id].figures = clone(d.duties[id].figures);
  else if (kind === "art"){ var key = id === "left" ? "artLeft" : "artRight";
                            S.display[key] = clone(d.display[key]); }
  // Presentation back to the defaults, words kept: retyping is not what anyone means by putting
  // a box back where it started.
  else if (kind === "status"){ var keepByView = clone(S.status.byView);
                               S.status = clone(d.status);
                               S.status.byView = keepByView; }
  else if (kind === "tithe"){ var tl = S.tithe.label, tr = clone(S.tithe.resources),
                                  ti = S.tithe.image, tn = S.tithe.imageName;
                              S.tithe = clone(d.tithe);
                              S.tithe.label = tl; S.tithe.resources = tr;
                              S.tithe.image = ti; S.tithe.imageName = tn; }
  else if (kind === "city"){ var co = S.city.counts, sh = S.city.shown, cl = S.city.label;
                             S.city = clone(d.city);
                             S.city.counts = co; S.city.shown = sh; S.city.label = cl; }
  commitPanels(); say("reset " + kind + (id ? " " + id : ""));
}

// =============================================================================================
// SIDE PANELS
// =============================================================================================
var actionPanelDuty = "clerical";

// THE STAGED PAIR. Files chosen for DUTY ART PAIR are held here rather than left sitting in the
// file inputs, because any panel repaint rebuilds that markup and would silently drop them. The
// duty is remembered with them: switching duty abandons a staging that was never applied, which
// is the only reading of "choose Clerical's art, then switch to Produce" that cannot surprise.
var artPairDuty = "clerical";
var pairPick = {actionA: null, actionB: null};
function clearPick(){ pairPick = {actionA: null, actionB: null}; }

function stepArtPairDuty(dir){
  var i = DUTY_ORDER.indexOf(artPairDuty);
  if (i < 0) i = 0;
  artPairDuty = DUTY_ORDER[(i + dir + DUTY_ORDER.length) % DUTY_ORDER.length];
  // Anything staged belonged to the duty being left, so it goes with it.
  clearPick();
  panels();
  say("duty art pair · " + S.duties[artPairDuty].name);
}

// ONE ACTION'S ARTWORK, and nothing else: not the other action, not the seal, not the names, and
// not another duty. Clearing is the ONLY way art is removed -- an empty file input never means
// "remove", because the commonest thing anyone does with a file dialog is change their mind.
function clearActionArt(key){
  var D = S.duties[artPairDuty], act = D && D[key];
  if (!act) return;
  if (!act.scenic && !act.scenicName){ say("no artwork on that action to clear"); return; }
  var was = act.scenicName || "the artwork";
  act.scenic = null;
  act.scenicName = null;
  commitPanels();
  say("cleared " + was + " from " + D.name + " · " + (act.name || key));
}

// LOAD PAIR. Both files land as ONE editor operation -- one undo takes both back -- and a file
// that was not chosen leaves its action exactly as it was.
function loadDutyArtPair(){
  var slug = artPairDuty, chosen = [];
  ACTIONS.forEach(function(a){ if (pairPick[a.key]) chosen.push(a.key); });
  if (!chosen.length){ say("choose an image for at least one action first", true); return; }
  var pending = chosen.length, loaded = [];
  chosen.forEach(function(key){
    readImageFile(pairPick[key], function(imgKey, name){
      var act = S.duties[slug][key];
      act.scenic = imgKey;
      act.scenicName = name;
      loaded.push((act.name || key) + " · " + name);
      pending -= 1;
      // THE COMMIT WAITS FOR BOTH READS. FileReader is asynchronous, so committing inside the
      // callback would make a two-file load into two undo entries, and the second one would land
      // whenever the larger file happened to finish.
      if (pending === 0) finishDutyArtPair(slug, loaded);
    });
  });
}

function finishDutyArtPair(slug, loaded){
  clearPick();
  // AN EDITOR CONVENIENCE, not a rule about the game: show what was just imported instead of
  // making somebody go and find it. In ACTION SELECTION the duty's two actions ARE the choice on
  // screen, so the import becomes the selection; before that, it becomes the preview.
  if (S.view === "action") S.selectedDuty = slug;
  else S.previewDuty = slug;
  commitPanels();
  say("loaded into " + S.duties[slug].name + " · " + loaded.join(" · "));
}

