  pairNum("tkSizeN", "tkSizeR", setTokenSize, tokenSize);
  pairNum("tkSpreadN", "tkSpreadR", setTokenSpread, tokenSpread);

  // ---- layout helpers ----------------------------------------------------------------------------------
  // SHORTCUTS FOR THE FIDDLY PART. Every one of these can be done by hand with the inspector and
  // the drag handles, and still can be -- see the note on the operations themselves. What the
  // panel removes is the arithmetic: eight cards to retype, a row to re-space, a wheel to
  // re-centre after every resize.
  //
  // The controls OPEN AT WHAT THE GEOMETRY SAYS and change nothing until moved. Opening a panel
  // is not an edit, and a layout whose gaps are 15 / 10 / 12 stays that way until somebody
  // decides otherwise.
  var cg = cardGroup(), aL = artOf("left"), aR = artOf("right");
  var hp = ''
    + '<div class=sub>wheel</div>'
    + '<div class=row><span>width</span><input type=number id=hpWheelN min=' + HELPERS.wheelW[0]
    + ' max=' + HELPERS.wheelW[1] + ' value="' + S.wheel.width + '"></div>'
    + '<input type=range id=hpWheelR min=' + HELPERS.wheelW[0] + ' max=' + HELPERS.wheelW[1]
    + ' step=1 value="' + S.wheel.width + '">'
