  [].forEach.call(el("acoCtl").querySelectorAll("[data-acoclr]"), function(b){
    b.onclick = function(){ var p = b.dataset.acoclr;
      if (A.style === "painted"){ A.painted[p] = null; A.paintedNames[p] = null; }
      else { A.colored[p] = null; A.coloredNames[p] = null; }
