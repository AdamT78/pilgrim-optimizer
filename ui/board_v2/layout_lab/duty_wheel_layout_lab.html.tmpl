    + btn("fit action row", fitActionRow) + '</div>';

  el("helpCtl").innerHTML = hp;
  // WIRED IN PAIRS, and neither writes back through panels(): rebuilding the panel on every
  // input would destroy the slider mid-drag. Each handler keeps its two inputs in step by hand
  // and lets render() repaint the numbers, exactly as the acolyte height control does.
  function pair(numId, rangeId, apply, read){
    var n = el(numId), r = el(rangeId);
    function go(v){
      // `true` -> recordSoon: a slider sweep collapses to one undo entry on a short debounce,
      // which is the existing history rule rather than a new one.
      apply(v, true);
      // THEN READ THE GEOMETRY BACK rather than echoing what was typed. The operation may have
      // clamped the number to the control's range, or refused it outright because something is
      // locked -- and a control still showing a value the object does not have is armed to jump
      // it there the next time it is touched.
      var actual = read();
      r.value = actual;
      // The number box is left alone WHILE IT HAS THE CARET, or a typed "1500" never gets past
      // its first digit. It settles on blur or Enter instead.
      if (document.activeElement !== n) n.value = actual;
    }
    n.oninput = function(){ go(n.value); };
    n.onchange = function(){ go(n.value); n.value = read(); };
    r.oninput = function(){ go(r.value); };
  }
  pair("hpWheelN", "hpWheelR", setWheelWidth, function(){ return S.wheel.width; });
  pair("hpCardN", "hpCardR", setCardHeights, function(){ return cardGroup().h.lo; });
  pair("hpArtWN", "hpArtWR", setArtWidth, function(){ return artOf("left").width; });
