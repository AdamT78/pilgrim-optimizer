  // ---- players --------------------------------------------------------------------------------------------
  var pc = "";
  S.players.forEach(function(p, i){
    pc += '<div class="row two"><span>' + p.id + '</span>'
       + '<input type=text data-pl="' + i + ':label" value="' + esc(p.label) + '">'
