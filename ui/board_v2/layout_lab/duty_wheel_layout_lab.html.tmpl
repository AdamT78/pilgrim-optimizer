// Does the instruction fit on one line? Measured rather than guessed -- the sow line is the long
// one and "does the text fit" is not something to find out from a screenshot afterwards.
function statusFits(){
  var n = el("statusObj");
  if (!n) return true;
  var m = n.querySelector(".main");
  return !m || m.scrollWidth <= m.clientWidth + 1;
}

// =============================================================================================
// SERIALISATION. Two outputs, because they answer to two different readers.
//
//   A LAB SESSION is for this page: everything, including which state was on screen, which duty
//   was being previewed, the occupancy counts being tested, the guides, and optionally the image
//   bytes. Its only contract is with a future version of this tool.
//
//   A GAME LAYOUT is for the real UI: geometry and the action wording, nothing else. Built field
//   by field rather than by deleting keys from the state -- a subtractive export leaks every new
//   editor setting into production the day it is added.
// =============================================================================================
function labSession(withImages){
  var used = {};
  if (withImages){
    function mark(k){ if (k && IMAGES[k]) used[k] = IMAGES[k]; }
    mark(S.wheel.image); mark(S.tithe.image);
    // The three resource tokens, or a session exported "with images" would reopen showing the
    // letters again and look like the art had been lost.
    (S.tithe.resources || []).forEach(function(r){ mark(r.icon); });
    DUTY_ORDER.forEach(function(s){
      ACTIONS.forEach(function(a){
        var act = S.duties[s][a.key]; mark(act.seal); mark(act.scenic);
      });
    });
    PLAYER_IDS.forEach(function(p){ mark(S.acolytes.painted[p]); mark(S.acolytes.colored[p]); });
  }
  return {kind: "duty-wheel-lab-session", version: STATE_VERSION,
          state: clone(S), images: used};
}

// THE PRODUCTION EXPORT. The line it draws is not "geometry in, everything else out" -- it is
// DESIGN DECISIONS IN, SESSION STATE OUT.
//
// A box alone was too little: the real UI could place the instruction and then not know what it
// says, how big it is or whether it is centred, and could place the two artwork slots without
// knowing whether they cover or contain. Those were decided here and are part of the design.
//
// What stays out is what somebody happened to be doing while composing: which object is
// selected, which duty is reached or previewed, the mode, the zoom, the guides, the ghosts, the
// undo history, the locks, the image pool, and the occupancy counts and seats being used to
// test crowding. The layout says where the pieces go; it does not say which pieces are on the
// board in this lab session.
//
// BUILT FIELD BY FIELD, never by cloning the state and deleting keys -- a subtractive export
// leaks each new editor setting into production on the day it is added.
function gameLayout(){
  function box(o){ return {x: o.x, y: o.y, width: o.width, height: o.height}; }
  var msgs = {};
  VIEW_STATES.forEach(function(vs){
    msgs[vs.key] = {main: ((S.status.byView || {})[vs.key] || {}).main || ""};
  });
  var H = S.display.highlight;
  var out = {
    version: STATE_VERSION,
    canvas: {width: CANVAS_W, height: CANVAS_H},
    // The instruction: where it sits AND what it says in each state, because the typography and
    // the wording were both decided here.
    status: {x: S.status.x, y: S.status.y, width: S.status.width, height: S.status.height,
             size: S.status.size, align: S.status.align, opacity: S.status.opacity,
             visible: !!S.status.visible, byView: msgs},
    // RATIO IS EXPORTED BECAUSE IT IS A DESIGN INVARIANT, not a consequence of the box: the
    // production UI has to know the wheel is a circle at this elevation, not a free rectangle.
    wheel: {x: S.wheel.x, y: S.wheel.y, width: S.wheel.width, height: S.wheel.height,
            ratio: WHEEL_RATIO, ground: !!S.wheel.ground, opacity: S.wheel.opacity},
    duties: {},
    artwork: {},
    // The mark on the reached duty, which was sized and coloured here and cannot be recreated
    // from anything else in this file.
    highlight: {width: H.width, height: H.height, dy: H.dy, style: H.style,
                visible: !!H.visible, opacity: H.opacity, colour: H.colour},
    // WHEN Tithe and the City are on screen is a phase the game already knows; WHAT they look
    // like and WHERE they go is this file's business, so the labels and the resources come too
    // and nothing about the phase does.
    // THE TOKEN SIZING IS A DESIGN DECISION AND TRAVELS; the image POOL KEY is session state
    // and does not. `iconName` is what the production asset pipeline resolves against, the same
    // way the action artwork is identified by filename rather than by bytes.
    tithe: {x: S.tithe.x, y: S.tithe.y, width: S.tithe.width, height: S.tithe.height,
            visible: !!S.tithe.visible, label: S.tithe.label,
            tokenSize: tokenSize(), tokenSpread: tokenSpread(),
            resources: (S.tithe.resources || []).map(function(r){
              return {key: r.key, name: r.name, iconName: r.iconName || null}; })},
    city: {x: S.city.x, y: S.city.y, width: S.city.width, height: S.city.height,
           visible: !!S.city.visible, label: S.city.label},
    acolytes: {height: S.acolytes.height, ratios: clone(S.acolytes.ratios)},
  };
  DUTY_ORDER.forEach(function(slug){
    var D = S.duties[slug], F = D.figures, cd = D.card;
    var d = {name: D.name,
             card: {x: cd.x, y: cd.y, width: cd.width, height: cd.height,
                    visible: !!cd.visible}};
    ACTIONS.forEach(function(a){
      // THE ACTION CARRIES ITS WORDING AND NOT A BOX. The two shared artwork slots own the
      // geometry, so there are no sixteen large boxes to export.
      var act = D[a.key];
      d[a.key] = {name: act.name, shortLabel: act.shortLabel};
    });
    // WHERE the acolytes stand, not WHO is standing there: count and seats are the crowding
    // test this session happens to be running.
    d.figures = {x: F.x, y: F.y, u: F.u, v: F.v,
                 spacing: F.spacing, arrangement: F.arrangement, attached: !!F.attached};
    out.duties[slug] = d;
  });
  ["left", "right"].forEach(function(side){
    var e = artOf(side);
    out.artwork[side] = {x: e.x, y: e.y, width: e.width, height: e.height, slot: e.slot,
                         fit: e.fit, opacity: e.opacity, visible: !!e.visible,
                         labelVisible: !!e.labelVisible, labelSize: e.labelSize};
  });
  return out;
}

function validate(d){
  if (!d || typeof d !== "object" || Array.isArray(d)) throw new Error("not an object");
  if (!d.canvas || d.canvas.width !== CANVAS_W || d.canvas.height !== CANVAS_H)
    throw new Error("canvas is not " + CANVAS_W + "x" + CANVAS_H);
  if (!d.duties || typeof d.duties !== "object") throw new Error("no duties");
  DUTY_ORDER.forEach(function(s){
    if (!d.duties[s]) throw new Error("no duty '" + s + "'");
  });
  var extra = Object.keys(d.duties).filter(function(s){ return DUTY_ORDER.indexOf(s) < 0; });
  if (extra.length) throw new Error("duties this module does not have: " + extra.join(", "));
  return true;
}

// =============================================================================================
// MIGRATION. One function, called on everything that comes in from outside, so nothing
// downstream has to know which shape it started as.
//
//   V1 -> V2  one artwork per duty became two, each with a box.
//   V2 -> V3  the boxes went away; assets moved to two shared slots; the module widened to 1400.
//   V3 -> V4  the composition rearranged. The per-duty summary becomes a reference card in the
//             top ribbon; the wheel-centre medallions retire; the status line loses its context
//             field; the duty labels on the wheel go, because nothing identifies a duty space on
//             the wheel now and a hidden object that could is worth removing rather than keeping.
//
// GEOMETRY IS NOT CARRIED ACROSS THE V4 BOUNDARY. Every band moved, so a V3 summary's position
// is a position in a layout that no longer exists -- keeping it would put eight cards where the
// old two columns were, off the ribbon and over the wheel. What IS carried is everything that is
// not a coordinate: the wording, the assets, the counts, the seats, the player colours, the
// guides and the acolyte settings, which is the part somebody actually spent time on.
// =============================================================================================
function migrate(d){
  if (!d || typeof d !== "object") return d;
  d = clone(d);
  var def = DEFAULT_STATE;

  function hoist(o){
    if (o && typeof o.image === "string" && o.image.slice(0, 5) === "data:") o.image = putImage(o.image);
  }
  hoist(d.wheel); hoist(d.city);

  // ---- V1 -> V2 ------------------------------------------------------------------------------
  if (d.duties){
    DUTY_ORDER.forEach(function(s){
      var D = d.duties[s];
      if (!D) return;
      if (D.art && !D.actionA){
        hoist(D.art);
        D.actionA = {art: D.art};
        D.actionB = {art: {image: null, imageName: null}};
      }
      delete D.art;
      ACTIONS.forEach(function(a){ if (D[a.key]) hoist(D[a.key].art); });
      var F = D.figures;
      if (F){
        if (F.anchorX !== undefined && F.x === undefined){ F.x = F.anchorX; F.y = F.anchorY; }
        delete F.anchorX; delete F.anchorY;
        if (F.arrangement === undefined) F.arrangement = F.compact ? "compact" : "row";
        delete F.compact;
        if (!Array.isArray(F.seats)) F.seats = clone(def.duties[s].figures.seats);
      }
    });
  }
  if (d.city && Array.isArray(d.city.players)){
    var counts = {}, shown = {}, players = [];
    d.city.players.slice(0, 4).forEach(function(p, i){
      var id = PLAYER_IDS[i];
      players.push({id: id, label: p.label || def.players[i].label,
                    colour: p.colour || def.players[i].colour});
      counts[id] = p.count; shown[id] = !!p.visible;
    });
    while (players.length < 4){ var j = players.length; players.push(clone(def.players[j])); }
    if (!d.players) d.players = players;
    if (!d.city.counts) d.city.counts = counts;
    if (!d.city.shown) d.city.shown = shown;
    delete d.city.players;
  }

  // ---- V2 -> V3: assets keep, boxes go --------------------------------------------------------
  if (d.duties){
    DUTY_ORDER.forEach(function(s){
      var D = d.duties[s];
      if (!D) return;
      ACTIONS.forEach(function(a){
        var slot = D[a.key];
        if (!slot) return;
        if (slot.art){
          var art = slot.art;
          hoist(art);
          D[a.key] = {
            name: slot.name || def.duties[s][a.key].name,
            shortLabel: slot.shortLabel || def.duties[s][a.key].shortLabel,
            seal: slot.seal || null, sealName: slot.sealName || null,
            scenic: art.image || null, scenicName: art.imageName || null,
          };
        }
      });
    });
  }

  // ---- V3 -> V4: the rearrangement --------------------------------------------------------------
  var oldW = d.canvas && d.canvas.width;
  if (oldW && oldW !== CANVAS_W){
    // A V1/V2 file on the 1200 module. Widening its coordinates would place them precisely in a
    // layout V4 has replaced, so the canvas is simply declared and the geometry comes from the
    // defaults below.
    d.canvas = {width: CANVAS_W, height: CANVAS_H};
  }
  var fromOlder = !(d.version >= STATE_VERSION);
  if (fromOlder){
    // The V3 summary becomes the V4 reference card -- same duty, same contents, new place in the
    // ribbon. The old position is dropped on purpose; see the note above.
    if (d.duties) DUTY_ORDER.forEach(function(s){
      var D = d.duties[s];
      if (!D) return;
      delete D.summary;
      delete D.label;              // nothing identifies a duty space on the wheel in V4
      delete D.titheLabel;
      D.card = clone(def.duties[s].card);
      if (D.figures){
        // The anchors ring a wheel that is now 1372 wide rather than 950, and u/v is a fraction
        // of THAT wheel -- so the ring is re-derived rather than reused at a different scale.
        delete D.figures.u; delete D.figures.v;
        D.figures.x = def.duties[s].figures.x;
        D.figures.y = def.duties[s].figures.y;
        D.figures.spacing = def.duties[s].figures.spacing;
      }
    });
    // Geometry that has no V4 equivalent, or whose band moved.
    ["wheel", "status", "city", "tithe"].forEach(function(k){
      if (!d[k]) return;
      ["x", "y", "width", "height"].forEach(function(f){ delete d[k][f]; });
    });
    if (d.display){ delete d.display.expandedLeft; delete d.display.expandedRight; }
    // V3's status had a context line and per-view presets; V4 has one line per state.
    if (d.status){
      var main = {};
      VIEW_STATES.forEach(function(vs){
        var old = (d.status.byView || {})[vs.key];
        main[vs.key] = {main: (old && old.main) || def.status.byView[vs.key].main};
      });
      d.status.byView = main;
      ["context", "main", "preset", "contextVisible", "contextSize", "mainSize", "autoContext",
       "accent", "accentColour"].forEach(function(f){ delete d.status[f]; });
    }
    // The in-hand pool kept a box while it lived in the wheel's centre. It does not have one now.
    if (d.inHand){
      var keep = {count: d.inHand.count, seat: d.inHand.seat,
                  label: def.inHand.label};
      d.inHand = keep;
    }
    if (d.tithe){
      delete d.tithe.u; delete d.tithe.v; delete d.tithe.attached; delete d.tithe.uvAnchor;
      delete d.tithe.resourceText;
    }
    if (d.city){ delete d.city.label; delete d.city.fit; delete d.city.opacity;
                 delete d.city.image; delete d.city.imageName; }
    delete d.summaryDim; delete d.connectors; delete d.titheInSummary;
    delete d.inHandOverride;
  }

  // ---- the flex pyramid becomes a triangle, inside V4 --------------------------------------------
  // NOT GATED ON `fromOlder`. Both fields belong to V4 -- the token controls arrived in 4.4 and
  // were replaced in 4.5 -- so `d.version` says nothing at all about which of them a file carries,
  // and the only honest test is whether the field is there.
  //
  // AND IT HAS TO HAPPEN HERE, on the incoming data, rather than in applyState after the merge.
  // deepMerge fills `tokenSpread` in from the defaults, so by the time applyState sees the state
  // there is no absence left to detect -- and the file's own arrangement has silently become the
  // default one. The first version of this was written after the merge and did exactly that: it
  // ran, it was wrong, and nothing about the state afterwards showed it had not worked.
  //
  // `tokenGap` was the space BETWEEN two token boxes; `tokenSpread` is the distance between two
  // token CENTRES. They differ by exactly one token, which is why the size is read here too.
  if (d.tithe){
    if (d.tithe.tokenSpread === undefined && d.tithe.tokenGap !== undefined
        && d.tithe.tokenGap !== null && !isNaN(+d.tithe.tokenGap)){
      var tsz = Math.round(+d.tithe.tokenSize);
      if (isNaN(tsz)) tsz = DEFAULT_STATE.tithe.tokenSize;
      d.tithe.tokenSpread = tsz + Math.round(+d.tithe.tokenGap);
    }
    delete d.tithe.tokenGap;
    // The per-resource optical correction, dropped with the control: the three masters were
    // re-exported to the same disc fraction instead.
    if (Array.isArray(d.tithe.resources)){
      d.tithe.resources.forEach(function(r){ if (r) delete r.scale; });
    }
  }
  d.version = STATE_VERSION;
  return d;
}

function deepMerge(base, over){
  // Defaults win where the file is silent, the file wins where it speaks. Arrays are replaced
  // wholesale -- a four-player list merged element-wise is a way to end up with a fifth player.
  if (over === null || over === undefined) return base;
  if (Array.isArray(base) || Array.isArray(over)) return clone(over);
  if (typeof base !== "object" || typeof over !== "object") return over;
  var out = clone(base);
  Object.keys(over).forEach(function(k){
    out[k] = (k in base) ? deepMerge(base[k], over[k]) : clone(over[k]);
  });
  return out;
}

// EVERY NUMBER OFF THE WIRE IS CLAMPED rather than trusted. A NaN width renders an invisible box
// that cannot be selected to fix it, which is a state a person cannot get out of.
function applyState(d){
  d = migrate(d);
  validate(d);
  S = deepMerge(clone(DEFAULT_STATE), d);
  // Before anything can hand out a new key, take every one this state already uses out of
  // circulation -- see reserveImageKeys.
  reserveImageKeys(S);

  // THE 32 DEGREE RATIO IS A DESIGN INVARIANT, so it is imposed rather than trusted. An older
  // V4 session may carry a ratio taken from whatever asset was loaded at the time, and a file
  // written by hand may carry anything at all; either way the height follows the width at the
  // layout's own ratio. This is a normalisation, not a migration -- the schema is unchanged and
  // an existing V4 session still opens.
  // THE TITHE TOKENS, NORMALISED RATHER THAN MIGRATED. `resources` is an ARRAY, and deepMerge
  // replaces arrays wholesale, so a V4 session written before tokens existed brings back three
  // objects shaped {key, name} with no icon or iconName -- the defaults do not survive the merge
  // the way an object's keys would. Filling them in here is what lets an older session open
  // without a schema bump. Imported numbers are clamped: a hand-edited file is not to be trusted
  // with a spread of 4000.
  if (!Array.isArray(S.tithe.resources) || !S.tithe.resources.length){
    S.tithe.resources = clone(DEFAULT_STATE.tithe.resources);
  }
  S.tithe.resources.forEach(function(r){
    if (r.icon === undefined) r.icon = null;
    if (r.iconName === undefined) r.iconName = null;
    // The per-resource optical correction is stripped in migrate(), with the rest of the
    // conversion from the flex build. Not here as well: a second delete would mean neither
    // could be shown to matter.
  });
  S.tithe.tokenSize = clamp(Math.round(+S.tithe.tokenSize || DEFAULT_STATE.tithe.tokenSize),
                            HELPERS.tokenSize[0], HELPERS.tokenSize[1]);
  // A session saved before the triangle carried `tokenGap` instead; migrate() has already turned
  // it into the equivalent spread, because after deepMerge there is nothing left to detect.
  //
  // NOT `|| default`: a spread of 0 is a legitimate choice -- three tokens concentric on one
  // point -- and must survive the round trip, which `0 || 47` would quietly turn into 47.
  S.tithe.tokenSpread = clamp(Math.round(
      S.tithe.tokenSpread === undefined || S.tithe.tokenSpread === null
        || isNaN(+S.tithe.tokenSpread)
          ? DEFAULT_STATE.tithe.tokenSpread : +S.tithe.tokenSpread),
      HELPERS.tokenSpread[0], HELPERS.tokenSpread[1]);

  S.wheel.width = clamp(S.wheel.width, MIN_SIZE, 4000);
  S.wheel.naturalRatio = WHEEL_RATIO;
  S.wheel.ratioSource = "builtin";
  S.wheel.height = Math.round(S.wheel.width * WHEEL_RATIO);
  DUTY_ORDER.forEach(function(s){
    var D = S.duties[s];
    ACTIONS.forEach(function(act){
      var a = D[act.key];
      a.name = String(a.name === undefined || a.name === null ? "" : a.name).slice(0, 80);
      a.shortLabel = String(a.shortLabel === undefined || a.shortLabel === null
                            ? a.name : a.shortLabel).slice(0, 80);
    });
    var cd = D.card;
    cd.width = clamp(Math.round(cd.width), MIN_SIZE, 1000);
    cd.height = clamp(Math.round(cd.height), MIN_SIZE, 1000);
    var f = D.figures;
    f.count = clamp(Math.round(f.count), 0, 4);
    f.spacing = clamp(f.spacing, 4, 400);
    if (["row","compact","arc"].indexOf(f.arrangement) < 0) f.arrangement = "row";
    f.seats = (Array.isArray(f.seats) ? f.seats : []).slice(0, 4)
                .map(function(p){ return PLAYER_IDS.indexOf(p) >= 0 ? p : PLAYER_IDS[0]; });
    while (f.seats.length < 4) f.seats.push(PLAYER_IDS[0]);
  });
  ["left", "right"].forEach(function(side){
    var e = artOf(side);
    e.width = clamp(Math.round(e.width), MIN_SIZE, 4000);
    e.height = clamp(Math.round(e.height), MIN_SIZE, 4000);
    e.opacity = clamp(e.opacity, 0, 1);
    e.fit = (e.fit === "contain") ? "contain" : "cover";
    if (ACTIONS.map(function(a){ return a.key; }).indexOf(e.slot) < 0)
      e.slot = side === "left" ? "actionA" : "actionB";
    e.labelSize = clamp(Math.round(e.labelSize), 8, 60);
  });
  S.players = (Array.isArray(S.players) ? S.players : []).slice(0, 4).map(function(p, i){
    var d0 = DEFAULT_STATE.players[i];
    return {id: d0.id, label: p && p.label ? p.label : d0.label,
            colour: /^#[0-9a-fA-F]{6}$/.test((p && p.colour) || "") ? p.colour : d0.colour};
  });
  while (S.players.length < 4) S.players.push(clone(DEFAULT_STATE.players[S.players.length]));
  PLAYER_IDS.forEach(function(p){
    S.city.counts[p] = clamp(Math.round(S.city.counts[p]), 0, 99);
    S.city.shown[p] = !!S.city.shown[p];
  });
  S.inHand.count = clamp(Math.round(S.inHand.count), 0, 99);
  if (PLAYER_IDS.indexOf(S.inHand.seat) < 0) S.inHand.seat = PLAYER_IDS[0];
  S.acolytes.height = clamp(Math.round(S.acolytes.height), ACO_RANGE[0], ACO_RANGE[1]);
  S.acolytes.style = (S.acolytes.style === "painted") ? "painted" : "colored";
  ["duty","city","inHand"].forEach(function(k){
    S.acolytes.ratios[k] = clamp(Math.round(S.acolytes.ratios[k]), 20, 150); });
  S.status.size = clamp(Math.round(S.status.size), 10, 80);
  if (["left","center","right"].indexOf(S.status.align) < 0) S.status.align = "center";
  if (DUTY_ORDER.indexOf(S.selectedDuty) < 0) S.selectedDuty = DUTY_ORDER[0];
  if (S.previewDuty && DUTY_ORDER.indexOf(S.previewDuty) < 0) S.previewDuty = null;
  if (!VIEW_STATES.some(function(v){ return v.key === S.view; })) S.view = VIEW_STATES[0].key;
  if (S.zoom !== "fit" && ZOOM_STEPS.indexOf(+S.zoom) < 0) S.zoom = "fit";
  if (!BACKGROUNDS.some(function(b){ return b.key === S.background; }))
    S.background = BACKGROUNDS[0].key;
  S.attachToWheel = S.attachToWheel !== false;
  // The absolute cache may be stale in an imported file -- the wheel it was saved against may
  // have been a different size. The normalized coordinates are the authority.
  syncAttached();

  setBackground(S.background, true);
  setMode(S.mode === "clean" ? "clean" : "edit");
  sel = null;
  render(); inspector(); panels(); relayout();
}

// =============================================================================================
// PERSISTENCE. The autosave is geometry and settings only: a handful of full-resolution images
// as data URLs is tens of megabytes and localStorage gives a page about five. The pool makes
// that structural -- there are no image bytes in S to save -- and the strip pass below is the
// belt to those braces, so a future field holding a data URL cannot reintroduce the problem.
// =============================================================================================
function stripDataUrls(o){
  if (o === null || typeof o !== "object") return o;
  if (Array.isArray(o)) return o.map(stripDataUrls);
  var out = {};
  Object.keys(o).forEach(function(k){
    var v = o[k];
    out[k] = (typeof v === "string" && v.slice(0, 5) === "data:") ? null : stripDataUrls(v);
  });
  return out;
}
function say(msg, bad){
  var e = el("status");
  if (!e) return;
  e.textContent = msg; e.className = bad ? "bad" : "ok";
  clearTimeout(say._t); say._t = setTimeout(function(){ e.className = ""; }, 4000);
}
function save(quiet){
  try { localStorage.setItem(STORE_KEY, JSON.stringify(stripDataUrls(S))); }
  catch (e){ if (!quiet) say("could not save: " + e.message, true); return; }
  if (!quiet) say("saved to this browser");
}
function load(){
  var raw = null;
  try { raw = localStorage.getItem(STORE_KEY); } catch (e){}
  if (!raw) return false;
  try { applyState(JSON.parse(raw)); return true; }
  catch (e){ say("saved layout could not be read, starting fresh: " + e.message, true); return false; }
}

// =============================================================================================
// VIEW STATE, BACKGROUND, ZOOM, CLEAN PREVIEW, FULL SCREEN
// =============================================================================================
// THE VIEW STATE IS NOT A LAYOUT CHANGE, so it is saved but never recorded on the undo stack --
// flipping between the three compositions twenty times to compare them costs nothing.
//
// CHANGING STATE CLOSES A PREVIEW. The artwork means something different in the next state, and
// a preview left open would be indistinguishable from a choice.
function setView(v){
  if (!VIEW_STATES.some(function(x){ return x.key === v; })) return;
  S.view = v;
  S.previewDuty = null;
  render(); inspector(); panels(); save(true);
}
function paintView(){
  var host = el("bView"); if (!host) return;
  host.innerHTML = VIEW_STATES.map(function(v){
    return '<button data-view="' + v.key + '" aria-pressed="' + (S.view === v.key) + '">'
         + v.label + '</button>'; }).join("");
  [].forEach.call(host.querySelectorAll("[data-view]"), function(b){
    b.onclick = function(){ setView(b.dataset.view); };
  });
}
function bgCss(key){
  var b = BACKGROUNDS.filter(function(x){ return x.key === key; })[0] || BACKGROUNDS[0];
  return b.css;
}
function setBackground(key, quiet){
  S.background = BACKGROUNDS.some(function(b){ return b.key === key; }) ? key : BACKGROUNDS[0].key;
  document.documentElement.style.setProperty("--stage-bg", bgCss(S.background));
  paintBg();
  if (!quiet){ record(); save(true); }
}
function paintBg(){
  var host = el("bgBtns"); if (!host) return;
  host.innerHTML = BACKGROUNDS.map(function(b){
    return '<button data-bg="' + b.key + '" aria-pressed="' + (S.background === b.key) + '">'
         + b.label + '</button>'; }).join("");
  [].forEach.call(host.querySelectorAll("[data-bg]"), function(b){
    b.onclick = function(){ setBackground(b.dataset.bg); };
  });
}
function paintZoom(){
  var host = el("zoomBtns"); if (!host) return;
  var opts = ["fit"].concat(ZOOM_STEPS);
  host.innerHTML = opts.map(function(z){
    return '<button data-zoom="' + z + '" aria-pressed="' + (String(S.zoom) === String(z)) + '">'
         + (z === "fit" ? "FIT" : z + "%") + '</button>'; }).join("");
  [].forEach.call(host.querySelectorAll("[data-zoom]"), function(b){
    b.onclick = function(){ setZoom(b.dataset.zoom === "fit" ? "fit" : +b.dataset.zoom); };
  });
}
// ZOOM IS DISPLAY ONLY: one number and a relayout, never an object's geometry, which is why an
// export taken at 125% is identical to one taken at FIT.
function setZoom(z){ S.zoom = z; relayout(); save(true); }

// FULL SCREEN. THE CLASS FOLLOWS THE BROWSER, not the keypress: Escape leaves full screen
// without going through this code, so a page that toggled its own class on F would sit there
// with its chrome hidden and no way back except pressing F twice.
function setFull(on){
  document.body.classList.toggle("full", !!on);
  relayout();
}
addEventListener("fullscreenchange", function(){ setFull(!!document.fullscreenElement); });

function toggleFull(){
  if (document.fullscreenElement){ document.exitFullscreen(); return; }
  var root = document.documentElement;
  var req = root.requestFullscreen && root.requestFullscreen();
  if (req && req.then){
    req.catch(function(){
      setFull(!document.body.classList.contains("full"));
      say("this browser would not go full screen · chrome hidden instead");
    });
  } else {
    setFull(!document.body.classList.contains("full"));
  }
}

function setMode(m){
  document.body.classList.toggle("clean", m === "clean");
  S.mode = m;
  el("bMode").textContent = m === "clean" ? "CLEAN PREVIEW" : "EDIT MODE";
  el("bMode").setAttribute("aria-pressed", m === "edit" ? "true" : "false");
}

[].forEach.call(document.querySelectorAll("#side h3"), function(h){
  h.onclick = function(){ h.classList.toggle("shut"); };
});

// =============================================================================================
// TOOLBAR
// =============================================================================================
el("bMode").onclick = function(){ setMode(S.mode === "edit" ? "clean" : "edit"); render();
                                  save(true); };
el("bUndo").onclick = function(){ say(stepHistory(-1) ? "undo" : "nothing to undo"); };
el("bRedo").onclick = function(){ say(stepHistory(1) ? "redo" : "nothing to redo"); };
el("bReset").onclick = function(){ applyState(clone(DEFAULT_STATE)); histReset(); save(true);
                                   say("lab reset"); };

function download(name, text, type){
  var blob = new Blob([text], {type: type || "application/json"});
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = name;
  a.click();
  setTimeout(function(){ URL.revokeObjectURL(a.href); }, 2000);
}

el("bExport").onclick = function(){
  var withImg = confirm("Include loaded images in the Lab Session?\n\nOK = yes, the session "
                      + "reopens exactly as it looks now but the file may be large.\n"
                      + "Cancel = geometry and settings only.");
  var d = labSession(withImg);
  download("duty_wheel_lab_session.json", JSON.stringify(d, null, 1));
  say("lab session exported " + (withImg ? "with " + Object.keys(d.images).length + " image(s)"
                                         : "geometry only"));
};
el("bGame").onclick = function(){
  download("duty_wheel_game_layout.json", JSON.stringify(gameLayout(), null, 1));
  say("game layout exported · geometry and wording, no editor state");
};
el("bCopy").onclick = function(){
  var t = JSON.stringify(gameLayout(), null, 1);
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(t).then(function(){ say("game layout copied"); },
                                          function(){ fallbackCopy(t); });
  } else fallbackCopy(t);
};
function fallbackCopy(t){
  var a = document.createElement("textarea");
  a.value = t; document.body.appendChild(a); a.select();
  try { document.execCommand("copy"); say("game layout copied"); }
  catch (e){ say("could not copy", true); }
  a.remove();
}
el("bImport").onclick = function(){ el("fImport").click(); };
el("fImport").onchange = function(){
  var f = this.files && this.files[0]; if (!f) return;
  var rd = new FileReader();
  rd.onload = function(){
    try { importSession(JSON.parse(rd.result)); say("imported " + f.name); }
    catch (e){ say("import refused: " + e.message, true); }
  };
  rd.readAsText(f); this.value = "";
};
// Accepts a Lab Session envelope of any version, a bare state object (V1's export), or a bare
// V2/V3/V4 state.
function importSession(d){
  var state = d, imgs = null;
  if (d && d.kind === "duty-wheel-lab-session"){ state = d.state; imgs = d.images; }
  if (imgs && typeof imgs === "object"){
    Object.keys(imgs).forEach(function(k){
      if (typeof imgs[k] === "string" && imgs[k].slice(0, 5) === "data:"){
        IMAGES[k] = imgs[k];
        var n = +String(k).replace(/^im/, "");
        if (isFinite(n) && n > IMG_SEQ) IMG_SEQ = n;
      }
    });
  }
  applyState(state);
  histReset();
  save(true);
}

// PNG export. Best effort and said so: an <img> holding a data: URL draws fine, but a page that
// ever gained a cross-origin image would taint the canvas, so the failure is caught and reported
// rather than producing a blank file.
el("bPng").onclick = function(){
  var cv = document.createElement("canvas");
  cv.width = CANVAS_W; cv.height = CANVAS_H;
  var ctx = cv.getContext("2d");
  ctx.fillStyle = bgCss(S.background); ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);
  var xml = new XMLSerializer().serializeToString(buildSvgSnapshot());
  var img = new Image();
  img.onload = function(){
    ctx.drawImage(img, 0, 0);
    try {
      cv.toBlob(function(b){
        var a = document.createElement("a");
        a.href = URL.createObjectURL(b);
        a.download = "duty_wheel_" + S.view + ".png"; a.click();
        setTimeout(function(){ URL.revokeObjectURL(a.href); }, 2000);
        say("png exported · " + S.view + " state, " + CANVAS_W + " × " + CANVAS_H);
      });
    } catch (e){ say("png export blocked by the browser: " + e.message, true); }
  };
  img.onerror = function(){ say("png export failed -- use a screenshot instead", true); };
  img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(xml);
};
function buildSvgSnapshot(){
  // foreignObject carries the live DOM into an SVG, which is the only way to snapshot CSS layout
  // without a library. Editing chrome -- ghosts, warnings, handles -- is excluded by snapshotting
  // in clean mode.
  var was = S.mode;
  setMode("clean"); render();
  var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
  svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");
  svg.setAttribute("width", CANVAS_W); svg.setAttribute("height", CANVAS_H);
  var fo = document.createElementNS("http://www.w3.org/2000/svg", "foreignObject");
  fo.setAttribute("width", CANVAS_W); fo.setAttribute("height", CANVAS_H);
  var copy = el("stage").cloneNode(true);
  copy.style.transform = "none";
  var div = document.createElement("div");
  div.setAttribute("xmlns", "http://www.w3.org/1999/xhtml");
  div.appendChild(copy);
  fo.appendChild(div); svg.appendChild(fo);
  setMode(was); render();
  return svg;
}

