        + '<div class=hint>' + ACO_RANGE[0] + '–' + ACO_RANGE[1]
        + ' px tall in design coordinates · the wheel is ' + S.wheel.width + ' px wide</div>'
        + '<div class="row two"><span>city / hand %</span>'
        + '<input type=number id=ratCity min=20 max=150 value="' + A.ratios.city + '">'
        + '<input type=number id=ratHand min=20 max=150 value="' + A.ratios.inHand + '"></div>'
        + '<div class=hint>' + (A.style === "painted" ? "painted" : "colored")
        + ' assets · one per player, transparent png or webp</div>';
  PLAYER_IDS.forEach(function(p){
    var key = A.style === "painted" ? A.painted[p] : A.colored[p];
    var nm = A.style === "painted" ? A.paintedNames[p] : A.coloredNames[p];
