  // ---- occupancy -----------------------------------------------------------------------------------------
  var h = "";
  DUTY_ORDER.forEach(function(slug){
    var f = S.duties[slug].figures;
    h += '<div class=row><span>' + slug.replace(/_/g, " ") + '</span><span style="text-align:left">'
       + [0,1,2,3,4].map(function(n){
           return '<button data-occ="' + slug + ':' + n + '" aria-pressed="'
                + (f.count === n ? "true" : "false") + '" style="padding:2px 6px">' + n + '</button>';
         }).join("")
       + ' <span class=tag>' + f.seats.slice(0, Math.max(f.count, 0)).map(function(p){
