                                      render(); recordSoon(); save(true); };
  el("ihSeat").onchange = function(){ S.inHand.seat = this.value; commit(); };

  // ---- wheel attachment ---------------------------------------------------------------------------------------
  el("attachCtl").innerHTML =
      '<div class=btns><button id=attAll aria-pressed="' + S.attachToWheel + '">'
