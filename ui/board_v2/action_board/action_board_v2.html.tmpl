<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>Pilgrim · action board v2 · duty grid</title>
<!--
  THE BOARD AT ITS FINISHED SIZE. Everything is positioned from GEO, which generate_action_board.py
  fills in from geometry.py. There is not a number in this file that decides anything: if a value
  is not in GEO it cannot be used here, which is what stops the geometry being written twice.

  NO CONTROLS, ON PURPOSE. See the long note at the top of the generator. The toolbar is not part
  of the board -- it sits above the canvas and holds only what is not the game: which phase is
  showing, whether pictures can be replaced, and save.
-->
<style>
/* NO @font-face HERE ANY MORE. The parchments and the face that lettered them have gone off this
   board; the files are still in the tree under duty_actions/banners/ and fonts/, still recorded,
   and still guarded, because they may come back. Nothing on this page loads them. */
:root{
  --ink:#e2d7bc; --dim:#968e7c; --line:#c9b27a; --faint:#2c2924;
  --panel:#0e0d0b; --panelline:#46413710;
  /* THE PLATE, AND NOW THE TILE'S. It was written once, in .seal.plate, while the tile under it
     was near-black -- so a cut-out icon sat on a visible coloured square. The tile carries the
     same colour now and the square stops being a square: the mark simply sits on the tile. Two
     things using one colour is exactly when it stops being a literal and becomes a name. The road
     took it as a third, which is the test of whether that was true.

     SLATE, CHOSEN IN THE ICON LAB. These three numbers are one entry of PALETTE in
     icon_lab/tile_column.html.tmpl, copied across whole -- the lab is where a plate is looked at
     against the real marks, and this is where the choice is written down. The pair has to move
     together: --plate-lit is the SELECTED tile, so taking one number and leaving the other gives
     seven slate tiles and one that is still the old hue. There is a guard for that now. */
  --plate:#151E25; --plate-lit:#2B3A46; --guide:#6a5f48;
  /* THE EDGE OF AN ICON FRAME, AND NOW OF THE LINE INSIDE IT. This was written once, as a
     literal in .iplate's border, while the frame was the only thing on this board drawn in it.
     The divider between a duty's actions and its tithe resource is meant to be the SAME line as
     the frame's own edge -- not a line that matches it today -- so the colour became a name the
     moment there were two readers. Matching it by eye is how a board ends up with two nearly
     identical darks and no way to tell which one moved. */
  --plate-edge:#2a2721;
  /* THE GROUND THE OPEN-DUTY FILM IS DRAWN ON, which is now also the board's. It is a MEASURED
     value and not a chosen one: the clip's background renders at rgb(4, 6, 8), and the canvas
     takes the same so that `screen` leaves no rectangle where a tile is lit. A name rather than
     a literal because it is a fact about a FILE -- replace the clip with one drawn on a
     different black and this is the line that has to move with it, which is exactly why the
     guard compares it against the clip's own record rather than against itself. */
  --film-black:#040608;
  /* NO --open-wash. Where this seat may act was a still gold gradient in the rectangle for a
     round and is a twelve-second film now -- see `.smoke` and the generator's open bundle -- so
     the colour has gone with it. The cue has had three homes and the two it left are worth
     keeping straight: a 1px warm edge on the icon frame, which failed for want of AREA rather
     than contrast and could not be seen at all; then this wash, which could. Neither is a
     fallback for the film; there is one cue. */
  /* AND THE GROUND INSIDE THAT EDGE, which is now worn by two kinds of object. It was written
     once, inline in .iplate, while the duty frames were the only thing on this board drawn in
     it; the three controls beside the Take Tithe box wear it too now, so it is a name. Written
     as the mix rather than as the colour it resolves to, because --tile-alpha is the thing
     somebody would reach for to make these more or less present and it has to keep reaching
     both. */
  --plate-ground:color-mix(in srgb, var(--plate) var(--tile-alpha), transparent);
  /* NO --lift. A hovered tile used to rise 6px and a selected one stayed up, and both are gone:
     the tiles sit still now and say everything they have to say in colour. The variable went
     with the rule, along with the ::after that refilled the strip a rising tile vacated and the
     reduced-motion rule that existed for its transition -- three pieces of machinery whose only
     job was to make the movement safe, which is the shape a removed feature should leave. */
  /* HOW MUCH VALLEY COMES THROUGH A TILE. One number; the marks keep their own opaque ground, so
     this moves the card and not what is drawn on it. */
  --tile-alpha:55%;
}
*{box-sizing:border-box}
html,body{margin:0;background:#07070a;color:var(--ink);
  font:13px/1.4 ui-sans-serif,system-ui,sans-serif}

/* ---- the toolbar. NOT the board. ------------------------------------------------------- */
#bar{display:flex;align-items:center;gap:8px;padding:7px 10px;background:#111013;
  border-bottom:1px solid #26231e;position:sticky;top:0;z-index:30;flex-wrap:wrap}
#bar button{background:#1b1915;color:var(--ink);border:1px solid #3c372e;border-radius:3px;
  padding:4px 10px;font:600 11px/1.4 ui-sans-serif,sans-serif;letter-spacing:.09em;
  text-transform:uppercase;cursor:pointer}
#bar button:hover{border-color:#6a6050}
#bar button[aria-pressed="true"]{background:#2e2718;border-color:var(--line);color:#f0e6cd}
#bar .tag{color:#6f6758;font-size:11px;letter-spacing:.06em}
/* THE CONTROLS LIVE IN THE BAR, WHICH IS OUTSIDE THE BOARD, and that is the whole reason they
   are allowed to exist here at all. The canvas stays 1400 x 1200 with nothing in it that is not
   the board, `body.full` already hides the bar, so a full-screen look at the result has no
   sliders in it. v1's docstring is right that a board whose geometry can be nudged is a board
   nobody can write a game against -- this is a fork for finding two numbers, not the board. */
#bar input[type=range]{width:96px;accent-color:var(--line);background:transparent;cursor:pointer;
  height:18px;margin:0}
#bar .val{color:var(--ink);font-size:11px;min-width:20px;text-align:right;
  font-variant-numeric:tabular-nums}
#bar .chk{display:flex;align-items:center;gap:5px;color:#6f6758;font-size:11px;
  letter-spacing:.06em;cursor:pointer}
#bar .chk input{accent-color:var(--line);width:13px;height:13px;margin:0;cursor:pointer}
#bar .sp{flex:1}
#note{padding:6px 12px;color:#9a8f77;font-size:11px;background:#15130f;
  border-bottom:1px solid #26231e}
#note:empty{display:none}

/* ---- the stage ------------------------------------------------------------------------- */
#wrap{display:flex;justify-content:center;padding:14px}
/* FULL SCREEN takes the chrome away and gives the padding back. Nothing here tells fit() what
   changed: it reads the toolbar's height and the stage's padding off the page every time, so
   hiding one and zeroing the other is enough and the scale follows. */
body.full #bar,body.full #note{display:none}
body.full #wrap{padding:0;align-items:center;min-height:100vh}
body.full{background:#000}
#fit{transform-origin:top left}
/* THE CANVAS IS THE CLIP'S OWN BLACK, NOT #000, AND THAT IS THE WHOLE REASON IT IS NOT #000.
   The open-duty film is drawn on a near-black that is not zero -- measured off the rendered page
   at rgb(4, 6, 8), steady to within one level across the loop -- and `screen` only disappears
   TRUE black. Screened over a pure black board that pedestal survives untouched, so every open
   tile wore a cool dark rectangle: not the border, which is transparent in the default view, but
   the clip's own ground showing where the board's was darker.
   SO THE BOARD MOVED TO MEET THE FILM rather than the film being crushed to meet the board.
   Crushing it is a filter on every frame of eight videos to delete four levels, and it would
   take the smoke's own darkest values with it; this is one declaration and it costs nothing.
   It has to STAY in step with the clip: the number is recorded in attribution.json under the
   clip's `measured`, and tests/action_board/test_action_board_v2_grid.py holds the two together.
   See --film-black. */
#board{position:relative;background:var(--film-black);overflow:hidden}
/* DIRECT CHILDREN ONLY. `#board *` made every descendant absolute, which quietly killed the
   text flow inside the placeholders -- a card with no picture drew its action name and "no
   picture yet" on top of each other. Anything nested that needs placing says so itself. */
#board > *{position:absolute}

/* Upper text box. One line, centred in its own box, so nothing is clipped at any size.

   BLACK, AND IT IS THE ONLY BLACK TYPE ON THE BOARD. Everything else here is cream on dark,
   because everything else sits on the board's own ground. This line does not: the backdrop
   reaches the top of the canvas, so these words are on painted SKY -- a flat mist at luminance
   144, the lightest surface on the board by a long way. Cream on it was 2.2:1 against the 4.5
   ordinary text is held to; black is 6.6:1.

   AND THE SHADOW WENT WITH THE CREAM. It was two dark rings holding light type off a light sky,
   which is a correction for a contrast that no longer exists -- a dark glow behind dark letters
   buys nothing and softens the edge it sits on. What has NOT come back is a plate: a dark box
   behind the words would be the black strip across the top of the picture that extending the
   picture removed, put back in the one place it was removed from.

   THE PAIRING IS MEASURED, NOT ASSUMED. The guard reads this colour out of the stylesheet and
   the sky out of the shipped backdrop file, so a darker picture arriving under black type fails
   rather than quietly disappearing. */
/* BOLD, AND THE WEIGHT LIVES HERE WHILE THE SIZE LIVES IN geometry.py. That split is not
   arbitrary: the SIZE has to fit the box, and check() holds it against STATUS["height"], so it
   is a number with a constraint on it. The weight has no constraint -- a line box comes from the
   family's ascent and descent, which bold does not change -- so it is a style fact and belongs
   in the stylesheet with the colour and the family. */
/* WHITE, AND THAT IS NOT A PREFERENCE. The black was right for as long as this line sat on the
   backdrop -- a pale misty valley, which black reads on and white does not. v2 draws no
   backdrop, so the line is on the canvas's own near-black and the old colour would have been
   invisible rather than merely wrong. The two changes travel together. */
#status{display:grid;place-items:center;text-align:center;
  font-family:Georgia,serif;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden}


/* The cross-highlight: hovering a wheel face lights its tile and the other way round. One class,
   set from one place, so the two directions cannot drift apart.

   IT CARRIES THE PLATE, AND THAT IS NOW ALL IT CARRIES. lightFace() already answers "which duty
   is the pointer on" from either end, so hovering a wheel face lights its tile without a second
   listener -- which would be the two-places-one-fact fault this class was made to avoid.

   THE LIFT IS GONE, and with it three pieces of machinery that existed only to make it safe.
   A hovered tile rose 6px, a selected tile stayed up at the same height, an ::after refilled
   the strip the rising tile vacated so a pointer resting on its bottom edge did not set off an
   un-hover / drop / re-hover shudder, and a reduced-motion rule turned the transition off. All
   four were correct, and all four were answers to a question the board no longer asks.

   WHICH LEAVES COLOUR DOING THE WHOLE JOB. Hover is the plate, selection is the plate and the
   gold rim, and nothing on the ribbon moves at any time. That is a weaker hover than movement
   was -- motion is the loudest signal there is and it is the one thing that cannot be mistaken
   for a state -- but it is the quieter board, and the eight tiles now hold a fixed line. There
   is also a real gain hidden in it: a tile that never moves cannot slide out from under the
   pointer, so the hit-testing problem the ::after was patching cannot occur at all.

   NOTHING BELOW CARED EITHER WAY. The lift was a transform, so the road, the cards and the
   wheel never felt it; removing it frees no space and closes none. The 16 above the ribbon that
   the tile used to rise into is simply air again. */

/* THE PLACEHOLDER IS A DISC; THE REAL SEAL IS NOT. The wax seals are drawn with a scalloped,
   irregular rim, so the container's own circle would show through at every bay of it and the
   round crop would shear the peaks off. Once a picture lands the container stops drawing -- the
   same correction the Tithe's three resources needed before they left the board, and the one
   tokens/README.md warns about. */
.seal{position:absolute;border-radius:50%;background:radial-gradient(70% 70% at 36% 30%,#6e2d26,#3d1512);
  border:1px solid #1f0b09;display:grid;place-items:center;cursor:pointer}
/* THE EMPTY SLOT IS DRAWN THE SIZE THE SEAL WILL BE, not the size of its box. Every disc on this
   board fills 0.906 of its own square -- geometry.py owns that figure and a test holds the files
   to it -- so a placeholder filling the whole box promises a seal bigger than any that can land
   in it, on twelve slots at once. The scale comes from GEO; it is not typed here. */
.seal.empty{background:#141210;border:1px dashed #3a352c;transform:scale(var(--solid))}
/* THE MARK'S EDGE, chosen in the icon lab: dashed, in the guides' own colour, 2 px. It sits
   inside the mark's box -- everything here is border-box -- so the drawing gives up 2 px each
   side rather than growing past where geometry.py placed it. */
/* NO FRAME, AND NO GROUND. These are cut-outs now -- the emblem with its painted black field
   knocked out -- so the dashed edge that used to draw the SLOT has nothing to enclose, and a
   plate behind a cut-out would be the only square left on a tile that is otherwise glass over a
   landscape. Both are gone, and the mark is the drawing and nothing else. */
.seal.filled{background:none;border:0}
/* AND SOLID UNDER THE POINTER. The dashes close up and NOTHING else changes -- same colour, same
   2 px, same box -- so the mark does not move or recolour, it just firms up. That restraint is
   the point: the border is already carrying the resting state, and a hover that also changed the
   width would shift the artwork inside it by a pixel, because this is a border-box.

   THE ICON LAB DOES NOT GET ONE: its marks are a sizing preview and are not clickable, so a
   hover state there would be an interaction that page does not have. (It said "nor the Tithe's
   three resources" too, until those left the board.) */
/* AND THE CHOSEN MARK STAYS SOLID, by the same rule rather than a second one -- the pattern the
   tiles use for hover and selection, for the same reason: one declaration cannot drift from
   itself. The pointer and the choice say the same thing here, which is right, because a mark
   under the pointer is what the chosen one would look like if you pressed it.

   An EMPTY slot is unaffected, as it is by the hover: there is no icon to firm up. */
/* LIT RATHER THAN FRAMED, by the same rule the controls column uses. The frame used to carry
   both states -- dashed at rest, solid under the pointer and when chosen -- and with it gone the
   mark needs another way to answer. Brightness is what the three controls already do, so the
   board has one way of saying "this one", not two.

   SAME NUMBERS AS .mark, deliberately: .88 at rest and 1.12 lit. A mark and a control are the
   same size and the same artwork now, and they should respond the same amount.

   HOVER AND CHOSEN LOOK ALIKE, which is right here and was right before: a mark under the
   pointer is what the chosen one would look like if you pressed it. The tile's own plate and
   gold rim are what say which duty is selected; this says which action within it. (It read
   "lift and gradient" until the lift was taken off the ribbon.) */
/* AND THE TITHE RESOURCE ANSWERS THE SAME AMOUNT, by joining these rules rather than copying
   them. It is the same 50px of the same artwork sitting on the same frame, and it is now chosen
   the same way -- so a board where the resource dimmed or lit by a different fraction would be
   saying there are two kinds of choosable mark when there is one. */
/* THE SAME REST WEIGHT FOR EVERY 50px MARK ON THE BOARD, chosen and unchoosable alike, so one
   frame holding two duty marks and a resource reads as one object. */
.seal.filled, .tmark.filled, .tslot.filled{filter:brightness(.88);transition:filter .12s ease}
/* BUT ONLY THE CHOOSABLE ONES BRIGHTEN. A tile's resource is a label and never lights under the
   pointer; it has no state to enter, and a label that responds to hover is a button that does
   nothing when pressed. */
.seal.filled:hover, .seal.filled.on,
.tslot.filled:hover, .tslot.filled.on{filter:brightness(1.12)}
@media (prefers-reduced-motion:reduce){
  .seal.filled, .tmark.filled, .tslot.filled{transition:none}}
.seal img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block}
.seal.filled img{border-radius:0;object-fit:contain}
/* A CUT-OUT BRINGS NO GROUND, so the board gives it one. A wax disc is a thing you could pick up
   and it carries its own; an emblem drawn on transparency does not, and on the tile's black it
   floats with nothing behind it. Which a seal is, is recorded in attribution.json and arrives
   here as one word -- the page does not look at the picture. The corner is square on purpose:
   these are plates, not discs, and the 4px is only to stop the colour cutting a hard rectangle
   out of the tile. THE TILE NOW CARRIES THE SAME PURPLE, so this rule draws nothing you can see
   on today's board -- it is kept because it is what makes the mark right if the tile's colour
   ever moves away from the plate's. */
/* THE PLATE PAINTS NOTHING NOW. attribution.json still records which marks are cut-outs and
   which carry their own ground, and the page still carries the word through -- that is a fact
   about the artwork and worth keeping. What changed is what the board does with it: a ground
   behind a cut-out was right when the mark sat in a framed slot on a flat tile, and is wrong now
   that the tile is glass over a valley and the mark has no frame. The rule is kept, emptied, so
   that the day a mark needs a ground again there is one place to put it. */
.seal.plate{background:none}




/* ---- the two action cards -------------------------------------------------------------- */
/* ISOLATED, AND THAT IS A FIX RATHER THAN A TIDY-UP. The `lift` overlay below is
   mix-blend-mode:screen, and a blended element blends with its nearest STACKING CONTEXT's
   backdrop -- not with its parent. `.art` is position:absolute with z-index:auto, which does not
   make one, so each card's overlay was blending against everything painted beneath it across the
   whole board: the backdrop picture, the road, the ribbon.
   TWO CONSEQUENCES, one of them visible. The effect is meant to lift the flames in THIS card's
   own picture, and it was reaching outside the card to do it. And a blending group that spans the
   board has to be rasterised together, so anything that changes compositing elsewhere -- a tile
   taking its hover transform, a mark animating its filter -- invalidates it, and the two cards
   flash while it is rebuilt. Two cards, side by side: a black rectangle on each side of the row.
   `isolation:isolate` makes each card its own stacking context, so the blend sees its own picture
   and nothing else, and the group cannot be disturbed by anything outside the card. */
.art{overflow:hidden;background:#000;cursor:pointer;isolation:isolate}
.art img{width:100%;height:100%;object-fit:cover;display:block}
/* THE NAME ONLY, AND NO SCRIM BEHIND IT.
   The effect line used to live along the bottom of the picture and moved into the upper text box,
   which halved the scrim count and handed the bottom of every card back -- the corner the briefs
   reserve for the close dark foreground element. The second scrim has now gone the same way: the
   briefs reserve the TOP of every action image for quiet dark ground too, so a gradient there was
   darkening a corner that is already dark and flattening the top of fourteen pictures to buy one
   word its contrast. The halo below buys it on the glyphs instead. If a picture ever fights the
   name, fix the picture. */
.art .nm{position:absolute;left:0;right:0;top:0;font-family:Georgia,serif;font-weight:600;
  letter-spacing:.11em;text-transform:uppercase;color:var(--ink);
  /* THE DARK IS ON THE LETTERS, NOT OVER THE PICTURE. Three stacked shadows: a tight one that
     separates the stroke from whatever it lands on, a wider soft one that carries the separation
     past the serifs, and a short drop that keeps the word sitting on the image rather than
     floating above it. Measured over the lit window on the Devotion card, which is the worst
     ground the board has: against a glyph mask taken from the page itself, the ring of pixels
     within 3px of a letter goes from a mean luminance of 0.264 to 0.124, which is 2.85:1 against
     the ink becoming 5.15:1. A wider, heavier stack reaches 5.69:1 and starts to read as a smudge
     behind the word, which is the scrim coming back by another route. */
  text-shadow:0 0 3px #000, 0 0 3px #000, 0 1px 2px #000}
.art .ph{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:14px;color:#5d5648;
  font:400 12px/1.6 Georgia,serif;letter-spacing:.07em;
  background:radial-gradient(70% 70% at 50% 45%,#141210,#000 82%)}
.art .ph span{display:block}
.art .ph b{display:block;font:600 15px/1.4 Georgia,serif;color:#857c67;letter-spacing:.1em;
  text-transform:uppercase;margin-bottom:4px}
/* THE HOVER LIFT IS A SCREEN OVERLAY, NOT filter: brightness(). Measured on these cards,
   brightness(1.08) moves the shadows -- where 85% of the picture and all the hatching live --
   by 0.4 L*, which nobody can see, while moving the flames by 4.6 and taking the blown-out area
   from 0.119% to 1.090% of the card. Screen at 4% does the opposite: +3.2 L* in the shadows,
   +0.5 in the flames, and it cannot clip, because screen only reaches white where the pixel
   already is. It also leaves the flames alone for the animation to have later. */
.art .lift{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .14s ease;
  background:#ffd696;mix-blend-mode:screen}
.art:hover .lift{opacity:.04}
/* CHOSEN, AND THE TITHE BOX SAYS IT THE SAME WAY. These are the three things the action row
   offers -- this duty's first action, its second, and taking the tithe instead -- so one choice
   among them should look like one kind of answer. The Tithe box said nothing at all until now:
   it has been clickable since it was drawn and the only sign it had been pressed was the commit
   mark appearing in the column. A resource that selects it makes that silence much louder, so
   the box joins the declaration rather than getting an outline of its own that matches. */
.art.sel, .panel.sel{outline:2px solid var(--line);outline-offset:-1px}

/* ---- buttons and the right-hand column -------------------------------------------------- */
.btn{display:grid;place-items:center;border-radius:4px;cursor:pointer;
  font-family:Georgia,serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
  text-align:center;line-height:1.35}
.btn.primary{background:#2e2718;border:1px solid var(--line);color:#ecdfc0}
.btn.primary:hover{background:#3a301d}
/* THE CONTROLS COLUMN. Three marks at the working edge -- Map, Hire Building, commit -- and no
   frame around any of them, which is what was asked for and is also the one thing that keeps them
   from being misread. A mark on a duty tile wears a dashed border because it is a thing you CHOOSE,
   and the border is the slot it would sit in; these are things you PRESS. Giving them the same
   edge would say they were the same kind of object and put three more selectable-looking squares
   on a board whose whole grammar is select-then-confirm.
   So the artwork is the control. Under the pointer it brightens and nothing moves -- the same
   restraint as the tile marks' hover, for the same reason: these are border-box squares at
   geometry's own rect, and a hover that changed the box would shift the drawing inside it. */
.mark{position:absolute;display:grid;place-items:center;cursor:pointer;
  color:var(--ink);font:700 15px/1 ui-monospace,monospace;
  filter:brightness(.88);transition:filter .12s ease}
.mark:hover{filter:brightness(1.12)}
/* THE GROUND UNDER THE CONTROLS, AND IT IS THE DUTY FRAME'S.
   Each mark used to carry its own, drawn as a ::before at a negative inset. At the box's own 65
   that ground would be 77 tall against a 71 line pitch and three of them would overlap, so the
   column is ONE rectangle holding three marks -- which is also what the Take Tithe box beside it
   is, and the two now read as a pair.

   IT WAS .panel's #0e0d0b AND THE REASON FOR THAT HAD EXPIRED. The note here used to argue
   against the duty tile's plate on the grounds that a tile is GLASS, 55% of --plate over the
   picture behind it, and that with no picture behind this row the same treatment comes out "very
   nearly invisible". True when written; v2 draws NO BACKDROP, so the duty frames are themselves
   55% over #board's black and whatever is true of one is true of the other.

   THE OTHER OBJECTION STILL STANDS, which is why only the ground is shared. A duty frame also
   means "selectable, takes the gold rim when chosen", and Show Map and Hire Building are never
   chosen. So this keeps its own border and radius and gains no selected state. */
.cbox{position:absolute;border:1px solid #46413a;border-radius:5px;
  background:var(--plate-ground)}
/* A STAND-IN LOOKS LIKE ONE. A control with no cut filed yet borrows Allocation's mark, and the
   whole reason that is better than drawing nothing is that a wrong emblem is visibly wrong --
   which only holds if it does not look as settled as the two beside it. Half-lit says provisional
   without inventing a second treatment, and it goes away by itself the moment a cut is filed. */
.mark.stand-in{filter:brightness(.55)}
.mark.stand-in:hover{filter:brightness(.75)}
/* NOTHING CHOSEN, NOTHING TO COMMIT. The three Confirm buttons this column replaced were drawn
   `display:none` until their own slot was selected, and the commit mark inherits that rule: it is
   the same control, so it appears at the same moment. Map and Hire are standing offers and are
   always there.
   display, NOT visibility: the mark should not be a dark square the pointer can find. The column
   is absolutely positioned at geometry's own slots, so the two above it do not move to fill the
   gap -- which is right, since they would otherwise shift under the pointer every time a duty was
   chosen. */
.mark.off{display:none}
.mark img{width:100%;height:100%;object-fit:contain;display:block}
@media (prefers-reduced-motion:reduce){.mark{transition:none}}
.panel{border:1px solid #46413a;border-radius:5px;background:#0e0d0b}
/* NO .panel.eligible RULE. The box wore the same wash for a round and it has been taken back
   out: a box with nothing in it already writes "no tithe available" across its own middle, so
   the light was the board saying one thing twice on one object. The rectangles keep it because
   they have nowhere to write a sentence -- a duty tile is figures and icons and no room. */
.panel .lb{position:absolute;left:0;right:0;text-align:center;font-family:Georgia,serif;font-weight:600;
  letter-spacing:.16em;text-transform:uppercase;color:var(--ink)}
/* Take Tithe stands in a row with the two action names, so it is tracked like them rather than
   like the City's label below it. The City keeps the panel tracking above. */
#tithe .lb{letter-spacing:.11em}
/* THE .tok RULES ARE GONE WITH THE THREE RESOURCES. They described a grey disc with a rim, a
   letter fallback inside it, and a `.filled` override that took both off the moment a picture
   landed -- a correction tokens/README.md warns about, because each PNG paints its own rim and a
   container with a second one gives every token two. None of that has anything to draw: the
   Tithe holds a label. Kept out rather than left behind, so that `tok` cannot come back meaning
   something else. */
.pawn{position:absolute;display:grid;place-items:center}
.pawn svg{width:100%;height:100%;display:block;overflow:visible}
.pawn .n{position:absolute;font:700 17px/1 Georgia,serif;color:#1b1a16;text-shadow:0 1px 0 #ffffff40}

/* ---- the duty grid ---------------------------------------------------------------------- */
/* NINE RECTANGLES WHERE THE WHEEL WAS, carrying the wheel's own three states.
   A face was a filled shape and could be brightened; a cell is an OUTLINE, and there is nothing
   inside it to brighten. So hover and selection are carried by the border and the ground
   instead -- the same two states, said in the only language this object has. */
.dcell{position:absolute;border:2px solid #6a6252;border-radius:3px;background:#14120f;
  cursor:pointer;display:grid;place-items:start stretch;overflow:hidden;
  transition:border-color .12s ease,background .12s ease}
/* THE NAME SITS AT THE TOP, NOT IN THE MIDDLE, and the acolytes are why. They stand along the
   bottom of the rectangle they occupy, and a centred name put four pawns straight through the
   middle of the word -- ALLOCATION unreadable behind three figures on the first build. The
   wheel never had this problem because its labels were in the drawing and the figures ringed
   the outside of it. A rectangle has an inside, and now two things want to be in it. */
.dcell.lit{border-color:#9d9079;background:#1b1813}
/* SELECTION IS A SECOND STATE, NOT THE SAME ONE. The tile has carried `sel` since there was a
   board, and the wheel's faces were given it for the same reason: without a second state,
   hovering one duty while another is selected shows two identical highlights and no way to tell
   which is which. Lit is the hover; selected is lit plus the gold this board uses everywhere
   else to say "this one is chosen". */
.dcell.sel{border-color:var(--line);background:#231d12}
/* THE CENTRE IS THE CITY, AND IT IS NOT A DUTY. It stood dashed and nameless while it stood for
   nothing; it is where the City panel went when the bottom right of the board was cleared, so it
   is solid now -- a dashed box under a title that says City would be the drawing contradicting
   the word.
   STILL NOT A NINTH CHOICE, THOUGH. It takes no pointer, carries no icons and never takes `lit`
   or `sel`, so the eight things you can pick stay eight. What separates it from its neighbours
   is the ground and the missing plate rather than a broken rule. The border colour is the City
   panel's own #46413a, carried over from the box this replaces. */
.dcell.centre{cursor:default;border-color:#46413a;background:#100f0d}
/* THE FRAME OFF, TO SEE WHAT THE BOARD LOOKS LIKE WITHOUT IT. Three edges and the ground go; the
   BOTTOM EDGE STAYS, because the acolytes stand on it -- their feet are 6px above the inner
   bottom edge, so that line is the floor of the drawing and not part of the frame around it.
   TRANSPARENT, NOT ABSENT. `border:none` would give the cell back 4px of width and 4px of
   height, and everything inside is placed against the PADDING box -- so the plate, the parchment
   and the whole figure row would shift two pixels and the one thing this checkbox must not do is
   change the arrangement it was added to look at. Colour is the only thing that moves.
   AND IT COMES LAST ON PURPOSE. `.lit` and `.sel` set `border-color` as a shorthand, so this
   rule overriding three of the four leaves the BOTTOM edge carrying the state -- hover and
   selection still read, in the only language a bare cell has left. */
.dcell.bare{background:transparent;border-top-color:transparent;
  border-left-color:transparent;border-right-color:transparent}
/* YOUR ACOLYTES ARE ON THIS TILE, WHICH IS WHAT BOTH FILMS MARK.
   A TWELVE-SECOND FILM OF SMOKE RISING OFF THE LINE THE ACOLYTES STAND ON, which is the reason
   the tile is marked at all -- the light comes off your own people rather than being painted on
   from nowhere. Eight tiles, eight places in one loop; the stagger is the generator's.
   THE SHOWING IS ON THE VIDEO AND NOT ON THE RECTANGLE, because there is more than one film and
   a stylesheet cannot know which phase the board is in. Each tile carries one video per phase
   that HAS a film and markStanding turns exactly one of them on, so the class says the whole
   fact -- this film, on this tile, now -- rather than half of it.
   `lighten` IS WHAT MAKES IT A GLOW RATHER THAN A PATCH, and it is not the obvious choice. The
   clip has no alpha channel and needs none, so the blend has to do the work of one -- and the
   first attempt was `screen`, on the reasoning that screening black is a no-op. It is, for TRUE
   black. The clip is drawn on rgb(4, 6, 8), which is not that, and screen left those four levels
   standing: every open tile wore a cool dark rectangle. Setting the board to the same value made
   it worse rather than better, because screen COMBINES -- (4,6,8) over (4,6,8) is (8,12,16), the
   same gap again. `lighten` takes the greater of the two instead, so a clip pixel at or below
   the board's own ground is exactly the board's own ground, and only what is brighter than it
   shows. That is what makes the rectangle vanish, and it needs --film-black to be what the clip
   is drawn on. The pair is the mechanism; neither half works alone.
   NO ISOLATION ANYWHERE ABOVE IT. An isolated group blends against a transparent backdrop, where
   `lighten` returns the source unchanged and the clip's ground paints a solid rectangle over the
   board -- the same failure screen had there. `.dcell` must stay a non-stacking context for this
   to read, which is why nothing here sets z-index or isolation.
   COVER, FROM THE FLOOR UP. The clip is 192 x 128 and the rectangle runs from 98px to 245px tall
   as the height slider moves, so it is scaled to fill and anchored to the bottom: the plume
   always stands on the line, and what a short tile loses is the thin top of it. `.dcell` is
   `overflow:hidden`, so this is clipped to the padding box and never paints over the gold floor
   line or the rectangle's edges.
   AND IT IS AN ELEMENT, NOT A BACKGROUND, which quietly retires a trap. The wash this replaces
   had to be declared after `.dcell.bare` because bare sets `background` and is the view the board
   opens in, and had to carry `no-repeat` because a background's origin is the padding box while
   its clip is the border box -- which drew the gradient's strong end as a hard line along every
   open tile's top edge. A child element has neither problem.
   NOTHING IS DIMMED. A shut tile is the board as it has always looked and the whole cue is what
   is ADDED to a marked one; see markStanding for why that direction and not the other. */
.smoke{position:absolute;left:0;top:0;width:100%;height:100%;
  object-fit:cover;object-position:bottom;mix-blend-mode:lighten;
  pointer-events:none;display:none}
.smoke.on{display:block}
/* THE ICONS GET THEIR TILE BACK. On the ribbon each duty's marks stood on a rounded plate --
   .tile, one pixel of #2a2721 round --plate at --tile-alpha -- and losing the ribbon lost that
   ground, leaving cut-out emblems floating on the rectangle. This is the same declaration, not
   a colour matched by eye. The .tile rules it was copied from have gone with the ribbon, so
   this is now the only place on this board that says what a plate looks like.

   IT WILL READ DARKER THAN IT DID, AND THAT IS NOT A MISTAKE. --tile-alpha is 55%, because a
   tile was GLASS over the backdrop valley and the valley came through it. v2 draws no backdrop,
   so the same 55% now sits over the cell's own near-black and settles about four levels above
   it rather than catching a lit sky. Same colour, different thing behind it. If it wants to be
   more present the honest fix is a higher alpha HERE, not a second hard-coded slate. */
.iplate{position:absolute;border:1px solid var(--plate-edge);pointer-events:none;
  background:var(--plate-ground)}
/* NO .tframe RULE ANY MORE. The resource had a frame of its own beside the duty's for a round
   and it carried no declaration even then -- same ground, same border, same corner, because two
   frames that looked different would have said the board has two kinds of frame. There is one
   frame now and the resource sits at the end of it, so the class has gone with the element. */
/* THE MARK IS NOT A .seal, for machinery reasons rather than visual ones -- see drawGrid. It is
   CHOOSABLE like a seal and it is not EDITABLE like one: the art machinery finds every replaceable
   picture by `#board .seal`, and a resource is cut in the icon lab and filed in the tree rather
   than dropped onto the board. Same geometry, same response, none of the file handling.
   IT TAKES THE POINTER EXPLICITLY, because the frame it sits in does not: `.iplate` is
   `pointer-events:none` so that a plate hanging below a rectangle cannot swallow clicks meant
   for the board, and a child of it has to opt back in. The seals do the same thing one line at
   a time in drawGrid; this says it once, where the rest of the mark is described. */
.tmark{position:absolute;pointer-events:none}
/* FED, which is the box pointing back at the board. Hovering a resource in the Take Tithe box
   brightens the resource on every tile feeding it -- a cornucopia tile among them, for any
   resource, which is the wildcard explaining itself. Brightness rather than a border because
   `bare` is the state the board opens in and there are no borders to light. */
.tmark.filled.feeds{filter:brightness(1.12)}
/* A RESOURCE IN THE TAKE TITHE BOX, which IS a choice and answers like every other one. */
.tslot{position:absolute;pointer-events:auto;cursor:pointer}
.tslot img{width:100%;height:100%;object-fit:contain;display:block}
.tslot.empty{border:1px dashed #46413a;border-radius:3px}
/* AND THE BOX WITH NOTHING IN IT SAYS SO. A seat with no figures on any tile that offers a
   resource has no tithe to take, and an empty box is indistinguishable from one still loading. */
.tslot.none{text-align:center;color:var(--dim);font-size:12px;letter-spacing:.06em;
  pointer-events:none}
.tmark img{width:100%;height:100%;object-fit:contain;display:block}
/* AN EMPTY FRAME SAYS SO. A resource whose cut is not on disk draws the frame with a faint
   outline in it rather than nothing: a frame with a hole in it is visibly unfinished, where a
   frame that is simply absent is indistinguishable from Taxation's correct emptiness. */
.tmark.empty{border:1px dashed #46413a;border-radius:3px}
/* NO TITLE RULES. A rectangle carries no name at all now -- not a parchment and not a word -- so
   the only thing inside it is its people, and the only thing beside it is its icons. */
.fig{position:absolute;pointer-events:none}
.fig svg{width:100%;height:100%;display:block;overflow:visible}

/* EDIT MODE is a mode, and it says so. In play the board must not look editable; while images
   are being replaced every slot that can take one is outlined, so there is no guessing. */
body.editing .art,body.editing .seal{outline:1px dashed #6f6350;cursor:copy}
body.editing .art.drop,body.editing .seal.drop{outline:2px solid var(--line)}
</style>

<div id=bar>
  <span class=tag>phase</span>
  <span id=phases></span>
  <span class=sp></span>
  <button id=bSound aria-pressed="true" title="interface sounds">sound</button>
  <button id=bEdit aria-pressed="false" title="click a slot to replace its picture; drop a file on one at any time">images</button>
  <button id=bSave>save</button>
  <span class=tag>gap</span>
  <input type=range id=rGap min=0 max=150 step=1 title="the gap between rectangles, both ways">
  <span class=val id=vGap></span>
  <span class=tag>edge</span>
  <input type=range id=rDisp min=0 max=150 step=1
         title="top up, bottom down, left left, right right -- all by the same amount">
  <span class=val id=vDisp></span>
  <span class=tag>size</span>
  <input type=range id=rSize min=40 max=160 step=1
         title="the size of the nine rectangles, as a percentage of what fits">
  <span class=val id=vSize></span>
  <span class=tag>height</span>
  <input type=range id=rHeight min=100 max=250 step=1
         title="taller rectangles, as a percentage of the 2:1 height; they grow UPWARD, so the line the acolytes stand on does not move">
  <span class=val id=vHeight></span>
  <label class=chk><input type=checkbox id=cBare
         title="hide the rectangles' top, left and right edges and their ground; the bottom edge the acolytes stand on stays"> bare</label>
  <span class=tag>seat</span>
  <select id=rSeat title="whose board this is: the Take Tithe box shows the resources THIS seat's figures are standing on. Demo state -- there is no turn order in v2"></select>
  <span class=tag id=gridTag
        title="one rectangle, then the nine together -- what the sliders cost and what they come to"></span>
  <span class=tag>f &nbsp;full screen</span>
  <span class=tag id=buildTag></span>
</div>
<div id=note></div>
<div id=wrap><div id=fit><div id=board></div></div></div>

<script>
// =================================================================================================
// THE NUMBERS COME FROM geometry.py AND ARE NOT RESTATED HERE.
var GEO    = __GEOMETRY__;
var DUTIES = __DUTIES__;
var CONTROLS = __CONTROLS__;
var IMAGES = __IMAGES__;
var SAVE   = __SAVEKEYS__;
var BUILD  = __BUILD__;
// NO WHEEL DRAWING IN v2. Nine rectangles stand where it stood, so the 59 KB of borrowed
// markup is not inlined and geometry.WHEEL_ASSET is never read. What arrives instead is the
// two numbers the sliders start at, so the defaults live in the generator with every other
// default rather than being typed into the markup.
var GRID = __GRID__;
var HOOD = __HOOD__;

var board = document.getElementById("board");

// TAKING THE TITHE IS A CHOICE ON THE SAME FOOTING AS AN ACTION, and `S.slot` has held it since
// the Take Tithe box was first wired -- as a bare string, written out wherever it was needed.
// There were two such places and it was survivable; a clickable resource makes five, across the
// panel, the mark, the picker and both halves of render(), and a misspelling in any one of them
// is a click that selects nothing while every other route still works. It is a name now.
var TITHE_SLOT = "tithe";

// WHICH RESOURCES EXIST AND WHICH OF THEM IS THE WILDCARD, from the generator rather than typed
// here. The page needs the ORDER to list a pool the same way every time and the WILD one to know
// what unions the rest in; both are facts about the tree's resources, and the tree is what the
// generator walks. Written out here they would be a second list to keep in step with TITHE_KEYS.
var TITHE = __TITHE__;

// WHAT A MARKED TILE WEARS IN EACH PHASE, AND WHEN EACH TILE STARTS WEARING IT.
//
// `byPhase` maps a phase key to a clip as a data URI, `loop` is how long they all run, and
// `offsets` gives one start time per duty slug. All of it is the generator's: the clips because
// it gates every asset on the attribution record, and the offsets because eight numbers that
// look arbitrary are exactly the kind of thing that gets copied wrong. The generator derives
// them from a rule and refuses to build a clip that does not close the loop -- see bundled_films.
//
// WHICH TILES ARE MARKED IS ONE RULE IN BOTH PHASES: the ones this seat's Acolytes stand on.
// WHICH FILM THEY WEAR IS THE PHASE. In Action Selection that set is where you may ACT, and in
// Sowing it is where your people are STANDING before you move them -- one set, two questions,
// so the clips differ rather than the set doing the talking. See markStanding.
//
// A PHASE WITH NO ENTRY HERE SIMPLY HAS NO FILM, and nothing is drawn for it; `ready` is in that
// position today, as is any phase whose clip the generator refused. There is no gradient
// underneath to fall back to: a path that only runs when an asset is missing is a path nobody
// ever looks at, and this board has removed three of those already.
var FILMS = __FILMS__;

// WHEN THE PAGE STARTED, so a tile that becomes marked later joins the others IN STEP rather than
// starting its own clock. The whole point of the stagger is that the eight are at different
// places in one loop; eight clips each started whenever its tile happened to light up would be
// eight unrelated films, and on a board where the marked set changes with the seat picker that
// is the normal case rather than an edge one.
//
// AND IT IS SHARED ACROSS THE FILMS, not one clock each. Both clips run the same twelve seconds
// from the same eight offsets, so changing phase swaps which film a tile is showing WITHOUT
// moving it in the loop -- the ring stays in the arrangement it was in.
var FILM_T0 = Date.now() / 1000;
function filmAt(slug){
  var span = FILMS.loop || 0;
  if (!span) return 0;
  var since = (Date.now() / 1000) - FILM_T0;
  return (((FILMS.offsets && FILMS.offsets[slug]) || 0) + since) % span;
}

var S = {
  phase: GEO.livePhase,
  duty: GEO.duties[0].slug,
  slot: null,                       // the chosen action, or TITHE_SLOT; set below, not here
  // THE OTHER HALF OF A TITHE. `slot` says you are taking one; this says which resource, and the
  // commit waits for it. Null while an action is chosen, and put down by select() when one is.
  tithe: null,
  // WHOSE BOARD THIS IS. Demo state -- see V2_SEAT.
  seat: null,
  editing: false,
  // WHO STANDS WHERE. Seeded from geometry so a fresh page opens on the crowded state the lab
  // opens on, which is the one worth looking at -- an empty wheel tells you nothing about
  // whether the acolytes crowd.
  occupancy: {},
  city: Object.assign({}, GEO.start.city)
};
// AND THE BOARD OPENS BY THE RULE A CLICK USES, rather than on a typed null that happens to be
// right. The first duty on the ribbon has two actions today, so this is null today -- and it
// stops being null on its own the day that duty has one, instead of opening on a tile whose
// single action is unchosen.
S.slot = onlySlot(S.duty);

// WHO STANDS WHERE, AND IT IS v2'S OWN FIXTURE. geometry.py gives counts for all eight duties
// but names SEATS for exactly one of them -- clerical -- so every other pile fell back to p1 and
// the board opened with seven columns of the same green. That is a fine state for a board nobody
// is judging colour on, and a useless one here: the whole reason these are the game view's
// hooded marks is that four seats have to be told apart at a glance.
//
// COUNTS AND SEATS BOTH, because naming seats alone cannot show a pile of p2 three deep when
// geometry says that duty holds two. These are demo numbers for a layout page and nothing reads
// them but this file; the moment v2 has a real game state they go.
// AND WHOSE TURN IT IS, WHICH THIS BOARD HAS NEVER NEEDED UNTIL NOW.
//
// Everything v2 draws is PUBLIC: where every seat stands, what each duty offers, which action is
// being looked at. The Take Tithe box is the first object here whose content belongs to ONE
// player -- the resources you may take are the ones your own figures are standing on, and the
// same board shows a different box to each seat. There is no turn order in v2 and no engine
// behind it, so the seat is picked in the bar.
//
// DEMO STATE, AND IT GOES THE WAY V2_SEATS GOES. When turn order arrives this is deleted and the
// seat comes from the game; nothing else in the page reads it except the pool.
var V2_SEAT = "p1";

// WHAT EACH SEAT'S POOL COMES TO UNDER V2_SEATS, worked out rather than arranged -- p1 stands on
// Clerical, Allocation and Give Alms, so wheat and stone; p2 adds Produce and Ordination, so all
// three; p3 stands on Construct, so the cornucopia unions all three in by itself; and p4 stands
// nowhere, which is the empty box. All four cases are reachable from the picker, including the
// one that is easiest to forget.
//
// AND p4 IS A POSITION THE GAME CANNOT REACH. Sowing guarantees every seat an Acolyte on at least
// one duty tile, so arriving in Action Selection with figures nowhere does not happen: there is
// no forced pass to design and no "you cannot act" state to draw. It is KEPT ANYWAY, as the
// degenerate case the guards drive -- an empty pool, no eligible duty, no commit, every cue off
// at once -- because the cheapest way to find out that a rule divides by the number of your own
// figures is to have a seat with none. IMPOSSIBLE, NOT ILLEGAL: nothing here should be read as
// the engine being allowed to produce it, and nothing should be built on top of it.

var V2_SEATS = {
  clerical:    ["p1", "p1", "p2", "p3"],
  allocation:  ["p1", "p2", "p2", "p3"],
  taxation:    ["p2", "p2", "p2", "p3"],
  give_alms:   ["p1", "p1", "p1", "p1", "p2", "p3"],
  produce:     ["p2", "p3"],
  build_roads: ["p3", "p3", "p3"],
  ordination:  ["p2", "p2"],
  construct:   ["p3"]
};
GEO.duties.forEach(function(d){
  if (V2_SEATS[d.slug]){ S.occupancy[d.slug] = V2_SEATS[d.slug].slice(); return; }
  var n = GEO.start.occupancy[d.slug] || 0;
  var seats = GEO.start.seats[d.slug];
  S.occupancy[d.slug] = [];
  for (var i = 0; i < n; i++) S.occupancy[d.slug].push(seats ? seats[i] : "p1");
});
// THE CITY IS FOUR OF EACH, which is the fullest this arrangement ever gets: four piles four
// deep is the case that decides whether the figures still read, so the board opens on it rather
// than on something comfortable.
var CITY_SEATS = ["p1", "p2", "p3", "p4"].reduce(function(a, id){
  for (var i = 0; i < 4; i++) a.push(id);
  return a;
}, []);
S.occupancy.city = CITY_SEATS;
S.seat = V2_SEAT;

function el(tag, cls, css, parent){
  var e = document.createElement(tag);
  if (cls) e.className = cls;
  if (css) for (var k in css) e.style[k] = css[k];
  (parent || board).appendChild(e);
  return e;
}
function box(o){ return {left:o.x+"px", top:o.y+"px", width:o.width+"px", height:o.height+"px"}; }
function px(n){ return n + "px"; }
function colourOf(id){
  for (var i = 0; i < GEO.players.length; i++) if (GEO.players[i].id === id) return GEO.players[i].colour;
  return "#8fae6a";
}
function dutyOf(slug){ return DUTIES[slug]; }

// THE LINE IN THE UPPER BOX, and the one place that decides it. A hover shows what the hovered
// thing does; nothing hovered shows the phase's own line. Two functions would be two answers.
var hovered = null;
// WHAT A RESOURCE IS CALLED, from the generator rather than from a capital letter put on the key
// here. The board's rule, stated where the controls are drawn: the wording comes from data.
function titheName(key){
  return (TITHE.names && TITHE.names[key]) || key;
}

function phaseLine(){
  // THE TITHE ANSWERS FOR ITSELF, because the phase line is written for the common case and the
  // common case is choosing an action. "Select a Duty Action or take Tithe" is the right line
  // while you are deciding WHICH of those to do; the moment you have decided on the tithe it is
  // describing a choice already made, and saying nothing about the one still open.
  //
  // TWO STATES, NOT THREE. A line for the empty pool was written here -- "No tithe to take" --
  // and driving the page found it unreachable: takeTithe REFUSES an empty pool, the box has no
  // slots to click when there is nothing in it, and reconcileTithe puts the whole choice down
  // when a change of seat empties it. So `S.slot === TITHE_SLOT` with nothing to take cannot
  // happen, and a seat with no tithe correctly keeps the phase line, because it has not chosen
  // anything. Removed rather than kept as reassurance: this file has carried three conditions
  // that could not fail, and each one was trusted for protection it was not giving.
  //
  // THE CHOSEN LINE NAMES THE RESOURCE, so it and the lit mark in the box agree without the
  // player having to look from one to the other.
  if (S.slot === TITHE_SLOT){
    if (!S.tithe) return "Choose a tithe resource";
    return "Confirm to take " + titheName(S.tithe);
  }
  for (var i = 0; i < GEO.phases.length; i++) if (GEO.phases[i].key === S.phase) return GEO.phases[i].line;
  return "";
}
// WHY A DUTY IS OUT OF REACH, JOINED ONTO WHAT IT DOES RATHER THAN REPLACING IT.
//
// The line a player wants over an ineligible tile answers two questions at once: what is this,
// and why can I not press it. Replacing the labels with the reason answers only the second, and
// the first is the one that makes the tile worth reading at all on a turn you cannot take it --
// you are looking at Ordination BECAUSE you are deciding where to walk next.
//
// AND IT IS THE WHOLE OF THE FEEDBACK. A refused press changes no state and makes no sound, so
// this sentence is the only thing that happens; see pickDuty.
function reasonFor(slug){
  return eligible(slug) ? "" : (GEO.lines.noAcolytes || "");
}
function say(body, why){
  if (!why) return body;
  return body ? body + "   —   " + why : why;
}
function lineFor(slug, slot){
  var d = dutyOf(slug);
  if (!d) return phaseLine();
  if (slot) return say((d[slot] && d[slot].shortLabel) || "", reasonFor(slug));
  // A whole tile covers both of its actions, so it says both. A one-action duty says one.
  var out = [];
  ["actionA","actionB"].forEach(function(k){
    if (d[k] && d[k].shortLabel) out.push(d[k].shortLabel);
  });
  return say(out.join("   ·   "), reasonFor(slug));
}
// WHAT A CONTROL IS CALLED, from the same wording the tooltip and the icon lab read.
function controlLine(name){
  var said = CONTROLS[name] || {};
  return said.name || name;
}

function setStatus(){
  var t;
  // A LINE CARRIED RATHER THAN LOOKED UP, which is how an object with no duty behind it says
  // something. The Take Tithe box is the only one -- it is not a duty and not a control, so
  // neither of the two routes below can answer for it. Set by a refused press and cleared by the
  // next crossing, like every other hover state.
  if (hovered && hovered.why) t = hovered.why;
  else if (hovered && hovered.mark) t = controlLine(hovered.mark);
  else if (hovered) t = lineFor(hovered.duty, hovered.slot);
  else t = phaseLine();
  document.getElementById("statusText").textContent = t;
}

// HOVERING A CONTROL, which is its own small state because a control has no duty to hang off.
//
// IT CLEARS THE DUTY HIGHLIGHT, through the same lightFace(null) a hover over nothing does. The
// pointer has left the wheel; leaving a tile lit while the line talks about Show Map would be two
// objects claiming the pointer at once.
function hoverMark(name){
  hovered = {mark: name};
  setStatus();
  lightFace(null);
}
function hover(duty, slot){
  // ON THE CHANGE, NOT ON THE CROSSING. mouseover bubbles and fires every time the pointer moves
  // between a tile and the mark inside it, which is the same duty twice -- so a cue fired here
  // without this test would rattle while you sat still over one tile. The duty under the pointer
  // changing is the thing that happened.
  var was = hovered ? hovered.duty : null;
  hovered = duty ? {duty: duty, slot: slot || null} : null;
  // FETCHED WHILE THE POINTER IS STILL MOVING. An action with eleven beds is 2.85 MB and takes a
  // noticeable moment to decode; asked for only on the click, the fade would start into silence.
  // Hovering a duty is the warning that a selection may be coming.
  //
  // ON THE CHANGE, NOT ON THE CROSSING -- the rule the hover CUE used to need and the prefetch
  // needs for the same reason. mouseover bubbles and fires again every time the pointer moves
  // between a tile and the mark inside it, which is the same duty twice; unguarded, a slow sweep
  // would re-ask for the same eleven buffers on every one of those.
  if (duty && duty !== was) {
    var info = dutyOf(duty);
    bedPrefetch(duty + "_" + (slot || (info && info.actions === 1 ? "actionA" : "actionB")));
  }
  setStatus();
  lightFace(duty);
}
// ONE FUNCTION FOR BOTH DIRECTIONS. Hovering a tile lights its rectangle in the grid and
// hovering a rectangle lights its tile; written twice they would disagree the first time one
// was changed. The name is the wheel's and is kept: it is the same job on a new object.
// =================================================================================================
// WHERE THIS SEAT MAY ACT, WHICH IS ONE RULE WITH TWO READERS.
//
// Both moves available in Action Selection need an Acolyte of yours standing on a duty tile. A
// duty's actions are open to you if your figures are on it; the tithe pool is drawn from the same
// tiles. So this is the one question underneath both -- "does this seat stand here" -- and the
// pool below is built on it rather than asking it again in its own words.
//
// WRITTEN TWICE THEY WOULD DISAGREE, and the disagreement would be ON SCREEN: the box offering a
// resource from a tile the board had just refused to let you act on, or the reverse. That is the
// rule drawGrid and lightFace already follow for the hover pair, applied to the thing that now
// decides what is pressable.
//
// THE TWO ARE NOT THE SAME SET, THOUGH, AND TAXATION IS WHY. It is the one duty with no resource,
// so figures there make its actions available and add nothing to the box. "You may act here" is a
// SUPERSET of "this feeds the box", which is exactly why the eligibility question has to be
// asked about the TILE and the resource looked up separately -- a pool built first and reused as
// eligibility would have quietly made Taxation unplayable.
function standsOn(seat, slug){
  return (S.occupancy[slug] || []).indexOf(seat) >= 0;
}

// WHETHER THE BOARD IS ASKING THE QUESTION AT ALL. Eligibility belongs to Action Selection: in
// Sowing these same tiles mean "where may I walk", which is a different question with a different
// answer, and marking them by where you ALREADY stand would answer the wrong one. The other two
// phases are placeholders with nothing built behind them -- the note under the bar says so -- so
// rather than guess at their rules this leaves them exactly as they were before eligibility
// existed.
function actionPhase(){ return S.phase === GEO.livePhase; }

// AND THE ANSWER THE REST OF THE PAGE ASKS FOR. Outside Action Selection every duty is open,
// which is the board's behaviour up to now and the honest state for a phase that is a label.
function eligible(slug){
  if (!actionPhase()) return true;
  return standsOn(S.seat, slug);
}

// =================================================================================================
// THE TITHE POOL: WHICH RESOURCES THIS SEAT MAY TAKE.
//
// NOT A PROPERTY OF THE SELECTED DUTY, which is what the box looked like it was for and is not.
// Taking a tithe moves nobody, so it does not matter which duty is selected when you take one --
// what matters is where your figures already are. The pool is the resources offered by every
// tile this seat stands on, and the box shows it whatever is selected.
//
// A SET, NOT A TALLY. Figures on two stone tiles and one silver give you stone and silver, not
// stone twice: you take ONE resource, so a second stone changes nothing you could choose. The
// order is the generator's own, so the box lists them the same way every time rather than in
// whatever order the duties happen to be walked.
//
// THE CORNUCOPIA UNIONS EVERYTHING IN, which is the whole of its rule in one line. It is the
// wildcard -- a figure there lets you take any resource -- so rather than appearing in the box
// as a fourth thing to choose, it puts the other three in. That also means it can never be
// chosen itself, which is right: you do not take a cornucopia, you take what it stands for.
function tithePool(seat){
  var have = {};
  GEO.duties.forEach(function(d){
    if (!standsOn(seat, d.slug)) return;
    var info = dutyOf(d.slug);
    var key = info && info.tithe != null ? info.tithe : null;
    if (key === null) return;                    // Taxation offers none, so it adds none
    if (key === TITHE.wild){
      TITHE.order.forEach(function(k){ have[k] = 1; });
      return;
    }
    have[key] = 1;
  });
  return TITHE.order.filter(function(k){ return have[k]; });
}

// ONE RESOURCE ANSWERS ITSELF, exactly as a duty holding one action does. `onlySlot` already
// settled this shape: where there is nothing to choose, choosing the thing chooses it, and the
// board does not sit waiting for a second click that has only one possible target.
function onlyTithe(){
  var pool = tithePool(S.seat);
  return pool.length === 1 ? pool[0] : null;
}

// WHICH TILES ARE FEEDING A RESOURCE, lit on the tile's own mark rather than on its border.
// The border would be the obvious place and is invisible in `bare`, which is the state the board
// opens in -- so the cue would be missing exactly when it is wanted. Brightening the resource
// itself also points at the thing rather than at the box around it, and a cornucopia tile lights
// for every resource, which is what makes the wildcard legible without a word of explanation.
function lightTithe(key){
  var feeds = {};
  if (key) GEO.duties.forEach(function(d){
    if (!standsOn(S.seat, d.slug)) return;
    var info = dutyOf(d.slug);
    var k = info && info.tithe != null ? info.tithe : null;
    if (k === key || k === TITHE.wild) feeds[d.slug] = 1;
  });
  Array.prototype.forEach.call(document.querySelectorAll("#board .tmark"), function(m){
    m.classList.toggle("feeds", !!feeds[m.dataset.duty]);
  });
}

function lightFace(slug){
  GEO.duties.forEach(function(d){
    var tile = document.getElementById("tile-" + d.slug);
    var face = document.getElementById("dcell-" + d.slug);
    var on = (slug === d.slug);
    if (tile) tile.classList.toggle("lit", on);
    if (face) face.classList.toggle("lit", on);
  });
}

// =================================================================================================
// DRAWING. Every element is placed once, from GEO, and then only its contents change.
function drawStatus(){
  var s = GEO.status;
  // THE LINE HEIGHT IS SET, NOT INHERITED. body's `font:13px/1.4` passes down a RATIO, so this
  // box was laying out at 1.4 x its own font size -- 25.2 at 18 -- while geometry held it to the
  // 22 the face needs. One of the two had to give, and it is the inherited one: geometry owns
  // the number check() measures against the box, so the page is told it rather than guessing.
  var e = el("div", null, Object.assign(box(s), {fontSize: px(s.size), lineHeight: px(s.line)}));
  e.id = "status";
  var t = el("span", null, null, e); t.id = "statusText"; t.style.position = "static";
}

// THE VALLEY, DRAWN FIRST SO EVERYTHING ELSE STANDS IN FRONT OF IT. It is the only thing on this
// board placed where other objects will cover it, so it goes in before the tiles rather than
// being pushed back with a z-index nobody can see the other end of.
//
// STRETCHED TO THE RECT, NOT COVERED INTO IT. The crop was anchored so its painted ground falls
// where the road strip falls; `cover` keeps the aspect and slides that alignment off.
// =================================================================================================
// HOVER IS DELEGATED, AND THAT IS THE WHOLE POINT.
//
// It was an enter/leave pair on each element, and it had a hole that showed on exactly one path:
// tile -> seal -> back to the same tile left the board with nothing hovered. The seals sit INSIDE
// their tiles, and those two events deliberately do not fire between a parent and its own child --
// so moving into the seal never left the tile, and moving back out of the seal fired the seal's
// leave with no matching enter on the tile behind it. The line went blank while the pointer was
// still sitting on the tile.
//
// Patching that one path would have left the same hole in every other nesting. So the pairs are
// gone. mouseover BUBBLES and fires on every crossing, parent to child included, so the state is
// recomputed from where the pointer IS rather than from a history of arrivals and departures.
//
// An element opts in with data-hover-duty, data-hover-slot or both, and the nearest ancestor
// carrying either one wins -- so a seal speaks for its action and the tile around it for its duty.
function hoverDataOf(node){
  while (node && node !== board){
    var d = node.dataset;
    if (d && (d.hoverDuty || d.hoverSlot || d.hoverMark)) return d;
    node = node.parentNode;
  }
  return null;
}
board.addEventListener("mouseover", function(ev){
  var d = hoverDataOf(ev.target);
  if (!d) return hover(null);
  // A CONTROL IS NOT A DUTY AND HAS NO SLOT, so it cannot go through the duty route at all --
  // `hover(S.duty, null)` would announce whatever duty happened to be selected, which is the
  // board saying something true about the wrong object. It carries its own name instead.
  if (d.hoverMark) return hoverMark(d.hoverMark);
  // A card carries only its slot: which duty it shows is state, not markup.
  hover(d.hoverDuty || S.duty, d.hoverSlot || null);
});
board.addEventListener("mouseleave", function(){ hover(null); });

// HOW FAR EVERYTHING UNDER THE TITLE COMES UP, AND WHY IT IS WORKED OUT RATHER THAN TYPED.
//
// geometry.py still opens the action row at y 241, because v1 draws a backdrop and eight tiles
// above it and needs that room. v2 draws neither, so the top two hundred pixels are empty and
// the cards, the Tithe and the controls would be floating in the middle of nothing.
//
// The lift closes it HERE, in the drawing, for exactly the reason the City panel is dropped
// here: geometry.py is shared with v1, and moving the row in it would move the row on a board
// that still has a ribbon over it. So v2 keeps geometry's numbers and places them differently,
// which is the only kind of divergence a shared geometry file can take.
//
// IT IS MEASURED OFF THE TITLE, NOT SET TO 186. Change the status line's size or its box and
// the row follows; the one number here is the gap under the text, which is a judgement and has
// nowhere better to live.
var TOP_GAP = 16;
var LIFT = GEO.art.y - (GEO.status.y + GEO.status.height + TOP_GAP);
function lifted(o){
  return {x: o.x, y: o.y - LIFT, width: o.width, height: o.height};
}

// THE THREE CONTROL MARKS, IN A COLUMN LAID OUT AGAINST THE TAKE TITHE BOX.
//
// geometry puts them at x 1270 on three y values of its own -- 265, 333 and 432 -- which left 74
// of canvas to the right of their ground while the cards keep 28 on the left, and put them on no
// line anything else uses. They go to the margin the cards use, measured the same way at the
// other end, and onto the THREE LINES THE TAKE TITHE BOX ALREADY HAS. Two columns, three rows,
// and a mark in the controls sits level with the resource beside it.
//
// geometry.py IS NOT TOUCHED, which is why this is arithmetic here rather than three new numbers
// there. v1 draws the same three marks from the same rects and is not having this layout.
//
// ONE RECTANGLE, NOT THREE. Individual grounds are what these wore and they cannot survive the
// size: a mark is drawn at the box's own 65 now, and a ground of `pad` either side of it is 77
// tall against a line pitch of 71 -- three of them would overlap by six. One panel holding three
// marks is also what the box beside it is, which is the point.
//
// AND IT IS NOT AS TALL AS THE BOX. It was, for one round, because sharing the box's rect made
// the rows line up without any arithmetic -- but the box is 247 tall because it carries a LABEL,
// and a column with no label wearing the same height has 31px of nothing at the top holding the
// place of a word it does not have. So the panel closes up: the air the box leaves BELOW its
// last resource is the air this leaves above its first and below its last, and the two panels
// end on the same line instead of starting on it.
//
// AND THE COMMIT'S SLOT IS KEPT WHILE IT IS EMPTY. `.mark.off` takes the element, so with
// nothing to confirm the bottom third of the column is bare ground rather than the other two
// sliding down -- buttons that move when a third appears are buttons you cannot aim at.
function controlBox(){
  var t = lifted(GEO.tithe);
  var pad = GEO.marks.pad;
  var L = titheLayout(TITHE.order.length);
  // The panel: one mark wide plus its margin either side, plus its own border at each end.
  var width = L.size + 2 * pad + 2 * PANEL_BORDER;
  var m = GEO.slots.actionA.x;
  // THE MARGIN IS THE ONE THE BOX LEAVES BELOW ITS LAST RESOURCE, used at both ends here. The
  // box's own top margin is not a margin at all -- it is the room its label sits in -- so
  // borrowing that would reproduce a gap that exists for a reason this column does not have.
  var below = (t.height - 2 * PANEL_BORDER) - (L.start + L.block);
  // WHERE THE BOX'S FIRST ROW ACTUALLY IS, in board coordinates: its panel, one border in, then
  // the offset titheLayout gives the first slot. The column is hung off this rather than off a
  // shared top edge, which is the price of closing up -- so the guard measures both columns'
  // rows and compares them rather than trusting that two rects match.
  var first = t.y + PANEL_BORDER + L.start;
  return {x: GEO.canvas.width - m - width,
          y: first - PANEL_BORDER - below,
          width: width, height: L.block + 2 * below + 2 * PANEL_BORDER,
          size: L.size, pitch: L.pitch, start: below,
          // CENTRED BY THE BOX'S OWN EXPRESSION, not by a copy of it that happens to agree. Both
          // panels pay for their border the same way because there is one place that says how.
          left: titheSlotLeft({panelW: width, size: L.size})};
}

function drawArt(){
  ["actionA","actionB"].forEach(function(slot){
    var a = GEO.slots[slot];
    var art = el("div", "art", box(lifted(a)));
    art.id = "art-" + slot;
    art.dataset.slot = slot; art.dataset.kind = "art";
    art.dataset.hoverSlot = slot;
    art.addEventListener("click", function(){ slotOrSelect(slot); });
    wireDrop(art);
  });
}

// =================================================================================================
// THE CONTROLS COLUMN, which replaces three confirm buttons and two standing ones with three marks.
//
// WHY ONE COLUMN AND NOT A BUTTON UNDER EACH CARD. The three confirms said the same word and did
// the same thing, and there was only ever one of them on screen -- the row under the cards was 64px
// of board reserved for whichever one was showing. Collapsing them into a single commit at the end
// of the row gives that height back (it is the road's now) and says the true thing about the turn:
// you choose one action anywhere in the row and confirm it once.
//
// THE PLACEHOLDER IS THE SAME PICTURE THREE TIMES, on purpose. Adam is drawing a Map, a Hire
// Building and an OK; until they land, three different borrowed emblems would read as three
// meanings and invite judgements about an arrangement that has none yet. One repeated emblem reads
// as what it is -- the column's size and rhythm, with the artwork still to come. The title is what
// says which is which in the meantime.
// WHICH MARK COMMITS, named once. Two rules turn on it -- the cue it plays and whether it is
// shown at all -- and the second was added long after the first, which is exactly when a second
// copy of a string gets typed. geometry.py's MARKS_ORDER owns the three names and a guard holds
// this to it, so a rename fails the build rather than quietly leaving a mark that makes the
// confirm sound and never appears.
var COMMIT = "commit";

function drawMarks(){
  var M = GEO.marks;
  // THE WORDING COMES FROM duty_text.json, like every other string the board prints. It was a
  // `labels` object typed here while the marks were placeholders, which is one file restating
  // another -- and the icon lab needs the same three strings for its card titles, so the two
  // would have disagreed the first time a mark was renamed.
  // ALLOCATION'S MARK IS STILL THE FALLBACK, for a control with no cut filed yet. A column that
  // refused to draw would look finished and be empty; a column wearing the wrong emblem is
  // visibly wrong, which is the failure you want.
  var placeholder = IMAGES["seal:allocation:actionA"];
  var C = controlBox();
  var panel = el("div", "cbox", {left: px(C.x), top: px(C.y),
                                 width: px(C.width), height: px(C.height)});
  panel.id = "controls";
  M.order.forEach(function(name, i){
    var said = CONTROLS[name] || {};
    var label = said.name || name;
    var src = IMAGES["control:" + name] || placeholder;
    // ORDER IS GEOMETRY'S, POSITION IS THE BOX'S. M.order says which mark is first; which LINE
    // that is comes from the Take Tithe box, so the two columns stay level.
    var e = el("div", "mark", {left: px(C.left), top: px(C.start + i * C.pitch),
                               width: px(C.size), height: px(C.size)}, panel);
    e.id = "mark-" + name;
    e.dataset.kind = "mark"; e.dataset.mark = name;
    e.title = said.shortLabel ? label + " \u2014 " + said.shortLabel : label;
    // AND THE STATUS LINE ANSWERS FOR IT TOO, which is where a hover on this board actually
    // speaks. A duty tile, a mark and an action card all put a line at the top when the pointer
    // crosses them; these three said nothing there and relied on a tooltip, which is a different
    // register -- it arrives late, it sits where the pointer is rather than where the board's
    // sentence is, and it is the only thing on this board that works that way.
    //
    // THE NAME ALONE UP THERE. The tooltip can afford `shortLabel` after an em dash because it
    // is a second look; the status line is one line in a fixed place and the name is what it is
    // for. Reading the same source means they cannot disagree about what the mark is called.
    e.dataset.hoverMark = name;
    e.classList.toggle("stand-in", !IMAGES["control:" + name]);
    if (src){ var im = document.createElement("img"); im.src = src;
              im.alt = label; e.appendChild(im); }
    else e.textContent = label.slice(0, 1).toUpperCase();
    // THE ONLY THING THE COMMIT DOES TODAY. There is no turn to commit yet, so this is a cue on a
    // placeholder -- it should come off when the mark is given its real job rather than be wired
    // around. Map and Hire are silent for the same reason the standing buttons were: they are not
    // the confirm, and a board where every mark clicks the same way teaches nothing.
    if (name === COMMIT) e.addEventListener("click", function(){ sfxWake(); sfx("confirm"); });
  });
}

// WHERE THE POOL GOES INSIDE THE BOX, and the box is a NARROW PORTRAIT: 154 x 247 with the
// label across the top, so about 154 x 213 of usable column. Three abreast would be 51px each
// and unreadable, so they stack.
//
// ONE SIZE, WHATEVER THE POOL HOLDS, and the size is the one the FULL SET gets. The column used
// to be divided by however many resources you had, so a single resource was drawn at the box's
// full width and three at a third of it -- the same object at two sizes for a reason that has
// nothing to do with it, namely how many OTHER resources you happen to hold. Switch seat and the
// wheat changed size while nothing about wheat changed. The duty marks settled this question for
// the board already: an icon that changes size with the arrangement is one you cannot compare,
// so the size is fixed and the ROOM is what gives.
//
// TAKEN FROM TITHE.order RATHER THAN FROM 3. The box is built for every resource there is, so
// the day a fourth real one is added every pool rescales together instead of the box quietly
// meaning something different depending on who is looking at it.
//
// AND THE BLOCK IS CENTRED, closing up rather than leaving holes. A resource you do not have is
// not a slot standing empty -- there is nothing to say about it -- so two resources are two marks
// in the middle of the column with the same air between them that three would have.
//
// READ OFF GEO.tithe AND GEO.marks.pad, not typed. The box is geometry's and the margin is the
// one the duty frames and the controls already keep, so a board that retightens takes this with
// it rather than leaving one panel on the old number.
function titheLayout(n){
  var t = GEO.tithe, pad = GEO.marks.pad;
  var top = t.labelTop + t.labelH + pad;
  var h = t.height - top - pad, w = t.width - 2 * pad;
  var full = TITHE.order.length;
  var size = Math.min(h / full - pad, w);
  var block = n * size + (n - 1) * pad;
  return {top: top, left: pad, width: w, height: h, panelW: t.width,
          size: size, pitch: size + pad, block: block,
          start: top + (h - block) / 2};
}

// THE BOX REDRAWN FROM THE STATE, like everything else on this board. The pool depends on the
// seat and on where the figures are, and both can change while the page is open -- so this is
// called from render() rather than once at build, and it sweeps its own slots first.
// CENTRED IN THE PANEL'S PADDING BOX, which is the panel less its own border at each end.
// Centring in `L.width` -- the column inside the margins -- was a pixel out, because the margins
// are measured from the panel's OUTER edge and the child is placed from its inner one. Shared by
// the box and the control column, so the two cannot be centred by different arithmetic.
function titheSlotLeft(L){
  return (L.panelW - 2 * PANEL_BORDER - L.size) / 2;
}

function drawTithe(){
  var box = document.getElementById("tithe");
  if (!box) return;
  var old = box.querySelectorAll(".tslot");
  for (var i = 0; i < old.length; i++) old[i].remove();

  var pool = tithePool(S.seat);
  if (!pool.length){
    var L0 = titheLayout(0);
    var none = el("div", "tslot none",
                  {left: px(L0.left), width: px(L0.width),
                   top: px(L0.top + L0.height / 2 - 8)}, box);
    none.textContent = "no tithe available";
    return;
  }

  var L = titheLayout(pool.length);
  pool.forEach(function(key, i){
    var slot = el("div", "tslot",
                  {left: px(titheSlotLeft(L)),
                   top: px(L.start + i * L.pitch),
                   width: px(L.size), height: px(L.size)}, box);
    slot.dataset.tithe = key;
    var src = IMAGES["tithe:" + key];
    if (src){
      var im = document.createElement("img"); im.src = src;
      slot.appendChild(im); slot.classList.add("filled");
    } else slot.classList.add("empty");
    // SET HERE FROM THE STATE, not in the click handler, for the reason render() already gives:
    // the resource is reached two ways -- this slot, and a one-resource pool answering itself --
    // and a class set where it is clicked is right on one of them.
    slot.classList.toggle("on", S.slot === TITHE_SLOT && S.tithe === key);
    slot.addEventListener("click", titheClick);
    slot.addEventListener("mouseenter", function(){ lightTithe(key); });
  });
}

function drawSide(){
  var t = GEO.tithe;
  var p = el("div", "panel", box(lifted(t)));
  p.id = "tithe";
  p.addEventListener("click", takeTithe);
  // THE THREE RESOURCES ARE GONE AND SO IS THE LOOP THAT DREW THEM. It read wheat, stone and
  // silver out of GEO.tithe.order and placed each at GEO.tithe.slots[i] -- geometry no longer
  // publishes either, so this cannot quietly half-work: the page would throw on `t.order` rather
  // than draw three empty discs. The box is its label, and what goes in it is open.
  var lb = el("div", "lb", {top: px(t.labelTop), fontSize: px(t.labelSize),
                            lineHeight: String(t.lh)}, p);
  lb.textContent = "Take Tithe";
  p.addEventListener("mouseleave", function(){ lightTithe(null); });
  drawTithe();

  // THE CITY PANEL IS NOT DRAWN IN v2, AND GEO.city IS LEFT ALONE. geometry.py still publishes
  // the box, its label and its four figure slots, because v1 draws all of it and the two builds
  // share one geometry file -- deleting the rect to stop drawing it here would take the panel
  // out of the board that still wants it. So this is a drawing decision and it is made in the
  // drawing: the bottom right of the canvas is empty, and that room is what the duty grid is
  // expected to grow into.
}

// THE PROCEDURAL PAWN IS GONE. It was this board's own drawing -- a dome and a body in a flat
// player colour -- and it has been replaced by the hooded mark the game view draws, which comes
// with a seat table, an outline and a neck notch the pawn never had. Deleted rather than left
// uncalled, for the same reason the ribbon's three draw functions were.

// =================================================================================================
// THE DUTY GRID, WHICH IS WHAT v2 IS FOR.
//
// Nine rectangles at a strict 2:1 stand where the wheel stood: eight of them are the eight
// duties and the ninth, the centre, is not a duty and stands for nothing yet.
//
// IT READS GEO.wheel EVERY TIME AND KEEPS NO COPY OF IT. That box is expected to GROW -- the
// City panel is gone in v2 and the room it freed is next door -- so nothing below may be written
// in terms of today's 1174 x 622. Change the wheel's rect in geometry.py, rebuild, and the nine
// rectangles follow it without a line changing here. That is the whole reason the arithmetic is
// general rather than a table of positions.
//
// WHY THE BLOCK IS INSCRIBED AND NOT STRETCHED. Three 2:1 rectangles with an equal gap make an
// arrangement that is itself 2:1 when the gap is zero, and the wheel's box is not 2:1. So one
// dimension binds, the other keeps the slack, and the block is centred in what it is given.
// Stretching to fill both would mean giving up either the 2:1 or the equal gap, and the point of
// this page is to look at exactly those two things.
// =================================================================================================

// Where each duty's rectangle ended up, so the acolytes can be put in it without measuring the
// DOM. Rebuilt by drawGrid(); read by drawFigures().
var GRIDPOS = {};

// HOW MANY DUTIES WENT WITHOUT THEIR ICONS, and it is counted rather than inferred. A plate that
// will not fit is not drawn -- which is right, because the alternative is `overflow:hidden`
// cropping it -- but a duty whose icons are simply absent looks like a duty that has none. The
// readout says the number, so the trade is stated on the page the way the margin overflow is.
var PLATES_DROPPED = 0;

// AND HOW MANY TITHE FRAMES WENT, which is a different number from the one above and goes first.
// The frame is refused when the rectangle has no width left BESIDE the plate, and that happens at
// a wider rectangle than the plate's own refusal does -- so a single counter would say "icons"
// about a board whose icons are all drawn. Taxation is never counted here: it has no frame to
// lose, which is the state it is meant to be in.
var TITHES_DROPPED = 0;


// HOW TALL AN ICON PLATE CAME OUT, because the acolytes are drawn to match it and the two are
// worked out in different passes. drawGrid() sizes the plates; drawFigures() runs after it and
// needs the answer, and re-deriving it there would be the same arithmetic in two places --
// which is how a figure ends up ALMOST the height of the plate beside it.
// THE TALLEST, not the last one assigned. All eight come out equal today, because the icon size
// is set by the rectangle's height and every rectangle is the same size -- but "they happen to
// be equal" is not a thing to depend on, and one figure size for the whole board is. Taking the
// largest makes the choice deterministic if they ever differ.
// AND IT IS THE HEIGHT THE PLATE WOULD HAVE, recorded before a plate that will not fit is
// zeroed. Otherwise a board whose bottom row lost its icons would draw its people to match a
// plate of nothing.
var PLATE_H = 0;

// THE CELL'S BORDER, NAMED BECAUSE THE ICON ARITHMETIC DEPENDS ON IT. An absolutely positioned
// child sits against the PADDING box, not the border box, so placing an icon at the cell's own
// width would put it two pixels past the right edge on each side. Must match .dcell's border.
var CELL_BORDER = 2;

// HOW FAR THE ICON PLATE HANGS BELOW THE BOTTOM LINE.
//
// IT WAS THE CLEARANCE EITHER SIDE OF THAT LINE and was one number for both, so the acolytes
// standing above it and the plate hanging below it read as the same gap around the same rule.
// The acolytes now stand ON the line with no gap at all, so there is nothing left to mirror and
// the number belongs to the plate alone -- which is why it is no longer called FOOT_GAP. A
// constant that still carried the feet in its name would be describing an arrangement the board
// stopped drawing.
var PLATE_DROP = 6;

// THE PLATE'S OWN BORDER, NAMED FOR THE SAME REASON CELL_BORDER IS. `*{box-sizing:border-box}`
// means the border eats into the declared size and the marks are placed against the PADDING box
// -- so a row set at `pad` from the left ended up with `pad` on one side and `pad - 2` on the
// other. Two pixels, invisible on a pair of marks and exactly the thing that stops a single
// centred mark from being centred.
// THE CONTROL COLUMN'S PANEL IS DRAWN THE SAME WAY: `.cbox` carries a
// 1px border INSIDE that, so the emblem sits `pad` from the frame's outer edge. The plate
// matches it by declaring `pad` either side and placing its marks one border further in, which
// is where this constant is spent.
// `.panel`'S OWN BORDER, which the Take Tithe box and the control column beside it both wear.
// Named for the same reason PLATE_BORDER is: `*{box-sizing:border-box}` draws it INSIDE the
// declared width and an absolutely positioned child is placed against the PADDING box, so
// anything centred without paying for it comes out a pixel off -- which is exactly what the
// box's resources were doing, 44.5 from one side and 42.5 from the other.
var PANEL_BORDER = 1;

var PLATE_BORDER = 1;

// CLOCKWISE FROM THE TOP, which is the order geometry.py's COMPASS is in. A duty knows its face
// and the ring knows its cells, so the two are indexed against each other and there is no table
// here to fall out of step with the one over there.
var RING_ORDER = [[1,0],[2,0],[2,1],[2,2],[1,2],[0,2],[0,1],[0,0]];
var RING_FACES = ["north", "north_east", "east", "south_east",
                  "south", "south_west", "west", "north_west"];

// THE AREA THE NINE RECTANGLES ARE CENTRED IN, WHICH IS NO LONGER GEO.wheel.
//
// geometry.py puts the wheel at x 28 with a width of 1174, so it keeps a 28 margin on the left
// and a 198 margin on the right -- it was never centred, because the drawing it held was not
// symmetrical and the controls column used to sit in that right-hand slack. v2 has neither, and
// the control marks have moved in to the same 28 the cards keep, so the slack is nothing but an
// off-centre grid.
//
// THE MARGIN IS READ OFF THE CARDS, NOT TYPED. GEO.slots.actionA.x IS the board's left margin --
// every other object on this board lines up with it -- so taking it from there means a board
// whose margin changes moves the grid, the icons and the cards together instead of two of three.
//
// VERTICALLY IT TAKES EVERYTHING UNDER THE CARDS. The card row was lifted to the top, so the
// room it left is the room the grid has: from the cards' own bottom plus one margin, down to one
// margin above the canvas. That is 842 tall against the wheel's 622, and it is the room the size
// slider grows into.
function gridArea(){
  // THE ROW ABOVE IS WHAT THE GRID LINES UP WITH, END TO END. It ran margin to margin -- the
  // card's left edge to the same distance off the right of the canvas -- which lined it up with
  // the board rather than with the things on the board. The card row does not reach that far:
  // it stops at the Tithe's right edge, 198 short of the mirror margin, so a grid spanning the
  // full width was wider than every object above it by most of a Tithe box.
  // SO BOTH ENDS ARE READ OFF THE ACTION CARDS. The left is the leftmost card's own left edge
  // and the right is where the second one ends -- the two pictures the grid is a choice
  // between. It reached the Tithe's right edge for a round, which lined the wheel up with the
  // whole row including a box that is not a duty; the cards are what the nine rectangles answer
  // to. Nothing here is a margin, so the grid follows the pair if either ever moves.
  var a = GEO.slots.actionA, b = GEO.slots.actionB;
  // The vertical still uses the card's left margin as its gap, above and below: it is the one
  // spacing this board repeats everywhere, and the row gives no vertical number to read.
  var m = a.x;
  var top = (a.y - LIFT) + a.height + m;
  return {x: a.x, y: top,
          width: (b.x + b.width) - a.x,
          height: GEO.canvas.height - top - m};
}

function gridCells(){
  var w = gridArea(), g = GRID.gap, d = GRID.disp;
  // THE DISPLACEMENT IS PAID FOR BEFORE THE RECTANGLES ARE SIZED, and that is a deliberate
  // difference from the standalone lab this came out of. There, the four edge rectangles were
  // allowed to push outside the box and the overflow was drawn, because there was margin around
  // the stage to draw it in. Here there is not: #board is `overflow:hidden` and the wheel sits
  // 28px from the canvas edge, so at the opening defaults Ordination landed at x -12 and
  // Construct ran 17px past the bottom -- both quietly cut in half, with nothing saying so.
  // Insetting first means the whole arrangement, displacement included, is always inside the
  // box it was given. The cost is that the edge slider shrinks the rectangles as well as moving
  // them; the alternative was a slider that silently clips two of the nine.
  var avW = w.width - 2 * d, avH = w.height - 2 * d;
  // WHAT FITS, AND THEN WHAT WAS ASKED FOR. The fit is still the inscribe: three 2:1 rectangles
  // with an equal gap, the binding dimension deciding. 100 on the size slider IS that fit, so
  // the slider reads as a percentage of the largest the arrangement can be rather than as a
  // number of pixels -- which means it keeps its meaning when the area changes, and the area is
  // expected to change. Above 100 the block is deliberately allowed to pass the margins: asking
  // for bigger and silently being refused is worse than asking for bigger and seeing it.
  var fit = Math.max(0, Math.min((avW - 2 * g) / 3,      // the width binding
                                 (avH - 2 * g) / 1.5));  // the height: 3 * rw/2 + 2g = avH
  var rw = fit * (GRID.size / 100);
  var rh = rw / 2;
  var bw = 3 * rw + 2 * g, bh = 3 * rh + 2 * g;
  // CENTRED ON THE WHOLE ARRANGEMENT, displacement included, so the four edge rectangles reach
  // equally far past the block on every side and the picture is symmetrical in the area whatever
  // the three sliders say.
  var ox = w.x + (w.width - (bw + 2 * d)) / 2 + d;
  // AND THE PLATES COUNT, VERTICALLY. They hang under the bottom row, so the ink this
  // arrangement puts on the board reaches further DOWN than the rectangles do -- 62px further
  // at the opening settings. Centring the rectangles alone left that overhang outside the
  // balance: equal slack above and below the OUTLINES, and visibly more above than below the
  // drawing. So the hang is paid for here, the same way the displacement is, and what ends up
  // centred is everything that gets drawn.
  // HORIZONTALLY THERE IS NOTHING TO ADD, because a plate is centred under its own rectangle
  // and is never wider than it -- the arrangement's left and right edges are the rectangles'.
  // ONLY AS MUCH AS THERE IS ROOM FOR. The rectangles are sized before the hang is known --
  // `fit` cannot account for it without solving for its own output -- so on an arrangement that
  // already fills the area vertically there is nothing left to reserve. Taking it anyway pushed
  // the top row 24px ABOVE the area and within 4px of the card row above it. Where the room runs
  // out the plates go back to hanging past the bottom, and `hasPlate` refuses the ones that run
  // off the board, which the readout already reports.
  var hang = Math.max(0, Math.min(plateHang(), w.height - (bh + 2 * d)));
  // HOW MUCH TALLER THAN 2:1 THE RECTANGLES ARE ASKED TO BE. Measured off `rh` rather than
  // typed, so the slider reads as a percentage of the shape the fork is about and keeps that
  // meaning when the other three sliders change the shape's size.
  var extra = rh * (GRID.height / 100 - 1);
  var oy = w.y + (w.height - (bh + 2 * d + hang)) / 2 + d;
  var out = [];
  for (var row = 0; row < 3; row++){
    for (var col = 0; col < 3; col++){
      var x = ox + col * (rw + g), y = oy + row * (rh + g);
      if (col === 1 && row === 0) y -= d;         // top, up
      if (col === 1 && row === 2) y += d;         // bottom, down
      if (col === 0 && row === 1) x -= d;         // left, left
      if (col === 2 && row === 1) x += d;         // right, right
      // `hang` TRAVELS WITH THE CELLS because it is what the arrangement was centred on, and
      // it is capped -- so it is not something a reader can re-derive from rw and rh. Anything
      // asking "is this balanced?" has to ask the number that was actually used.
      // TALLER, AND UPWARD ONLY. The height slider is applied AFTER the arrangement is laid
      // out and centred, which is what makes the bottom edge stay put: `y + rh` is untouched,
      // so the line the acolytes stand on, the plate hanging under it and the vertical balance
      // of the whole wheel are all exactly where they were before the slider moved.
      // WHICH ALSO MEANS THE TOP CAN LEAVE THE AREA. Growing upward has to come from somewhere
      // and nothing else is allowed to move, so past a certain height the top row rises past
      // the area and, eventually, into the card row. That is reported rather than prevented --
      // the readout already says when the arrangement passes its margins -- because a slider
      // that silently refuses to grow is worse than one you can see has gone too far.
      // THE BLOCK IS NOT RE-INSCRIBED EITHER. `fit` sizes the rectangles at 2:1 and the extra
      // height is added on top of that, so the width does not shrink to pay for the height.
      // Inscribing the taller shape would have kept everything inside the area and moved every
      // bottom edge to do it, which is the one thing this slider must not do.
      // `bottom` IS CARRIED, NOT DERIVED, and it is carried because of one pixel. The extended
      // cell stores `y - extra` and `rh + extra`; adding those back together is not bit-for-bit
      // `y + rh`, and when the true bottom lands exactly on a half pixel that 1e-13 of noise is
      // enough to flip `Math.round` the other way. The bottom edge then moved by a pixel when
      // the height slider was dragged -- the one thing it promises not to do. So the exact
      // bottom is worked out BEFORE the extension and travels with the cell.
      out.push({x: x, y: y - extra, width: rw, height: rh + extra, bottom: y + rh,
                col: col, row: row, hang: hang, centre: (col === 1 && row === 1)});
    }
  }
  return out;
}

// HOW BIG THE PLATE OF ICONS UNDER A RECTANGLE COMES OUT.
//
// IT IS A FUNCTION BECAUSE TWO PASSES NEED IT AND NEITHER MAY GUESS. drawGrid() needs the whole
// answer to place the plate; gridCells() needs only its HEIGHT, because the arrangement is
// centred on everything it draws and the plates hang below the bottom row. Worked out in both
// places it would be the same arithmetic twice, and the drift that produces is a wheel centred
// on a plate height that is not the one drawn -- a few pixels off, consistently, with nothing
// to compare it against.
//
// THE ICON IS GEOMETRY'S OWN SIZE AND IS NEVER SHRUNK. It used to be the smallest of that size,
// what the row could take across the rectangle and what the rectangle's height allowed -- so a
// duty's marks came out at 32px at the settings this board opens on, against the 50 the same
// mark is drawn at everywhere else in the game. An icon that changes size with a layout slider
// is an icon you cannot compare across boards, and these are the one object on the rectangle
// that carries meaning rather than arrangement. So the size is a constant now and the ROOM is
// what gives: a plate that will not fit where it has to go is not drawn, and is counted.
//
// WHICH MAKES THE HEIGHT A CONSTANT TOO -- one icon plus its padding, whatever rectangle it
// belongs to -- so `plateHeight` stands alone and `plateHang` can ask for it without inventing
// a rectangle to ask about.
//
// THE GROUND ROUND A MARK IS THE CONTROLS' OWN, AND IT IS READ FROM THEM. It was the ribbon's
// `pad` -- 12, what a tile kept around its marks when the marks were on tiles -- against the 6
// the Map and Hire controls keep. Two paddings on two frames holding the same 50px emblems, so
// the duty plates read as a looser kind of object than the controls rather than as the same
// kind in another place. `GEO.marks.pad` is the number those controls are drawn with, taken
// from there rather than copied, so the two cannot be tuned apart.
function plateHeight(){ return GEO.ribbon.seal + 2 * GEO.marks.pad; }

// THE WIDEST ROW OF MARKS ANY DUTY NEEDS, counted rather than typed. Every plate is built to
// this, so a duty with fewer marks gets the same frame with its marks centred in it -- and the
// day a duty gains a third action, every plate widens to match without anything here changing.
function mostActions(){
  var n = 1;
  for (var k in DUTIES) n = Math.max(n, (DUTIES[k] && DUTIES[k].actions) || 1);
  return n;
}

function plateFor(rw, rh, nAct){
  var mg = GEO.ribbon.sealInset * 2, ip = GEO.marks.pad, igap = 6;
  var sz = GEO.ribbon.seal;
  // ONE FRAME FOR EVERY DUTY, WHATEVER IT HOLDS. Allocation and Taxation have a single mark
  // each and used to get a plate 74 wide against the other six's 130 -- two sizes of the same
  // object in one row, which reads as two kinds of thing rather than as one kind holding
  // different amounts. The frame is built to the widest row any duty needs and a short row is
  // CENTRED in it, so what differs between duties is the marks and not the ground they sit on.
  var rowW = nAct * sz + (nAct - 1) * igap;
  var most = mostActions();
  var fullRow = most * sz + (most - 1) * igap;
  // THE FRAME IS BUILT TO THE MARKS, AND THAT IS NOW WHAT IT MEANS. It spanned the whole
  // rectangle for a round, with the tithe resource at its right-hand end -- and a frame holding
  // both made the two look like one kind of thing, which they are not: an action is CHOSEN and a
  // resource is a label saying what the tile provides. So the frame has come back to the row of
  // marks and the resource stands outside it. INSIDE A FRAME YOU CAN CHOOSE IT; OUTSIDE, IT IS
  // TELLING YOU SOMETHING -- readable at rest, without hovering anything, which is exactly what
  // the merged bar could not do: the two were the same ink at the same weight on the same ground.
  //
  // `rowBox` IS BOTH WHAT THE MARKS NEED AND WHAT IS DRAWN. `innerW` is still worth naming,
  // because the resource is placed against the RECTANGLE's far edge rather than the frame's, and
  // because the fit test asks whether the row fits the rectangle.
  var innerW = rw - 2 * CELL_BORDER;
  return {mg: mg, ip: ip, igap: igap,
          innerW: innerW, innerH: rh - 2 * CELL_BORDER,
          // WHERE THE ROW STARTS INSIDE THE PADDING, which is what centres a short one. It is
          // zero for a duty holding the full row, so the two cases are one expression.
          sz: sz, rowW: rowW, inset: (fullRow - rowW) / 2,
          fullRow: fullRow, rowBox: fullRow + 2 * ip, height: plateHeight()};
}

// WHAT THE PLATES ADD BELOW THE BOTTOM ROW, which is what the arrangement has to be centred on.
// No longer a function of the rectangle, because the plate is not: one number for the board.
function plateHang(){ return PLATE_DROP + plateHeight(); }

// WHERE A RECTANGLE'S PLATE GOES, AND WHETHER IT GOES AT ALL.
//
// SEPARATED FROM drawGrid FOR THE SAME REASON plateFor WAS. drawGrid places a DOM element with
// these numbers and nothing else can see them, so the only way to check them was to work them
// out a second time -- and a guard that recomputes what it is checking agrees with a mistake for
// the same reason the mistake happened. Two of these were being re-derived in the test suite and
// two mutations went unnoticed because of it.
//
// TWO WAYS A FULL-SIZE PLATE CAN HAVE NOWHERE TO GO, now that it cannot shrink to fit. DOWN: it
// hangs into the margin below the bottom row and #board is `overflow:hidden`, so a tall
// arrangement would crop it. ACROSS: it is centred under its rectangle and at 130 wide it can be
// wider than the rectangle once the sliders make these small -- at which point it reaches under
// its neighbours and stops saying which duty it belongs to. Both are refused rather than drawn.
//
// THE WIDTH TEST WAS DEAD CODE UNTIL NOW. It was in `hasPlate` for a round, a mutation proved no
// slider setting could fail it -- the icon shrank first -- and it was removed. The icon no longer
// shrinks, so it is live, and it is the condition that does the most work.
// THE INTEGER RECTANGLE A CELL IS ACTUALLY DRAWN AS.
//
// THE BOTTOM EDGE IS ROUNDED, NOT THE HEIGHT, and it is rounded from the cell's own `bottom`
// rather than from `y + height`. Rounding `y` and `height` separately gives `round(y) +
// round(h)`, which differs from `round(y + h)` by a pixel often enough; and adding the extended
// pair back together is not bit-for-bit the un-extended sum either, which flips `Math.round` on
// a half pixel. Both ways the bottom edge moved when the height slider was dragged. That edge
// is the floor the acolytes stand on and the line the icon plate hangs from, and it is the one
// thing the height slider promises not to move -- so it is the number that gets rounded, from
// the value gridCells worked out before it extended anything, and the height follows from it.
//
// A FUNCTION FOR THE SAME REASON THE OTHERS ARE. It was two lines inside drawGrid and the guard
// that checks the bottom edge had to round the cell itself to have anything to check -- a third
// copy of the same arithmetic, which is how the pixel got through in the first place.
function cellRect(c){
  var y0 = Math.round(c.y), y1 = Math.round(c.bottom);
  return {x: Math.round(c.x), y: y0, width: Math.round(c.width), height: y1 - y0};
}

// WHERE THE k-TH MARK SITS INSIDE ITS PLATE.
//
// THE LAST PIECE OF PLACEMENT THAT WAS STILL INLINE, and the last one a guard had to re-derive
// to have anything to check. Two mutations went unnoticed because of it -- the border going
// unpaid for, and the marks pushed down inside the frame -- both of which move the emblems off
// centre by a couple of pixels, which is exactly the size of error a second copy agrees with.
//
// ONE BORDER IN FROM THE PADDING BOX. `*{box-sizing:border-box}` means the frame's border eats
// into its declared size, so a mark set at `ip` from the padding box sits `ip + 1` from the
// frame's outer edge. The control column's panel is drawn the same way -- it carries its border
// inside its declared width -- so this is what makes the two match.
// THE CORNER EVERY MARK STARTS FROM, which is one expression because there are now two frames
// asking for it. Writing `P.ip - PLATE_BORDER` a second time inside the tithe frame is how the
// border went unpaid for the first time: the number is small, the error is a couple of pixels off
// centre, and a second copy of it agrees with the mistake. Both `markAt` and `titheMarkAt` read
// this, so the two frames cannot pad their marks differently.
function plateInset(P){ return P.ip - PLATE_BORDER; }

function markAt(P, k){
  return {left: plateInset(P) + P.inset + k * (P.sz + P.igap),
          top: plateInset(P), size: P.sz};
}

// WHERE THE RESOURCE STANDS, WHICH IS EXACTLY WHERE IT STOOD WHEN THE FRAME REACHED IT.
//
// The frame moved away from the resource; the resource did not move. It keeps `GEO.marks.pad`
// from the RECTANGLE's inner right edge -- the margin it kept from the frame's right edge while
// the frame ended there -- so nothing shifted on the board when the frame shrank, and the only
// visible change is that there is no edge around it any more.
//
// BOARD COORDINATES, NOT THE FRAME'S. It used to be a child of the plate, placed against the
// plate's padding box; it is a child of #board now, because a frame 118 wide cannot hold
// something 136 from the rectangle's left edge. That is also why drawGrid's sweep has to name
// it: nothing else would take it away on a rebuild, and it would pile up one copy per slider
// event -- the exact failure the plates had when they first left the cell.
//
// `P.ip` DOES BOTH JOBS, which is what keeps the resource level with the marks beside it: the
// margin from the rectangle's edge, and the inset that centres a 50px mark on a 62px line. The
// same number, because the line IS the mark plus that margin at each end.
//
// AND NO `P.inset`. That term centres a SHORT row inside the widest row any duty needs; the
// resource is not in that row and is not centred in anything. Applying it would move the
// resource on the two duties that hold a single action and nowhere else.
function titheMarkAt(r, P, y){
  return {x: r.x + CELL_BORDER + P.innerW - P.ip - P.sz,
          y: y + P.ip, size: P.sz};
}

function placeFor(r, nAct, hasTithe){
  var P = plateFor(r.width, r.height, nAct);
  // THE FRAME SPANS THE RECTANGLE, inner edge to inner edge. It was centred under the rectangle
  // while it was built to its contents, then flush left while the resource had a frame of its
  // own beside it; it is neither now, because there is one frame and it is as wide as the thing
  // it hangs from. `CELL_BORDER` is paid once on each side because `*{box-sizing:border-box}`
  // draws the cell's border INSIDE its declared width, so the inner box starts one border in.
  var x = r.x + CELL_BORDER;
  var y = r.y + r.height + PLATE_DROP;
  var tm = titheMarkAt(r, P, y);
  // WHERE THE FRAME ENDS, which is what the resource has to clear. It used to be where the row
  // of marks ended, inside a frame that reached past it; the frame's own right edge is the
  // boundary now, and it is the thing the eye actually sees.
  var frameEnd = x + P.rowBox;
  var has = P.rowBox <= P.innerW && y + P.height <= GEO.canvas.height;
  // EACH CONDITION GETS A NAME BECAUSE EACH IS A DIFFERENT QUESTION, and they were a chain of
  // `&&` inside one object literal until the divider arrived and needed to ask the answer to the
  // one above it. A literal cannot read its own fields, and the alternative -- restating the
  // resource's test inside the divider's -- is the second copy this file keeps being bitten by.
  var hasT = !!hasTithe && has && tm.x - frameEnd >= P.igap;
  return {p: P, x: x, y: y, has: has, titheMark: tm,
          // THE FRAME'S DRAWN WIDTH, NAMED HERE RATHER THAN WORKED OUT IN drawGrid. It is
          // `P.innerW` and nothing else today, which is exactly why it needs a name: drawGrid is
          // the one function the guards cannot call, so a width decided there can only be
          // checked by a second copy of it -- and every bug this file has had came from a second
          // copy agreeing with the first. placeFor is what the sweep calls, so the page and the
          // guards read the same expression.
          width: P.rowBox,
          // THE RESOURCE NEEDS A CLEAR GAP, NOT MERELY A FREE PIXEL, and the gap it needs is the
          // one BETWEEN the duty's own marks. Inside a single frame the only thing separating
          // "the actions you may take" from "what this duty hands you" is distance: let the
          // resource come closer than `igap` and it reads as a third icon in the row, which is
          // the one misreading this arrangement has to avoid. At the opening settings the
          // clearance is 24px against the 6 between the two duty marks, so the resource is four
          // times further from them than they are from each other.
          //
          // AND IT RIDES IN THE DUTY'S FRAME, SO IT NEEDS THE FRAME. `has` is kept here even
          // though its WIDTH half is implied -- clearing the row by `igap` cannot happen in a
          // rectangle too narrow for the row -- because its HEIGHT half is not: a frame pushed
          // off the bottom of the board is refused for a reason that has nothing to do with
          // width, and without this term the resource would be placed into a frame that was
          // never drawn, landing loose inside the rectangle.
          hasTithe: hasT,
          // THE ROW RUNS THE WHOLE RECTANGLE, less one margin at each end. It ran from the
          // banner's left edge to the plate's while both were inside; neither is any more.
          figLeft: r.x + CELL_BORDER + P.mg,
          figRight: r.x + CELL_BORDER + P.innerW - P.mg};
}

function drawGrid(){
  // THE PLATES ARE SWEPT TOO, AND THEY HAVE TO BE SWEPT HERE. They used to be children of the
  // rectangle, so removing the rectangle took them with it. They hang BELOW it now, which means
  // they are children of #board -- and a rebuild that cleared only `.dcell` would leave nine
  // orphaned plates behind on every slider event.
  // AND THE RESOURCES, which left the plate when the frame stopped reaching them. A tmark is a
  // child of #board now, so a rebuild that swept only `.dcell, .iplate` would leave one behind
  // per duty per slider event -- the same failure the plates had the day they left the cell.
  var old = board.querySelectorAll(".dcell, .iplate, .tmark");
  for (var i = 0; i < old.length; i++) old[i].remove();
  GRIDPOS = {};
  PLATES_DROPPED = 0;
  TITHES_DROPPED = 0;
  PLATE_H = 0;
  var byFace = {};
  GEO.duties.forEach(function(d){ byFace[d.face] = d; });

  gridCells().forEach(function(c){
    var r = cellRect(c);
    var cell = el("div", "dcell", box(r));
    // SET WHERE THE CELL IS MADE, not toggled on a parent afterwards. The sliders rebuild these
    // on every input event anyway, so there is no redraw to save -- and a class on #board would
    // need a second selector for every state the cell already has.
    if (GRID.bare) cell.classList.add("bare");
    if (c.centre){
      cell.classList.add("centre");
      // THE CITY IS NOW A RECTANGLE WITH PEOPLE IN IT AND NOTHING ELSE. It carried a parchment
      // reading "City" while the eight duties carried theirs; the parchments have gone, and a
      // ninth name on a nameless board would be the drawing contradicting itself. What still
      // separates it from its neighbours is the ground, the missing plate and the pointer it
      // does not take.
      // ITS ROW IS THE SAME ROW THE DUTIES GET, worked out the same way, because with no plate
      // inside any rectangle there is no longer anything for the City's row to differ about.
      // Registered in GRIDPOS under "city" so one figure pass covers all nine rather than the
      // duties here and the City somewhere else.
      var cmg = GEO.ribbon.sealInset * 2;
      r.figLeft = r.x + CELL_BORDER + cmg;
      r.figRight = r.x + CELL_BORDER + r.width - 2 * CELL_BORDER - cmg;
      GRIDPOS.city = r;
      return;
    }

    var ring = -1;
    for (var i = 0; i < RING_ORDER.length; i++)
      if (RING_ORDER[i][0] === c.col && RING_ORDER[i][1] === c.row) ring = i;
    var d = byFace[RING_FACES[ring]];
    if (!d) return;

    GRIDPOS[d.slug] = r;
    cell.id = "dcell-" + d.slug;
    cell.setAttribute("data-face", d.face);
    cell.dataset.hoverDuty = d.slug;

    // THE FILMS, INSIDE THE RECTANGLE AND BEHIND EVERYTHING IN IT.
    //
    // ONE ELEMENT PER PHASE THAT HAS A FILM, rather than one element whose `src` is swapped when
    // the phase changes. Swapping would reload and re-decode eight videos on every press of a
    // phase button, for a saving of eight paused elements holding a 95 KB clip each -- and it
    // would put a blank frame in the place the board is meant to be most legible.
    //
    // BUILT FOR ALL EIGHT TILES AND PLAYED FOR SOME. Hidden by CSS and paused by markStanding,
    // because a tile's state changes with the seat picker and the phase several times a turn,
    // and building the element on the way in would make the first frame of a newly marked tile
    // wait on a decode. At most eight play at once, and usually one or two do.
    //
    // THE ACOLYTES STAY IN FRONT OF IT. They are drawn by drawFigures as children of #board, so
    // they are later siblings of this rectangle and paint over it without either knowing about
    // the other -- which is the right way round: the figures are the reason the tile is lit.
    //
    // `muted` TWICE, AS A PROPERTY AND AS AN ATTRIBUTE, and that is not belt and braces. Autoplay
    // without a gesture is permitted for a muted video, and some browsers read the ATTRIBUTE when
    // they decide that, not the property -- set only as a property, the play() in markStanding is
    // refused on a page nobody has clicked yet, which is every page on first paint.
    Object.keys(FILMS.byPhase || {}).forEach(function(phase){
      var sm = el("video", "smoke", null, cell);
      sm.id = "smoke-" + phase + "-" + d.slug;
      sm.dataset.phase = phase;
      sm.src = FILMS.byPhase[phase];
      sm.muted = true; sm.loop = true; sm.playsInline = true;
      sm.setAttribute("muted", ""); sm.setAttribute("playsinline", "");
      sm.setAttribute("aria-hidden", "true");
      sm.preload = "auto";
    });

    // THE DUTY'S ICONS, BELOW THE RECTANGLE AND CENTRED UNDER IT.
    //
    // On the ribbon they were stacked down a 74-wide tile, which is why geometry.py hands over
    // `sealSlots` as a diagonal: in a box taller than it is wide, two 50px discs can only go one
    // above the other. geometry still publishes it, because v1 still stacks them. They ran
    // across the rectangle's top right corner for several rounds, and now they are out of the
    // rectangle altogether.
    //
    // OUT OF THE RECTANGLE MEANS OUT OF THE ELEMENT. `.dcell` is `overflow:hidden`, so a plate
    // placed below the cell's own bottom edge would be clipped to nothing -- the one failure
    // that looks like "the icons stopped being drawn". So the plate is a child of #board and
    // carries BOARD coordinates, not cell-relative ones. render() finds the seals inside it by
    // `#board .seal`, which is why they can change parent without anything else changing; what
    // does change is drawGrid()'s sweep, which now has to clear `.iplate` itself.
    //
    // THEY SHRINK WITH THE RECTANGLE, still. Both sliders make these boxes smaller -- at gap 150
    // and edge 150 a cell is 215 x 107 -- and a 50px disc that was right at full size would be
    // wider than the box it is captioning. So the size is the smallest of geometry's 50, what
    // the row can take across the cell's width, and what the cell's own height allows. The
    // height term no longer has to be true -- nothing clips the plate now but the board edge --
    // and it is kept because it is what makes the icons read as belonging to a small tile.
    var info = dutyOf(d.slug);
    var nAct = info ? info.actions : 1;
    // A DUTY WITH NO RESOURCE GETS NO FRAME, WHICH IS NOT THE SAME AS AN EMPTY ONE. Taxation is
    // the one duty that takes no tithe, so the right-hand side of its rectangle is bare on
    // purpose. An empty frame would say a resource belongs there and has not been drawn yet --
    // which is exactly what a resource with no cut on disk DOES say, two lines down, and the two
    // states have to stay distinguishable. `=== null` rather than falsy: a key is a string or it
    // is null, and testing truthiness would make a future "" mean Taxation.
    var tkey = info && info.tithe != null ? info.tithe : null;
    var L = placeFor(r, nAct, tkey !== null);
    var P = L.p, ip = P.ip, igap = P.igap, sz = P.sz;
    var plateW = L.width, plateH = P.height;
    var plateX = L.x, plateY = L.y;
    // TAKEN HERE, BEFORE ANYTHING CAN ZERO IT. The acolytes are drawn to this height.
    PLATE_H = Math.max(PLATE_H, plateH);
    var hasPlate = L.has;
    if (!hasPlate){ plateW = 0; plateH = 0; PLATES_DROPPED++; }
    // COUNTED SEPARATELY FROM THE PLATES, because they are lost for a different reason and at a
    // different setting -- the frame goes when the rectangle runs out of width BESIDE the plate,
    // which happens first. One counter for both would report "three without room for icons" on a
    // board whose icons are all drawn.
    if (tkey !== null && !L.hasTithe) TITHES_DROPPED++;
    r.figLeft = L.figLeft;
    r.figRight = L.figRight;

    var plate = hasPlate
      ? el("div", "iplate", {left: px(plateX), top: px(plateY),
                             width: px(plateW), height: px(plateH),
                             borderRadius: px(GEO.ribbon.radius)})
      : cell;

    for (var k = 0; hasPlate && k < nAct; k++){
      var kslot = k === 0 ? "actionA" : "actionB";
      // INSIDE THE PLATE, so the two move as one object and the icon cannot drift off its
      // ground. render() still finds these by `#board .seal`, which is why they can change
      // parent without changing anything else.
      var at = markAt(P, k);
      var seal = el("div", "seal",
                    {left: px(at.left), top: px(at.top),
                     width: px(at.size), height: px(at.size),
                     zIndex: String(k + 1)}, plate);
      seal.style.pointerEvents = "auto";
      // EVERY HANDLE THE RIBBON'S SEALS CARRIED, CARRIED OVER. The picker, the drop target and
      // render()'s `on` class all find these by dataset and by `#board .seal`, so a seal that
      // moved house but changed its labels would break three things at once and none of them
      // here.
      seal.dataset.duty = d.slug; seal.dataset.slot = kslot; seal.dataset.kind = "seal";
      seal.dataset.hoverDuty = d.slug; seal.dataset.hoverSlot = kslot;
      var key = info && info[kslot] && info[kslot].seal;
      if (key && IMAGES[key]){
        var im = document.createElement("img"); im.src = IMAGES[key];
        seal.appendChild(im); seal.classList.add("filled");
        if (info[kslot].sealGround === "board") seal.classList.add("plate");
      } else seal.classList.add("empty");
      seal.addEventListener("click", slotClick);
      wireDrop(seal);
    }
    // THE TITHE RESOURCE, BESIDE THE FRAME AND OUTSIDE IT.
    //
    // THE FRAME IS THE SIGNAL NOW. It has been three things in three rounds -- a frame of its
    // own, then the right-hand end of a frame spanning the rectangle, and now bare ground beside
    // a frame built to the marks. The first two both made it look like the actions: same ground,
    // same border, or no border and the same ground. It is not like the actions. An action is
    // CHOSEN, and this says what the tile provides, to anyone, whether or not they have a figure
    // standing on it. Inside a frame you can choose it; outside, it is telling you something.
    //
    // WHICH COSTS NOTHING TO READ AND IS READABLE AT REST. The distinction used to live entirely
    // in what happened on hover -- the marks brightened and this did not -- so a still board
    // said nothing at all about which of the three objects on that line could be pressed.
    //
    // AND IT IS A LABEL, NOT A CHOICE. It was clickable for a round, and the mechanic that
    // arrived afterwards took that back: you do not get Build Roads' stone by clicking Build
    // Roads' stone. You get stone because one of YOUR figures is standing on a tile that offers
    // it, and the tile draws its resource whether you are standing there or not -- so a click
    // here would offer something you may have no claim to, and would put one decision in two
    // places. The choosing happens in the Take Tithe box, against the pool; this says what the
    // tile provides, which is a permanent fact about the tile.
    //
    // AND IT IS NOT GREYED, for the reason the controls column already gives about Map and Hire:
    // a disabled look promises a state the thing can enter later. These never become clickable.
    // So they are drawn at rest, at the same weight as the duty marks beside them -- one frame,
    // one reading -- and they do not answer the pointer at all.
    //
    // `hoverDuty` STAYS, and so does the duty on the dataset, because the box lights the tiles
    // feeding a resource through them. A label that knows which duty it belongs to is how the
    // two halves of this are connected without either knowing about the other.
    if (L.hasTithe){
      var tat = L.titheMark;
      var tm = el("div", "tmark",
                  {left: px(tat.x), top: px(tat.y),
                   width: px(tat.size), height: px(tat.size)});
      // THE SAME LOOK-UP A SEAL DOES, so a resource with no cut on disk draws an EMPTY slot
      // rather than nothing: visibly unfinished, which is the state it is in.
      var tsrc = IMAGES["tithe:" + tkey];
      if (tsrc){
        var ti = document.createElement("img"); ti.src = tsrc;
        tm.appendChild(ti); tm.classList.add("filled");
      } else tm.classList.add("empty");
      tm.dataset.tithe = tkey;
      tm.dataset.duty = d.slug;
      tm.dataset.hoverDuty = d.slug;
    }


    // THE SAME ENTRY POINT THE TILE USES. A cell and its tile are two handles on one duty, so
    // both go through pickDuty and the selection, the action cards and the grid all follow from
    // the one piece of state rather than from whichever was clicked.
    cell.addEventListener("click", function(slug){
      return function(){ pickDuty(slug); };
    }(d.slug));
  });

  // DRAWN IN THE RIGHT STATE RATHER THAN DRAWN AND THEN CORRECTED. The sliders rebuild these
  // nine elements on every input event, and a rebuild that dropped the selection until the next
  // render() would flicker the gold off and on under the pointer.
  GEO.duties.forEach(function(d){
    var cell = document.getElementById("dcell-" + d.slug);
    if (cell) cell.classList.toggle("sel", d.slug === S.duty);
  });
  markStanding();
  drawFigures();
}

// WHERE THIS SEAT'S ACOLYTES STAND, AND WHICH FILM THAT EARNS. ONE SWEEP, TWO CALLERS.
//
// NOT NAMED AFTER ELIGIBILITY ANY MORE, AND THE RENAME IS THE POINT. The marked set is the tiles
// this seat has figures on, which is true in BOTH phases that have a film; "eligible" is true of
// it in one of them. eligible() is the REFUSAL rule and answers `true` for every duty outside
// Action Selection, so a sweep built on it would have lit all eight during Sowing. Two different
// questions had been sharing one word, and the day Sowing got a film was the day that cost
// something.
//
// THE PHASE PICKS THE FILM AND THE OCCUPANCY PICKS THE TILES. A phase with no entry in
// FILMS.byPhase marks nothing at all -- `ready` is in that position -- so the gate is simply
// whether a film exists, rather than a second list of which phases are allowed to light.
//
// render() SETS IT BECAUSE IT IS STATE, and drawGrid() sets it because the sliders throw these
// nine elements away and build them again -- a rebuild that left it to the next render would
// drop the cue under the pointer every time a slider moved. Written out at both ends it would be
// two answers the first time one was edited, which is the rule the hover pair already follows.
//
// ADDITIVE, AND THAT IS THE WHOLE DESIGN. Nothing is dimmed. An unmarked tile is the board as it
// has always looked and a marked one is what is added to it, because the marked set is the
// MINORITY -- your figures are on one or two tiles of eight -- so dimming would change six or
// seven objects to say something about two, on a palette that has no room below the one it is
// already at. It also keeps the board readable to the three players not taking this turn.
//
// ON THE RECTANGLE, WHICH IS THE SECOND PLACE THIS CUE HAS LIVED. It was the icon frame's 1px
// edge first, and that failed in use for a reason worth keeping: the colour step was real and the
// AREA was not. A cue that has to be found at a glance across eight tiles needs room, and the
// rectangle is the largest object a duty has.
function markStanding(){
  var phases = Object.keys(FILMS.byPhase || {});
  GEO.duties.forEach(function(d){
    var here = standsOn(S.seat, d.slug);
    phases.forEach(function(phase){
      var sm = document.getElementById("smoke-" + phase + "-" + d.slug);
      if (!sm) return;
      var on = here && phase === S.phase;
      sm.classList.toggle("on", on);
      // AND A CLIP IS STOPPED WHEN IT IS NOT BEING LOOKED AT. `display:none` hides a video and
      // does not pause it, so the films of every other phase -- and of every tile this seat is
      // not on -- would go on being decoded for the whole of a turn.
      if (!on){ if (!sm.paused) sm.pause(); return; }
      // SOUGHT ONLY ON THE WAY IN. Setting currentTime on a playing video is a seek, and doing
      // it every render -- render runs on every click, hover cue and slider nudge -- would hold
      // the clip at one frame. It is already playing and already in step; leave it alone.
      if (!sm.paused) return;
      try { sm.currentTime = filmAt(d.slug); } catch (e) {}
      // A REJECTED play() IS NOT AN ERROR HERE. Autoplay is allowed because the clip is muted,
      // but a browser may still refuse before the first gesture; the class is set either way,
      // and the next render tries again because a paused video is what brings us back here.
      var q = sm.play();
      if (q && q.catch) q.catch(function(){});
    });
  });
}

// AND THE TAKE TITHE BOX IS NOT IN THIS SWEEP, which was tried and taken back out.
//
// IT SAYS THE SAME THING IN WORDS, AND IT IS THE ONLY OBJECT HERE THAT CAN. A box with nothing
// in it draws "no tithe available" across the middle of itself -- see drawTithe -- so a wash
// behind that sentence would be the board making one statement twice, in two languages, on one
// object. The rectangles need the light precisely because they have no room for a sentence: a
// duty tile is figures and icons, and there is nowhere in it to write why it cannot be pressed.
//
// A PRESS ON IT STILL ANSWERS. takeTithe refuses an empty pool out loud rather than silently;
// what has gone is the resting cue, not the refusal.

// THE ACOLYTES ARE THE DUTY WHEEL'S HOODED MARK, piled by seat, and the shape and its numbers
// are board_v2's own copy of ui/render/population_sets.py -- see action_board/hood.py.
//
// NOT THE PAWN THIS BOARD DREW BEFORE. That was procedural and had no seat beyond a colour; this
// is the figure the game view itself draws, which is the point of changing it. A hood is a flat
// seat colour with a dark outline and a neck notch, so every figure in a pile has an edge the one
// below it does not -- which is what lets four read as four.
//
// ONE PILE PER SEAT, GROWING UPWARD, AND NO NUMERAL. The original's reasoning is worth keeping
// whole: a count used to be one figure with a number on its robe, and the number was the only
// part carrying information. What a player asks is "who has the most here", and a pile answers
// it without being read.
//
// THE BOTTOM FIGURE DOES NOT LEAN. Only the ones resting on it. Leaning all of them and centring
// afterwards also works and moves the figure standing on the line by half a lean whenever the
// count changes -- so a seat going from one acolyte to two shifts its foot sideways, and the row
// of feet the eye compares heights against stops being a row.
//
// A SEAT WITH NONE IS DRAWN AS NOTHING AND THE OTHERS DO NOT CLOSE UP. Each seat keeps the slot
// its position gives it, so a gap means a SPECIFIC player is missing rather than merely that
// somebody is.
function hoodSvg(seat, w){
  // ONE UNIT WIDE WITH ITS CROWN AT y = 0, so a viewBox of the INKED box is what the markup
  // needs: a stroke is centred on its path, so a box set to the path's bare bounds cuts half the
  // outline off on every edge -- the dome comes out flat and it reads as a figure that does not
  // fit rather than as one being trimmed.
  var s = HOOD.stroke / 2;
  return '<svg viewBox="' + (-0.5 - s) + ' ' + (-s) + ' ' + (1 + 2 * s) + ' '
       + (HOOD.h + 2 * s) + '" width="100%" height="100%" overflow="visible">'
       + '<path d="' + HOOD.path + '" fill="' + (HOOD.swatch[seat] || "#8fae6a")
       + '" stroke="' + HOOD.ink + '" stroke-width="' + HOOD.stroke
       + '" stroke-linejoin="round"/>'
       + '<ellipse cx="0" cy="' + HOOD.face.cy + '" rx="' + HOOD.face.rx
       + '" ry="' + HOOD.face.ry + '" fill="#000" opacity="0.22"/></svg>';
}

function drawFigures(){
  var old = board.querySelectorAll(".fig");
  for (var i = 0; i < old.length; i++) old[i].remove();

  // ONE FIGURE SIZE FOR THE WHOLE BOARD, not one per rectangle. Sizing each cell to its own
  // tallest pile makes a four-acolyte duty draw smaller people than a one-acolyte duty, and the
  // row of piles the eye compares stops being comparable -- which is the one thing this drawing
  // is for. So the tallest pile anywhere sets the size and every cell uses it.
  // THE SEATS ARE THE BOARD'S PLAYERS, NOT THE HOOD TABLE'S NAMES. S.occupancy holds player ids
  // -- p1..p4 -- while the figure's own table is keyed sage/pewter/plum/bone. Keying the piles by
  // the hood's names found nothing and drew nobody, silently, which is what a board with four
  // empty duties looks like. GEO.players is the order; the swatch is taken by INDEX, so seat one
  // is sage whatever the board happens to call its first player.
  function countsFor(slug){
    var seats = S.occupancy[slug] || [], by = {};
    seats.forEach(function(s){ by[s] = (by[s] || 0) + 1; });
    return GEO.players.map(function(pl){ return by[pl.id] || 0; });
  }
  // ALL NINE RECTANGLES, NOT THE EIGHT DUTIES. The City is the ninth and it is the fullest, so
  // leaving it out of the sizing pass would size every figure on the board against a shorter
  // pile than the board actually draws.
  var CELLS = GEO.duties.map(function(d){ return d.slug; });
  if (GRIDPOS.city) CELLS.push("city");
  var tallest = 1;
  CELLS.forEach(function(slug){
    countsFor(slug).forEach(function(n){ tallest = Math.max(tallest, n); });
  });

  // AN ACOLYTE IS AS TALL AS THE PLATE OF ICONS BELOW HIS RECTANGLE, and that is the size the
  // figures are ASKED for rather than the size they are allowed. A figure and an icon plate are
  // the two objects a duty is read by, so giving them one height makes them read as one row of
  // things rather than as two sizes that nearly agree. The width follows from the height,
  // because the hood scales on one number.
  var fw = PLATE_H / HOOD.h, fh = 0;
  CELLS.forEach(function(slug){
    var r = GRIDPOS[slug];
    if (!r) return;
    // AND THE TWO OLD CAPS STAY, as caps. They were what SET the size until the plate started
    // asking for one, and they are still the two things that make a figure impossible: four of
    // them have to fit across the row, and the deepest pile has to fit down the rectangle. The
    // plate's height wins whenever it is the smallest of the three, which at the opening
    // settings it is -- but a narrow rectangle must still be allowed to shrink its people.
    // Four figures and three gaps of 0.24 of a figure is 4.72 figure widths, so the span divides
    // without a remainder.
    var w = (r.figRight - r.figLeft) / (4 + 3 * HOOD.gap);
    // THE WHOLE INNER HEIGHT, now that the feet are on the line. It used to take a clearance
    // off each end -- the gap the figures kept at the bottom, and the same again at the top for
    // symmetry -- and with the bottom gap gone there is nothing to subtract: the pile stands on
    // the inner bottom edge and has until the inner top edge.
    var cap = (r.height - 2 * CELL_BORDER)
              / (HOOD.h * (1 + HOOD.step * (tallest - 1)));
    fw = Math.min(fw, w, cap);
  });
  fh = fw * HOOD.h;
  if (fw < 3) return;                       // below this a hood is a smudge; draw nobody

  var step = fh * HOOD.step, lean = fw * HOOD.lean, gap = fw * HOOD.gap;
  CELLS.forEach(function(slug){
    var r = GRIDPOS[slug];
    if (!r) return;
    var counts = countsFor(slug);
    // STANDING ON THE LINE, NOT ABOVE IT. They kept a 6px clearance and the icon plate kept the
    // same below, which read as one gap around one rule; the feet are now flush to the inner
    // bottom edge and the plate keeps its drop. So there is no term here at all -- a zero would
    // be a number somebody could change, and there is nothing to change.
    var foot = r.y + r.height - CELL_BORDER;
    HOOD.order.forEach(function(seat, j){
      var n = counts[j] || 0;
      if (n <= 0) return;                   // drawn as nothing, and the others do not close up
      // CENTRED IN THE RECTANGLE, NOT ANCHORED TO ITS LEFT MARGIN. While the figures were sized
      // BY the row they filled it exactly and there was nothing to centre; sized by the plate
      // instead they come out narrower than the room -- 291 of 380 at the opening settings --
      // and the 89 left over has to be somewhere. Split, so the group sits over the middle of
      // its rectangle the way the icon plate sits under it. Anchored left it would have read as
      // people pushed against an edge, with the icons centred underneath disagreeing.
      // THE SAME 4.72 AS THE CAP ABOVE, deliberately written the same way: the row's width and
      // the width that would fill the row are one expression, so they cannot come apart.
      var slack = (r.figRight - r.figLeft) - fw * (4 + 3 * HOOD.gap);
      var x = r.figLeft + slack / 2 + j * (fw + gap);
      for (var i = 0; i < n; i++){
        var up = n - 1 - i;                 // 0 is the one standing on the line
        var side = up === 0 ? 0 : (up % 2 ? lean : -lean);
        var f = el("div", "fig", {left: px(x + side), top: px(foot - fh - up * step),
                                  width: px(fw), height: px(fh)});
        f.innerHTML = hoodSvg(seat, fw);
      }
    });
  });
}

// THE SLIDERS, AND THE ONLY THING ON THIS PAGE THAT MOVES THE BOARD. They rebuild the nine
// rectangles and nothing else: render() is not called, because none of the art, the marks or the
// status line depends on where these sit, and calling it on every input event would redraw
// fourteen pictures to move nine outlines.
function wireGrid(){
  var rg = document.getElementById("rGap");
  var rd = document.getElementById("rDisp");
  var rs = document.getElementById("rSize");
  var rt = document.getElementById("rHeight");
  var cb = document.getElementById("cBare");
  rg.value = GRID.gap; rd.value = GRID.disp; rs.value = GRID.size;
  rt.value = GRID.height;
  cb.checked = !!GRID.bare;
  function apply(){
    GRID.gap = +rg.value; GRID.disp = +rd.value; GRID.size = +rs.value;
    GRID.height = +rt.value;
    GRID.bare = cb.checked;
    document.getElementById("vGap").textContent = GRID.gap;
    document.getElementById("vDisp").textContent = GRID.disp;
    document.getElementById("vSize").textContent = GRID.size;
    document.getElementById("vHeight").textContent = GRID.height;
    drawGrid();
    // WHAT THE TWO NUMBERS COST, SAID OUT LOUD. Both sliders shrink the rectangles -- the gap
    // because it eats the row, the edge because the arrangement is inset to stay inside the
    // wheel -- so the size is the thing to watch while dragging, and it is the one number the
    // board itself cannot show.
    var cs = gridCells(), a = gridArea(), c = cs[0];
    // AND WHETHER IT STILL FITS. Over 100 on the size slider the block passes the margins and
    // #board clips it, so the readout says so rather than letting two rectangles quietly lose a
    // corner -- the same failure the edge slider was changed to avoid.
    var l = Math.min.apply(null, cs.map(function(k){ return k.x; }));
    var r = Math.max.apply(null, cs.map(function(k){ return k.x + k.width; }));
    var tp = Math.min.apply(null, cs.map(function(k){ return k.y; }));
    var bt = Math.max.apply(null, cs.map(function(k){ return k.y + k.height; }));
    var over = Math.max(a.x - l, r - (a.x + a.width), a.y - tp, bt - (a.y + a.height));
    // AND WHAT THE NINE COME TO, which is the number the eye cannot get off the page. The size
    // of one rectangle says what the sliders cost; the arrangement's own width and height say
    // whether the thing is the shape the board wants, and the two are not a fixed multiple of
    // each other -- the gap and the edge each change the second without changing the first in
    // the same proportion.
    // THE RECTANGLES' OWN EXTENT, NOT THE AREA THEY SIT IN, and the difference is easy to miss
    // in the worst way. gridArea() is the room; this is what was put in it, displacement and
    // all. At the opening defaults the room is 1344 x 842 and the arrangement is 1344 x 732 --
    // the SAME width, because width is the binding dimension and the block fills it exactly, and
    // 110 short on height. So a tag that reported the area would be indistinguishable from this
    // one on the number anybody would check first.
    var tag = document.getElementById("gridTag");
    // AND HOW MANY DUTIES LOST THEIR ICONS TO IT. The plates hang below the rectangles, so a
    // tall arrangement pushes the bottom row's plates off the board and they are refused rather
    // than cropped. Refusing is right and it is still a loss, so it is said here: three duties
    // quietly without icons is indistinguishable from three duties that have none.
    tag.textContent = Math.round(c.width) + " × " + Math.round(c.height)
                    + "  ·  wheel " + Math.round(r - l) + " × " + Math.round(bt - tp)
                    + (over > 0.5 ? "  past the margin by " + Math.round(over) : "")
                    + (PLATES_DROPPED ? "  ·  " + PLATES_DROPPED + " without room for icons"
                                      : "")
                    + (TITHES_DROPPED ? "  ·  " + TITHES_DROPPED + " without room for a resource"
                                      : "");
    tag.style.color = (over > 0.5 || PLATES_DROPPED || TITHES_DROPPED) ? "#d08c6a" : "";
  }
  rg.addEventListener("input", apply);
  rd.addEventListener("input", apply);
  rs.addEventListener("input", apply);
  rt.addEventListener("input", apply);
  // THE SEAT IS NOT A GRID SETTING AND IS WIRED APART FROM THEM. It changes nothing about the
  // arrangement -- no rectangle moves -- so it does not belong in apply(), which rebuilds the
  // nine and re-measures them. It changes WHOSE box is drawn, which is render()'s business.
  var seat = document.getElementById("rSeat");
  GEO.players.forEach(function(pl){
    var o = document.createElement("option");
    o.value = pl.id; o.textContent = pl.name || pl.id;
    seat.appendChild(o);
  });
  seat.value = S.seat;
  seat.addEventListener("change", function(){
    S.seat = seat.value; reconcile(); render();
  });
  cb.addEventListener("change", apply);
  apply();
}

// =================================================================================================
// WHAT CLICKING DOES. In play a click chooses; while images are being replaced a click on a slot
// opens the picker instead. One mode switch rather than two gestures to remember.
// =================================================================================================
// THE INTERFACE SOUNDS
//
// WEB AUDIO, NOT <audio> ELEMENTS, and the reason is the hover. Eight tiles on a ribbon means a
// pointer crossing them fires eight cues inside a second; one <audio> element restarts and cuts
// itself off, and eight of them is a pool to manage. A decoded buffer can be fired as many times
// as you like, overlapping, from one copy in memory.
//
// DECODED AT LOAD, RESUMED ON THE FIRST GESTURE, and those are two different rules that are easy
// to collapse into one and get wrong. A browser will not let audio SOUND before a gesture, so a
// context built now is born suspended -- but building it now is exactly what we want, because
// decoding is asynchronous. Waiting for the first click to start decoding makes that first click
// silent and the second one work, which reads as a broken cue rather than as a policy.
//
// So: the context and the buffers are made at load, and the first click resumes a context that
// already has everything it needs. The first hover of a fresh page is still silent, and nothing
// can change that.
//
// ONE CLIP SERVES HOVER AND SELECTION, at two gains. They are the same event at two strengths --
// the pointer passing over a duty, and the duty being taken -- so the same mark of sound at a
// quarter of the level reads as a quieter version of the same thing rather than a second idea.
var SFX = __SFX__;
// THE CLIPS ARE AT THEIR NATURAL LEVEL, so these gains mean what they say. An earlier cut was
// peak-normalised to -1 dBFS, which lifted the confirm 3.1 dB above the level it has in the
// montage and made the board's version of it plainly louder than the one that was chosen in the
// picker. Normalising one-shots that were recorded together throws away the thing you were
// listening to -- how loud they are RELATIVE to each other.
//
// THE PICKER'S SLIDER WAS THE OLD ANSWER AND IT WAS THE WRONG QUESTION. 0.7 was the volume the
// confirm was auditioned at in the picker, carried over so the board matched it. The picker plays
// one cue against silence; the board plays it over a looping soundscape. Against the beds the
// confirm stood 7.8 dB over the loudest moment of a mix that twelve stems were levelled into. A
// cue is feedback that a click registered, not the loudest thing in the room.
//
// AND IT WAS HALF THE BOARD'S HEADROOM. ambientMaster gates the beds and the cues bypass it --
// group -> fade -> bedMaster -> destination for one, source -> gain -> destination for the other
// -- so at 0.7 the confirm alone reached -4.48 dBFS and held 49% of the peak budget while eleven
// ambient actions shared the other 51%. The provable worst case, two actions crossfading with a
// confirm on top, came to +1.71 dBFS. At 0.32 it is -0.97. ambientMaster did not move: buying the
// same margin there would have cost -8.5, four decibels off every soundscape in the game.
//
// THE RATIO BETWEEN THEM IS KEPT. Both came down about 6.8 dB, so confirm still sits 3.1 dB over
// select, exactly as it did at 0.7 and 0.5. The two clips are nearly the same peak -- -1.4 and
// -1.6 dBFS -- so that difference was always the gain and never the recording.
// NO HOVER. There were three cues and the first fired on the pointer merely crossing a tile,
// which is not something a player did -- the ribbon answers a hover with light already, and a
// noise on top of it makes a slow sweep across eight duties into a stutter. Selecting and
// confirming are the two moments that are an act, and those are the two that sound.
var SFX_GAIN = {select: 0.23, confirm: 0.32};
var SFX_ON = true, actx = null, BUF = {};

// THE AMBIENT BEDS. A duty action is a place, and choosing it should put you in that place --
// which is a different kind of sound from a cue and is built differently all the way down.
//
// THEY ARE FETCHED, NOT CARRIED. generate_action_board.py's bundled_beds() explains the size
// arithmetic; what matters here is the consequence: a page opened from disk has its cues and no
// beds, and bedNote() says so in the note line rather than leaving the quarry mysteriously quiet.
var BEDS = __BEDS__;
var BED_SILENT = BEDS.__silent__ || [];
var BED_MASTER_DB = BEDS.__master__ || 0;
// "start" or "random" -- where a LOOPING bed enters its clip. The generator's BED_START says
// which, and why the answer used to be the other one.
var BED_START = BEDS.__start__ || "start";
// 1.5 SECONDS, AND IT IS ONE TRANSITION RATHER THAN TWO. The outgoing action fades out while the
// incoming fades in over the same second and a half, so the change takes 1.5 s end to end and not
// 3. EQUAL POWER, NOT LINEAR: two beds that are not the same recording do not cancel, so their
// POWERS add, and a linear pair sums to 0.5 of the power at the midpoint -- an audible 3 dB dip
// in the middle of every switch. sin and cos hold the sum at 1.
var BED_FADE_S = 1.5;
var BED_KEEP = 3;               // actions whose buffers stay decoded; see bedEvict()

var bedBuf = {}, bedWant = {}, bedVoice = {}, bedUse = [], bedOn = null, bedMaster = null;

function bedDb(db){ return Math.pow(10, db / 20); }

// AN EQUAL-POWER CURVE, HANDED OVER WHOLE. setValueCurveAtTime takes the shape as samples, which
// is the only way to get a cosine out of a parameter that otherwise ramps linearly or
// exponentially -- and exponentialRamp cannot reach zero at all, so it cannot fade anything out.
function bedCurve(up){
  var n = 65, c = new Float32Array(n);
  for (var i = 0; i < n; i++) {
    var t = (i / (n - 1)) * Math.PI / 2;
    c[i] = up ? Math.sin(t) : Math.cos(t);
  }
  return c;
}

function bedReady(){
  if (!actx) return false;
  if (!bedMaster) {
    bedMaster = actx.createGain();
    bedMaster.gain.value = bedDb(BED_MASTER_DB);
    bedMaster.connect(actx.destination);
  }
  return true;
}

// ONE FETCH PER FILE, HOWEVER MANY TIMES IT IS ASKED FOR. Hover prefetches and selection asks
// again a moment later; without this the second ask would start a second download of the same
// 2 MB and decode it twice.
function bedLoad(url){
  if (bedBuf[url]) return Promise.resolve(bedBuf[url]);
  if (bedWant[url]) return bedWant[url];
  bedWant[url] = fetch(url).then(function(r){
    if (!r.ok) throw new Error(r.status + " on " + url);
    return r.arrayBuffer();
  }).then(function(b){
    return new Promise(function(res, rej){ actx.decodeAudioData(b, res, rej); });
  }).then(function(buf){
    bedBuf[url] = buf; delete bedWant[url]; return buf;
  })["catch"](function(e){ delete bedWant[url]; throw e; });
  return bedWant[url];
}

function bedPrefetch(key){
  if (!bedReady() || !BEDS[key]) return;
  BEDS[key].beds.forEach(function(b){ bedLoad(b.url)["catch"](function(){}); });
}

// 35 SECONDS OF STEREO AT 48 kHz IS 13.4 MB DECODED, and the eleven sounded actions come to 847
// MB between them. Nothing keeps them all; the three most recently used stay, which covers the
// one playing, the one fading out, and the one you are about to go back to.
function bedEvict(){
  while (bedUse.length > BED_KEEP) {
    var gone = bedUse.shift();
    if (gone === bedOn || !BEDS[gone]) continue;
    BEDS[gone].beds.forEach(function(b){ delete bedBuf[b.url]; });
  }
}

function bedStop(key, at){
  var v = bedVoice[key];
  if (!v) return;
  delete bedVoice[key];
  v.fade.gain.cancelScheduledValues(at);
  v.fade.gain.setValueCurveAtTime(bedCurve(false), at, BED_FADE_S);
  v.sources.forEach(function(s){ try { s.stop(at + BED_FADE_S + 0.05); } catch (e) {} });
  setTimeout(function(){ try { v.fade.disconnect(); } catch (e) {} }, (BED_FADE_S + 0.5) * 1000);
}

// THE FADE IS ITS OWN NODE AND IT SITS ABOVE THE GROUP. The group gain is the duty action's own
// level, the thing that gets set by ear, and a fade written onto it would be fighting whatever
// that level is at the moment the switch happens -- set it mid-crossfade and the ramp would snap.
// Two nodes keep them independent: the group says how loud this place is, the fade says how far
// in you are. And because the group is ONE node above every bed in the action, moving it cannot
// change the balance between them.
function bedStart(key, at){
  var spec = BEDS[key];
  var fade = actx.createGain(), group = actx.createGain();
  fade.gain.setValueAtTime(0, at);
  fade.gain.setValueCurveAtTime(bedCurve(true), at, BED_FADE_S);
  group.gain.value = bedDb(spec.groupDb || 0);
  group.connect(fade); fade.connect(bedMaster);
  var v = {fade: fade, group: group, sources: []};
  bedVoice[key] = v;
  spec.beds.forEach(function(b){
    var buf = bedBuf[b.url];
    if (!buf) return;
    var s = actx.createBufferSource(), g = actx.createGain();
    s.buffer = buf;
    // A BED IS NOT ALWAYS A LOOP, AND attribution.json HAS SAID SO ALL ALONG. `loop: false` is on
    // door_close and distant_rooster, the ambient bench reads it and comes up with those boxes
    // unticked, and this player set every source to loop regardless -- so Mission's door, which
    // is one door shutting in 36 seconds of silence, shut again every 36 seconds for as long as
    // you stood there. Absent means looping; only a record that says otherwise does otherwise.
    s.loop = b.loop !== false;
    // PINNED TO THE FILE'S OWN LENGTH, NOT THE BUFFER'S. decodeAudioData returns 4 to 17 ms of
    // Vorbis padding past the true end, and looping on buf.duration wraps through it every time:
    // a hole at -64.7 dB under a bed sitting at -33, once per loop, on every bed. The real length
    // is read out of the container at build time -- see ogg_seconds() -- because the decoder is
    // the one thing that cannot tell you. Set on every source; a non-looping one ignores them.
    s.loopStart = 0;
    s.loopEnd = b.seconds || buf.duration;
    g.gain.value = bedDb(b.gainDb || 0);
    s.connect(g); g.connect(group);
    // WHERE TO ENTER THE CLIP, AND A ONE-SHOT HAS NO SAY IN IT. BED_START is the board's choice
    // for LOOPING beds: "random" keeps the scene from being a recording you have heard -- started
    // at 0 every time, Produce Stone's owl calls exactly 20.4 s after every selection -- and
    // "start" puts every bed at its own beginning.
    //
    // THE GUARD IS HERE AND NOT IN THE SETTING. A clip that does not loop has one pass, so an
    // entry point partway in does not vary it, it truncates it: door_close is one door at 2.997 s
    // of 36, distant_rooster a rooster at 1.975 s of 35, and a uniform random entry missed them
    // 92% and 94% of the time. The two tracks whose whole job was to sound at the start of a
    // scene were the two least likely to sound at all. So `s.loop` decides, not the constant.
    s.start(at, (s.loop && BED_START === "random") ? Math.random() * s.loopEnd : 0);
    v.sources.push(s);
  });
}

// WHAT IS SELECTED IS WHAT PLAYS, asked from render() rather than from the three click handlers.
// pickDuty, pickAction and select all reach the same two fields and all call render(), so one
// test here covers every route in -- including the one that sets no action at all, where the
// right answer is silence.
function bedsFollow(){
  if (!SFX_ON || !bedReady()) return;
  var key = (S.duty && S.slot) ? (S.duty + "_" + S.slot) : null;
  if (key && !BEDS[key]) key = null;          // a slot with no folder; BED_SILENT names them
  if (key === bedOn) return;
  var at = actx.currentTime;
  if (bedOn) bedStop(bedOn, at);
  bedOn = key;
  if (!key) return;
  var urls = BEDS[key].beds.map(function(b){ return b.url; });
  bedUse = bedUse.filter(function(k){ return k !== key; }); bedUse.push(key); bedEvict();
  Promise.all(urls.map(bedLoad)).then(function(){
    // STILL THE ONE SELECTED? A decode can take a second on an action with eleven beds, and in
    // that second the player may have moved on. Starting it then would fade in a place nobody is
    // standing in any more.
    if (bedOn !== key || bedVoice[key]) return;
    bedStart(key, actx.currentTime);
  })["catch"](function(e){ bedNote(String(e && e.message || e)); });
}

// SAYING SO IS PART OF THE FEATURE. A board opened by double-clicking fetches nothing, so the
// cues work and the ambience does not, and the difference between that and a bug is this line.
function bedNote(why){
  var n = document.getElementById("note");
  if (!n || n.textContent.indexOf("click anywhere once") >= 0) return;
  n.textContent = (location.protocol === "file:")
    ? "the duty action ambience needs the page served — run the generator with --serve; the interface sounds work either way"
    : ("the ambience could not load — " + why);
}

function sfxWake(){
  if (actx) return;
  var C = window.AudioContext || window.webkitAudioContext;
  if (!C) return;
  actx = new C();
  Object.keys(SFX).forEach(function(k){
    var raw = atob(SFX[k].split(",")[1]);
    var b = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) b[i] = raw.charCodeAt(i);
    actx.decodeAudioData(b.buffer, function(buf){ BUF[k] = buf; }, function(){});
  });
}
// THE CUE IS NAMED, THE CLIP IS LOOKED UP. `tile` is one file today and the page asks for
// "hover" and "select"; swapping either to its own file is a line in the generator, not here.
// ONE GESTURE ANYWHERE UNLOCKS IT, AND THERE MUST BE ONE. A browser keeps a page silent until it
// has been clicked or typed into, and MOVING a pointer is not a gesture -- so the first hover of a
// freshly loaded board cannot make a sound, whatever this file does. That is not a bug to fix, it
// is a rule to be honest about.
//
// What IS fixable is the surprise. Any pointerdown or keydown anywhere on the document unlocks it,
// so the bar, the background and the f key all count and you do not have to find a tile; and until
// it happens the board says so in its own note line rather than in a tooltip nobody hovers.
function sfxUnlock(){
  removeEventListener("pointerdown", sfxUnlock, true);
  removeEventListener("keydown", sfxUnlock, true);
  sfxWake();
  // AND THE BED THE BOARD IS ALREADY SITTING ON. The page restores its last selection before any
  // gesture has happened, so by the time sound is allowed the render that would have started the
  // ambience is long past. Without this the board opens on Produce Stone in silence and stays
  // there until you pick something else.
  if (actx && actx.state === "suspended") actx.resume().then(function(){ sfxBadge(); bedsFollow(); },
                                                             sfxBadge);
  else { sfxBadge(); bedsFollow(); }
}
addEventListener("pointerdown", sfxUnlock, true);
addEventListener("keydown", sfxUnlock, true);

function sfxBadge(){
  var b = document.getElementById("bSound");
  if (!b) return;
  var live = !!actx && actx.state === "running";
  b.setAttribute("aria-pressed", String(SFX_ON));
  b.title = !SFX_ON ? "interface sounds are off"
          : live ? "interface sounds"
          : "click or press a key anywhere first — a browser keeps a page silent until you do";
  b.textContent = (SFX_ON && !live) ? "sound ·" : "sound";
  // IN THE NOTE LINE, WHERE IT WILL BE READ. A tooltip explains this only to somebody who already
  // suspects the button, and the person it needs to reach is the one who just hovered the ribbon
  // and heard nothing. The line clears itself the moment the first gesture lands.
  var n = document.getElementById("note");
  if (!n) return;
  if (SFX_ON && !live) n.textContent = "sound is ready — click anywhere once to let the browser play it";
  else if (n.textContent.indexOf("click anywhere once") >= 0) n.textContent = "";
}

function sfx(cue){
  if (!SFX_ON || !actx) return;
  // THE CUE IS THE KEY NOW. This used to read `cue === "confirm" ? "confirm" : "tile"` -- a
  // ternary that quietly answered every cue that was not confirm with the tile clip, so a
  // misspelled cue made a sound instead of nothing and `hover` and `select` shared a file by
  // arrangement rather than by lookup. The generator decides what is behind a name; this asks.
  var buf = BUF[cue];
  if (!buf) return;
  if (actx.state === "suspended") actx.resume();
  var s = actx.createBufferSource(), g = actx.createGain();
  s.buffer = buf; g.gain.value = SFX_GAIN[cue] || 0.5;
  s.connect(g); g.connect(actx.destination); s.start();
}

// A DUTY WITH ONE ACTION HAS NOTHING TO CHOOSE, so choosing the duty chooses it. Taxation and
// Allocation have one each -- duty_text.json is what says so, and this asks it rather than
// naming them, so a duty gaining or losing a second action needs no edit here.
//
// WITHOUT THIS the board could sit on Taxation with Taxation's only action unchosen -- an unlit
// card and a dashed mark, which is a question with exactly one answer.
function onlySlot(slug){
  var info = dutyOf(slug);
  return (info && info.actions === 1) ? "actionA" : null;
}
// A REFUSED PRESS, WHICH ANSWERS AND CHANGES NOTHING.
//
// IT COSTS YOU NOTHING YOU HAD. The state is not touched -- not the duty being looked at, not the
// chosen action, not the resource -- so pressing a tile you cannot take does not put down a
// choice you had already made somewhere you can. A press that both refuses you AND takes your
// answer away would be the worst of both: you learn you cannot do this, and you have to redo the
// thing you could.
//
// AND IT IS SILENT. `sfx("select")` is the sound of a choice being made and nothing was chosen;
// played here it would be the board sounding exactly as it does when it accepts you. A refusal
// cue of its own was considered and not added -- it is an asset with a measured trim and a
// record, and a line that answers you is not confusing.
//
// THE LINE IS THE WHOLE OF IT, WHICH IS REDUNDANT ON A MOUSE AND ESSENTIAL ON A TOUCH SCREEN. A
// pointer hovering the tile has already been told by lineFor; a finger has no hover at all, so
// without this the tile would be the one object on the board that answers a tap with nothing.
// Taking the hover state is deliberate rather than a convenience: a tap IS the pointer arriving,
// and leaving the tile clears it by the route a mouse leaving already uses.
function explain(slug, slot){
  hovered = {duty: slug, slot: slot || null};
  setStatus();
  lightFace(slug);
}
// THE SAME REFUSAL FOR AN OBJECT THAT IS NOT A DUTY. The Take Tithe box has no duty to hand to
// lineFor, so it carries its sentence instead of being described by one; see setStatus.
function explainWhy(why){
  hovered = {why: why};
  setStatus();
  lightFace(null);
}
function pickDuty(slug){
  if (S.editing) return;
  if (!eligible(slug)) return explain(slug, null);
  sfxWake(); sfx("select");
  S.duty = slug; S.slot = onlySlot(slug);
  S.tithe = null;
  render();
}
function slotOrSelect(slot){
  if (S.editing) return pickFile({kind: "art", duty: S.duty, slot: slot});
  select(slot);
}
function slotClick(ev){
  ev.stopPropagation();
  var d = ev.currentTarget.dataset;
  if (S.editing) return pickFile({kind: d.kind, duty: d.duty || S.duty, slot: d.slot});
  // A MARK IS ITS ACTION, IN ONE CLICK, WHEREVER YOU WERE STANDING.
  //
  // It used to depend on where you already were: on a duty you were not on, the click chose the
  // DUTY and left the action unanswered, so a second click was needed to reach the action. That
  // was a trade against the ribbon's geometry, and the ribbon is gone. The reasoning was that
  // two marks covered 52% of a tile -- 39x39 each inside 57x101, stacked top and bottom -- so
  // aiming at a tile and hitting an action was the usual case rather than the odd one, and
  // which action you got depended on whether you had clicked high or low.
  //
  // THE MARKS ARE NOT ON THE TILE ANY MORE. They sit on a plate BELOW the rectangle, outside
  // the element, and the rectangle is its own clean target for "which duty". The two questions
  // now have two separate places to be asked, so the mark can answer its own without ever
  // being hit by somebody aiming at the tile.
  //
  // AND THE OLD RULE WAS VISIBLY INCONSISTENT. `pickDuty` answers the slot itself when a duty
  // has ONE action, so Allocation and Taxation lit their picture on the first click while the
  // other six did not -- the same gesture doing two different things depending on a property of
  // the duty you cannot see from the mark you are clicking.
  if (!d.duty) return;
  pickAction(d.duty, d.slot);
}
// A CLICK CHOOSES; IT DOES NOT UN-CHOOSE. Both of these used to toggle, so pressing the same
// mark or the same card twice put the action back down. That was invisible while nothing marked
// the choice and obvious the moment the chosen mark started holding a solid edge: the second
// press read as a misfire rather than as an undo.
//
// BOTH, NOT JUST THE MARK. The mark and the card below it set the same fact by different routes,
// and one that toggles beside one that does not is the same click behaving two ways depending on
// where you aimed it. The Tithe NO LONGER comes through here -- it has its own route below,
// because choosing it now means choosing a resource as well and that is more than a slot.
//
// Nothing is lost: "no action chosen" is still reached, by picking another duty, which is the
// only time it means anything -- you have been asked which of the two.
// AND IT SAYS SO. The cue belonged to pickAction alone -- the route the duty-action ICONS take
// -- so clicking the picture of an action chose it in silence while clicking its mark did not.
// Two ways to make the same choice, one of them audible, which reads as the sound being broken
// rather than as a route that skips it. The Tithe comes through here too and gets it for the
// same reason: it is a choice of what to do this turn, like the other two.
//
// AND IT PUTS THE RESOURCE DOWN. S.slot and S.tithe are two halves of one answer -- "I am taking
// a tithe, and it is stone" -- so choosing an action has to clear the second or the board keeps a
// resource chosen underneath an action, and the commit gate reads a stale yes.
// AND THE THIRD ROUTE IS GUARDED TOO, which is not the same test as the other two. The cards
// above belong to whatever duty is being looked at, and a change of SEAT can make that duty
// ineligible without anything being clicked -- so this asks about S.duty where pickDuty and
// pickAction ask about the duty in the press. Missing it would leave the one route to a choice
// that does not go through a tile able to choose an action the tiles refuse.
function select(slot){
  if (!eligible(S.duty)) return explain(S.duty, slot);
  sfxWake(); sfx("select"); S.slot = slot; S.tithe = null; render();
}

// TAKING THE TITHE, which is a different shape from choosing an action and now has its own door.
//
// IT REFUSES AN EMPTY POOL rather than selecting nothing. A seat with no figures on any tile that
// offers a resource -- or figures only on Taxation -- has no tithe to take, and a box that lit up
// on a press while offering nothing would be the board accepting a move that cannot be made.
// AND IT SAYS SO NOW, WHICH IT DID NOT. The press was refused in silence with nothing on the
// board changed, so an empty box and a box that had not understood the click looked the same.
//
// "No Tithe to take" WAS HERE ONCE AND WAS REMOVED AS UNREACHABLE, so its return needs saying:
// that line lived in phaseLine(), keyed on having CHOSEN a tithe with an empty pool, which is a
// state this board cannot enter. This is a different thing on a different route -- what the
// board answers when you PRESS a box that has nothing in it -- and it is reachable by definition,
// because the press is what reaches it.
function takeTithe(){
  if (S.editing) return;
  if (!tithePool(S.seat).length) return explainWhy(GEO.lines.noTithe);
  sfxWake(); sfx("select");
  S.slot = TITHE_SLOT;
  S.tithe = onlyTithe();
  render();
}

// WHAT A CHANGE OF SEAT DOES TO A TITHE ALREADY CHOSEN, which is not nothing.
//
// The pool belongs to the seat, so changing seat can take the chosen resource away -- and can
// empty the pool altogether. Left alone, the board sat with the Take Tithe box lit and NOTHING
// IN IT, offering a confirm for a move the new seat cannot make. So the two halves are
// reconciled against the new pool: a resource that is no longer in it falls back to whatever the
// pool answers by itself, and a pool with nothing in it puts the whole choice down.
//
// ONLY WHERE THE SEAT CHANGES. render() must not do this -- it is called from everywhere and a
// render that quietly rewrites the state is a render nobody can reason about.
function reconcileTithe(){
  if (S.slot !== TITHE_SLOT){ S.tithe = null; return; }
  var pool = tithePool(S.seat);
  if (!pool.length){ S.slot = null; S.tithe = null; return; }
  if (pool.indexOf(S.tithe) < 0) S.tithe = onlyTithe();
}

// AND WHAT THE SAME CHANGE DOES TO A DUTY ACTION ALREADY CHOSEN, which is the same hole one
// object over. Eligibility belongs to the seat and to the phase, so both of the things that can
// change underneath you -- picking another seat, moving to Action Selection -- can take away the
// right to the action you had chosen. Left alone the board kept the commit up over a move the
// new state refuses, which is the identical failure reconcileTithe was written for.
//
// THE DUTY STAYS; ONLY THE CHOICE GOES. S.duty is what you are LOOKING at and the cards above
// belong to it, so clearing it would empty the board's largest two objects to say something
// about a small one. The action is what you had chosen, and that is what is no longer yours.
//
// NOTHING IS CHOSEN IN ITS PLACE. reconcileTithe falls back to onlyTithe() because a pool of one
// has a single answer and offering it is not a decision; there is no equivalent here -- picking
// some other duty's action for you would be the board taking your turn.
function reconcileDuty(){
  if (!S.slot || S.slot === TITHE_SLOT) return;
  if (!eligible(S.duty)) S.slot = null;
}

// BOTH, ALWAYS, FROM ONE NAME. These answer for the two halves of what may be chosen and they are
// invalidated by exactly the same events, so a call site that remembered one and forgot the other
// would leave half the board stale -- and that is not a hypothetical: the tithe half shipped
// first and the seat picker called it alone.
function reconcile(){ reconcileTithe(); reconcileDuty(); }

// AND CHOOSING WHICH RESOURCE, from inside the box. One click answers both halves, the way a
// duty action mark answers both its duty and its slot.
function titheClick(ev){
  ev.stopPropagation();
  if (S.editing) return;
  var key = ev.currentTarget.dataset.tithe;
  if (!key) return;
  sfxWake(); sfx("select");
  S.slot = TITHE_SLOT; S.tithe = key;
  render();
}
// ONE RENDER, NOT TWO. pickDuty followed by select() would do the same work -- pickDuty sets the
// duty and answers the slot for it, then select overwrites that answer -- and draw the whole
// board twice on the way, once on a slot nobody asked for.
function pickAction(duty, slot){
  if (S.editing) return;
  if (!eligible(duty)) return explain(duty, slot);
  sfxWake(); sfx("select");
  S.duty = duty;
  S.slot = slot;
  // AND THE RESOURCE GOES DOWN WITH IT, for the reason select() states. This was missed when
  // select() was given the line and pickAction was not: choosing an action by its MARK left the
  // tithe resource set underneath it while choosing the same action by its PICTURE cleared it --
  // two routes to one fact disagreeing, which is the exact failure both of them exist to avoid.
  S.tithe = null;
  render();
}

function render(){
  GEO.duties.forEach(function(d){
    var tile = document.getElementById("tile-" + d.slug);
    // AND NOT WHILE A TITHE IS BEING TAKEN. Taking a tithe moves nobody and depends on no duty,
    // so the duty you happened to be looking at is not chosen -- and a board wearing the gold rim
    // on Construct while the Take Tithe box is also lit is claiming two answers to a question
    // that has one. The cards above stay up, because they are what you are BROWSING; the rim is
    // what says CHOSEN, and only one thing can be.
    var chosen = d.slug === S.duty && S.slot !== TITHE_SLOT;
    if (tile) tile.classList.toggle("sel", chosen);
    // AND THE GRID, FROM THE SAME LINE. Two loops would be two answers the first time one of
    // them was edited; this is the rule lightFace() already states for the hover pair.
    var face = document.getElementById("dcell-" + d.slug);
    if (face) face.classList.toggle("sel", chosen);
  });
  // THE CHOSEN ACTION'S MARK, ASKED HERE AND NOT IN THE CLICK HANDLER. S.slot is reached three
  // ways -- the mark, the card below it, and picking a duty, which either clears it or, for a
  // duty with one action, chooses that one -- and a class set where it is CLICKED would be right
  // on one of them. Set from the state, like everything else in render(), and all three are
  // answered at once.
  //
  // BOTH HALVES OF THE QUESTION. Matching the slot alone would leave the same-named mark solid in
  // every other duty's tile, which looks like eight choices rather than one.
  //
  // AND THE RESOURCES ARE IN THE SAME LOOP, by the same two-part test. A tmark is not a .seal --
  // the art machinery must not find it -- but it is chosen the same way and lit by the same
  // rule, and asking the question twice in two loops is how the two answers come apart the first
  // time one of them is edited.
  Array.prototype.forEach.call(document.querySelectorAll("#board .seal, #board .tmark"),
                               function(s){
    s.classList.toggle("on", s.dataset.duty === S.duty && s.dataset.slot === S.slot);
  });
  // THE TITHE BOX, FROM THE SAME STATE THE ACTION CARDS ARE DRAWN FROM. It is reached three ways
  // now -- the box itself, a resource on any of the seven tiles that have one, and nothing else
  // -- so like every other cue on this board it is set from S.slot here rather than where it was
  // clicked, and all the routes agree without any of them knowing about the others.
  var tbox = document.getElementById("tithe");
  if (tbox) tbox.classList.toggle("sel", S.slot === TITHE_SLOT);
  markStanding();
  drawTithe();
  var info = dutyOf(S.duty);
  ["actionA","actionB"].forEach(function(slot){
    var art = document.getElementById("art-" + slot);
    var a = info && info[slot];
    var has = a && a.art && IMAGES[a.art];
    art.innerHTML = "";
    art.style.display = (info && info.actions === 1 && slot === "actionB") ? "none" : "";
    if (has){
      var im = document.createElement("img"); im.src = IMAGES[a.art]; art.appendChild(im);
    } else {
      var ph = document.createElement("div"); ph.className = "ph";
      ph.innerHTML = "<b>" + ((a && a.name) || "no second action") + "</b>" +
                     (a && a.name ? "<span>no picture yet &mdash; drop one here</span>" : "");
      art.appendChild(ph);
    }
    if (a && a.name){
      var nm = document.createElement("div"); nm.className = "nm";
      nm.style.fontSize = px(GEO.art.capSize);
      // capLh was exported and never applied, so the caption took the body's 1.4 and CAP_H was
      // computed from a line height the page did not use. It is applied now because Take Tithe
      // shares this line, and two line heights would put the row half a pixel out.
      nm.style.lineHeight = String(GEO.art.capLh);
      nm.style.padding = GEO.art.capPadY + "px " + GEO.art.capPadX + "px";
      nm.textContent = a.name;
      art.appendChild(nm);
    }
    var lift = document.createElement("div"); lift.className = "lift"; art.appendChild(lift);
    art.classList.toggle("sel", S.slot === slot);
  });
  // THE COMMIT APPEARS WHEN THERE IS SOMETHING TO COMMIT, which is what the confirm buttons it
  // replaced did -- one per card and one under the Tithe, each drawn only while its own slot was
  // chosen. One mark serves all three now, so the condition is simply that a slot is chosen at
  // all. S.slot is null until a duty with one action selects its own, so the board can open with
  // the column showing two marks rather than three.
  // AND A TITHE IS NOT COMMITTABLE UNTIL IT NAMES A RESOURCE. `S.slot` alone used to be the
  // whole question, because every answer it could hold was complete; a tithe is two halves, and
  // offering the confirm on the first of them would let you commit a choice you have not made.
  // A pool of one answers itself, so this is never in the way of the common case.
  var ready = S.slot && !(S.slot === TITHE_SLOT && !S.tithe);
  document.getElementById("mark-" + COMMIT).classList.toggle("off", !ready);
  setStatus();
  bedsFollow();
}

// =================================================================================================
// REPLACING A PICTURE. The page keeps the ORIGINAL bytes, never the copy it is displaying: the
// board draws at 590 x 295 and a save that posted what it was showing would quietly put a small
// JPEG over a 1120 x 560 master. The downscaling is the generator's job and happens once, at
// build time, on the way in.
var PENDING = [];
function pickFile(target){
  var inp = document.createElement("input");
  inp.type = "file"; inp.accept = "image/png,image/jpeg,image/webp";
  inp.addEventListener("change", function(){ if (inp.files[0]) takeFile(inp.files[0], target); });
  inp.click();
}
function wireDrop(e){
  e.addEventListener("dragover", function(ev){ ev.preventDefault(); e.classList.add("drop"); });
  e.addEventListener("dragleave", function(){ e.classList.remove("drop"); });
  e.addEventListener("drop", function(ev){
    ev.preventDefault(); ev.stopPropagation(); e.classList.remove("drop");
    var f = ev.dataTransfer.files[0]; if (!f) return;
    var d = e.dataset;
    takeFile(f, {kind: d.kind, duty: d.duty || S.duty, slot: d.slot});
  });
}
function takeFile(file, target){
  var r = new FileReader();
  r.onload = function(){
    var rec = {kind: target.kind, duty: target.duty, slot: target.slot,
               filename: file.name, bytes: r.result};
    PENDING = PENDING.filter(function(p){
      return !(p.kind === rec.kind && p.duty === rec.duty && p.slot === rec.slot);
    });
    PENDING.push(rec);
    // Shown at once from the original; the browser scales it to the box. The bytes kept for the
    // save are untouched.
    // NO "token" KIND ANY MORE. The Tithe's three resources were the only droppable thing that
    // was not a duty's art or seal, and nothing on the board carries that kind now.
    var key = rec.kind === "seal" ? ("seal:" + rec.duty + ":" + rec.slot)
                                  : ("art:" + rec.duty + ":" + rec.slot);
    IMAGES[key] = r.result;
    var info = dutyOf(rec.duty);
    if (info && info[rec.slot]) info[rec.slot][rec.kind === "seal" ? "seal" : "art"] = key;
    note(PENDING.length + " picture(s) waiting to be saved");
    board.innerHTML = ""; draw();
  };
  r.readAsDataURL(file);
}

function manifest(){
  var art = {}, seals = {};
  Object.keys(DUTIES).forEach(function(slug){
    ["actionA","actionB"].forEach(function(slot){
      var a = DUTIES[slug][slot];
      if (a && a.artFile) art[slug + "/" + slot] = a.artFile;
      if (a && a.sealFile) seals[slug + "/" + slot] = a.sealFile;
    });
  });
  return {art: art, seals: seals,
          acolytes: S.occupancy, city: S.city,
          selected: {duty: S.duty, slot: S.slot}};
}

// TWO PATHS, ONE KEY LIST. Served, this POSTs and the generator writes the files and the record.
// Opened as a file it can only download, and it says so -- but it writes the SAME keys, because
// both read them from SAVE, which the generator filled in from its own constants.
function doSave(){
  var payload = {manifest: pick(manifest(), SAVE.manifest),
                 images: PENDING.map(function(p){ return pick(p, SAVE.image); })};
  if (location.protocol === "http:" || location.protocol === "https:"){
    fetch("/save", {method: "POST", headers: {"Content-Type": "application/json"},
                    body: JSON.stringify(payload)})
      .then(function(r){ return r.json(); })
      .then(function(j){
        if (j.ok){ PENDING = []; note("saved: " + j.files.join(", ")); }
        else note("the save was refused: " + (j.error || "no reason given"));
      })
      .catch(function(e){ note("the save could not be sent: " + e); });
  } else {
    download(SAVE.manifestFile.split("/").pop(), JSON.stringify(payload.manifest, null, 1));
    note("downloaded the manifest only -- run with --serve to write into the repository, "
         + "and to have the " + PENDING.length + " new picture(s) filed and recorded.");
  }
}
function pick(o, keys){
  var out = {};
  keys.forEach(function(k){ if (o[k] !== undefined) out[k] = o[k]; });
  return out;
}
function download(name, text){
  var a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([text], {type: "application/json"}));
  a.download = name; a.click(); URL.revokeObjectURL(a.href);
}
function note(t){ document.getElementById("note").textContent = t || ""; }

// =================================================================================================
function drawPhases(){
  var holder = document.getElementById("phases");
  // REBUILT, NOT ADDED TO. This function is its own click handler, so without this line every
  // click appended a second set of phase buttons and the row grew by three each time. The loop
  // that used to sit at the end then walked holder.children against GEO.phases[i], which is
  // shorter, threw on the undefined, and took note() and setStatus() down with it -- so the
  // phase line silently stopped updating as well. One clear fixes both.
  holder.textContent = "";
  GEO.phases.forEach(function(p){
    var b = document.createElement("button");
    b.textContent = p.label;
    b.setAttribute("aria-pressed", String(p.key === S.phase));
    b.addEventListener("click", function(){
      S.phase = p.key;
      // AND THE PHASE IS NOW PART OF WHAT MAY BE CHOSEN, so changing it reconciles and redraws
      // like changing seat does. It used to set the line and nothing else, which was right while
      // the phase was a label: eligibility reads the phase, so leaving this at setStatus() would
      // have left the frames marked for a phase the board was no longer in, and an action chosen
      // under "Sowing" -- where nothing is refused -- still chosen on arrival in Action Selection,
      // where it is.
      reconcile();
      drawPhases();
      note(p.key === GEO.livePhase ? "" :
           "“" + p.label + "” is a placeholder — nothing is built behind it yet.");
      render();
    });
    holder.appendChild(b);
  });
}

// THE VALLEY GOES IN FIRST, FULL STOP. These are `#board > *` with no z-index, so the order
// they are appended in IS the order they stack -- and the backdrop is the one thing here that is
// meant to be covered by everything else.
//
// drawStatus() USED TO COME BEFORE IT, and got away with it for as long as the picture started
// at the top of the TILES: the status line sits at y 10 and the backdrop began at 55, so the two
// never met and the order was invisible. Extending the picture to the top of the canvas made
// them overlap and the backdrop painted straight over the line -- a caption that simply was not
// there any more, with nothing in the console to say why.
function draw(){
  // THREE OF v1'S SEVEN ARE GONE. drawBackdrop(), drawTiles() and drawRoad() drew the band
  // across the top -- the picture, the eight tiles standing on it and the road under them --
  // and that whole band is what v2 removes. The duty icons it held are drawn inside the
  // rectangles now, by drawGrid(). The functions are deleted rather than left uncalled, so
  // nothing can quietly start drawing a ribbon again.
  drawStatus(); drawArt(); drawMarks(); drawSide();
  drawGrid(); render(); wireGrid();
}

// SCALED ON BOTH AXES, and the chrome above the stage is MEASURED rather than allowed for.
//
// This used to read `Math.min(1, (window.innerWidth - 36) / GEO.canvas.width)` -- width only, and
// a 36 nobody could derive. On a wide, short window, which is every laptop, the board is 1400
// across and fits, so the scale came back 1 and the bottom 200-odd rows of a 1200-tall board were
// simply off the screen: the wheel cut in half with no sign that anything was missing. The canvas
// check next door has always scaled on min(width, height) -- which is exactly why that page looked
// right on the same screen where this one did not.
//
// The toolbar and the note bar sit OUTSIDE the stage and the note bar collapses when it is empty,
// so their height is read from the page each time rather than carried as a constant that would be
// wrong whenever the note appears.
function fit(){
  var f = document.getElementById("fit");
  var wrap = document.getElementById("wrap");
  var cs = getComputedStyle(wrap);
  var padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
  var padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
  var chrome = document.getElementById("bar").offsetHeight
             + document.getElementById("note").offsetHeight;
  var availW = window.innerWidth - padX;
  var availH = window.innerHeight - chrome - padY;
  var s = Math.min(1, availW / GEO.canvas.width, availH / GEO.canvas.height);
  f.style.transform = "scale(" + s + ")";
  f.style.width = (GEO.canvas.width * s) + "px";
  f.style.height = (GEO.canvas.height * s) + "px";
}

board.style.width = px(GEO.canvas.width);
board.style.height = px(GEO.canvas.height);
board.style.setProperty("--solid", String(GEO.ribbon.solidFraction));

document.getElementById("buildTag").textContent = "build " + BUILD.version;
document.getElementById("bEdit").addEventListener("click", function(){
  S.editing = !S.editing;
  this.setAttribute("aria-pressed", String(S.editing));
  document.body.classList.toggle("editing", S.editing);
  note(S.editing ? "click a picture slot to replace it, or drop a file on one" : "");
});
document.getElementById("bSave").addEventListener("click", doSave);
document.getElementById("bSound").addEventListener("click", function(){
  SFX_ON = !SFX_ON;
  sfxBadge();
  if (SFX_ON) sfx("select");
  // THE BUTTON MEANS SOUND, AND THE AMBIENCE IS SOUND. Turning it off has to take the bed with
  // it or the board goes on murmuring under a control that says it is silent -- and it leaves on
  // the same 1.5 s fade, because a scene cut dead is a worse answer than a scene walked out of.
  if (!SFX_ON && bedOn && actx) { bedStop(bedOn, actx.currentTime); bedOn = null; }
  else if (SFX_ON) bedsFollow();
});

// ---- FULL SCREEN, ON F --------------------------------------------------------------------
//
// The board is a settled 1400 x 1200 composition and fit() already scales it into whatever room
// there is, so the only thing between it and the whole display is the toolbar -- which is not part
// of the board. F therefore does two things that belong together: it takes the chrome off, and it
// asks the browser for the screen.
//
// THE TWO ARE KEPT SEPARATE ON PURPOSE. requestFullscreen can be refused -- a file:// page in some
// browsers, a policy, a window that is already somebody else's full screen -- and a refusal must
// not leave F doing nothing. The class is ours and always applies; the screen is the browser's and
// is asked for politely. So the worst case is a board that fills the window rather than the
// display, which is still the thing that was wanted.
//
// Esc leaves full screen WITHOUT passing through the key handler, so the chrome is put back by
// fullscreenchange rather than by the keystroke. Driving it from the key alone would strand the
// page with no toolbar and no way back to it.
var FULL = false;

function screenEl(){
  return document.fullscreenElement || document.webkitFullscreenElement || null;
}

function setFull(on){
  FULL = on;
  document.body.classList.toggle("full", on);
  fit();
}

function toggleFull(){
  if (FULL){
    setFull(false);
    var exit = document.exitFullscreen || document.webkitExitFullscreen;
    if (screenEl() && exit) exit.call(document);
    return;
  }
  setFull(true);
  var d = document.documentElement;
  var ask = d.requestFullscreen || d.webkitRequestFullscreen;
  if (!ask) return;                       // no API: the chrome is off and that is most of it
  var p = ask.call(d);
  if (p && p.catch) p.catch(function(){}); // refused: keep the chrome off, say nothing
}

document.addEventListener("keydown", function(e){
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  var t = e.target;
  // Not while somebody is typing. There is no text field on the board today and there will be one
  // the day a slot gets a name, and a page that swallowed the f would be a horrible way to find out.
  if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
  if (e.key === "f" || e.key === "F"){ e.preventDefault(); toggleFull(); }
  else if (e.key === "Escape" && FULL && !screenEl()) setFull(false);
});

["fullscreenchange", "webkitfullscreenchange"].forEach(function(t){
  document.addEventListener(t, function(){
    // Left the screen by any route other than F -- Esc, the window chrome, another tab taking it.
    if (!screenEl() && FULL) setFull(false);
    else fit();
  });
});

window.addEventListener("resize", fit);
drawPhases();
draw();
fit();
// DECODE NOW SO THE FIRST CLICK CAN SOUND. The context is born suspended and the first gesture
// resumes it; what cannot be hurried is the decoding, so it happens here rather than on a click.
sfxWake();
sfxBadge();
if (BUILD.notes && BUILD.notes.length) note(BUILD.notes.join("  ·  "));
</script>
</html>
