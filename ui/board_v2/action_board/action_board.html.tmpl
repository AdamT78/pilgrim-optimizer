<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>Pilgrim · action board</title>
<!--
  THE BOARD AT ITS FINISHED SIZE. Everything is positioned from GEO, which generate_action_board.py
  fills in from geometry.py. There is not a number in this file that decides anything: if a value
  is not in GEO it cannot be used here, which is what stops the geometry being written twice.

  NO CONTROLS, ON PURPOSE. See the long note at the top of the generator. The toolbar is not part
  of the board -- it sits above the canvas and holds only what is not the game: which phase is
  showing, whether pictures can be replaced, and save.
-->
<style>
:root{
  --ink:#e2d7bc; --dim:#968e7c; --line:#c9b27a; --faint:#2c2924;
  --panel:#0e0d0b; --panelline:#46413710;
  /* THE PLATE, AND NOW THE TILE'S. It was written once, in .seal.plate, while the tile under it
     was near-black -- so a cut-out icon sat on a visible coloured square. The tile carries the
     same colour now and the square stops being a square: the mark simply sits on the tile. Two
     things using one colour is exactly when it stops being a literal and becomes a name. The road
     took it as a third, which is the test of whether that was true.

     SLATE, CHOSEN IN THE ICON LAB. These three numbers are one entry of PALETTE in
     icon_lab/tile_column.html.tmpl, copied across whole -- the lab is where a plate is looked at
     against the real marks, and this is where the choice is written down. The pair has to move
     together: --plate-lit is the SELECTED tile, so taking one number and leaving the other gives
     seven slate tiles and one that is still the old hue. There is a guard for that now. */
  --plate:#151E25; --plate-lit:#2B3A46; --guide:#6a5f48;
  /* HOW FAR A HOVERED TILE RISES. Here and not in geometry.py, deliberately: geometry owns what
     the board RESERVES, and this reserves nothing -- it is a transform, so no number downstream
     of RIBBON_Y can feel it. The 16 above the ribbon is what it rises into. */
  --lift:6px;
  /* HOW MUCH VALLEY COMES THROUGH A TILE. One number; the marks keep their own opaque ground, so
     this moves the card and not what is drawn on it. */
  --tile-alpha:55%;
}
*{box-sizing:border-box}
html,body{margin:0;background:#07070a;color:var(--ink);
  font:13px/1.4 ui-sans-serif,system-ui,sans-serif}

/* ---- the toolbar. NOT the board. ------------------------------------------------------- */
#bar{display:flex;align-items:center;gap:8px;padding:7px 10px;background:#111013;
  border-bottom:1px solid #26231e;position:sticky;top:0;z-index:30;flex-wrap:wrap}
#bar button{background:#1b1915;color:var(--ink);border:1px solid #3c372e;border-radius:3px;
  padding:4px 10px;font:600 11px/1.4 ui-sans-serif,sans-serif;letter-spacing:.09em;
  text-transform:uppercase;cursor:pointer}
#bar button:hover{border-color:#6a6050}
#bar button[aria-pressed="true"]{background:#2e2718;border-color:var(--line);color:#f0e6cd}
#bar .tag{color:#6f6758;font-size:11px;letter-spacing:.06em}
#bar .sp{flex:1}
#note{padding:6px 12px;color:#9a8f77;font-size:11px;background:#15130f;
  border-bottom:1px solid #26231e}
#note:empty{display:none}

/* ---- the stage ------------------------------------------------------------------------- */
#wrap{display:flex;justify-content:center;padding:14px}
/* FULL SCREEN takes the chrome away and gives the padding back. Nothing here tells fit() what
   changed: it reads the toolbar's height and the stage's padding off the page every time, so
   hiding one and zeroing the other is enough and the scale follows. */
body.full #bar,body.full #note{display:none}
body.full #wrap{padding:0;align-items:center;min-height:100vh}
body.full{background:#000}
#fit{transform-origin:top left}
#board{position:relative;background:#000;overflow:hidden}
/* DIRECT CHILDREN ONLY. `#board *` made every descendant absolute, which quietly killed the
   text flow inside the placeholders -- a card with no picture drew its action name and "no
   picture yet" on top of each other. Anything nested that needs placing says so itself. */
#board > *{position:absolute}

/* Upper text box. One line, centred in its own box, so nothing is clipped at any size. */
#status{display:grid;place-items:center;text-align:center;
  font-family:Georgia,serif;color:#e8dfca;white-space:nowrap;overflow:hidden}

/* ---- the eight duty tiles -------------------------------------------------------------- */
/* THE TILE IS GLASS OVER THE VALLEY. --plate at --tile-alpha rather than a colour of its own, so
   the palette stays one fact and the transparency is one number. The SELECTED tile stays opaque
   on purpose -- its gradient has no alpha -- which is what makes it read as solid against seven
   panes of glass, and is a second thing selection says for free. */
.tile{border:1px solid #2a2721;border-radius:4px;cursor:pointer;
  background:color-mix(in srgb, var(--plate) var(--tile-alpha), transparent);
  transition:transform .12s ease-out}
.tile .nm{position:absolute;left:0;right:0;text-align:center;font-family:Georgia,serif;
  font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--ink)}
/* THE SELECTED TILE CATCHES LIGHT, it is not filled in. A flat --plate-lit across the whole card
   read as a highlighted rectangle -- the selection announced by a block of colour. The gradient
   puts the light at the name and lets the card settle back into the board, which is what a raised
   thing does.

   IT CAN AFFORD TO BE QUIET NOW, and could not have been before. Selection is already carried by
   the lift and by the chosen mark's solid edge, so the plate is the third voice saying it rather
   than the only one. On a board where the plate had to do this alone, this would be too faint. */
.tile.sel{background:linear-gradient(180deg,var(--plate-lit) 0%,var(--plate) 100%);
  border-color:#60594a}
/* The cross-highlight: hovering a wheel face lights its tile and the other way round. One class,
   set from one place, so the two directions cannot drift apart.

   AND THE LIFT RIDES ON IT, which is the whole of "lift the tile when its wheel face is hovered
   too". lightFace() already answers "which duty is the pointer on" from either end, so the second
   direction needs no wiring -- adding a rule here is cheaper AND more correct than a second
   listener, which would be the two-places-one-fact fault this class was made to avoid.

   A TRANSFORM COSTS NO LAYOUT. The tile is placed at RIBBON_Y and stays placed there; translate
   moves what is drawn and not what is reserved, so the road, the cards and the wheel do not feel
   it. Anything that actually shortened or moved the box would push the whole column down. */
/* THE LIFT IS THE WHOLE SIGNAL. This rule used to also set a gold border and a gold halo behind
   it, and with the tile rising as well that was three things saying one thing. Movement is the
   loudest of the three and the only one that cannot be confused with a state -- the gold rim read
   as a near relative of the SELECTED tile's lighter plate, on a ribbon where exactly one tile is
   always selected. The wheel's own faces still brighten; that is their rule, not this one. */
/* AND THE SELECTED TILE STAYS UP, at exactly the same height. ONE VALUE, TWO SELECTORS, and they
   have to stay one value: a tile you click is already raised, because you were pointing at it to
   click it, so matching heights mean it does not move at all under your finger. Give selection a
   height of its own and every click jerks the tile you just pressed. What changes on the click is
   the COLOUR -- the new tile takes --plate-lit where it stands, and the old one darkens and sinks.
   So height says "the pointer is here", plate says "this is the one in play", and the two stop
   competing for the same signal.

   HOVERING THE SELECTED TILE THEREFORE DOES NOTHING HERE, which is the one hole in this and is
   covered elsewhere: its face on the wheel still brightens, so the pointer is still answered. */
.tile.lit, .tile.sel{transform:translateY(calc(-1 * var(--lift)))}
/* THE TILE KEEPS THE GROUND IT LEAVES. Hover is recomputed from what the pointer is OVER, so a
   tile that slides out from under a pointer resting in its bottom few pixels un-hovers itself,
   drops, re-hovers and shudders. This fills the strip it vacated: it is inside the transformed
   box, so top:100% lands it exactly where the tile's lower edge used to be, and it belongs to the
   tile for hit-testing. Found by driving the built page with the pointer on the bottom edge. */
.tile.lit::after, .tile.sel::after{content:"";position:absolute;left:0;right:0;top:100%;height:var(--lift)}
@media (prefers-reduced-motion:reduce){.tile{transition:none}}
/* THE PLACEHOLDER IS A DISC; THE REAL SEAL IS NOT. The wax seals are drawn with a scalloped,
   irregular rim, so the container's own circle would show through at every bay of it and the
   round crop would shear the peaks off. Once a picture lands the container stops drawing -- the
   same correction the Tithe tokens needed, and the one tokens/README.md warns about. */
.seal{position:absolute;border-radius:50%;background:radial-gradient(70% 70% at 36% 30%,#6e2d26,#3d1512);
  border:1px solid #1f0b09;display:grid;place-items:center;cursor:pointer}
/* THE EMPTY SLOT IS DRAWN THE SIZE THE SEAL WILL BE, not the size of its box. Every disc on this
   board fills 0.906 of its own square -- geometry.py owns that figure and a test holds the files
   to it -- so a placeholder filling the whole box promises a seal bigger than any that can land
   in it, on twelve slots at once. The scale comes from GEO; it is not typed here. */
.seal.empty{background:#141210;border:1px dashed #3a352c;transform:scale(var(--solid))}
/* THE MARK'S EDGE, chosen in the icon lab: dashed, in the guides' own colour, 2 px. It sits
   inside the mark's box -- everything here is border-box -- so the drawing gives up 2 px each
   side rather than growing past where geometry.py placed it. */
.seal.filled{background:none;border:var(--seal-border) dashed var(--guide);border-radius:4px}
/* AND SOLID UNDER THE POINTER. The dashes close up and NOTHING else changes -- same colour, same
   2 px, same box -- so the mark does not move or recolour, it just firms up. That restraint is
   the point: the border is already carrying the resting state, and a hover that also changed the
   width would shift the artwork inside it by a pixel, because this is a border-box.

   NO .tok RULE BESIDE IT, deliberately. The Tithe's three resources are `tok` and draw no border
   at all; this is the duty tiles' marks, which is what was asked for. Nor does the icon lab get
   one: its marks are a sizing preview and are not clickable, so a hover state there would be an
   interaction that page does not have. */
/* AND THE CHOSEN MARK STAYS SOLID, by the same rule rather than a second one -- the pattern the
   tiles use for lift and selection, for the same reason: one declaration cannot drift from
   itself. The pointer and the choice say the same thing here, which is right, because a mark
   under the pointer is what the chosen one would look like if you pressed it.

   An EMPTY slot is unaffected, as it is by the hover: there is no icon to firm up. */
.seal.filled:hover, .seal.filled.on{border-style:solid}
.seal img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block}
.seal.filled img{border-radius:0;object-fit:contain}
/* A CUT-OUT BRINGS NO GROUND, so the board gives it one. A wax disc is a thing you could pick up
   and it carries its own; an emblem drawn on transparency does not, and on the tile's black it
   floats with nothing behind it. Which a seal is, is recorded in attribution.json and arrives
   here as one word -- the page does not look at the picture. The corner is square on purpose:
   these are plates, not discs, and the 4px is only to stop the colour cutting a hard rectangle
   out of the tile. THE TILE NOW CARRIES THE SAME PURPLE, so this rule draws nothing you can see
   on today's board -- it is kept because it is what makes the mark right if the tile's colour
   ever moves away from the plate's. */
.seal.plate{background:var(--plate);border-radius:4px}
/* THE ROAD. Reserved for the Merchant and empty on purpose -- it is the space the shorter
   ribbon freed, held open so the cards below it did not move. */
/* THE STRIP IS A PLACE, NOT A SURFACE, NOW THAT THERE IS A PICTURE BEHIND IT. It used to paint
   itself --plate, which is exactly the band of the backdrop the road is painted on -- so the one
   part of the valley that had to show was the one part covered up. It keeps its rect, because the
   Merchant still needs somewhere to be told to walk. */
#road{position:absolute;background:transparent;border:0}
#backdrop{position:absolute;background-size:100% 100%;background-position:center;border-radius:4px}
/* A PLATE BELONGS TO ITS TILE, NOT TO THE BOARD. The selected tile lifts, and a plate left on
   --plate turned back into the visible square this whole arrangement exists to get rid of -- on
   the one tile you are looking at.

   AND ON A GRADIENT IT CAN ONLY BE NOTHING. A ground is invisible when it is the same colour as
   what it sits on; against a gradient there is no one colour to be, so --plate-lit would match at
   exactly one height of the tile and draw a lighter rectangle at every other. All fourteen marks
   carry this class, so that is fourteen squares, which is precisely the fault naming the plate
   was meant to end. Transparent lets the tile's own light through and the ground disappears.

   NOT `background:none` BY ACCIDENT EITHER: these marks are cut-outs with real alpha, so what
   shows through here is the gradient, which is the ground. */
.tile.sel .seal.plate{background:transparent}

/* ---- the two action cards -------------------------------------------------------------- */
/* ISOLATED, AND THAT IS A FIX RATHER THAN A TIDY-UP. The `lift` overlay below is
   mix-blend-mode:screen, and a blended element blends with its nearest STACKING CONTEXT's
   backdrop -- not with its parent. `.art` is position:absolute with z-index:auto, which does not
   make one, so each card's overlay was blending against everything painted beneath it across the
   whole board: the backdrop picture, the road, the ribbon.
   TWO CONSEQUENCES, one of them visible. The effect is meant to lift the flames in THIS card's
   own picture, and it was reaching outside the card to do it. And a blending group that spans the
   board has to be rasterised together, so anything that changes compositing elsewhere -- a tile
   taking its hover transform, a mark animating its filter -- invalidates it, and the two cards
   flash while it is rebuilt. Two cards, side by side: a black rectangle on each side of the row.
   `isolation:isolate` makes each card its own stacking context, so the blend sees its own picture
   and nothing else, and the group cannot be disturbed by anything outside the card. */
.art{overflow:hidden;background:#000;cursor:pointer;isolation:isolate}
.art img{width:100%;height:100%;object-fit:cover;display:block}
/* THE NAME ONLY, AND NO SCRIM BEHIND IT.
   The effect line used to live along the bottom of the picture and moved into the upper text box,
   which halved the scrim count and handed the bottom of every card back -- the corner the briefs
   reserve for the close dark foreground element. The second scrim has now gone the same way: the
   briefs reserve the TOP of every action image for quiet dark ground too, so a gradient there was
   darkening a corner that is already dark and flattening the top of fourteen pictures to buy one
   word its contrast. The halo below buys it on the glyphs instead. If a picture ever fights the
   name, fix the picture. */
.art .nm{position:absolute;left:0;right:0;top:0;font-family:Georgia,serif;font-weight:600;
  letter-spacing:.11em;text-transform:uppercase;color:var(--ink);
  /* THE DARK IS ON THE LETTERS, NOT OVER THE PICTURE. Three stacked shadows: a tight one that
     separates the stroke from whatever it lands on, a wider soft one that carries the separation
     past the serifs, and a short drop that keeps the word sitting on the image rather than
     floating above it. Measured over the lit window on the Devotion card, which is the worst
     ground the board has: against a glyph mask taken from the page itself, the ring of pixels
     within 3px of a letter goes from a mean luminance of 0.264 to 0.124, which is 2.85:1 against
     the ink becoming 5.15:1. A wider, heavier stack reaches 5.69:1 and starts to read as a smudge
     behind the word, which is the scrim coming back by another route. */
  text-shadow:0 0 3px #000, 0 0 3px #000, 0 1px 2px #000}
.art .ph{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:14px;color:#5d5648;
  font:400 12px/1.6 Georgia,serif;letter-spacing:.07em;
  background:radial-gradient(70% 70% at 50% 45%,#141210,#000 82%)}
.art .ph span{display:block}
.art .ph b{display:block;font:600 15px/1.4 Georgia,serif;color:#857c67;letter-spacing:.1em;
  text-transform:uppercase;margin-bottom:4px}
/* THE HOVER LIFT IS A SCREEN OVERLAY, NOT filter: brightness(). Measured on these cards,
   brightness(1.08) moves the shadows -- where 85% of the picture and all the hatching live --
   by 0.4 L*, which nobody can see, while moving the flames by 4.6 and taking the blown-out area
   from 0.119% to 1.090% of the card. Screen at 4% does the opposite: +3.2 L* in the shadows,
   +0.5 in the flames, and it cannot clip, because screen only reaches white where the pixel
   already is. It also leaves the flames alone for the animation to have later. */
.art .lift{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .14s ease;
  background:#ffd696;mix-blend-mode:screen}
.art:hover .lift{opacity:.04}
.art.sel{outline:2px solid var(--line);outline-offset:-1px}

/* ---- buttons and the right-hand column -------------------------------------------------- */
.btn{display:grid;place-items:center;border-radius:4px;cursor:pointer;
  font-family:Georgia,serif;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
  text-align:center;line-height:1.35}
.btn.primary{background:#2e2718;border:1px solid var(--line);color:#ecdfc0}
.btn.primary:hover{background:#3a301d}
/* THE CONTROLS COLUMN. Three marks at the working edge -- Map, Hire Building, commit -- and no
   frame around any of them, which is what was asked for and is also the one thing that keeps them
   from being misread. A mark on a duty tile wears a dashed border because it is a thing you CHOOSE,
   and the border is the slot it would sit in; these are things you PRESS. Giving them the same
   edge would say they were the same kind of object and put three more selectable-looking squares
   on a board whose whole grammar is select-then-confirm.
   So the artwork is the control. Under the pointer it brightens and nothing moves -- the same
   restraint as the tile marks' hover, for the same reason: these are border-box squares at
   geometry's own rect, and a hover that changed the box would shift the drawing inside it. */
.mark{position:absolute;display:grid;place-items:center;cursor:pointer;
  color:var(--ink);font:700 15px/1 ui-monospace,monospace;
  filter:brightness(.88);transition:filter .12s ease}
.mark:hover{filter:brightness(1.12)}
/* A STAND-IN LOOKS LIKE ONE. A control with no cut filed yet borrows Allocation's mark, and the
   whole reason that is better than drawing nothing is that a wrong emblem is visibly wrong --
   which only holds if it does not look as settled as the two beside it. Half-lit says provisional
   without inventing a second treatment, and it goes away by itself the moment a cut is filed. */
.mark.stand-in{filter:brightness(.55)}
.mark.stand-in:hover{filter:brightness(.75)}
/* NOTHING CHOSEN, NOTHING TO COMMIT. The three Confirm buttons this column replaced were drawn
   `display:none` until their own slot was selected, and the commit mark inherits that rule: it is
   the same control, so it appears at the same moment. Map and Hire are standing offers and are
   always there.
   display, NOT visibility: the mark should not be a dark square the pointer can find. The column
   is absolutely positioned at geometry's own slots, so the two above it do not move to fill the
   gap -- which is right, since they would otherwise shift under the pointer every time a duty was
   chosen. */
.mark.off{display:none}
.mark img{width:100%;height:100%;object-fit:contain;display:block}
@media (prefers-reduced-motion:reduce){.mark{transition:none}}
.panel{border:1px solid #46413a;border-radius:5px;background:#0e0d0b}
.panel .lb{position:absolute;left:0;right:0;text-align:center;font-family:Georgia,serif;font-weight:600;
  letter-spacing:.16em;text-transform:uppercase;color:var(--ink)}
/* Take Tithe stands in a row with the two action names, so it is tracked like them rather than
   like the City's label below it. The City keeps the panel tracking above. */
#tithe .lb{letter-spacing:.11em}
.tok{position:absolute;border-radius:50%;overflow:hidden;background:radial-gradient(70% 70% at 35% 30%,#3c3527,#241d14);
  border:1px solid #6b5c3e;display:grid;place-items:center;cursor:pointer;
  color:#e4d6b4;font:700 15px/1 ui-monospace,monospace}
.tok img{width:100%;height:100%;object-fit:contain;display:block;background:none;border:0}
/* EACH PNG IS THE COMPLETE MARK -- its rim, its disc and its motif are painted into the artwork,
   which tokens/README.md says in as many words. A container with a disc of its own behind it and
   a border around it gives every one of them two rims, and it did. The disc and border below are
   for the LETTER fallback only, and `.filled` takes them off the moment a picture is there.

   THE CLASS IS `filled` AND NOT `art` BECAUSE `.art` IS THE BIG CARD. A token marked `.art`
   matched the card's own rule -- `overflow:hidden;background:#000;cursor:pointer` -- and only
   looked right because the line below happened to win on specificity. A second container, the
   seal, would have inherited the same accident. */
.tok.filled{background:none;border:0;border-radius:0}
.pawn{position:absolute;display:grid;place-items:center}
.pawn svg{width:100%;height:100%;display:block;overflow:visible}
.pawn .n{position:absolute;font:700 17px/1 Georgia,serif;color:#1b1a16;text-shadow:0 1px 0 #ffffff40}

/* ---- the wheel -------------------------------------------------------------------------- */
#wheel svg{width:100%;height:100%;display:block}
#wheel [id="ground"]{display:none}
#wheel [id="guide"]{display:none}
#wheel path[data-face]{cursor:pointer;transition:filter .12s ease}
#wheel path[data-face].lit{filter:brightness(1.45)}
/* SELECTION IS A SECOND STATE, NOT THE SAME ONE. The tile has carried `sel` since there was a
   board; the face had nothing, so picking a duty lit its tile and left the wheel saying nothing.
   It is the hover brightness as asked, plus a gold rim: without the rim a selected face and a
   hovered face are the same picture, and while you hover one face with another selected the
   board would be showing two identical highlights and no way to tell which is which. */
#wheel path[data-face].sel{filter:brightness(1.45);stroke:var(--line);stroke-width:2;
  stroke-linejoin:round;paint-order:stroke}
.fig{position:absolute;pointer-events:none}
.fig svg{width:100%;height:100%;display:block;overflow:visible}

/* EDIT MODE is a mode, and it says so. In play the board must not look editable; while images
   are being replaced every slot that can take one is outlined, so there is no guessing. */
body.editing .art,body.editing .seal,body.editing .tok{outline:1px dashed #6f6350;cursor:copy}
body.editing .art.drop,body.editing .seal.drop,body.editing .tok.drop{outline:2px solid var(--line)}
</style>

<div id=bar>
  <span class=tag>phase</span>
  <span id=phases></span>
  <span class=sp></span>
  <button id=bSound aria-pressed="true" title="interface sounds">sound</button>
  <button id=bEdit aria-pressed="false" title="click a slot to replace its picture; drop a file on one at any time">images</button>
  <button id=bSave>save</button>
  <span class=tag>f &nbsp;full screen</span>
  <span class=tag id=buildTag></span>
</div>
<div id=note></div>
<div id=wrap><div id=fit><div id=board></div></div></div>

<script>
// =================================================================================================
// THE NUMBERS COME FROM geometry.py AND ARE NOT RESTATED HERE.
var GEO    = __GEOMETRY__;
var DUTIES = __DUTIES__;
var CONTROLS = __CONTROLS__;
var IMAGES = __IMAGES__;
var SAVE   = __SAVEKEYS__;
var BUILD  = __BUILD__;
// JSON-ENCODED, not pasted between quotes. The drawing is 59 KB of markup with
// newlines and quotes of its own in it; dropped raw into a string literal it ends
// the literal on its first apostrophe and the whole page dies with one unhelpful
// "invalid or unexpected token".
var WHEEL_SVG = __WHEEL_SVG__;

var board = document.getElementById("board");
var S = {
  phase: GEO.livePhase,
  duty: GEO.duties[0].slug,
  slot: null,                       // the chosen action, or "tithe"; set below, not here
  editing: false,
  // WHO STANDS WHERE. Seeded from geometry so a fresh page opens on the crowded state the lab
  // opens on, which is the one worth looking at -- an empty wheel tells you nothing about
  // whether the acolytes crowd.
  occupancy: {},
  city: Object.assign({}, GEO.start.city)
};
// AND THE BOARD OPENS BY THE RULE A CLICK USES, rather than on a typed null that happens to be
// right. The first duty on the ribbon has two actions today, so this is null today -- and it
// stops being null on its own the day that duty has one, instead of opening on a tile whose
// single action is unchosen.
S.slot = onlySlot(S.duty);
GEO.duties.forEach(function(d){
  var n = GEO.start.occupancy[d.slug] || 0;
  var seats = GEO.start.seats[d.slug];
  S.occupancy[d.slug] = [];
  for (var i = 0; i < n; i++) S.occupancy[d.slug].push(seats ? seats[i] : "p1");
});

function el(tag, cls, css, parent){
  var e = document.createElement(tag);
  if (cls) e.className = cls;
  if (css) for (var k in css) e.style[k] = css[k];
  (parent || board).appendChild(e);
  return e;
}
function box(o){ return {left:o.x+"px", top:o.y+"px", width:o.width+"px", height:o.height+"px"}; }
function px(n){ return n + "px"; }
function colourOf(id){
  for (var i = 0; i < GEO.players.length; i++) if (GEO.players[i].id === id) return GEO.players[i].colour;
  return "#8fae6a";
}
function dutyOf(slug){ return DUTIES[slug]; }

// THE LINE IN THE UPPER BOX, and the one place that decides it. A hover shows what the hovered
// thing does; nothing hovered shows the phase's own line. Two functions would be two answers.
var hovered = null;
function phaseLine(){
  for (var i = 0; i < GEO.phases.length; i++) if (GEO.phases[i].key === S.phase) return GEO.phases[i].line;
  return "";
}
function lineFor(slug, slot){
  var d = dutyOf(slug);
  if (!d) return phaseLine();
  if (slot) return (d[slot] && d[slot].shortLabel) || "";
  // A whole tile covers both of its actions, so it says both. A one-action duty says one.
  var out = [];
  ["actionA","actionB"].forEach(function(k){
    if (d[k] && d[k].shortLabel) out.push(d[k].shortLabel);
  });
  return out.join("   ·   ");
}
function setStatus(){
  var t = hovered ? lineFor(hovered.duty, hovered.slot) : phaseLine();
  document.getElementById("statusText").textContent = t;
}
function hover(duty, slot){
  // ON THE CHANGE, NOT ON THE CROSSING. mouseover bubbles and fires every time the pointer moves
  // between a tile and the mark inside it, which is the same duty twice -- so a cue fired here
  // without this test would rattle while you sat still over one tile. The duty under the pointer
  // changing is the thing that happened.
  var was = hovered ? hovered.duty : null;
  hovered = duty ? {duty: duty, slot: slot || null} : null;
  if (duty && duty !== was) sfx("hover");
  setStatus();
  lightFace(duty);
}
// ONE FUNCTION FOR BOTH DIRECTIONS. Hovering a tile lights its face on the wheel and hovering a
// face lights its tile; written twice they would disagree the first time one was changed.
function lightFace(slug){
  GEO.duties.forEach(function(d){
    var tile = document.getElementById("tile-" + d.slug);
    var face = document.querySelector('#wheel [data-face="' + d.face + '"]');
    var on = (slug === d.slug);
    if (tile) tile.classList.toggle("lit", on);
    if (face) face.classList.toggle("lit", on);
  });
}

// =================================================================================================
// DRAWING. Every element is placed once, from GEO, and then only its contents change.
function drawStatus(){
  var s = GEO.status;
  var e = el("div", null, Object.assign(box(s), {fontSize: px(s.size)}));
  e.id = "status";
  var t = el("span", null, null, e); t.id = "statusText"; t.style.position = "static";
}

// THE VALLEY, DRAWN FIRST SO EVERYTHING ELSE STANDS IN FRONT OF IT. It is the only thing on this
// board placed where other objects will cover it, so it goes in before the tiles rather than
// being pushed back with a z-index nobody can see the other end of.
//
// STRETCHED TO THE RECT, NOT COVERED INTO IT. The crop was anchored so its painted ground falls
// where the road strip falls; `cover` keeps the aspect and slides that alignment off.
function drawBackdrop(){
  if (!BACKDROP) return;
  var d = el("div", null, box(GEO.backdrop));
  d.id = "backdrop";
  d.style.backgroundImage = "url(" + BACKDROP + ")";
}
function drawRoad(){
  var r = el("div", null, box(GEO.road));
  r.id = "road";
}
function drawTiles(){
  GEO.duties.forEach(function(d){
    var t = GEO.tiles[d.slug];
    var tile = el("div", "tile", box(t));
    tile.id = "tile-" + d.slug;
    // THE LINE HEIGHT IS SET, not left to the font. geometry.py measures the seals from where
    // this line of type ends, and with no line-height in the CSS the browser used Georgia's own
    // and drew 15px where the module had worked on 16.
    var nm = el("div", "nm", {top: px(GEO.ribbon.nameTop), fontSize: px(GEO.ribbon.nameSize),
                              lineHeight: String(GEO.ribbon.nameLh)}, tile);
    nm.textContent = d.name;
    var info = dutyOf(d.slug);
    var n = info ? info.actions : 1;
    // THE DIAGONAL IS NOT WORKED OUT HERE. geometry.py hands over both arrangements already
    // placed, relative to the tile, so the one fact about where a seal sits has one owner. The
    // page lays out what it is given and knows nothing about insets or overlaps.
    var at = GEO.ribbon.sealSlots[String(n)];
    for (var i = 0; i < n; i++){
      var slot = i === 0 ? "actionA" : "actionB";
      var p = at[i];
      var seal = el("div", "seal", {left: px(p.x), top: px(p.y),
                                    width: px(p.size), height: px(p.size),
                                    zIndex: String(i + 1)}, tile);
      seal.dataset.duty = d.slug; seal.dataset.slot = slot; seal.dataset.kind = "seal";
      seal.dataset.hoverDuty = d.slug; seal.dataset.hoverSlot = slot;
      var key = info && info[slot] && info[slot].seal;
      if (key && IMAGES[key]) { var im = document.createElement("img"); im.src = IMAGES[key];
                                seal.appendChild(im); seal.classList.add("filled");
                                if (info[slot].sealGround === "board") seal.classList.add("plate"); }
      else seal.classList.add("empty");
      seal.addEventListener("click", slotClick);
      wireDrop(seal);
    }
    tile.dataset.hoverDuty = d.slug;
    tile.addEventListener("click", function(slug){ return function(){ pickDuty(slug); }; }(d.slug));
  });
}
// =================================================================================================
// HOVER IS DELEGATED, AND THAT IS THE WHOLE POINT.
//
// It was an enter/leave pair on each element, and it had a hole that showed on exactly one path:
// tile -> seal -> back to the same tile left the board with nothing hovered. The seals sit INSIDE
// their tiles, and those two events deliberately do not fire between a parent and its own child --
// so moving into the seal never left the tile, and moving back out of the seal fired the seal's
// leave with no matching enter on the tile behind it. The line went blank while the pointer was
// still sitting on the tile.
//
// Patching that one path would have left the same hole in every other nesting. So the pairs are
// gone. mouseover BUBBLES and fires on every crossing, parent to child included, so the state is
// recomputed from where the pointer IS rather than from a history of arrivals and departures.
//
// An element opts in with data-hover-duty, data-hover-slot or both, and the nearest ancestor
// carrying either one wins -- so a seal speaks for its action and the tile around it for its duty.
function hoverDataOf(node){
  while (node && node !== board){
    var d = node.dataset;
    if (d && (d.hoverDuty || d.hoverSlot)) return d;
    node = node.parentNode;
  }
  return null;
}
board.addEventListener("mouseover", function(ev){
  var d = hoverDataOf(ev.target);
  if (!d) return hover(null);
  // A card carries only its slot: which duty it shows is state, not markup.
  hover(d.hoverDuty || S.duty, d.hoverSlot || null);
});
board.addEventListener("mouseleave", function(){ hover(null); });

function drawArt(){
  ["actionA","actionB"].forEach(function(slot){
    var a = GEO.slots[slot];
    var art = el("div", "art", box(a));
    art.id = "art-" + slot;
    art.dataset.slot = slot; art.dataset.kind = "art";
    art.dataset.hoverSlot = slot;
    art.addEventListener("click", function(){ slotOrSelect(slot); });
    wireDrop(art);
  });
}

// =================================================================================================
// THE CONTROLS COLUMN, which replaces three confirm buttons and two standing ones with three marks.
//
// WHY ONE COLUMN AND NOT A BUTTON UNDER EACH CARD. The three confirms said the same word and did
// the same thing, and there was only ever one of them on screen -- the row under the cards was 64px
// of board reserved for whichever one was showing. Collapsing them into a single commit at the end
// of the row gives that height back (it is the road's now) and says the true thing about the turn:
// you choose one action anywhere in the row and confirm it once.
//
// THE PLACEHOLDER IS THE SAME PICTURE THREE TIMES, on purpose. Adam is drawing a Map, a Hire
// Building and an OK; until they land, three different borrowed emblems would read as three
// meanings and invite judgements about an arrangement that has none yet. One repeated emblem reads
// as what it is -- the column's size and rhythm, with the artwork still to come. The title is what
// says which is which in the meantime.
// WHICH MARK COMMITS, named once. Two rules turn on it -- the cue it plays and whether it is
// shown at all -- and the second was added long after the first, which is exactly when a second
// copy of a string gets typed. geometry.py's MARKS_ORDER owns the three names and a guard holds
// this to it, so a rename fails the build rather than quietly leaving a mark that makes the
// confirm sound and never appears.
var COMMIT = "commit";

function drawMarks(){
  var M = GEO.marks;
  // THE WORDING COMES FROM duty_text.json, like every other string the board prints. It was a
  // `labels` object typed here while the marks were placeholders, which is one file restating
  // another -- and the icon lab needs the same three strings for its card titles, so the two
  // would have disagreed the first time a mark was renamed.
  // ALLOCATION'S MARK IS STILL THE FALLBACK, for a control with no cut filed yet. A column that
  // refused to draw would look finished and be empty; a column wearing the wrong emblem is
  // visibly wrong, which is the failure you want.
  var placeholder = IMAGES["seal:allocation:actionA"];
  M.order.forEach(function(name){
    var at = M[name];
    var said = CONTROLS[name] || {};
    var label = said.name || name;
    var src = IMAGES["control:" + name] || placeholder;
    var e = el("div", "mark", box(at));
    e.id = "mark-" + name;
    e.dataset.kind = "mark"; e.dataset.mark = name;
    e.title = said.shortLabel ? label + " \u2014 " + said.shortLabel : label;
    e.classList.toggle("stand-in", !IMAGES["control:" + name]);
    if (src){ var im = document.createElement("img"); im.src = src;
              im.alt = label; e.appendChild(im); }
    else e.textContent = label.slice(0, 1).toUpperCase();
    // THE ONLY THING THE COMMIT DOES TODAY. There is no turn to commit yet, so this is a cue on a
    // placeholder -- it should come off when the mark is given its real job rather than be wired
    // around. Map and Hire are silent for the same reason the standing buttons were: they are not
    // the confirm, and a board where every mark clicks the same way teaches nothing.
    if (name === COMMIT) e.addEventListener("click", function(){ sfxWake(); sfx("confirm"); });
  });
}

function drawSide(){
  var t = GEO.tithe;
  var p = el("div", "panel", box(t));
  p.id = "tithe";
  p.addEventListener("click", function(){ if (!S.editing) select("tithe"); });
  // EVERY NUMBER IN THIS COLUMN COMES FROM GEO. The three seals used to start at a 21 typed
  // here and the label sat on a 14, which is how the column survived the seals going from 64 to
  // 78 without anybody noticing the label had been pushed at.
  t.order.forEach(function(name, i){
    var at = t.slots[i];
    // THE SEAL, NOT THE COIN. A seal on this board means a thing you can take, and its colour
    // says which kind -- red for a duty action, grey for a resource. The Tithe column is the
    // third choice beside the two actions, so it speaks the same language they do. The coin is
    // still built in and is the fallback, and a letter is the fallback to that, because the
    // page has to stay usable with no assets at all.
    var k = IMAGES["seal:" + name] ? "seal:" + name
          : IMAGES["token:" + name] ? "token:" + name : null;
    var e = el("div", "tok", {left: px(at.x), top: px(at.y),
                              width: px(at.size), height: px(at.size)}, p);
    e.dataset.kind = "token"; e.dataset.slot = name;
    if (k) { var im = document.createElement("img"); im.src = IMAGES[k];
             e.appendChild(im); e.classList.add("filled"); }
    else e.textContent = name.slice(0, 1).toUpperCase();
    wireDrop(e);
  });
  var lb = el("div", "lb", {top: px(t.labelTop), fontSize: px(t.labelSize),
                            lineHeight: String(t.lh)}, p);
  lb.textContent = "Take Tithe";

  // THE CITY GRID IS HANDED OVER PLACED, like the seals in a duty tile. It used to be worked out
  // here from `(c.width - 24) / 2` with 8px margins -- and 132 is the panel's OUTER width, so the
  // grid drew 9px from the left edge and 7px from the right, leaning two pixels with nothing
  // watching. Its four vertical figures agreed with nothing else on the board either.
  var c = GEO.city;
  var cp = el("div", "panel", box(c));
  var cl = el("div", "lb", {top: px(c.labelTop), fontSize: px(c.labelSize),
                            lineHeight: String(c.lh)}, cp);
  cl.textContent = "The City";
  GEO.players.forEach(function(pl, i){
    var f = el("div", "pawn", box(c.figures[i]), cp);
    f.innerHTML = pawnSvg(pl.colour);
    var n = el("div", "n", null, f);
    n.textContent = S.city[pl.id];
    n.style.left = "50%"; n.style.top = "58%"; n.style.transform = "translate(-50%,-50%)";
  });
}

// The acolyte, drawn rather than loaded: in the lab's own saved sessions `acolytes.painted` and
// `.colored` are null for every seat, so the pawns on that board are procedural too. There is
// no asset here to go missing.
function pawnSvg(colour){
  return '<svg viewBox="0 0 42 100" preserveAspectRatio="xMidYMax meet">' +
    '<ellipse cx="21" cy="94" rx="14" ry="3.6" fill="#00000050"/>' +
    '<g fill="' + colour + '" stroke="#00000055" stroke-width="1" stroke-linejoin="round">' +
    '<path d="M21 20c-4.2 0-6.3 2.6-6.3 6.1 0 4.2-3.6 6.3-5.7 11.4C5.6 46.2 4.2 62 3.8 76.4' +
    'c-.15 5.2 1.6 7.2 6.2 7.2h22c4.6 0 6.35-2 6.2-7.2C37.8 62 36.4 46.2 33 37.5' +
    'c-2.1-5.1-5.7-7.2-5.7-11.4 0-3.5-2.1-6.1-6.3-6.1z"/>' +
    '<ellipse cx="21" cy="12.5" rx="8.6" ry="9"/></g>' +
    '<path d="M8.6 72h24.8" stroke="#00000026" stroke-width="2" fill="none"/></svg>';
}

function drawWheel(){
  var w = GEO.wheel;
  var holder = el("div", null, box(w));
  holder.id = "wheel";
  holder.innerHTML = WHEEL_SVG;
  var svg = holder.querySelector("svg");
  if (svg){ svg.removeAttribute("width"); svg.removeAttribute("height"); }
  GEO.duties.forEach(function(d){
    var face = holder.querySelector('[id="' + d.face + '"]');
    if (!face) return;
    face.setAttribute("data-face", d.face);
    face.setAttribute("data-hover-duty", d.slug);
    face.style.pointerEvents = "auto";
    // THE SAME ENTRY POINT THE TILE USES. A face and its tile are two handles on one duty, so
    // they go through pickDuty and the selection, the action cards and the wheel all follow from
    // the one piece of state rather than from whichever was clicked.
    face.addEventListener("click", function(slug){
      return function(){ pickDuty(slug); };
    }(d.slug));
  });
  drawFigures();
}

// THE ACOLYTES RING THE WHEEL'S OWN FACES, at a fraction of it so they scale with it. The
// fractions are geometry.py's, and they are expected to change: the centre is to stop holding
// acolytes and the City box will show them instead.
function drawFigures(){
  var old = board.querySelectorAll(".fig");
  for (var i = 0; i < old.length; i++) old[i].remove();
  var w = GEO.wheel, h = GEO.acolytes.height, aw = Math.round(h * GEO.acolytes.aspect);
  GEO.duties.forEach(function(d){
    var seats = S.occupancy[d.slug] || [];
    if (!seats.length) return;
    var t = d.clock * Math.PI / 180;
    var cx = w.x + w.width / 2 + w.figRx * Math.sin(t);
    var cy = w.y + w.height / 2 - w.figRy * Math.cos(t);
    var span = (seats.length - 1) * (aw * 0.82);
    seats.forEach(function(seat, i){
      var f = el("div", "fig", {left: px(Math.round(cx - span / 2 + i * aw * 0.82 - aw / 2)),
                                top: px(Math.round(cy - h / 2)), width: px(aw), height: px(h)});
      f.innerHTML = pawnSvg(colourOf(seat));
    });
  });
}

// =================================================================================================
// WHAT CLICKING DOES. In play a click chooses; while images are being replaced a click on a slot
// opens the picker instead. One mode switch rather than two gestures to remember.
// =================================================================================================
// THE INTERFACE SOUNDS
//
// WEB AUDIO, NOT <audio> ELEMENTS, and the reason is the hover. Eight tiles on a ribbon means a
// pointer crossing them fires eight cues inside a second; one <audio> element restarts and cuts
// itself off, and eight of them is a pool to manage. A decoded buffer can be fired as many times
// as you like, overlapping, from one copy in memory.
//
// DECODED AT LOAD, RESUMED ON THE FIRST GESTURE, and those are two different rules that are easy
// to collapse into one and get wrong. A browser will not let audio SOUND before a gesture, so a
// context built now is born suspended -- but building it now is exactly what we want, because
// decoding is asynchronous. Waiting for the first click to start decoding makes that first click
// silent and the second one work, which reads as a broken cue rather than as a policy.
//
// So: the context and the buffers are made at load, and the first click resumes a context that
// already has everything it needs. The first hover of a fresh page is still silent, and nothing
// can change that.
//
// ONE CLIP SERVES HOVER AND SELECTION, at two gains. They are the same event at two strengths --
// the pointer passing over a duty, and the duty being taken -- so the same mark of sound at a
// quarter of the level reads as a quieter version of the same thing rather than a second idea.
var BACKDROP = __BACKDROP__;
var SFX = __SFX__;
// THE CLIPS ARE AT THEIR NATURAL LEVEL, so these gains mean what they say. An earlier cut was
// peak-normalised to -1 dBFS, which lifted the confirm 3.1 dB above the level it has in the
// montage and made the board's version of it plainly louder than the one that was chosen in the
// picker. Normalising one-shots that were recorded together throws away the thing you were
// listening to -- how loud they are RELATIVE to each other.
//
// 0.7 is the picker's own volume slider, so confirm comes out of the board at the level it came
// out of the picker.
var SFX_GAIN = {hover: 0.12, select: 0.5, confirm: 0.7};
var SFX_ON = true, actx = null, BUF = {};

function sfxWake(){
  if (actx) return;
  var C = window.AudioContext || window.webkitAudioContext;
  if (!C) return;
  actx = new C();
  Object.keys(SFX).forEach(function(k){
    var raw = atob(SFX[k].split(",")[1]);
    var b = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) b[i] = raw.charCodeAt(i);
    actx.decodeAudioData(b.buffer, function(buf){ BUF[k] = buf; }, function(){});
  });
}
// THE CUE IS NAMED, THE CLIP IS LOOKED UP. `tile` is one file today and the page asks for
// "hover" and "select"; swapping either to its own file is a line in the generator, not here.
// ONE GESTURE ANYWHERE UNLOCKS IT, AND THERE MUST BE ONE. A browser keeps a page silent until it
// has been clicked or typed into, and MOVING a pointer is not a gesture -- so the first hover of a
// freshly loaded board cannot make a sound, whatever this file does. That is not a bug to fix, it
// is a rule to be honest about.
//
// What IS fixable is the surprise. Any pointerdown or keydown anywhere on the document unlocks it,
// so the bar, the background and the f key all count and you do not have to find a tile; and until
// it happens the board says so in its own note line rather than in a tooltip nobody hovers.
function sfxUnlock(){
  removeEventListener("pointerdown", sfxUnlock, true);
  removeEventListener("keydown", sfxUnlock, true);
  sfxWake();
  if (actx && actx.state === "suspended") actx.resume().then(sfxBadge, sfxBadge);
  else sfxBadge();
}
addEventListener("pointerdown", sfxUnlock, true);
addEventListener("keydown", sfxUnlock, true);

function sfxBadge(){
  var b = document.getElementById("bSound");
  if (!b) return;
  var live = !!actx && actx.state === "running";
  b.setAttribute("aria-pressed", String(SFX_ON));
  b.title = !SFX_ON ? "interface sounds are off"
          : live ? "interface sounds"
          : "click or press a key anywhere first — a browser keeps a page silent until you do";
  b.textContent = (SFX_ON && !live) ? "sound ·" : "sound";
  // IN THE NOTE LINE, WHERE IT WILL BE READ. A tooltip explains this only to somebody who already
  // suspects the button, and the person it needs to reach is the one who just hovered the ribbon
  // and heard nothing. The line clears itself the moment the first gesture lands.
  var n = document.getElementById("note");
  if (!n) return;
  if (SFX_ON && !live) n.textContent = "sound is ready — click anywhere once to let the browser play it";
  else if (n.textContent.indexOf("click anywhere once") >= 0) n.textContent = "";
}

function sfx(cue){
  if (!SFX_ON || !actx) return;
  var buf = BUF[cue === "confirm" ? "confirm" : "tile"];
  if (!buf) return;
  if (actx.state === "suspended") actx.resume();
  var s = actx.createBufferSource(), g = actx.createGain();
  s.buffer = buf; g.gain.value = SFX_GAIN[cue] || 0.5;
  s.connect(g); g.connect(actx.destination); s.start();
}

// A DUTY WITH ONE ACTION HAS NOTHING TO CHOOSE, so choosing the duty chooses it. Taxation and
// Allocation have one each -- duty_text.json is what says so, and this asks it rather than
// naming them, so a duty gaining or losing a second action needs no edit here.
//
// WITHOUT THIS the board could sit on Taxation with Taxation's only action unchosen -- an unlit
// card and a dashed mark, which is a question with exactly one answer.
function onlySlot(slug){
  var info = dutyOf(slug);
  return (info && info.actions === 1) ? "actionA" : null;
}
function pickDuty(slug){
  if (S.editing) return;
  sfxWake(); sfx("select");
  S.duty = slug; S.slot = onlySlot(slug);
  render();
}
function slotOrSelect(slot){
  if (S.editing) return pickFile({kind: "art", duty: S.duty, slot: slot});
  select(slot);
}
function slotClick(ev){
  ev.stopPropagation();
  var d = ev.currentTarget.dataset;
  if (S.editing) return pickFile({kind: d.kind, duty: d.duty || S.duty, slot: d.slot});
  // IN PLAY A MARK IS ITS ACTION. Clicking one used to call pickDuty, which sets the duty and
  // CLEARS the slot -- so the mark for an action could not select that action, and the only way
  // in was to click the card. The tile's own area still goes through pickDuty, because a click on
  // the tile is about the duty and names no action.
  if (d.duty) pickAction(d.duty, d.slot);
}
// A CLICK CHOOSES; IT DOES NOT UN-CHOOSE. Both of these used to toggle, so pressing the same
// mark or the same card twice put the action back down. That was invisible while nothing marked
// the choice and obvious the moment the chosen mark started holding a solid edge: the second
// press read as a misfire rather than as an undo.
//
// BOTH, NOT JUST THE MARK. The mark and the card below it set the same fact by different routes,
// and one that toggles beside one that does not is the same click behaving two ways depending on
// where you aimed it. The Tithe comes through select() too and is included for that reason.
//
// Nothing is lost: "no action chosen" is still reached, by picking another duty, which is the
// only time it means anything -- you have been asked which of the two.
function select(slot){ S.slot = slot; render(); }
// ONE RENDER, NOT TWO. pickDuty followed by select() would do the same work -- pickDuty sets the
// duty and answers the slot for it, then select overwrites that answer -- and draw the whole
// board twice on the way, once on a slot nobody asked for.
function pickAction(duty, slot){
  if (S.editing) return;
  sfxWake(); sfx("select");
  S.duty = duty;
  S.slot = slot;
  render();
}

function render(){
  GEO.duties.forEach(function(d){
    var tile = document.getElementById("tile-" + d.slug);
    if (tile) tile.classList.toggle("sel", d.slug === S.duty);
    // AND THE WHEEL, FROM THE SAME LINE. Two loops would be two answers the first time one of
    // them was edited; this is the rule lightFace() already states for the hover pair.
    var face = document.querySelector('#wheel [data-face="' + d.face + '"]');
    if (face) face.classList.toggle("sel", d.slug === S.duty);
  });
  // THE CHOSEN ACTION'S MARK, ASKED HERE AND NOT IN THE CLICK HANDLER. S.slot is reached three
  // ways -- the mark, the card below it, and picking a duty, which either clears it or, for a
  // duty with one action, chooses that one -- and a class set where it is CLICKED would be right
  // on one of them. Set from the state, like everything else in render(), and all three are
  // answered at once.
  //
  // BOTH HALVES OF THE QUESTION. Matching the slot alone would leave the same-named mark solid in
  // every other duty's tile, which looks like eight choices rather than one.
  Array.prototype.forEach.call(document.querySelectorAll("#board .seal"), function(s){
    s.classList.toggle("on", s.dataset.duty === S.duty && s.dataset.slot === S.slot);
  });
  var info = dutyOf(S.duty);
  ["actionA","actionB"].forEach(function(slot){
    var art = document.getElementById("art-" + slot);
    var a = info && info[slot];
    var has = a && a.art && IMAGES[a.art];
    art.innerHTML = "";
    art.style.display = (info && info.actions === 1 && slot === "actionB") ? "none" : "";
    if (has){
      var im = document.createElement("img"); im.src = IMAGES[a.art]; art.appendChild(im);
    } else {
      var ph = document.createElement("div"); ph.className = "ph";
      ph.innerHTML = "<b>" + ((a && a.name) || "no second action") + "</b>" +
                     (a && a.name ? "<span>no picture yet &mdash; drop one here</span>" : "");
      art.appendChild(ph);
    }
    if (a && a.name){
      var nm = document.createElement("div"); nm.className = "nm";
      nm.style.fontSize = px(GEO.art.capSize);
      // capLh was exported and never applied, so the caption took the body's 1.4 and CAP_H was
      // computed from a line height the page did not use. It is applied now because Take Tithe
      // shares this line, and two line heights would put the row half a pixel out.
      nm.style.lineHeight = String(GEO.art.capLh);
      nm.style.padding = GEO.art.capPadY + "px " + GEO.art.capPadX + "px";
      nm.textContent = a.name;
      art.appendChild(nm);
    }
    var lift = document.createElement("div"); lift.className = "lift"; art.appendChild(lift);
    art.classList.toggle("sel", S.slot === slot);
  });
  // THE COMMIT APPEARS WHEN THERE IS SOMETHING TO COMMIT, which is what the confirm buttons it
  // replaced did -- one per card and one under the Tithe, each drawn only while its own slot was
  // chosen. One mark serves all three now, so the condition is simply that a slot is chosen at
  // all. S.slot is null until a duty with one action selects its own, so the board can open with
  // the column showing two marks rather than three.
  document.getElementById("mark-" + COMMIT).classList.toggle("off", !S.slot);
  setStatus();
}

// =================================================================================================
// REPLACING A PICTURE. The page keeps the ORIGINAL bytes, never the copy it is displaying: the
// board draws at 590 x 295 and a save that posted what it was showing would quietly put a small
// JPEG over a 1120 x 560 master. The downscaling is the generator's job and happens once, at
// build time, on the way in.
var PENDING = [];
function pickFile(target){
  var inp = document.createElement("input");
  inp.type = "file"; inp.accept = "image/png,image/jpeg,image/webp";
  inp.addEventListener("change", function(){ if (inp.files[0]) takeFile(inp.files[0], target); });
  inp.click();
}
function wireDrop(e){
  e.addEventListener("dragover", function(ev){ ev.preventDefault(); e.classList.add("drop"); });
  e.addEventListener("dragleave", function(){ e.classList.remove("drop"); });
  e.addEventListener("drop", function(ev){
    ev.preventDefault(); ev.stopPropagation(); e.classList.remove("drop");
    var f = ev.dataTransfer.files[0]; if (!f) return;
    var d = e.dataset;
    takeFile(f, {kind: d.kind, duty: d.duty || S.duty, slot: d.slot});
  });
}
function takeFile(file, target){
  var r = new FileReader();
  r.onload = function(){
    var rec = {kind: target.kind, duty: target.duty, slot: target.slot,
               filename: file.name, bytes: r.result};
    PENDING = PENDING.filter(function(p){
      return !(p.kind === rec.kind && p.duty === rec.duty && p.slot === rec.slot);
    });
    PENDING.push(rec);
    // Shown at once from the original; the browser scales it to the box. The bytes kept for the
    // save are untouched.
    var key = rec.kind === "token" ? ("token:" + rec.slot) : ("art:" + rec.duty + ":" + rec.slot);
    if (rec.kind === "seal") key = "seal:" + rec.duty + ":" + rec.slot;
    IMAGES[key] = r.result;
    var info = dutyOf(rec.duty);
    if (info && info[rec.slot]) info[rec.slot][rec.kind === "seal" ? "seal" : "art"] = key;
    note(PENDING.length + " picture(s) waiting to be saved");
    board.innerHTML = ""; draw();
  };
  r.readAsDataURL(file);
}

function manifest(){
  var art = {}, seals = {};
  Object.keys(DUTIES).forEach(function(slug){
    ["actionA","actionB"].forEach(function(slot){
      var a = DUTIES[slug][slot];
      if (a && a.artFile) art[slug + "/" + slot] = a.artFile;
      if (a && a.sealFile) seals[slug + "/" + slot] = a.sealFile;
    });
  });
  return {art: art, seals: seals, tokens: GEO.tithe.order.slice(),
          acolytes: S.occupancy, city: S.city,
          selected: {duty: S.duty, slot: S.slot}};
}

// TWO PATHS, ONE KEY LIST. Served, this POSTs and the generator writes the files and the record.
// Opened as a file it can only download, and it says so -- but it writes the SAME keys, because
// both read them from SAVE, which the generator filled in from its own constants.
function doSave(){
  var payload = {manifest: pick(manifest(), SAVE.manifest),
                 images: PENDING.map(function(p){ return pick(p, SAVE.image); })};
  if (location.protocol === "http:" || location.protocol === "https:"){
    fetch("/save", {method: "POST", headers: {"Content-Type": "application/json"},
                    body: JSON.stringify(payload)})
      .then(function(r){ return r.json(); })
      .then(function(j){
        if (j.ok){ PENDING = []; note("saved: " + j.files.join(", ")); }
        else note("the save was refused: " + (j.error || "no reason given"));
      })
      .catch(function(e){ note("the save could not be sent: " + e); });
  } else {
    download(SAVE.manifestFile.split("/").pop(), JSON.stringify(payload.manifest, null, 1));
    note("downloaded the manifest only -- run with --serve to write into the repository, "
         + "and to have the " + PENDING.length + " new picture(s) filed and recorded.");
  }
}
function pick(o, keys){
  var out = {};
  keys.forEach(function(k){ if (o[k] !== undefined) out[k] = o[k]; });
  return out;
}
function download(name, text){
  var a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([text], {type: "application/json"}));
  a.download = name; a.click(); URL.revokeObjectURL(a.href);
}
function note(t){ document.getElementById("note").textContent = t || ""; }

// =================================================================================================
function drawPhases(){
  var holder = document.getElementById("phases");
  // REBUILT, NOT ADDED TO. This function is its own click handler, so without this line every
  // click appended a second set of phase buttons and the row grew by three each time. The loop
  // that used to sit at the end then walked holder.children against GEO.phases[i], which is
  // shorter, threw on the undefined, and took note() and setStatus() down with it -- so the
  // phase line silently stopped updating as well. One clear fixes both.
  holder.textContent = "";
  GEO.phases.forEach(function(p){
    var b = document.createElement("button");
    b.textContent = p.label;
    b.setAttribute("aria-pressed", String(p.key === S.phase));
    b.addEventListener("click", function(){
      S.phase = p.key;
      drawPhases();
      note(p.key === GEO.livePhase ? "" :
           "“" + p.label + "” is a placeholder — nothing is built behind it yet.");
      setStatus();
    });
    holder.appendChild(b);
  });
}

function draw(){
  drawStatus(); drawBackdrop(); drawTiles(); drawRoad(); drawArt(); drawMarks(); drawSide();
  drawWheel(); render();
}

// SCALED ON BOTH AXES, and the chrome above the stage is MEASURED rather than allowed for.
//
// This used to read `Math.min(1, (window.innerWidth - 36) / GEO.canvas.width)` -- width only, and
// a 36 nobody could derive. On a wide, short window, which is every laptop, the board is 1400
// across and fits, so the scale came back 1 and the bottom 200-odd rows of a 1200-tall board were
// simply off the screen: the wheel cut in half with no sign that anything was missing. The canvas
// check next door has always scaled on min(width, height) -- which is exactly why that page looked
// right on the same screen where this one did not.
//
// The toolbar and the note bar sit OUTSIDE the stage and the note bar collapses when it is empty,
// so their height is read from the page each time rather than carried as a constant that would be
// wrong whenever the note appears.
function fit(){
  var f = document.getElementById("fit");
  var wrap = document.getElementById("wrap");
  var cs = getComputedStyle(wrap);
  var padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
  var padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
  var chrome = document.getElementById("bar").offsetHeight
             + document.getElementById("note").offsetHeight;
  var availW = window.innerWidth - padX;
  var availH = window.innerHeight - chrome - padY;
  var s = Math.min(1, availW / GEO.canvas.width, availH / GEO.canvas.height);
  f.style.transform = "scale(" + s + ")";
  f.style.width = (GEO.canvas.width * s) + "px";
  f.style.height = (GEO.canvas.height * s) + "px";
}

board.style.width = px(GEO.canvas.width);
board.style.height = px(GEO.canvas.height);
board.style.setProperty("--solid", String(GEO.ribbon.solidFraction));
// THE MARK'S FRAME, FROM GEOMETRY. It was a 2 typed into .seal.filled, which was nobody's business
// but this file's until the controls column was sized off it: a mark in that column is a tile's
// mark MINUS this frame, so the same number now sets a border here and a width there. Two owners
// would mean the column quietly stopping being the artwork it is supposed to equal.
board.style.setProperty("--seal-border", px(GEO.ribbon.sealBorder));
document.getElementById("buildTag").textContent = "build " + BUILD.version;
document.getElementById("bEdit").addEventListener("click", function(){
  S.editing = !S.editing;
  this.setAttribute("aria-pressed", String(S.editing));
  document.body.classList.toggle("editing", S.editing);
  note(S.editing ? "click a picture slot to replace it, or drop a file on one" : "");
});
document.getElementById("bSave").addEventListener("click", doSave);
document.getElementById("bSound").addEventListener("click", function(){
  SFX_ON = !SFX_ON;
  sfxBadge();
  if (SFX_ON) sfx("select");
});

// ---- FULL SCREEN, ON F --------------------------------------------------------------------
//
// The board is a settled 1400 x 1200 composition and fit() already scales it into whatever room
// there is, so the only thing between it and the whole display is the toolbar -- which is not part
// of the board. F therefore does two things that belong together: it takes the chrome off, and it
// asks the browser for the screen.
//
// THE TWO ARE KEPT SEPARATE ON PURPOSE. requestFullscreen can be refused -- a file:// page in some
// browsers, a policy, a window that is already somebody else's full screen -- and a refusal must
// not leave F doing nothing. The class is ours and always applies; the screen is the browser's and
// is asked for politely. So the worst case is a board that fills the window rather than the
// display, which is still the thing that was wanted.
//
// Esc leaves full screen WITHOUT passing through the key handler, so the chrome is put back by
// fullscreenchange rather than by the keystroke. Driving it from the key alone would strand the
// page with no toolbar and no way back to it.
var FULL = false;

function screenEl(){
  return document.fullscreenElement || document.webkitFullscreenElement || null;
}

function setFull(on){
  FULL = on;
  document.body.classList.toggle("full", on);
  fit();
}

function toggleFull(){
  if (FULL){
    setFull(false);
    var exit = document.exitFullscreen || document.webkitExitFullscreen;
    if (screenEl() && exit) exit.call(document);
    return;
  }
  setFull(true);
  var d = document.documentElement;
  var ask = d.requestFullscreen || d.webkitRequestFullscreen;
  if (!ask) return;                       // no API: the chrome is off and that is most of it
  var p = ask.call(d);
  if (p && p.catch) p.catch(function(){}); // refused: keep the chrome off, say nothing
}

document.addEventListener("keydown", function(e){
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  var t = e.target;
  // Not while somebody is typing. There is no text field on the board today and there will be one
  // the day a slot gets a name, and a page that swallowed the f would be a horrible way to find out.
  if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
  if (e.key === "f" || e.key === "F"){ e.preventDefault(); toggleFull(); }
  else if (e.key === "Escape" && FULL && !screenEl()) setFull(false);
});

["fullscreenchange", "webkitfullscreenchange"].forEach(function(t){
  document.addEventListener(t, function(){
    // Left the screen by any route other than F -- Esc, the window chrome, another tab taking it.
    if (!screenEl() && FULL) setFull(false);
    else fit();
  });
});

window.addEventListener("resize", fit);
drawPhases();
draw();
fit();
// DECODE NOW SO THE FIRST CLICK CAN SOUND. The context is born suspended and the first gesture
// resumes it; what cannot be hurried is the decoding, so it happens here rather than on a click.
sfxWake();
sfxBadge();
if (BUILD.notes && BUILD.notes.length) note(BUILD.notes.join("  ·  "));
</script>
</html>
