<!doctype html>
<meta charset="utf-8">
<title>Duty art viewfinder __BUILD__</title>
<style>
  :root{--ink:#e7ddc6;--dim:#9c9075;--line:#ffffff1c;--hot:#d8b26a;--warn:#e08a6a;--ok:#8fae6a}
  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%;background:#0b0a09;color:var(--ink);
    font:13px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}
  #page{display:grid;grid-template-columns:1fr 330px;gap:22px;padding:18px 20px;align-items:start}
  h1{margin:0 0 4px;font:600 18px/1.2 Georgia,serif;letter-spacing:.04em}
  h2{margin:20px 0 8px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;
    color:var(--dim);border-bottom:1px solid var(--line);padding-bottom:4px}
  .sub{color:var(--dim);margin:0 0 14px;max-width:74ch}
  #drop{border:1px dashed #ffffff33;border-radius:6px;padding:26px;text-align:center;
    color:var(--dim);cursor:pointer;background:#ffffff05}
  #drop.over{border-color:var(--hot);background:#d8b26a12;color:var(--ink)}
  #drop b{color:var(--ink);display:block;font-size:14px;margin-bottom:4px}
  #drop input{display:none}
  #masterWrap{margin-top:14px;display:none;position:relative}
  #refGhost{position:absolute;display:none;pointer-events:none;opacity:.55;
    transform:translate(-50%,-50%);filter:saturate(.2) contrast(1.15)}
  #refThumb{width:100%;height:auto;border:1px solid var(--line);border-radius:4px;
    background:#151310;cursor:grab;display:block;margin-bottom:6px}
  #refThumb:active{cursor:grabbing}
  #refThumb.idle{opacity:.45;cursor:not-allowed}
  .btn{display:inline-block;background:#241f17;color:var(--ink);border:1px solid #6b5c3e;
    border-radius:3px;padding:5px 10px;font:inherit;cursor:pointer;text-decoration:none}
  .btn:hover{background:#2f281d}
  .btns{display:flex;flex-wrap:wrap;gap:5px;margin:6px 0}
  .btns button{padding:4px 8px;font-size:11px}
  .btns button.arch{border-style:dashed;border-color:#6b5c3e88;color:var(--dim)}
  #masterWrap canvas{display:block;width:100%;height:auto;border:1px solid var(--line);
    border-radius:4px;background:#000}
  /* THE PREVIEW IS THE WHOLE POINT, at the board's own size and with the board's own gap.
     A pair that reads at 700px wide and falls apart at 375 is what this exists to catch. */
  #previewWrap{display:none;margin-top:6px}
  #pv{display:flex;background:#000;padding:14px;border-radius:5px;border:1px solid var(--line);
    width:max-content}
  #pv canvas{display:block;outline:1px solid #ffffff2e}
  .row{display:grid;grid-template-columns:96px 1fr 64px;gap:8px;align-items:center;margin:7px 0}
  .row span.k{color:var(--dim);text-align:right}
  input[type=range]{width:100%}
  textarea{width:100%;background:#151310;color:var(--ink);border:1px solid var(--line);
    border-radius:3px;padding:4px 6px;font:11px/1.5 ui-monospace,monospace;resize:vertical}
  input[type=number],input[type=text],select{width:100%;background:#151310;color:var(--ink);
    border:1px solid var(--line);border-radius:3px;padding:3px 5px;font:inherit}
  .hint{color:var(--dim);font-size:11px;line-height:1.5;margin:6px 0}
  table{border-collapse:collapse;width:100%;margin-top:4px}
  td{padding:2px 0;vertical-align:top}
  td:first-child{color:var(--dim);padding-right:10px;white-space:nowrap}
  .num{color:var(--ink)} .bad{color:var(--warn)} .good{color:var(--ok)} .hot{color:var(--hot)}
  pre{background:#151310;border:1px solid var(--line);border-radius:4px;padding:10px;
    overflow-x:auto;font-size:11px;line-height:1.6;color:#cfc4a8;white-space:pre-wrap;
    word-break:break-all}
  button{background:#241f17;color:var(--ink);border:1px solid #6b5c3e;border-radius:3px;
    padding:5px 10px;font:inherit;cursor:pointer}
  button:hover{background:#2f281d}
</style>

<div id=page>
<div>
  <h1>Duty art viewfinder</h1>
  <p class=sub>Drop a wide master in. It is cropped once to the shape of the whole action band,
  gap included, then split where the gap falls &mdash; so the two cards are the two halves of one
  picture and the gap hides a sliver rather than the cards sharing one. The band's shape comes
  from the layout lab's own state, not from anything typed here. Nothing is cut: the command at
  the right does that.</p>

  <div id=drop>
    <b>Drop a master image here</b>
    or click to choose one &middot; it never leaves this page
    <input id=file type=file accept="image/*">
  </div>

  <div id=masterWrap>
    <canvas id=master></canvas>
    <!-- AN IMG, NOT DRAWN INTO THE CANVAS. Drawing a file:// image into a canvas taints it, and
         it would have to be cleared and the whole master repainted on every pointer move.
         Floating an element over the top costs nothing and never touches the crop preview. -->
    <img id=refGhost alt="">
  </div>

  <div id=previewWrap>
    <h2>at the size the board draws them</h2>
    <div id=pv><canvas id=pvL></canvas><div id=pvGap></div><canvas id=pvR></canvas></div>
    <div class=hint id=pvNote></div>
  </div>
</div>

<div>
  <h2>the band</h2>
  <table id=bandTbl></table>

  <h2>the one thing to decide</h2>
  <div class="row"><span class=k>y</span>
    <input type=range id=rY min=0 max=1000 step=1 value=0>
    <input type=number id=nY min=0 max=8000 step=1 value=0></div>
  <div class=hint>how far down the master the band is taken. The band is shorter than the master
  &mdash; the board's span is wider than anything a generator will draw &mdash; so something has
  to be dropped, and this is the only choice in the whole cut.
  <button id=bCentre>centre it</button></div>

  <h2>what that gives you</h2>
  <table id=out></table>

  <h2>the brief to generate one</h2>
  <div class="row"><span class=k>left</span>
    <input type=text id=actL value="DEVOTION" style="grid-column:2/4"></div>
  <div class="row"><span class=k>right</span>
    <input type=text id=actR value="SILVERSMITH" style="grid-column:2/4"></div>
  <div class="row"><span class=k>left subject</span>
    <textarea id=subL rows=4 style="grid-column:2/4"></textarea></div>
  <div class="row"><span class=k>right subject</span>
    <textarea id=subR rows=4 style="grid-column:2/4"></textarea></div>
  <div class=hint>One dash per line. These open filled with the Clerical pair, which is the
  one that is known to work &mdash; a worked example rather than an empty box.</div>
  <div class="row"><span class=k>aspect</span>
    <select id=aspect style="grid-column:2/4"></select></div>
  <div class=hint id=aspectNote></div>
  <div class=btns id=promptBtns></div>
  <div class=hint>Paste one into ChatGPT with the camera reference attached. The shape and zone
  paragraphs are written from the board's own band, so a brief and the cut below cannot describe
  different pictures.</div>

  <h2>the camera reference</h2>
  <img id=refThumb draggable="true" alt="the ground plate used as camera reference">
  <div class=hint id=refState></div>
  <div class=hint id=refNote></div>
  <div class=btns>
    <a id=refDl class=btn download="ground_plate_32deg.png">download it</a>
  </div>
  <div class=hint id=refDrag><b>Drag the plate onto the master</b> to lay it over the floor and
  compare the ground plane. Let go and it disappears.</div>

  <h2>the cut, as a command</h2>
  <pre id=cmd>drop a master in first</pre>
  <button id=bCopy>copy</button>
</div>
</div>

<script>
// THE BAND, FROM THE LAYOUT LAB'S STATE. The one shape this page must not invent.
var BAND = __BAND__;

var el = function(id){ return document.getElementById(id); };
var IMG = null, NAME = "master.png";

el("bandTbl").innerHTML =
    '<tr><td>card</td><td class=num>' + BAND.card_w + ' x ' + BAND.card_h + '</td></tr>'
  + '<tr><td>gap</td><td class=num>' + BAND.gap + '</td></tr>'
  + '<tr><td>span</td><td class=num>' + BAND.span + ' x ' + BAND.card_h
      + '  (' + (BAND.span / BAND.card_h).toFixed(4) + ':1)</td></tr>'
  + '<tr><td>card ratio</td><td class=num>'
      + (BAND.card_w / BAND.card_h).toFixed(5) + '</td></tr>';

// THE GEOMETRY, IN ONE PLACE, and the same arithmetic the cutting script does. A card is the
// span's own fraction of the master's width, so its ratio is the slot's ratio however wide the
// master is. Nothing to choose but where the band sits.
function geom(){
  if (!IMG) return null;
  var bandH = Math.round(IMG.width * BAND.card_h / BAND.span);
  var cardW = Math.round(IMG.width * BAND.card_w / BAND.span);
  // THE TWO CARDS ARE THE SAME WIDTH AND THE GAP TAKES THE ROUNDING -- the gap is the one part
  // of this nobody ever sees, so the odd pixel belongs there.
  var gapW = IMG.width - 2 * cardW;
  var top = +el("nY").value;
  return {bandH: bandH, cardW: cardW, gapW: gapW, top: top,
          fits: bandH <= IMG.height,
          left:  {x: 0, y: top, w: cardW, h: bandH},
          right: {x: IMG.width - cardW, y: top, w: cardW, h: bandH}};
}

function load(file){
  if (!file) return;
  NAME = file.name || NAME;
  var r = new FileReader();
  r.onload = function(){
    var im = new Image();
    im.onload = function(){
      IMG = im;
      var bandH = Math.round(im.width * BAND.card_h / BAND.span);
      var room = Math.max(0, im.height - bandH);
      el("rY").max = el("nY").max = room;
      el("rY").value = el("nY").value = Math.floor(room / 2);
      draw();
      refState();
    };
    im.src = r.result;
  };
  r.readAsDataURL(file);
}
el("file").onchange = function(){ load(this.files[0]); };
el("drop").onclick = function(){ el("file").click(); };
["dragenter","dragover"].forEach(function(t){
  el("drop").addEventListener(t, function(e){ e.preventDefault(); this.classList.add("over"); }); });
["dragleave","drop"].forEach(function(t){
  el("drop").addEventListener(t, function(e){ e.preventDefault(); this.classList.remove("over"); }); });
el("drop").addEventListener("drop", function(e){
  load(e.dataTransfer.files && e.dataTransfer.files[0]); });

el("rY").oninput = function(){ el("nY").value = this.value; draw(); };
el("nY").oninput = function(){ el("rY").value = this.value; draw(); };
el("bCentre").onclick = function(){
  if (!IMG) return;
  var g = geom();
  var v = Math.floor(Math.max(0, IMG.height - g.bandH) / 2);
  el("rY").value = el("nY").value = v; draw();
};

function draw(){
  var g = geom();
  if (!g) return;
  el("masterWrap").style.display = "block";
  el("previewWrap").style.display = "block";

  var c = el("master"), x = c.getContext("2d");
  c.width = IMG.width; c.height = IMG.height;
  x.drawImage(IMG, 0, 0);
  // What is being dropped is dimmed, not hidden: the choice is as much about what goes as what
  // stays, and a preview that only showed the keep would not be showing the decision.
  x.fillStyle = "rgba(0,0,0,0.62)";
  x.fillRect(0, 0, c.width, c.height);
  [g.left, g.right].forEach(function(r){ x.save(); x.beginPath();
    x.rect(r.x, r.y, r.w, r.h); x.clip(); x.drawImage(IMG, 0, 0); x.restore(); });
  var lw = Math.max(2, Math.round(IMG.width / 500));
  x.lineWidth = lw;
  x.strokeStyle = "#d8b26a"; x.strokeRect(g.left.x, g.left.y, g.left.w, g.left.h);
  x.strokeStyle = "#8fb6d8"; x.strokeRect(g.right.x, g.right.y, g.right.w, g.right.h);

  // THE PREVIEW AT BOARD SIZE, drawn at 2x and shown at 1x: crisp on a retina screen without
  // ever being bigger than the board will be. The question is "does this read at 375 x 184",
  // and a preview that flatters it answers a different one.
  var K = 2;
  [[el("pvL"), g.left], [el("pvR"), g.right]].forEach(function(p){
    var cv = p[0], r = p[1], cx = cv.getContext("2d");
    cv.width = BAND.card_w * K; cv.height = BAND.card_h * K;
    cv.style.width = BAND.card_w + "px"; cv.style.height = BAND.card_h + "px";
    cx.imageSmoothingQuality = "high";
    cx.drawImage(IMG, r.x, r.y, r.w, r.h, 0, 0, cv.width, cv.height);
  });
  el("pvGap").style.width = BAND.gap + "px";
  el("pvNote").textContent = "each " + BAND.card_w + " x " + BAND.card_h
    + " at 1:1, with the board's own " + BAND.gap + " px gap between them";

  paintOut(g);
}

// WHAT `cover` WILL THROW AWAY, in slot pixels. It should be a fraction of a pixel now -- the
// cut gives the slot's ratio by construction and only integer rounding is left -- and it is
// MEASURED rather than asserted, because "by construction" is a claim about arithmetic nobody
// re-checks after editing it.
function coverClip(g){
  var s = Math.max(BAND.card_w / g.cardW, BAND.card_h / g.bandH);
  return Math.max(g.cardW * s - BAND.card_w, g.bandH * s - BAND.card_h);
}

function paintOut(g){
  var rows = [];
  function row(k, v, cls){ rows.push('<tr><td>' + k + '</td><td class="num ' + (cls||"")
                                     + '">' + v + '</td></tr>'); }
  row("master", IMG.width + " x " + IMG.height);
  row("band", IMG.width + " x " + g.bandH + " at y " + g.top);
  row("dropped", (IMG.height - g.bandH) + " px of height  ("
      + (100 * (IMG.height - g.bandH) / IMG.height).toFixed(0) + "%)");
  row("left", "x 0 .. " + g.cardW + "   y " + g.top + " .. " + (g.top + g.bandH));
  row("right", "x " + g.right.x + " .. " + IMG.width + "   y " + g.top + " .. " + (g.top + g.bandH));
  row("the gap hides", g.gapW + " px of picture");
  row("card", g.cardW + " x " + g.bandH + "   ratio " + (g.cardW / g.bandH).toFixed(5));
  var sc = g.cardW / BAND.card_w;
  row("scale", sc.toFixed(2) + "x the slot", sc < 1 ? "bad" : (sc < 2 ? "hot" : "good"));
  if (!g.fits)
    row("!", "this master is too TALL for its width -- the band wants " + g.bandH
        + " px and it has " + IMG.height, "bad");
  if (sc < 1) row("!", "the board would have to enlarge this", "bad");
  var clip = coverClip(g);
  row("cover", clip < 0.5 ? "clips " + clip.toFixed(2) + " px -- nothing to see"
                          : "clips " + clip.toFixed(1) + " px", clip < 0.5 ? "good" : "hot");
  el("out").innerHTML = rows.join("");

  var stem = NAME.replace(/\.[^.]+$/, "");
  el("cmd").textContent =
      "python3 tools/duty_art/crop_duty_master.py \\\n"
    + "    '" + NAME + "' \\\n"
    + "    --out-dir ui/board_v2/duty_actions/<duty>/ \\\n"
    + "    --left-name <duty>_<actionA>_left.png \\\n"
    + "    --right-name <duty>_<actionB>_right.png \\\n"
    + "    --y " + g.top;
}

// =============================================================================================
// THE GENERATION BRIEF.
//
// The prose is master_prompt.md; the geometry paragraph is written here, from the same band the
// cut uses. That is the whole reason this lives in the tool rather than in a text file somebody
// keeps beside it: a brief that asks for one shape while the cut takes another is worse than no
// brief, and a brief that has to be edited by hand every time the board moves will not be.
//
// IT IS EXPRESSED IN PROPORTIONS, NOT PIXELS, and that is not a style choice. A 2544 x 848 was
// asked for and 2172 x 724 came back -- the generator honoured the ASPECT and ignored the size,
// because it works to a fixed pixel budget. Pixel dimensions in a brief are noise; the shape and
// the zones are what it can actually act on.
var PROMPTS = __PROMPTS__;
var ASPECTS = __ASPECTS__, GEOMETRY = __GEOMETRY__;

// THE FIELDS OPEN ON A WORKED EXAMPLE, not on nothing, and the words come from subjects.json
// so this page and the art board cannot offer different briefs for the same duty.
var SUBJECTS = __SUBJECTS__;
(function(){
  var first = SUBJECTS[Object.keys(SUBJECTS)[0]];
  if (!first) return;
  el("subL").value = first.left || "";
  el("subR").value = first.right || "";
})();

function bandAspect(){ return BAND.span / BAND.card_h; }
function keptFraction(a){ return a / bandAspect(); }

// THE PARAGRAPH IS LOOKED UP, NOT BUILT. It is written once, in Python, from the same band the
// cut uses -- see geometry_text() in the generator. Building it here as well is how a brief and
// a cut come to disagree.
function geometryText(){ return GEOMETRY[el("aspect").value]; }

(function(){
  var s = el("aspect");
  s.innerHTML = ASPECTS.map(function(a){
    return '<option value="' + a + '"' + (a === "3.0" ? " selected" : "") + '>' + a
         + ':1  &middot; keeps ' + (100 * keptFraction(+a)).toFixed(0) + '% of the height</option>';
  }).join("");
  s.onchange = paintAspect;
  paintAspect();
})();
function paintAspect(){
  var a = +el("aspect").value, kept = keptFraction(a);
  el("aspectNote").innerHTML =
      'The board\'s band is <b>' + bandAspect().toFixed(4) + ':1</b> &mdash; wider than any '
    + 'generator will draw &mdash; so the shortfall is always vertical. At ' + a.toFixed(1)
    + ':1, <b>' + (100 * kept).toFixed(0) + '%</b> of the height survives the crop and '
    + (100 * (1 - kept)).toFixed(0) + '% is overscan. <b>3:1 is the widest ChatGPT allows and '
    + 'therefore the least wasteful ask.</b>';
}

function fullPrompt(which){
  var P = (which === undefined ? PROMPTS[0] : PROMPTS[which]);
  if (P.archival) return P.text;        // verbatim, by definition
  return P.text
    .replace(/\{\{GEOMETRY\}\}/g, geometryText())
    .replace(/\{\{LEFT_ACTION\}\}/g, el("actL").value.trim() || "LEFT ACTION")
    .replace(/\{\{RIGHT_ACTION\}\}/g, el("actR").value.trim() || "RIGHT ACTION")
    .replace(/\{\{LEFT_SUBJECT\}\}/g, el("subL").value.trim() || "- [describe it]")
    .replace(/\{\{RIGHT_SUBJECT\}\}/g, el("subR").value.trim() || "- [describe it]");
}

function copyText(text, button, done){
  var t = document.createElement("textarea");
  t.value = text;
  document.body.appendChild(t); t.select();
  try { document.execCommand("copy"); } catch (e) {}
  t.remove();
  var was = button.textContent;
  button.textContent = done;
  setTimeout(function(){ button.textContent = was; }, 1400);
}
// ONE BUTTON PER BRIEF. They are alternatives to run against each other, not versions of one
// thing, so they all stay reachable rather than the newest winning by default.
el("promptBtns").innerHTML = PROMPTS.map(function(p, i){
  return '<button data-p="' + i + '" class="' + (p.archival ? "arch" : "")
       + '" title="' + p.file + '">' + p.title + '</button>';
}).join("");
// AN ARCHIVAL BRIEF SAYS SO ON THE PAGE, not only in a comment nobody opens. It is somebody's
// text kept because it produced a particular picture, so the page fills nothing in and the
// geometry it asks for is its own -- which for the ones here does NOT match what the cut does.
// A button that looked like the others would be offering it as a live option.
(function(){
  var arch = PROMPTS.filter(function(p){ return p.archival; });
  if (!arch.length) return;
  el("promptBtns").insertAdjacentHTML("afterend",
    '<div class=hint>' + arch.map(function(p){
      return '<b>' + p.title + '</b> is a record, copied verbatim with nothing filled in \u2014 '
           + p.archival;
    }).join('<br>') + '</div>');
})();
[].forEach.call(el("promptBtns").querySelectorAll("button"), function(b){
  b.onclick = function(){
    copyText(fullPrompt(+this.dataset.p), this, "copied \u2014 attach the reference");
  };
});

// =============================================================================================
// THE CAMERA REFERENCE, AND COMPARING IT AGAINST A GENERATED FLOOR.
//
// A circle lying on the ground at elevation t projects to an ellipse whose minor axis over its
// major is sin(t), which is the one thing about this plate that can be MEASURED rather than
// asserted. The silhouette includes the rim's thickness, though, and thickness only ever adds
// height -- so what comes out is an UPPER BOUND on the elevation and is labelled as one. A page
// that printed it as "32 degrees" would be quoting the brief back at itself.
// INLINED ONCE and handed to the three places that need it. As three attributes it was 10.4 MB
// of page for a 2.6 MB picture.
var REF_SRC = "__REF__";
var REF = el("refThumb"), REFBOX = __REFBOX__;
REF.src = REF_SRC;
el("refGhost").src = REF_SRC;
el("refDl").href = REF_SRC;
REF.onerror = function(){
  el("refState").innerHTML = '<b class=bad>The reference image did not load.</b> It is inlined '
    + 'in this page, so if you are seeing this the file is truncated &mdash; download it again '
    + 'rather than copying it out of a preview pane.';
};
// WHY THE PLATE CANNOT BE DRAGGED YET, said out loud. Before this it was simply inert, which is
// indistinguishable from broken -- and was read as broken, correctly, because nothing on the
// page distinguished "no master loaded" from "this feature does not work".
function refState(){
  var ready = !!IMG;
  REF.classList.toggle("idle", !ready);
  el("refDrag").innerHTML = ready
    ? '<b>Drag the plate onto the master</b> to lay it over the floor and compare the ground '
      + 'plane. Let go and it disappears.'
    : 'Drop a master in above, then drag this plate onto it to compare the ground plane. '
      + '<b>There is nothing to lay it over yet.</b>';
}
(function(){
  // THE PICTURE'S SIZE, NOT THE FILE'S. Measured at build time off the alpha channel, because a
  // transparent margin is still pixels: the file is 1677 x 938 and reports 34.0 degrees,
  // the plate inside it is smaller and reports 33.2. The page prints an angle, so the number
  // behind it has to be the plate's.
  var r = REFBOX.h / REFBOX.w;
  var deg = Math.asin(Math.min(1, r)) * 180 / Math.PI;
  var margin = (REFBOX.fileW !== REFBOX.w || REFBOX.fileH !== REFBOX.h);
  el("refNote").innerHTML =
      'The plate itself is <b>' + REFBOX.w + ' x ' + REFBOX.h + '</b>'
    + (margin ? ' (the file is ' + REFBOX.fileW + ' x ' + REFBOX.fileH
                + ', the rest transparent)' : '')
    + ', a height over width of <b>' + r.toFixed(4) + '</b>. A circle lying on the ground at '
    + 'elevation <i>t</i> projects to an ellipse of that ratio when <i>t</i> = <b>'
    + deg.toFixed(1) + '&deg;</b>. The rim has thickness and thickness only ADDS height, so the '
    + 'true elevation is a little under that &mdash; an upper bound, and consistent with the '
    + '32&deg; the briefs ask for.';
})();

// DRAG IT ONTO THE MASTER AND LET GO. Deliberately transient: the comparison wanted is "does
// this floor recede like that floor", which is a glance, and anything that stayed on screen
// would have to be dismissed. Sized to a third of the master's width, which puts it at roughly
// the scale of a paved area in these scenes rather than at whatever the file happens to be.
var ghost = el("refGhost");
function ghostAt(ev){
  var wrap = el("masterWrap"), r = wrap.getBoundingClientRect();
  if (ev.clientX < r.left || ev.clientX > r.right
      || ev.clientY < r.top || ev.clientY > r.bottom){ ghost.style.display = "none"; return; }
  ghost.style.display = "block";
  ghost.style.width = Math.round(r.width / 3) + "px";
  ghost.style.left = (ev.clientX - r.left) + "px";
  ghost.style.top = (ev.clientY - r.top) + "px";
}
function ghostOff(){ ghost.style.display = "none"; }

// Pointer events rather than HTML5 drag-and-drop: dragstart hands you a drag IMAGE and a drop
// target contract, neither of which is wanted here, and dragover coordinates are unreliable
// across browsers. A pointer held down is exactly the gesture being described.
REF.addEventListener("pointerdown", function(ev){
  if (!IMG) return;                       // nothing to compare against yet
  ev.preventDefault();
  REF.setPointerCapture(ev.pointerId);
  ghostAt(ev);
  var move = function(e){ ghostAt(e); };
  var up = function(e){
    ghostOff();
    REF.removeEventListener("pointermove", move);
    REF.removeEventListener("pointerup", up);
    REF.removeEventListener("pointercancel", up);
  };
  REF.addEventListener("pointermove", move);
  REF.addEventListener("pointerup", up);
  REF.addEventListener("pointercancel", up);
});
// The browser's own drag would fight the gesture above, so it is turned off rather than used.
REF.addEventListener("dragstart", function(ev){ ev.preventDefault(); });
refState();

el("bCopy").onclick = function(){ copyText(el("cmd").textContent, this, "copied"); };
</script>
