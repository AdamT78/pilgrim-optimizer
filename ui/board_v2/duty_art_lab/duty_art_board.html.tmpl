<!doctype html>
<meta charset="utf-8">
<title>Duty action art __BUILD__</title>
<style>
  :root{--ink:#e7ddc6;--dim:#9c9075;--line:#ffffff1c;--hot:#d8b26a;--warn:#e08a6a;--ok:#8fae6a}
  *{box-sizing:border-box}
  html,body{margin:0;background:#0b0a09;color:var(--ink);
    font:13px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace}
  #page{padding:20px 22px;max-width:1180px}
  h1{margin:0 0 4px;font:600 19px/1.2 Georgia,serif;letter-spacing:.04em}
  .sub{color:var(--dim);margin:0 0 4px;max-width:80ch}
  #tally{margin:14px 0 22px;padding:10px 12px;border:1px solid var(--line);border-radius:5px;
    background:#ffffff05}
  #bar{display:flex;height:9px;border-radius:2px;overflow:hidden;margin:8px 0 6px;
    background:#ffffff0d}
  #bar i{display:block;height:100%}
  #bar .done{background:var(--ok)} #bar .todo{background:#ffffff12}

  .duty{margin:0 0 26px;padding-top:14px;border-top:1px solid var(--line)}
  .dh{display:flex;align-items:baseline;gap:10px;margin-bottom:9px;flex-wrap:wrap}
  .dh b{font:600 15px/1.2 Georgia,serif;letter-spacing:.07em;text-transform:uppercase}
  .dh .n{color:var(--dim);font-size:11px}
  .dh .one{color:var(--hot);font-size:11px;border:1px solid #6b5c3e;border-radius:2px;
    padding:1px 5px}
  /* THE BAND, AT THE BOARD'S OWN SIZE AND WITH THE BOARD'S OWN GAP. Judging art at any other
     size answers a different question, and this page exists to be judged from. */
  .band{display:flex;background:#000;padding:10px;border-radius:5px;border:1px solid var(--line);
    width:max-content}
  .slot{position:relative}
  .slot img{display:block;outline:1px solid #ffffff2e}
  /* AN EMPTY SLOT IS THE POINT, so it is drawn rather than left out: a dashed frame the exact
     size of the card, carrying the name of the action nobody has drawn yet. */
  .slot.empty{border:1px dashed #d8b26a55;background:#d8b26a08;display:grid;place-items:center;
    text-align:center;padding:10px}
  .slot.empty span{color:#d8b26aaa;font-size:11px;line-height:1.5}
  .slot.empty b{display:block;color:var(--hot);font:600 13px/1.3 Georgia,serif;
    letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px}
  /* A duty that offers one action has no second card at all -- not an empty one. Showing a
     blank there would put it on the list of things to draw, and it is not one. */
  .slot.na{border:1px dashed #ffffff1a;display:grid;place-items:center;text-align:center}
  .slot.na span{color:#5f594e;font-size:11px}
  .cap{position:absolute;left:0;right:0;bottom:0;padding:5px 8px;
    font:600 11px/1.2 Georgia,serif;letter-spacing:.1em;text-transform:uppercase;color:#e2d7bc;
    background:linear-gradient(transparent,#000000cc 62%);pointer-events:none}
  .ver{position:absolute;right:5px;top:5px;font-size:9px;letter-spacing:.06em;color:#cfc4a8;
    background:#0d0c0ac9;border:1px solid #ffffff22;border-radius:2px;padding:1px 4px}
  .ver.inboard{color:var(--ok);border-color:#8fae6a55}
  .ver.notboard{color:var(--warn);border-color:#e08a6a55}

  .aside{margin-top:8px;display:flex;gap:16px;flex-wrap:wrap;align-items:flex-start}
  .masters img{display:block;border:1px solid var(--line);border-radius:3px;margin-top:4px}
  .k{color:var(--dim);font-size:11px}
  .btns{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
  button{background:#241f17;color:var(--ink);border:1px solid #6b5c3e;border-radius:3px;
    padding:4px 8px;font:11px/1.4 ui-monospace,monospace;cursor:pointer}
  button:hover{background:#2f281d}
  .warn{color:var(--warn)} .good{color:var(--ok)} .dimc{color:var(--dim)}
  .note{color:var(--dim);font-size:11px;margin-top:6px;max-width:78ch}
  #briefPick{margin:-10px 0 22px;color:var(--dim);font-size:11px}
  #briefPick select{background:#151310;color:var(--ink);border:1px solid var(--line);
    border-radius:3px;padding:3px 6px;font:11px/1.4 ui-monospace,monospace;margin:0 4px}
  .nosub{color:var(--warn)}

  /* ---- the seals -------------------------------------------------------------------------
     SHOWN AT THE SIZE THE BOARD DRAWS THEM, like everything else on this page, because a wax
     seal judged at 500px is a different object from one judged at 78. The superseded versions
     sit beside the one that draws, dimmed, so what a new one replaced is visible rather than
     only inferable from a filename that sorts. */
  .seals{margin-top:8px;display:flex;gap:18px;flex-wrap:wrap;align-items:flex-start}
  .sealslot{display:flex;gap:8px;align-items:flex-start}
  .sealslot .k{min-width:52px}
  .disc{position:relative;display:block}
  .disc img{display:block;image-rendering:auto}
  .disc.old img{opacity:.38;filter:grayscale(.55)}
  .disc .v{position:absolute;right:-2px;bottom:-4px;font-size:9px;letter-spacing:.06em;
    color:#cfc4a8;background:#0d0c0ad9;border:1px solid #ffffff22;border-radius:2px;
    padding:0 3px}
  .disc.draws .v{color:var(--ok);border-color:#8fae6a55}
  .brf{position:absolute;left:-3px;bottom:-4px;width:15px;height:15px;padding:0;line-height:13px;
    text-align:center;font-size:9px;border-radius:50%;border:1px solid #6b5c3e;background:#241f17;
    color:var(--ok);cursor:pointer}
  .brf.none{color:#5f594e;border-color:#ffffff1a;cursor:default}
  .sealnone{border:1px dashed #d8b26a55;background:#d8b26a08;border-radius:50%;
    display:grid;place-items:center;color:#d8b26aaa;font-size:10px;text-align:center}
  #tithe{margin:0 0 26px;padding:12px 14px;border:1px solid var(--line);border-radius:5px;
    background:#0e0d0b}
  #tithe .row{display:flex;gap:26px;align-items:flex-start;margin-top:8px;flex-wrap:wrap}
</style>

<div id=page>
  <h1>Duty action art</h1>
  <p class=sub>Every action slot on the board, in the wheel's own order, at the size the board
  draws them. The duties and their order come from the action board's geometry; the action names from
  <code>duty_text.json</code>; the art from <code>ui/board_v2/duty_actions/</code>. Nothing here
  is typed.</p>
  <div id=tally></div>
  <div id=briefPick></div>
  <div id=tithe></div>
  <div id=list></div>
</div>

<script>
var D = __DATA__, BAND = D.band;
var el = function(id){ return document.getElementById(id); };
function esc(s){ return String(s).replace(/[&<>"]/g, function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]; }); }

// NEWEST FIRST. The files are versioned by a _vNN suffix and the last one is the one being
// looked at; an alphabetical first would show v01 forever.
function newest(list){
  if (!list || !list.length) return null;
  return list.slice().sort(function(a, b){
    return a.file.localeCompare(b.file, undefined, {numeric: true});
  }).pop();
}

function slotHtml(s, side, inBoard){
  if (s) s = Object.assign({}, s, {inBoard: inBoard});
  var w = BAND.card_w, h = BAND.card_h;
  var dim = 'width:' + w + 'px;height:' + h + 'px';
  if (s === null)
    return '<div class="slot na" style="' + dim + '"><span>this duty offers<br>one action</span></div>';
  var art = newest(s.art);
  if (!art)
    return '<div class="slot empty" style="' + dim + '"><span><b>' + esc(s.label || side)
         + '</b>' + (s.name ? esc(s.name) + '<br>' : '') + 'not drawn yet</span></div>';
  // IS THIS THE FILE THE BOARD DRAWS? This page and the action board now ask the same
  // function which slot a file belongs in, so they should always agree -- and the moment they
  // do not, this badge is where it shows, rather than in a board that quietly draws a placeholder.
  var v = (art.file.match(/_v(\d+)/) || [,null])[1];
  var inBoard = s.inBoard && s.inBoard === art.file;
  var mark = inBoard ? '' : (s.inBoard ? ' \u2260' : ' \u2717');
  var why = inBoard ? 'the board draws this file'
          : (s.inBoard ? 'the board draws ' + s.inBoard + ' instead'
                     : 'the board will NOT draw any art here \u2014 no slot is recorded for '
                       + 'it in attribution.json');
  return '<div class=slot style="' + dim + '">'
       + '<img src="' + art.src + '" width="' + w + '" height="' + h + '" alt="">'
       + '<div class=cap>' + esc(s.label || "") + '</div>'
       + '<div class="ver' + (inBoard ? ' inboard' : ' notboard') + '" title="'
       + esc(art.folder + '/' + art.file + ' \u2014 ' + why) + '">'
       + esc(v ? "v" + v : art.file) + mark + '</div></div>';
}


// =================================================================================================
// THE SEALS. Two conventions, and the page shows which is which rather than implying one.
//
// A DUTY seal's print carries its version and the board draws the newest, so the first entry is
// the one in play and the rest are what it superseded -- dimmed, still there, because the whole
// point of keeping v01 is being able to look at it.
//
// A TITHE seal's print has a stable name, so there is no version to pick at draw time: the
// version lives on the master and replacing the print is the change. Putting it in the same band
// would say the two work alike, so it gets its own block that names its masters instead.
// A SEAL WITH NO BRIEF SAYS SO. Seventeen of the nineteen were filed before the briefs were
// kept, and a page that showed only the ones with a brief would make that look like nothing is
// missing. The dot is the whole indicator: filled means the text that produced this file is in
// the tree, hollow means it is not.
function discHtml(a, px, draws){
  var b = a.brief;
  return '<span class="disc' + (draws ? ' draws' : ' old') + '" title="' + esc(a.file)
       + (b ? ' \u2014 ' + esc(b.file) : ' \u2014 no brief kept') + '">'
       + '<img src="' + a.src + '" width="' + px + '" height="' + px + '" alt="">'
       // NO BADGE WHERE THERE IS NO VERSION. The Tithe prints carry a stable name on purpose,
       // so a "v?" on them would invent a question the filename is not asking.
       + (a.file.match(/_v(\d+)/)
            ? '<span class=v>v' + esc(a.file.match(/_v(\d+)/)[1]) + '</span>' : '')
       + (b ? '<button class=brf data-brief-file="' + esc(b.file) + '">\u25cf</button>'
            : '<span class="brf none">\u25cb</span>')
       + '</span>';
}

// The brief itself, copied verbatim -- it is archival, so there is nothing to substitute.
var SEALBRIEF = {};
(D.sealBriefs || []).forEach(function(b){ SEALBRIEF[b.file] = b; });
document.addEventListener("click", function(ev){
  var t = ev.target.closest && ev.target.closest("[data-brief-file]");
  if (!t) return;
  var b = SEALBRIEF[t.getAttribute("data-brief-file")];
  if (!b) return;
  navigator.clipboard.writeText(b.text).then(function(){
    var was = t.textContent; t.textContent = "\u2713";
    setTimeout(function(){ t.textContent = was; }, 1100);
  });
});

function sealsHtml(d, px){
  var slots = [["left", "action A"], ["right", "action B"]];
  var parts = slots.map(function(pair){
    if (pair[0] === "right" && d.actions === 1) return "";
    var list = (d.seals || {})[pair[0]] || [];
    var inner = list.length
      ? list.map(function(a, i){ return discHtml(a, px, i === 0); }).join("")
      : '<span class=sealnone style="width:' + px + 'px;height:' + px + 'px">no<br>seal</span>';
    return '<div class=sealslot><span class=k>' + pair[1] + '</span>'
         + '<div style="display:flex;gap:10px">' + inner + '</div></div>';
  }).join("");
  return '<div class=seals>' + parts + '</div>';
}

el("tithe").innerHTML = '<span class=k>TAKE TITHE &mdash; the three resource seals</span>'
  + '<div class=row>' + D.titheSeals.map(function(t){
      var img = t.src
        ? discHtml({file: t.file, src: t.src, brief: t.brief}, D.sealPx, true)
        : '<span class=sealnone style="width:' + D.sealPx + 'px;height:' + D.sealPx
          + 'px">no<br>seal</span>';
      return '<div><div class=k style="margin-bottom:5px">' + esc(t.name) + '</div>' + img
           + '<div class=k style="margin-top:6px">' + (esc(t.file || "\u2014"))
           + '<br>' + (t.masters.length ? t.masters.map(esc).join('<br>')
                                        : '<span class=warn>no master</span>') + '</div></div>';
    }).join("") + '</div>'
  + '<div class=note>These keep their version on the MASTER, not on the print: the generator '
  + 'looks the print up by name, so replacing it is the change. A duty\'s seals work the other '
  + 'way round \u2014 the print carries the version and the newest draws.</div>'
  + ((D.sealBriefsWaiting || []).length
      ? '<div class=note><span class=warn>written, nothing filed against it yet:</span> '
        + D.sealBriefsWaiting.map(function(b){
            return '<button data-brief-file="' + esc(b.file) + '">' + esc(b.title) + '</button>';
          }).join(" ")
        + '</div>'
      : '')
  + '<div class=note>A filled dot is a seal whose brief is kept in '
  + '<code>duty_art_lab/prompts/seals/</code>; click it to copy the text as sent. A hollow one '
  + 'was filed before the briefs were, and its record says so rather than guessing.</div>';

el("list").innerHTML = D.duties.map(function(d, i){
  var pair = '<div class=band>' + slotHtml(d.left, "action A", d.inBoard.left)
           + '<div style="width:' + BAND.gap + 'px"></div>'
           + slotHtml(d.actions === 1 ? null : d.right, "action B", d.inBoard.right) + '</div>';
  var m = newest(d.masters);
  var aside = '<div class=aside>'
    + '<div class=masters><span class=k>master</span>'
      + (m ? '<img src="' + m.src + '" width="260" alt=""><div class=k>' + esc(m.file) + '</div>'
           : '<div class="k warn" style="margin-top:4px">none &mdash; nothing to re-cut from</div>')
    + '</div>'
    + '<div><span class=k>folders</span><div class=k>'
      + (d.folders.length ? d.folders.map(esc).join('<br>') : 'none') + '</div></div>'
    + (d.unplaced.length ? '<div><span class="k warn">not placed</span><div class=k>'
        + d.unplaced.map(function(u){ return esc(u.folder + '/' + u.file); }).join('<br>')
        + '</div></div>' : '')
    + '</div>';
  var names = [d.left && d.left.label, d.actions === 1 ? null : (d.right && d.right.label)]
                .filter(Boolean).map(esc).join('  &middot;  ');
  return '<div class=duty><div class=dh><b>' + esc(d.name) + '</b>'
       + '<span class=n>' + names + '</span>'
       + (d.actions === 1 ? '<span class=one>one action</span>' : '')
       + '</div>' + pair + sealsHtml(d, D.sealPx) + aside
       + '<div class=btns><button data-brief="' + i + '">copy a brief for '
       + esc(d.name) + '</button></div></div>';
}).join("");

// THE TALLY IS COUNTED, NOT WRITTEN DOWN. A page about what is missing that had a hand-kept
// number on it would be wrong the first time somebody drew something.
(function(){
  var slots = 0, done = 0, masters = 0, inBoard = 0;
  D.duties.forEach(function(d){
    ["left","right"].forEach(function(k){
      if (k === "right" && d.actions === 1) return;
      if (!d[k]) return;
      slots++;
      if (newest(d[k].art)) done++;
      if (d.inBoard[k]) inBoard++;
    });
    if (newest(d.masters)) masters++;
  });
  el("tally").innerHTML =
      '<b>' + done + ' of ' + slots + ' action slots drawn</b>'
    + '  <span class=k>&middot; ' + masters + ' of ' + D.duties.length
        + ' duties have a master to re-cut from</span>'
    + '<div id=bar><i class=done style="width:' + (100*done/slots) + '%"></i>'
    + '<i class=todo style="width:' + (100*(slots-done)/slots) + '%"></i></div>'
    + '<span class=k>A dashed gold frame is an action nobody has drawn. A grey one is a duty '
    + 'that offers a single action, so there is no second card to draw.</span>'
    + '<div class=note>A badge in <b class=good>green</b> is the file the action board will '
        + 'actually open with. <b class=warn>Red</b> means it will not: either no slot is '
        + 'recorded for it, or a different file wins. Both pages ask the same function which '
        + 'slot a file belongs in, so they should never disagree &mdash; if they do, this is '
        + 'where it shows.</div>'
    + (inBoard !== done
        ? '<div class="note warn"><b>' + done + ' slot(s) have art on disk but the board draws '
          + 'with ' + inBoard + '.</b> The difference is files whose slot cannot be established.</div>'
        : '')
    + (D.artNotes.length ? '<div class="note warn"><b>Left out of the board:</b><br>'
        + D.artNotes.map(esc).join('<br>')
        + '<br>The folder names came from wording that has since changed, so they neither match '
        + 'duty_text.json nor sort into slot order &mdash; Clerical\'s left is '
        + '<code>gain_piety</code> and its right is <code>gain_coins</code>. Adding '
        + '<code>"slot": "left"</code> to an entry settles it for good.</div>' : '');
})();

// A COMPLETE BRIEF PER DUTY. It used to copy the two action names and two "[describe it]"
// markers -- 264 characters under a button that said "copy a brief", which is not a brief. The
// whole text is here now, with the shape paragraph already computed at 3:1 and the duty's own
// names substituted. What is still a marker is the SUBJECT, and only where nobody has written
// one: subjects.json has Clerical and nothing else, and the page says which is which rather
// than handing out a placeholder that looks like content.
el("briefPick").innerHTML = 'Each button copies the whole of '
  + '<select id=whichBrief>' + D.briefs.map(function(b, i){
      return '<option value="' + i + '">' + esc(b.title) + '</option>'; }).join("")
  + '</select> with that duty\'s action names in it, at 3:1. '
  + 'The <i>original</i> brief is not offered here because it substitutes nothing &mdash; it '
  + 'names Clerical\'s actions whichever button you press. It is on the viewfinder, where '
  + 'copied-verbatim is the point.';

function briefFor(d){
  var b = D.briefs[+el("whichBrief").value];
  var subj = D.subjects[d.slug] || {};
  var missing = [];
  if (!subj.left) missing.push("left");
  if (d.actions > 1 && !subj.right) missing.push("right");
  var text = b.text
    .replace(/\{\{LEFT_ACTION\}\}/g, d.left.name || d.left.label || "LEFT ACTION")
    .replace(/\{\{RIGHT_ACTION\}\}/g,
             d.actions === 1 ? "(this duty offers ONE action -- see the note at the end)"
                             : (d.right.name || d.right.label || "RIGHT ACTION"))
    .replace(/\{\{LEFT_SUBJECT\}\}/g, subj.left || "- [nobody has written this down yet]")
    .replace(/\{\{RIGHT_SUBJECT\}\}/g, subj.right || "- [nobody has written this down yet]");
  // A ONE-ACTION DUTY GETS TOLD SO, at the end where it will be read. Handing it a brief built
  // around two zones without a word about it is how you get two scenes for a duty that offers
  // one, and only find out after generating.
  if (d.actions === 1)
    text += "\n\n======================================================================\n"
          + "THIS DUTY OFFERS ONE ACTION\n"
          + "======================================================================\n\n"
          + "The board draws a single card for it, not two. Ignore the two-zone split above:\n"
          + "compose ONE scene across the whole width, and do not put a seam down the middle.\n";
  return {text: text, missing: missing};
}

[].forEach.call(document.querySelectorAll("[data-brief]"), function(btn){
  btn.onclick = function(){
    var r = briefFor(D.duties[+this.dataset.brief]);
    var a = document.createElement("textarea");
    a.value = r.text; document.body.appendChild(a); a.select();
    try { document.execCommand("copy"); } catch (e) {}
    a.remove();
    var was = this.dataset.label || this.textContent;
    this.dataset.label = was;
    this.textContent = r.missing.length
      ? "copied \u2014 " + r.missing.join(" and ") + " subject still blank"
      : "copied \u2014 complete";
    var me = this; setTimeout(function(){ me.textContent = was; }, 2200);
  };
});

// WHICH DUTIES HAVE NO SUBJECT WRITTEN DOWN, said on the page rather than discovered on paste.
[].forEach.call(document.querySelectorAll("[data-brief]"), function(btn){
  var d = D.duties[+btn.dataset.brief], s = D.subjects[d.slug] || {};
  var need = (!s.left) || (d.actions > 1 && !s.right);
  if (need) btn.insertAdjacentHTML("afterend",
    '<span class="k nosub" style="align-self:center">no subject written yet &mdash; '
    + 'add it to subjects.json</span>');
});
</script>
