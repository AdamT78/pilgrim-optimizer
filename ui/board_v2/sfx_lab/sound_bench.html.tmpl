<!doctype html><html lang=en><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<title>Pilgrim sound bench</title>
<style>
:root{--bg:#07070a;--panel:#0e0d0b;--line:#46413a;--ink:#e2d7bc;--dim:#968e7c;
      --gold:#c9b27a;--empty:#2a2721}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
     font:14px/1.55 ui-sans-serif,system-ui,sans-serif;padding:28px 16px 80px}
.wrap{max-width:900px;margin:0 auto}
h1{font:600 26px/1.2 Georgia,serif;margin:0 0 6px}
.sub{color:var(--dim);margin:0 0 26px}
h2{font:600 15px/1.2 Georgia,serif;letter-spacing:.16em;text-transform:uppercase;
   color:var(--gold);margin:34px 0 10px;padding-bottom:7px;border-bottom:1px solid #26231e}
h3{font:600 14px/1.2 Georgia,serif;letter-spacing:.06em;margin:18px 0 8px}
.lead{color:var(--dim);margin:-2px 0 16px;max-width:62em}
.lead code{color:var(--ink);font:12px ui-monospace,monospace}
.card{background:var(--panel);border:1px solid var(--line);border-radius:5px;
      padding:11px 13px;margin:7px 0;display:flex;gap:13px;align-items:center;flex-wrap:wrap}
.card.empty{border-style:dashed;border-color:var(--empty);background:transparent;color:var(--dim)}
button{font:inherit;cursor:pointer;background:#1b1915;color:var(--ink);
       border:1px solid #3c372e;border-radius:3px;padding:7px 13px}
button:hover{border-color:var(--gold)}
button.play{min-width:76px}
button.play.on{background:#2e2718;border-color:var(--gold)}
.nm{font-weight:600;min-width:170px}
.meta{color:var(--dim);font:12px/1.4 ui-monospace,monospace;flex:1;min-width:210px}
.note{color:var(--dim);font-size:12px;width:100%;margin-top:-2px}
.g{display:flex;align-items:center;gap:7px;font:12px ui-monospace,monospace;color:var(--dim)}
input[type=range]{width:104px;accent-color:var(--gold)}
.lvl{display:flex;gap:13px;align-items:center;flex-wrap:wrap;margin:0 0 20px;padding:11px 13px;
     border:1px solid var(--line);border-radius:5px;background:var(--panel)}
.lvl button{min-width:132px}
.lvl button[aria-pressed=true]{background:#2e2718;border-color:var(--gold);color:var(--gold)}
.lvlnote{color:var(--dim);font-size:12.5px;flex:1;min-width:240px}
.trim{font:11px ui-monospace,monospace;color:var(--dim);border:1px solid #3c372e;
      border-radius:3px;padding:2px 6px}
.trim.up{color:#8fb98a;border-color:#3d5139} .trim.dn{color:#c98f8f;border-color:#553939}
.trim.lim{color:var(--gold);border-color:#5d5134}
.cov{display:flex;gap:7px;align-items:baseline;margin:0 0 4px}
.bar{height:7px;background:#1b1915;border:1px solid var(--line);border-radius:4px;
     overflow:hidden;width:190px}
.bar i{display:block;height:100%;background:var(--gold)}
.lv{font:11px ui-monospace,monospace;color:var(--dim)}
.set{border:1px solid #26231e;border-radius:6px;padding:13px 15px 15px;margin:14px 0;background:#0b0a09}
.set.chosen{border-color:#5d5134}
.sethead{display:flex;align-items:center;gap:11px;flex-wrap:wrap}
.setid{font:600 12px ui-monospace,monospace;color:var(--bg);background:var(--gold);
       border-radius:3px;padding:2px 7px}
.setname{font:600 15px Georgia,serif}
.tag{font:11px ui-sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);
     border:1px solid #5d5134;border-radius:3px;padding:2px 7px}
.sethead .seq{margin-left:auto;padding:6px 12px;font-size:13px}
.setnote{color:var(--dim);font-size:12.5px;margin:7px 0 4px}
.warn{border-left:3px solid var(--gold);padding:9px 12px;background:#141210;
      color:var(--dim);font-size:13px;margin:22px 0 0;border-radius:3px}
.warn b{color:var(--ink)}
</style>
<div class=wrap>
<h1>Pilgrim sound bench</h1>
<p class=sub>Every slot the board has, at the gains it actually plays them. Built from what is in
the tree, so it cannot disagree with what ships.</p>
<div class=lvl>
  <button id=lvlBtn aria-pressed="false">levelling: off</button>
  <span class=g>monitor <input type=range id=monitor min=-12 max=18 step=1 value=0>
    <span id=monv>0 dB</span></span>
  <span class=lvlnote id=lvlNote>every clip at its slider value, which is how the set sounds
  today &mdash; 31.9 dB of loudness between the quietest and the loudest.</span>
</div>
<div id=body></div>
<div class=warn><b>Levelling, not normalising.</b> These clips keep their natural levels because
what makes a set work is how loud they are <em>relative to each other</em>. Match a new clip by
ear against the ones here; never peak-normalise one on its own.</div>
<script>
var D = __DATA__, CL = [];
var LEVELLED = false, MONITOR = 1;

function esc(s){ return String(s == null ? "" : s)
  .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

function card(c, label, gain, seq, cue){
  var i = CL.length; CL.push({src: c.src, gain: gain, seq: seq, cue: cue, gainDb: c.gainDb});
  // THE MEAN IS OPTIONAL. It comes from the record and the record does not always carry one;
  // printing "mean null dB" is worse than printing nothing.
  var lv = c.peak == null ? ""
    : "peak " + c.peak + " dB" + (c.mean == null ? "" : " · mean " + c.mean + " dB");
  return '<div class=card><button class=play data-i="' + i + '">play</button>' +
    '<span class=nm>' + esc(label) + '</span>' +
    '<span class=meta>' + c.ms + ' ms · ' + c.sr + ' Hz ' + (c.ch === 1 ? 'mono' : 'stereo') +
      ' · ' + Math.round(c.bytes / 1024) + ' KB<br><span class=lv>' + lv + '</span></span>' +
    '<span class=g>gain <input type=range min=0 max=1 step=.01 value="' + gain +
      '" data-i="' + i + '"><span id="gv' + i + '">' + gain.toFixed(2) + '</span></span>' +
    (c.gainDb == null ? '<span class=trim>no gainDb</span>'
       : '<span class="trim ' + (c.gainDb > 0.05 ? 'up' : (c.gainDb < -0.05 ? 'dn' : '')) +
         '">' + (c.gainDb > 0 ? '+' : '') + c.gainDb.toFixed(1) + ' dB</span>') +
    '<span class=note>' + esc(c.file) + ' · ' + esc(c.licence) + ' — ' + esc(c.note) + '</span></div>';
}
function empty(name, why){
  return '<div class="card empty"><span class=nm>' + esc(name) + '</span>' +
         '<span class=meta>' + (why || 'no sound yet') + '</span></div>';
}
function coverage(have, total, word){
  return '<div class=cov><span class=lv>' + have + ' of ' + total + ' ' + word +
    ' have a sound</span><span class=bar><i style="width:' +
    (100 * have / total).toFixed(0) + '%"></i></span></div>';
}

var h = ["<h2>General</h2>",
  '<p class=lead>Each version is a complete set of cues. The board asks for its cues by name, ' +
  'so a version is just a different answer to them — and it is chosen whole, because what makes ' +
  'a set work is how its clips sit against <em>each other</em>. It asks for <b>' +
  (D.inUseSlots.length ? D.inUseSlots.join("</b> and <b>") : "nothing") + '</b> today; a slot a ' +
  'set carries and the board does not ask for is marked <em>not played</em> rather than left ' +
  'looking like it is in service.</p>'];
D.sets.forEach(function(s){
  h.push('<div class="set' + (s.chosen ? ' chosen' : '') + '"><div class=sethead>' +
    '<span class=setid>' + esc(s.id) + '</span><span class=setname>' + esc(s.name) + '</span>' +
    (s.chosen ? '<span class=tag>in use</span>' : '') +
    '<button class=seq data-set="' + esc(s.id) + '">play the set</button></div>' +
    '<p class=setnote>' + esc(s.note) + '</p>');
  s.slots.forEach(function(sl){
    var name = sl[0] + (sl[3] ? " — NOT PLAYED by the board" : "");
    h.push(sl[1] ? card(sl[1], name + " — " + sl[1].label, sl[2], s.id, sl[0])
                 : empty(sl[0], "no clip in this set"));
  });
  h.push("</div>");
});

h.push("<h2>Tithe resources</h2>",
       coverage(D.tithe.filter(function(t){ return t.clip; }).length, D.tithe.length, "resources"));
D.tithe.forEach(function(t){
  h.push(t.clip ? card(t.clip, t.name + " — " + t.clip.label, 0.5) : empty(t.name));
});

var aHave = 0, aAll = 0;
D.duties.forEach(function(d){ d.actions.forEach(function(a){ aAll++; if (a.clip) aHave++; }); });
h.push("<h2>Duty actions</h2>", coverage(aHave, aAll, "actions"));
D.duties.forEach(function(d){
  h.push("<h3>" + esc(d.name) + "</h3>");
  d.actions.forEach(function(a){
    h.push(a.clip ? card(a.clip, a.name + " — " + a.clip.label, 0.5) : empty(a.name));
  });
});

h.push("<h2>Buildings</h2>",
       coverage(D.buildings.filter(function(b){ return b.clip; }).length, D.buildings.length,
                "buildings"));
var lastLv = null;
D.buildings.forEach(function(b){
  if (b.level !== lastLv){
    lastLv = b.level;
    var n = D.buildings.filter(function(x){ return x.level === lastLv; }).length;
    h.push("<h3>Level " + lastLv + " <span class=lv style='font-weight:400'>· " + n +
           " buildings</span></h3>");
  }
  h.push(b.clip ? card(b.clip, b.name + " — " + b.clip.label, 0.5) : empty(b.name));
});

// MISC HAS NO COVERAGE BAR, AND THAT IS THE POINT OF IT. Every section above counts against a
// denominator the game supplies -- three resources, fourteen actions, twenty-four buildings --
// so a gap in them is a thing still to do. Misc has no denominator: it is sound that was kept
// without a slot, either because it was replaced by something better or because it has not found
// its home yet. Printing "4 of 4" there would be meaningless, and printing nothing says the
// right thing.
if (D.misc && D.misc.length){
  h.push("<h2>Misc</h2>",
         '<p class=setnote>Kept, but not assigned to a slot. Nothing here is played by the ' +
         'board. A clip lands here when it is superseded or when it is worth having before ' +
         'there is somewhere to put it.</p>');
  D.misc.forEach(function(m){
    h.push(card(m, m.label, 0.5));
  });
}
document.getElementById("body").innerHTML = h.join("");

// PLAYBACK IS WEBAUDIO, NOT <audio>, AND THE FIRST VERSION OF THIS PAGE GOT IT WRONG.
// HTML Audio.volume is hard-capped at 1, so a clip wanting +12.3 dB could not be turned up
// and "levelled" could only mean turning everything DOWN to meet the quietest -- which cost
// the median clip 15.9 dB and made the whole idea sound like a regression. A GainNode has no
// such cap. The board already plays this way; the bench now matches it.
//
// NOTHING CAN CLIP: sfx_levels.py clamps every gainDb so the clip's true peak lands at or
// under -1 dBTP, and the slider sits below unity on top of that.
var AC = null, BUF = [], ready = false, playing = null, srcNode = null;

function prepare(){
  if (AC) return Promise.resolve();
  var C = window.AudioContext || window.webkitAudioContext;
  if (!C) return Promise.reject();
  AC = new C();
  return Promise.all(CL.map(function(c, i){
    var raw = atob(c.src.split(",")[1]);
    var b = new Uint8Array(raw.length);
    for (var k = 0; k < raw.length; k++) b[k] = raw.charCodeAt(k);
    return AC.decodeAudioData(b.buffer).then(function(buf){ BUF[i] = buf; },
                                             function(){ BUF[i] = null; });
  })).then(function(){ ready = true; });
}
function gainOf(i){
  var c = CL[i];
  var g = c.gain * MONITOR;
  if (LEVELLED && c.gainDb != null) g *= Math.pow(10, c.gainDb / 20);
  return g;
}
function stop(){
  if (srcNode){ try { srcNode.stop(); } catch (e) {} srcNode = null; }
  if (playing !== null){
    var b = document.querySelector('button.play[data-i="' + playing + '"]');
    if (b){ b.classList.remove("on"); b.textContent = "play"; }
    playing = null;
  }
}
function fire(i, onend){
  if (!ready || !BUF[i]) return;
  if (AC.state === "suspended") AC.resume();
  var s = AC.createBufferSource(), g = AC.createGain();
  s.buffer = BUF[i]; g.gain.value = gainOf(i);
  s.connect(g); g.connect(AC.destination); s.start();
  if (onend) s.onended = onend;
  return s;
}


document.getElementById("lvlBtn").addEventListener("click", function(){
  LEVELLED = !LEVELLED;
  this.setAttribute("aria-pressed", String(LEVELLED));
  this.textContent = "levelling: " + (LEVELLED ? "on" : "off");
  document.getElementById("lvlNote").innerHTML = LEVELLED
    ? 'every clip trimmed to <b>' + D.targetLufs.toFixed(0) + ' LUFS</b> by its own gainDb. '
      + 'Quiet clips go UP, loud ones come down; the median clip moves about 3.6 dB quieter '
      + 'because most of the set was running hot. Use the monitor control to match levels '
      + 'before judging.'
    : 'every clip at its slider value, which is how the set sounds today &mdash; 31.9 dB of '
      + 'loudness between the quietest and the loudest.';
});

var mon = document.getElementById("monitor");
mon.addEventListener("input", function(){
  MONITOR = Math.pow(10, (+mon.value) / 20);
  document.getElementById("monv").textContent = (+mon.value > 0 ? "+" : "") + (+mon.value) + " dB";
});

document.querySelectorAll("button.play").forEach(function(b){
  b.addEventListener("click", function(){
    var i = +b.dataset.i, again = (playing === i);
    stop(); if (again) return;
    prepare().then(function(){
      playing = i; b.classList.add("on"); b.textContent = "stop";
      srcNode = fire(i, function(){ if (playing === i) stop(); });
    });
  });
});
document.querySelectorAll('input[type=range][data-i]').forEach(function(r){
  r.addEventListener("input", function(){
    var i = +r.dataset.i;
    CL[i].gain = +r.value;
    document.getElementById("gv" + i).textContent = (+r.value).toFixed(2);
  });
});
// PLAYING A SET IN ORDER, which is the only way to judge one. The gaps are a plausible
// interaction rather than a metronome: you brush a tile, you choose it, you think, you commit.
var ORDER = {hover: 0, select: 700, confirm: 2300}, pending = [];
document.querySelectorAll("button.seq").forEach(function(b){
  var set = b.dataset.set;
  b.addEventListener("click", function(){
    pending.forEach(clearTimeout); pending = []; stop();
    prepare().then(function(){
      CL.forEach(function(c, i){
        if (c.seq !== set || !(c.cue in ORDER)) return;
        pending.push(setTimeout(function(){ fire(i); }, ORDER[c.cue]));
      });
    });
  });
});
addEventListener("keydown", function(e){ if (e.key === "Escape") stop(); });
</script>
</div></html>
