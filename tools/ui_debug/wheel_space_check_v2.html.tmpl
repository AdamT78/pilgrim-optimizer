<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Duty wheel at a size you set</title>
<style>
 html,body{margin:0;height:100%;background:__GROUND__;overflow:hidden;
   font:13px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;color:#8b8071}
 /* No stage and no transform anywhere on this page. One CSS pixel is exactly dpr device pixels,
    so every size here is a real device pixel with nothing to divide back out. */
 /* Explicit z-index rather than DOM order: the rules must sit UNDER the wheel so they never cut
    across a face or a piece, while their labels stay readable over it. */
 #wheel{position:absolute;z-index:1}
 #wheel svg{display:block;width:100%;height:100%}
 .vedge{position:fixed;top:0;bottom:0;width:0;border-left:1px dashed #4d4536;
   pointer-events:none;z-index:0}
 .vlab{position:fixed;font-size:11px;color:#7b7160;background:rgba(11,9,7,.85);
   padding:1px 6px;border-radius:2px;pointer-events:none;white-space:pre;z-index:2}
 .fig{position:absolute;touch-action:none;
   user-select:none;-webkit-user-select:none;-webkit-user-drag:none}
 /* An AUTHOR `display` beats the user agent's `[hidden]{display:none}` outright -- origin wins
    before specificity is even consulted -- so without this line `el.hidden = true` would quietly
    do nothing and a figure with no art would still take up space. */
 .fig[hidden]{display:none!important}
 .fig.copy{cursor:grab}
 .fig.copy.drag{cursor:grabbing}
 #tray{position:fixed;top:18px;right:18px;display:flex;flex-direction:column;gap:14px;
   align-items:flex-end;z-index:5}
 /* Each row is one subject at every size, bottom-aligned so the bases stand on a common line
    and the height differences between the characters are the thing you actually see. */
 .trow{display:flex;gap:16px;align-items:flex-end;justify-content:flex-end}
 .trow .tag{font-size:11px;color:#6f6556;align-self:flex-end;padding-bottom:1px}
 #tray .fig{position:static;cursor:copy}          /* the tray mints, it never moves */
 body.bare .trow .tag{display:none}
 #hud{position:fixed;left:16px;top:18px;white-space:pre;color:#7b7160;
   pointer-events:none;font-size:12px;line-height:1.55}
 #hud b{color:#c9b27a;font-weight:400}
 #hud s{color:#e0705f;text-decoration:none}
 #figread{position:fixed;right:18px;bottom:14px;text-align:right;white-space:pre;
   color:#7b7160;font-size:12px;line-height:1.55;pointer-events:none}
 #figread b{color:#c9b27a;font-weight:400}
 #figread s{color:#e0705f;text-decoration:none}
 #panel{position:fixed;left:16px;bottom:14px;color:#6f6556;font-size:12px;
   background:rgba(11,9,7,.9);padding:9px 12px;border:1px solid #2e2820;border-radius:3px}
 #panel input[type=range]{width:230px;vertical-align:middle}
 #panel input[type=checkbox]{vertical-align:middle;margin:0 5px 0 0}
 #panel label{cursor:pointer;user-select:none}
 #panel #owv{color:#8a7c64;margin-left:8px}
 #panel b{color:#c9b27a}
 #panel .row{margin:2px 0}
 #panel button{font:inherit;color:#cbbb98;background:#241d16;border:1px solid #4a4133;
   border-radius:3px;padding:3px 9px;cursor:pointer}
 #panel .hint{color:#5f574a;margin-top:5px}
 #err{position:fixed;left:0;right:0;top:0;background:#5a1d16;color:#ffd9d2;padding:8px 14px;
   font-size:13px;display:none;z-index:9;white-space:pre-wrap}
 body.bare #hud,body.bare #panel,body.bare #figread,
 body.bare .vedge,body.bare .vlab{display:none}
</style>

<div id="err"></div>
<div id="rules"></div>
<div id="wheel"></div>
<div id="tray"></div>
<div id="hud"></div>
<div id="figread"></div>
<div id="panel">
  <div class="row">wheel <button id="wbtn" type="button">&nbsp;</button>
    &nbsp;&#183;&nbsp; <b id="sizev">&nbsp;</b></div>
  <div class="row">width &nbsp;<input type="range" id="ws"> <b id="wv">&nbsp;</b></div>
  <div class="row">height <input type="range" id="hs"> <b id="hv">&nbsp;</b></div>
  <div class="row">scale &nbsp;<input type="range" id="ss"> <b id="sv">&nbsp;</b></div>
  <div class="row"><label for="ow"><input type="checkbox" id="ow" checked> only Duty wheel</label>
    <span id="owv"></span></div>
  <div class="hint">a wheel &#183; m match built aspect &#183; t tile colour &#183; c clear pieces &#183; h hide<br>
    drag from the tray top right to mint a piece &#183; double-click a piece to remove it</div>
</div>

<script>
window.onerror = function(m, src, line){
  var e = document.getElementById("err");
  e.style.display = "block";
  e.textContent = "This page hit an error and stopped drawing:\n" + m + "  (line " + line + ")";
};

var WH = __WHEELS__, KEYS = __KEYS__, ROWS = __ROWS__, PALETTES = __PALETTES__;
var WR = __WRANGE__, HR = __HRANGE__, SR = __SRANGE__;
var CANVASES = __CANVASES__, START = __START__;
var key = KEYS[0], pal = 0, wheelOnly = true;
var wPx = START[0], hPx = START[1];      // REAL DEVICE pixels, both of them
// The scale slider multiplies a BASE shape rather than the live size, or dragging it would
// compound its own output. Touching width or height rebases and sends scale back to 100%, so the
// two size sliders always read as the wheel's actual size and there is no hidden multiplier.
var baseW = wPx, baseH = hPx, scale = 1;
var V = null;                            // where paint() last put the wheel, in CSS px

function clamp(v, lo, hi){ return Math.max(lo, Math.min(hi, v)); }

function hit(x, y, poly){                // ray cast, in box units
  var inside = false;
  for (var i = 0, j = poly.length - 1; i < poly.length; j = i++){
    var xi = poly[i][0], yi = poly[i][1], xj = poly[j][0], yj = poly[j][1];
    if ((yi > y) !== (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi) + xi) inside = !inside;
  }
  return inside;
}

// STOCK is the fixed tray, COPIES are the only things that move. A copy's position is held as a
// FRACTION of the wheel box rather than in pixels, so it keeps its tile while the sliders move
// the wheel under it -- which is the whole question this page is asking.
function makeImg(spec, cls, parent, z){
  var el = document.createElement("img");
  el.className = "fig " + cls; el.alt = ""; el.draggable = false; el.hidden = true;
  if (z) el.style.zIndex = z;
  el.src = spec.uri;
  parent.appendChild(el);
  return el;
}
var tray = document.getElementById("tray");
var STOCK = [], SIZES = [];
ROWS.forEach(function(row){
  var r = document.createElement("div");
  r.className = "trow";
  var tag = document.createElement("span");
  tag.className = "tag"; tag.textContent = row.tag;
  r.appendChild(tag);
  tray.appendChild(r);
  row.items.forEach(function(spec){
    STOCK.push({spec: spec, el: makeImg(spec, "stock", r)});
    if (SIZES.indexOf(spec.nom) < 0) SIZES.push(spec.nom);
  });
});
SIZES.sort(function(a, b){ return a - b; });
var COPIES = [], zTop = 10;

// One pair of rules per canvas, built once and moved on every paint.
var RULES = CANVASES.map(function(c){
  var box = document.getElementById("rules");
  function line(){ var e = document.createElement("div"); e.className = "vedge"; box.appendChild(e); return e; }
  var lab = document.createElement("div");
  lab.className = "vlab"; box.appendChild(lab);
  return {c: c, l: line(), r: line(), lab: lab};
});

// v1's own rule: a canvas is a box of UNITS scaled to fit the window, so how many real pixels it
// is worth depends on the display. Width-bound means the canvas fills the window and its rules
// land on the window edges -- which is the answer to "is the canvas even the limit here".
function canvasFit(c){
  var dpr = devicePixelRatio || 1;
  var k = Math.min(innerWidth / c.w, innerHeight / c.h);
  var cssW = c.w * k;
  return {k: k, cssW: cssW, x: (innerWidth - cssW) / 2,
          realW: Math.round(c.w * k * dpr), realH: Math.round(c.h * k * dpr),
          wide: innerWidth / c.w <= innerHeight / c.h};
}

// With "only Duty wheel" ticked, a piece on the wheel holds its true size while the wheel grows
// or shrinks under it, which is the question this page was built to answer. Untick it and pieces
// ON THE WHEEL keep their PROPORTION to it instead, so the board zooms as one thing.
//
// The tray never scales either way. It is the reference you are comparing against -- the whole
// point of a row labelled 90 px is that it IS 90 px -- so it stays put and a piece minted while
// zoomed simply arrives bigger than the stock it came from.
//
// Measured against the size the page opens at, not against the scale slider, so it holds however
// you got there -- the slider rebases scale to 100% every time you touch width or height, and a
// piece that snapped back to nominal on a rebase while the wheel stayed big would be nonsense.
// Geometric mean of the two axes, so a stretched wheel moves the pieces by a sensible amount
// rather than following whichever axis was picked.
function pieceScale(){
  if (wheelOnly) return 1;
  return Math.sqrt((wPx / START[0]) * (hPx / START[1]));
}

// The file's OWN pixel size, not its nominal: a plinth-levelled piece comes in under the nominal
// and drawing it at the nominal would be the browser's resample of art that is already correct.
// `placed` is what separates a piece on the wheel from the stock in the tray.
function size(spec, placed){             // real device px -> CSS px, the only conversion here
  var dpr = devicePixelRatio || 1, z = placed ? pieceScale() : 1;
  return {w: spec.w * z / dpr, h: spec.h * z / dpr};
}

function paint(){
  var d = WH[key], dpr = devicePixelRatio || 1;
  var wCss = wPx / dpr, hCss = hPx / dpr;
  var x = Math.round((innerWidth - wCss) / 2), y = Math.round((innerHeight - hCss) / 2);
  var el = document.getElementById("wheel");
  el.style.left = x + "px"; el.style.top = y + "px";
  el.style.width = wCss + "px"; el.style.height = hCss + "px";
  var P = PALETTES[pal], p = "";
  for (var i = 0; i < d.faces.length; i++)
    p += '<path fill="' + (d.faces[i].pos === "centre" ? P.centre : P.face) +
         '" d="' + d.faces[i].d + '"/>';
  // preserveAspectRatio="none" is what makes the height slider a lever at all: left at its
  // default the SVG would letterbox inside the box and the slider would move nothing but margin.
  el.innerHTML = '<svg viewBox="0 0 ' + d.box + ' ' + d.box_h +
                 '" preserveAspectRatio="none">' + p + "</svg>";

  V = {dpr: dpr, wx: x, wy: y, ww: wCss, wh: hCss};
  STOCK.forEach(function(s){
    var z = size(s.spec);
    s.el.hidden = false;
    s.el.style.width = z.w + "px"; s.el.style.height = z.h + "px";
  });
  // The tray is laid out by CSS and now several rows deep, so its left edge is measured rather
  // than assumed -- the canvas labels have to keep clear of it and it grows with the art.
  var trayL = tray.getBoundingClientRect().left;
  RULES.forEach(function(r, i){
    var f = canvasFit(r.c);
    r.l.style.left = f.x + "px";
    r.r.style.left = (f.x + f.cssW) + "px";
    r.lab.textContent = "canvas " + r.c.w + "  " + f.realW + " px wide" + (f.wide ? "  (fills window)" : "");
    // Clamp against the label's MEASURED width, not a guess: the text is longer when a canvas
    // fills the window, and a fixed allowance clipped exactly those two off the right edge.
    // Stepped down the screen so canvases landing on the same edge stay readable.
    r.lab.style.top = (72 + i * 19) + "px";
    var lw = r.lab.offsetWidth, lim = Math.max(4, Math.min(innerWidth, trayL - 8) - lw - 5);
    r.lab.style.left = clamp(f.x + f.cssW - lw - 5, 4, lim) + "px";
  });
  document.getElementById("wbtn").textContent = key;
  document.getElementById("sizev").textContent = wPx + " × " + hPx + " real px";
  document.getElementById("wv").textContent = wPx;
  document.getElementById("hv").textContent = hPx;
  document.getElementById("sv").textContent = Math.round(scale * 100) + "%";
  var z = pieceScale();
  document.getElementById("owv").textContent =
    wheelOnly ? "placed pieces held at true size" : "placed pieces ×" + z.toFixed(2);
  hud(); place();
}

function hud(){
  var d = WH[key], ar = wPx / hPx;
  var out = [
    ["screen", innerWidth + " × " + innerHeight + " css  " + (devicePixelRatio || 1).toFixed(2) + "×"],
    ["wheel", wPx + " × " + hPx + " real px"],
    ["aspect", ar.toFixed(3)],
    ["scale", Math.round(scale * 100) + "% of " + baseW + " × " + baseH],
    ["tile", PALETTES[pal].name + "  " + PALETTES[pal].face + "   (t)"]
  ];
  // The page's whole promise is that a size on screen is a real device pixel. The moment the
  // pieces are allowed to zoom with the wheel that stops being true, so it says so, and it says
  // when they have gone past the resolution of their own art rather than letting that pass.
  var z = pieceScale();
  if (!wheelOnly){
    out.push(["placed", "×" + z.toFixed(2) + " of nominal — no longer true size (the tray is)"]);
    if (z > 1.02)
      out.push(["", ""], ["!", "placed pieces are drawn larger than the art they come from: " +
        "above ×1 that is the browser's resample, not a " + Math.round(z * 100) + "% piece"]);
  }
  // The layouts are BUILT at their aspect, not scaled to it, so a ratio that is not the built one
  // is a stretch of the drawing and the faces stop being the shape the builder would produce.
  var off = Math.abs(ar - d.aspect) / d.aspect;
  if (off > 0.005)
    out.push(["", ""], ["!", "stretched from the built " + d.aspect.toFixed(3) +
      " — faces are not the shape build_duty_wheel_v2 makes at " + ar.toFixed(3) + " (m to match)"]);
  out.push(["", ""]);
  CANVASES.forEach(function(c){
    var f = canvasFit(c);
    out.push(["canvas " + c.w, c.w + " × " + c.h + " units  ·  " + f.realW + " × " + f.realH +
              " real px here" + (f.wide ? "  (fills window)" : "")]);
  });
  // Said once rather than on each row: the rules are the canvas EDGE. In the real layout the
  // boards, the alms column and the action box come out first and the wheel takes what is left,
  // so fitting between these lines is necessary and nowhere near sufficient -- v1 answers that.
  out.push(["", ""], ["note", "rules are the canvas edge, not the wheel's column"]);
  out.push(["", ""]);
  ["north", "north_west", "east"].forEach(function(pos){
    var f, j;
    for (j = 0; j < d.faces.length; j++) if (d.faces[j].pos === pos) f = d.faces[j];
    // Reported as the side of a square of equal area, so it sits in the same unit as a piece's
    // height and you can compare the two without doing a square root in your head.
    out.push([pos === "north_west" ? "corner" : pos,
              Math.round(Math.sqrt(f.frac * wPx * hPx)) + " px square"]);
  });
  var fitW = wPx / (devicePixelRatio || 1) <= innerWidth,
      fitH = hPx / (devicePixelRatio || 1) <= innerHeight;
  if (!fitW || !fitH)
    out.push(["", ""], ["!", "wheel is wider or taller than the window and is being clipped — " +
      "nothing is scaled down, so what you see is still true size"]);
  document.getElementById("hud").innerHTML = out.map(function(r){
    if (!r[0]) return "";
    if (r[0] === "!") return '<s>' + r[1] + '</s>';
    return '<b>' + r[0] + '</b>  ' + r[1];
  }).join("\n");
}

function placeCopy(p){
  var z = size(p.spec, true), d = WH[key];
  var x = V.wx + p.u * V.ww - z.w / 2, y = V.wy + p.v * V.wh - z.h / 2;
  // Clamp on the piece's BOX, not its centre, so it can never leave the window entirely.
  x = clamp(x, 0, innerWidth - z.w);
  y = clamp(y, 0, innerHeight - z.h);
  p.u = (x + z.w / 2 - V.wx) / V.ww;              // write the clamp back, so it sticks
  p.v = (y + z.h / 2 - V.wy) / V.wh;
  p.el.hidden = false;
  p.el.style.left = x + "px"; p.el.style.top = y + "px";
  p.el.style.width = z.w + "px"; p.el.style.height = z.h + "px";
  // A piece stands on its BASE, so the tile it occupies is the one under the bottom centre of the
  // art -- not under its middle, which for a tall figure can be a face further out.
  var bx = (x + z.w / 2 - V.wx) / V.ww * d.box, by = (y + z.h - V.wy) / V.wh * d.box_h;
  p.on = null;
  for (var i = 0; i < d.faces.length; i++)
    if (hit(bx, by, d.faces[i].poly)){ p.on = d.faces[i]; break; }
}

// Bounded whatever the count: a line per size, then one tally line across the faces. Listing
// every piece would run the readout off the screen as soon as the board got interesting.
function readout(){
  var lines = [], tally = {}, order = [], off = 0;
  // Grouped by NOMINAL size, not by tray slot: with four subjects a line each would be eight
  // lines of mostly zeroes, and the count per size is what says how busy the wheel is.
  var z = pieceScale();
  SIZES.forEach(function(nom){
    var n = 0;
    COPIES.forEach(function(p){ if (p.spec.nom === nom) n++; });
    // When the pieces are zooming, the nominal is no longer what is on the glass, so both are
    // shown rather than leaving the label quietly wrong.
    lines.push("<b>" + nom + " px</b>" + (wheelOnly ? "" : " → " + Math.round(nom * z)) +
               "  " + n + " placed");
  });
  COPIES.forEach(function(p){
    if (!p.on){ off++; return; }
    if (!tally[p.on.pos]){ tally[p.on.pos] = 0; order.push(p.on.pos); }
    tally[p.on.pos]++;
  });
  if (order.length)
    lines.push(order.map(function(k){ return k + " " + tally[k]; }).join(" · "));
  if (off) lines.push("<s>" + off + " off the wheel</s>");
  document.getElementById("figread").innerHTML = lines.join("\n");
}

function place(){
  if (!V) return;
  COPIES.forEach(placeCopy);
  readout();
}

function grab(p, e, dx, dy){
  p.drag = {id: e.pointerId, dx: dx, dy: dy, moved: false};
  try { p.el.setPointerCapture(e.pointerId); } catch (_){}
  p.el.classList.add("drag");
  p.el.style.zIndex = ++zTop;                     // the one being moved comes to the front
}

function drop(p){
  if (!p.drag) return;
  var moved = p.drag.moved;
  try { p.el.releasePointerCapture(p.drag.id); } catch (_){}
  p.drag = null;
  p.el.classList.remove("drag");
  // A plain click on the tray mints a copy exactly ON the stock, where it would look like nothing
  // had happened. Step a never-moved NEW piece clear so it is visibly its own thing. Only a new
  // one: clicking a piece already on the board must leave it exactly where it stands.
  if (!moved && p.fresh){
    var z = size(p.spec, true);
    p.u -= (z.w * 1.2) / V.ww;
    p.v += (z.h * (0.5 + 0.28 * (COPIES.indexOf(p) % 4))) / V.wh;
    placeCopy(p); readout();
  }
  p.fresh = false;
}

function discard(p){
  var i = COPIES.indexOf(p);
  if (i < 0) return;
  COPIES.splice(i, 1);
  p.el.parentNode.removeChild(p.el);
  readout();
}

function wire(p){
  p.el.addEventListener("pointerdown", function(e){
    if (e.button !== 0 || !V || p.drag) return;   // left button held, as asked -- nothing else
    var r = p.el.getBoundingClientRect();
    grab(p, e, e.clientX - r.left, e.clientY - r.top);
    e.preventDefault(); e.stopPropagation();
  });
  p.el.addEventListener("pointermove", function(e){
    if (!p.drag || e.pointerId !== p.drag.id || !V) return;
    // No stage transform on this page, so a client coordinate IS a page coordinate: the only
    // conversion is the piece's own grab offset.
    var z = size(p.spec, true);
    p.u = (e.clientX - p.drag.dx + z.w / 2 - V.wx) / V.ww;
    p.v = (e.clientY - p.drag.dy + z.h / 2 - V.wy) / V.wh;
    p.drag.moved = true;
    placeCopy(p); readout();                      // only this piece
  });
  p.el.addEventListener("pointerup", function(){ drop(p); });
  p.el.addEventListener("pointercancel", function(){ drop(p); });
  p.el.addEventListener("dblclick", function(e){ discard(p); e.preventDefault(); });
}

// Pressing a stock figure mints a copy under the cursor and hands the drag straight to it, so
// picking a piece off the tray and putting it on a tile is one motion, not click-then-find.
function mint(spec, e, dx, dy){
  var p = {spec: spec, el: makeImg(spec, "copy", document.body, ++zTop),
           u: 0, v: 0, on: null, fresh: true};
  COPIES.push(p);
  wire(p);
  var z = size(spec, true);
  p.u = (e.clientX - dx + z.w / 2 - V.wx) / V.ww;
  p.v = (e.clientY - dy + z.h / 2 - V.wy) / V.wh;
  placeCopy(p);
  grab(p, e, dx, dy);
  readout();
}

STOCK.forEach(function(s){
  s.el.addEventListener("pointerdown", function(e){
    if (e.button !== 0 || !V) return;
    var r = s.el.getBoundingClientRect();
    mint(s.spec, e, e.clientX - r.left, e.clientY - r.top);
    e.preventDefault();
  });
});

var ws = document.getElementById("ws"), hs = document.getElementById("hs"),
    ss = document.getElementById("ss");
ws.min = WR[0]; ws.max = WR[1]; ws.step = 1; ws.value = wPx;
hs.min = HR[0]; hs.max = HR[1]; hs.step = 1; hs.value = hPx;
ss.min = SR[0]; ss.max = SR[1]; ss.step = 1; ss.value = 100;

function rebase(){                       // the size sliders ARE the size; scale starts over
  baseW = wPx; baseH = hPx; scale = 1; ss.value = 100;
}
function applyScale(){
  // Clamp the SCALE, not the results: clamping width and height separately would let one hit its
  // limit while the other kept going, which would silently stretch the wheel the scale slider is
  // supposed to leave alone.
  var lo = Math.max(SR[0] / 100, WR[0] / baseW, HR[0] / baseH),
      hi = Math.min(SR[1] / 100, WR[1] / baseW, HR[1] / baseH);
  scale = clamp(scale, lo, hi);
  ss.value = Math.round(scale * 100);
  wPx = Math.round(baseW * scale);
  hPx = Math.round(baseH * scale);
  ws.value = wPx; hs.value = hPx;
  paint();
}
ws.addEventListener("input", function(){ wPx = +ws.value; rebase(); paint(); });
hs.addEventListener("input", function(){ hPx = +hs.value; rebase(); paint(); });
ss.addEventListener("input", function(){ scale = +ss.value / 100; applyScale(); });
document.getElementById("ow").addEventListener("change", function(){
  wheelOnly = this.checked;
  paint();
});

function matchAspect(){                  // height follows the BUILT ratio of the current wheel
  hPx = clamp(Math.round(wPx / WH[key].aspect), HR[0], HR[1]);
  hs.value = hPx;
  rebase();
  paint();
}
function nextWheel(){
  key = KEYS[(KEYS.indexOf(key) + 1) % KEYS.length];
  matchAspect();                         // switching wheels lands on that wheel's own shape
}
document.getElementById("wbtn").addEventListener("click", nextWheel);

addEventListener("resize", paint);
addEventListener("keydown", function(e){
  if (e.key === "a") nextWheel();
  else if (e.key === "m") matchAspect();
  else if (e.key === "c") COPIES.slice().forEach(discard);
  else if (e.key === "t") { pal = (pal + 1) % PALETTES.length; paint(); }
  else if (e.key === "h") document.body.classList.toggle("bare");
});
paint();
</script>
</html>
