<!doctype html><html lang=en><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<title>Sow, by hand</title>
<style>
@font-face{font-family:"PB";src:url(__FONTURI_CSS__) format("truetype");font-display:block}
html,body{margin:0;height:100%;overflow:hidden;background:#0d0b08;color:#8b8071;
  font:11px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}
#wrap{height:100%;display:flex;align-items:center;justify-content:center}
.stage{position:relative;background:__GROUND__;flex:none}
.cell{position:absolute}
.ban{position:absolute;left:50%;transform:translateX(-50%);z-index:3}
.ban img{display:block;width:100%;height:100%}
.ban b{position:absolute;left:50%;transform:translate(-50%,-50%);
  font-family:"PB",serif;text-transform:uppercase;white-space:nowrap;line-height:1}
.figs{position:absolute;z-index:4}
.fig{position:absolute}
.fig img{display:block;width:100%;height:100%;pointer-events:none}

/* ---- the marking ---------------------------------------------------------------------------
   LIT MEANS LEGAL NOW, and nothing else. An earlier version also ghosted the tiles further
   along a forced run; it was dropped rather than fixed. The lookahead answered "where will this
   end up", which is not the question in front of the player -- the question is where THIS
   acolyte goes -- and the count in the hand already says how much is left to place.

   The mark sits UNDER the figures and above the ground, and is invisible until something is in
   hand. A board that is always outlined is a form; a board that outlines itself only while you
   are holding something is a board. */
.mark{position:absolute;z-index:2;pointer-events:none;opacity:0;transition:opacity .14s}
.cell.live .mark{opacity:1}
/* NO MARK ON THE SOURCE. It answered "where did this fistful come from", which is history and
   not a choice. Every opacity rule here is scoped by the cell's state on purpose: a rule
   carrying three classes once outranked the one-class default and painted every tile at once. */

/* FLOOR -- the line the figures stand on, lit and widened. What we settled on. */
.mark.floor{position:absolute;height:2px;border-radius:2px;
  background:linear-gradient(90deg,rgba(201,178,122,0),#c9b27a 18%,#c9b27a 82%,rgba(201,178,122,0))}
/* FOOTPRINTS -- an ellipse where the next sculpt will stand. Kept because the placement file
   still admits it, not because it is the choice: it promises a SPOT, and a rule that re-lays
   the whole group cannot keep that promise. */
.mark.foot{position:absolute;border-radius:50%;border:1.5px solid #c9b27a;
  background:radial-gradient(ellipse at center,rgba(201,178,122,.16),rgba(201,178,122,0) 70%)}
.cell.live .mark.foot.next{animation:pulse 1.15s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.42}}
.cell.live .mark.foot.later{opacity:.34}
/* BOX -- a thin border rising from the banner's ends, open at the top: a closed rectangle reads
   as a form field, and leaving it open keeps it a pen. */
.mark.box{position:absolute;border:1px solid rgba(201,178,122,.75);
  border-bottom:none;border-radius:3px 3px 0 0}
.mark.box::before,.mark.box::after{content:"";position:absolute;top:-1px;width:26%;height:1px;
  background:rgba(201,178,122,.75)}
.mark.box::before{left:-1px} .mark.box::after{right:-1px}
/* GILD -- no new geometry at all; the parchment itself lights. */
.cell.live.m-gild .ban img{filter:brightness(1.22) saturate(1.15)
  drop-shadow(0 0 7px rgba(201,178,122,.55))}
.cell.src.m-gild .ban img{filter:brightness(.9) saturate(.85)}

.ground{position:absolute;height:1px;background:#241e15;z-index:1}

/* The picture the tile is drawn on, and the plate the acolytes stand on. Both come from the
   files the placement sheet writes; there is nothing to tune here. `.plate` rather than
   `.ground` because `.ground` is already the hairline the figures stand on, and two things
   called ground in one stylesheet is how a rule ends up on the wrong element. */
.frame{position:absolute;z-index:0;border:1px solid rgba(201,178,122,.16);border-radius:2px;
  background:rgba(201,178,122,.03)}
.plate{position:absolute;z-index:1;pointer-events:none}
.plate img{display:block;width:100%;height:100%}

/* ---- the gauge -------------------------------------------------------------------------------
   Two dashed boxes, drawn OVER the sculpts so they can be read against them rather than hidden
   behind whoever is standing there.

     cell   the tile's own third of the wheel. Nothing about it is decoration: the gap between
            this and the box inside it is exactly how much closer the tiles could sit.
     cap    the room a FULL tile needs -- five sculpts, every slot given the widest and tallest
            figure in the set, because a tile does not choose who stands on it. This is the
            constraint; what a tile happens to hold today is not. */
.gauge{position:absolute;pointer-events:none;z-index:5;border:1px dashed}
.gauge.cellbox{border-color:rgba(201,178,122,.20)}
.gauge.cap{border-color:rgba(201,178,122,.50)}
.gauge.foot{border-color:rgba(120,180,220,.40)}
.gauge b{position:absolute;right:2px;top:-13px;font:10px/1 ui-monospace,monospace;
  color:rgba(201,178,122,.55);font-weight:400}

/* ---- the hand ------------------------------------------------------------------------------
   Beside the wheel rather than on it, so the board keeps its whole square. */
/* Under the panels, not over them. A hand of three 210 px sculpts is taller than half the
   screen, and with the tray on top it covered the seat buttons completely -- the controls were
   still there and simply could not be clicked. */
#hand{position:fixed;display:flex;flex-direction:column-reverse;align-items:center;gap:2px;
  padding:10px 12px 12px;border-radius:4px;background:rgba(20,16,10,.82);
  border:1px solid #2c2519;z-index:6}
#hand.empty{opacity:.25}
#hand .lab{color:#5f574a;font-size:10px;margin-top:6px;order:99}
#hand .held{cursor:grab;touch-action:none;filter:drop-shadow(2px 4px 4px rgba(0,0,0,.6))}
#hand .held img{display:block;width:100%;height:100%;pointer-events:none}
.ghost{position:fixed;z-index:20;pointer-events:none;
  filter:drop-shadow(4px 8px 6px rgba(0,0,0,.7))}
.ghost img{display:block;width:100%;height:100%}

#note{position:fixed;left:10px;top:12px;width:250px;color:#5f574a;white-space:pre-wrap;
  pointer-events:none;z-index:8}
#note b{color:#c9b27a;font-weight:400}
#ui{position:fixed;left:10px;bottom:12px;width:252px;color:#6b6152;z-index:8}
#ui .row{display:flex;align-items:center;gap:5px;margin-bottom:6px;flex-wrap:wrap}
#ui button{font:inherit;color:#8b8071;background:#1c1811;border:1px solid #332c20;
  border-radius:3px;padding:3px 8px;cursor:pointer}
#ui button:hover{border-color:#5a4c36}
#ui button[aria-pressed=true]{background:#c9b27a;border-color:#c9b27a;color:#1a1610}
#ui button[aria-disabled=true]{cursor:default;opacity:.85}
#ui button[aria-disabled=true]:hover{border-color:#c9b27a}
/* The sculpt-set dropdown. Styled to sit with the buttons rather than to look like a form
   control, since it is the same kind of choice as the ones beside it. */
.setpick{font:inherit;color:#c9b27a;background:#1c1811;border:1px solid #332c20;
  border-radius:3px;padding:3px 6px;cursor:pointer;
  /* Fits whatever column it is put in. A fixed max-width was 176px, which suited the
     sow page's 252px panel and overflowed the placement sheet's 227px one by 24. */
  max-width:100%;min-width:0;box-sizing:border-box}
.setpick:hover{border-color:#5a4c36}
.setpick optgroup{color:#5f5646;font-style:normal}
.setpick option{color:#8b8071;background:#1c1811}
#ui .lab{color:#4f483d;min-width:46px}
#ui .hint{color:#3f3930;line-height:1.5}
</style>
<svg width=0 height=0 style="position:absolute" aria-hidden=true><defs id=hazedefs></defs></svg>
<div id=wrap><div class=stage id=stage></div></div>
<div id=hand class=empty></div>
<div id=note></div>
<div id=ui>
  <div class=row><span class=lab>sculpt</span><span id=szb></span></div>
  <div class=row><span class=lab>seat</span><span id=seatb></span>
    <button id=breset>reset board</button></div>
  <div class=row><span class=lab>gauge</span>
    <button id=bgauge aria-pressed=false>show the boxes</button></div>
  <div class="row hint">click a tile holding your own sculpts to LIFT them &#183;
    drag one out of the hand onto a lit tile &#183; u undo &#183; r reset &#183; x gauge
    &#183; f full</div>
</div>
<script>
// ---- the drawing rules, inlined from tools/ui_debug/duty_sculpt_rules.js -----------------------
__FORMATION__
// ---- the set dropdown, inlined from tools/ui_debug/duty_set_picker.js -------------------
__SETPICKER__
// -----------------------------------------------------------------------------------------------
var CELLS = __CELLS__, EDGES = __EDGES__, FIGS = __FIGS__, SIZES = __SIZES__;
// EVERY RENDERED SET IS REACHABLE; `sizes` only says which are grouped as the played ones.
// It used to decide which existed here, and a set tuned next door was invisible as a result.
var PLAYED = __PLAYED__, BASE_SET = __BASESET__, OWN_SETS = __OWNSETS__;
var PLACE = __PLACEMENT__, OPENING = __OPENING__;
var FRAME, PLATES = __PLATES__, PLAN = __GROUNDPLAN__;
// Every offered set's numbers and plates, resolved in Python: the base with that set's own
// laid over it. One merge, shared with the placement sheet that tuned them.
var RULES = __RULES__, GPLANS = __GPLANS__;
// How far the ground sits above the floor line, the same on all nine tiles. Tuned in the
// placement sheet against the banner and saved with the rest of the plan; there is nothing to
// set here. Positive is upward.
var LIFT = PLAN.lift || 0;
// WHICH DUTY STANDS ON WHICH PLATE IS NOT PER SET, so it is held once and every set's plan is
// handed the SAME object -- restand a plate for one set and the assignment does not fork.
var BY_DUTY = PLAN.by_duty || {};
var BANNER_FS = __BANNERFS__, BANNER_TRACK = __BANNERTRACK__;
var BANNER_TOP = __BANNERTOP__, BANNER_INK = __BANNERINK__;

// EVERYTHING THE PAGE DRAWS WITH COMES FROM THE PLACEMENT FILE. There are no sliders here on
// purpose: the numbers are tuned next door in the placement sheet, saved, and this page shows
// what they do to a sow. A control here would be a second place to set them, and the two would
// disagree the first time one was nudged.
// THE NUMBERS FOLLOW THE SET. Read once at load, they made the sculpt button change the
// sculpts and nothing else -- so a set tuned to stand differently was drawn standing the way
// the set before it did. `order` and `mark` stay on the document: both are conventions about
// reading a tile rather than facts about how big the sculpts are.
var ORDER = PLACE.order, MARK = PLACE.mark;
var SPREAD, BACK, RANK, MODE, SHADE, FULL_AT, WIDE;
function applySet(label){
  var r = RULES[label] || {}, d = r.depth || {};
  SPREAD = r.spread; BACK = r.back; RANK = r.rank;
  MODE = d.mode; SHADE = d.amount; FULL_AT = d.full_at;
  WIDE = !!r.width_across_ranks;
  FRAME = r.frame || {w: 320, h: 390, drop: 40};
  var g = GPLANS[label] || {};
  PLAN = {by_duty: BY_DUTY, grounds: g.grounds || {}, lift: g.lift || 0};
  LIFT = PLAN.lift;
}
var HAZE_STEPS = DUTY_HAZE.steps, HAZE_MAX = DUTY_HAZE.max;

var DPR = devicePixelRatio || 1, px = function(v){ return (v / DPR) + "px"; };
var POS = CELLS.map(function(c){ return c.pos; });
// A set LABEL -- `210_painted` -- not a pixel height: two sets can be 210 tall, so the height
// stopped being able to say which sculpts are on screen.
var SIZE = SIZES.indexOf(OPENING) >= 0 ? OPENING : SIZES[SIZES.length - 1];
// The opening set's numbers in force before anything below reads them.
applySet(SIZE);
// WHICH POSE A TILE DRAWS is a property of where it sits -- dutyPoseForColumn in the shared
// rules -- so it is read per tile inside build() rather than held here. The HAND is the one
// place with no grid position of its own; see drawHand.
var SEAT = 0, shadow = true, GAUGE = false;

// THE FORMATION ONLY KNOWS FIVE. A tile already holding five is not lit, because there is no
// sixth place for the rules to describe and a silent refusal at the drop would look like a bug
// in the drag. What a sow that would overfill a tile actually does is a rule question the game
// has not answered yet; until it does, the page declines rather than inventing an answer.
var SLOTS = 5;

// A tile is the LIST of seats standing on it, in the order they arrived. Not a count: `arrival`
// needs to know who got there first, and a count cannot remember that.
var BOARD = [], HAND = 0, FROM = -1, AT = -1, HIST = [];

document.getElementById("hazedefs").innerHTML =
  dutyHazeDefs("__GROUND__", HAZE_STEPS, HAZE_MAX);

function figFilter(y){
  return dutyFilter(y, {ref: FULL_AT, amount: SHADE, mode: MODE, shadow: shadow,
                        steps: HAZE_STEPS});
}

function countsOf(tile){
  var c = [0, 0, 0];
  tile.forEach(function(s){ c[s] += 1; });
  return c;
}

function reset(){
  // An opening-ish board rather than an empty one: the setup config starts a player with three
  // on a single position, so a pile is the normal state and not an edge case.
  BOARD = CELLS.map(function(){ return []; });
  OPENING_BOARD.forEach(function(p){
    var i = POS.indexOf(p.pos);
    if (i >= 0) for (var k = 0; k < p.n && BOARD[i].length < SLOTS; k++) BOARD[i].push(p.seat);
  });
  HAND = 0; FROM = -1; AT = -1; HIST = [];
  build();
}
var OPENING_BOARD = [{pos: "north", seat: 0, n: 3}, {pos: "east", seat: 1, n: 2},
                     {pos: "south_west", seat: 2, n: 1}, {pos: "west", seat: 0, n: 1},
                     {pos: "north_west", seat: 2, n: 1}];

// THE LIT SET: the tiles this acolyte may legally go to, and only those. The board graph runs
// one way and only three positions branch, so this is one tile most of the time and two at
// east, west and the City. Both choices are lit identically -- the page has no business
// implying one of them is the real one.
function legal(){
  if (AT < 0 || HAND <= 0) return [];
  return (EDGES[POS[AT]] || []).map(function(n){ return POS.indexOf(n); })
                               .filter(function(i){ return i >= 0 && BOARD[i].length < SLOTS; });
}

// Which seats stand where, left to right, for a tile's current occupants.
function queueFor(tile){
  return ORDER === "arrival" ? tile.slice()
                             : tile.slice().sort(function(a, b){ return a - b; });
}

var BUD = 0, CELL = 0, FIELD = 0, TIGHT = 0, CAP = null, TOTALH = 0, FOOTW = 0;
function build(){
  BUD = Math.floor(Math.min(innerWidth, innerHeight) * DPR);
  CELL = BUD / 3;
  // Over every seat AND every pose: the field has to clear whatever might be drawn in it, and a
  // height taken off one pose would clip another the moment a tile asked for it.
  var FIG = FIGS[SIZE] || [], figH = dutySetHeight(FIG);
  // The footprint marks are sized off the FIRST SEAT, because they are a mark on the floor
  // rather than a figure -- one size for the whole tile, not one per occupant. Measured over
  // the set rather than at one pose, so the mark does not change size from column to column.
  var FOOTW = dutySetWidth([FIG[0] || []]);
  // Where the parts of a tile sit comes from the shared rules, not from here: this was one of
  // two copies that had already drifted apart on the gap above the banner.
  var L = dutyTileLayout(CELL, figH, RANK, BACK, {icons: false});
  var banW = L.banW, banH = L.banH, gapA = L.gapA, top = L.top;
  FIELD = L.field;
  var total = L.total;
  TOTALH = total;                       // the whole stack: figures, gap, banner
  FOOTW = L.mark;                       // across, the parchment's floor mark sets the width
  // TRUE SIZE IS THE POINT, so nothing here scales to fit: a sculpt on this page is the size it
  // is on the table. When the window cannot afford that, the tile's contents run past it and the
  // bottom row loses its banner -- which looks like a drawing bug rather than a small window.
  // So the page says so instead, and says what to do about it.
  TIGHT = total > CELL ? Math.ceil((total - CELL) / DPR) : 0;
  // One capacity box for the whole board: the formation and the sculpt set are the same on
  // every tile, so the room a full tile needs is the same on every tile too.
  // Over every seat AND every pose, for the same reason the field height is: the box has to
  // hold the worst case the set can produce, not the case pose 1 happens to be.
  CAP = dutyCapacityBox(SLOTS, SPREAD, BACK, RANK, dutySetWidth(FIG), dutySetHeight(FIG),
                        WIDE);
  var lit = legal();

  var h = "";
  for (var i = 0; i < 9; i++){
    var r = (i / 3) | 0, c = i % 3, C = CELLS[i];
    var tile = BOARD[i], n = tile.length;
    var isLive = lit.indexOf(i) >= 0;
    h += '<div class="cell m-' + MARK + (isLive ? " live" : "") + (i === FROM ? " src" : "")
       + '" data-i="' + i + '" style="left:' + px(c * CELL) + ';top:' + px(r * CELL)
       + ';width:' + px(CELL) + ';height:' + px(CELL) + '">';

    // THE MARK CLAIMS THE TILE'S TERRITORY, NOT ITS CONTENTS. Sized to the current formation it
    // gave an empty tile a narrow slot and a crowded one a wide pen, so it said "how full am I"
    // when its whole job is to say "this much of the board is mine". The banner already declares
    // the tile's width, so the mark takes its width from that.
    var wide = L.mark;
    if (MARK === "floor"){
      h += '<div class="mark floor" style="left:' + px(CELL / 2 - wide / 2) + ';top:'
         + px(top + FIELD) + ';width:' + px(wide) + '"></div>';
    } else if (MARK === "box"){
      h += '<div class="mark box" style="left:' + px(CELL / 2 - wide / 2) + ';top:' + px(top)
         + ';width:' + px(wide) + ';height:' + px(FIELD) + '"></div>';
    } else if (MARK === "foot"){
      // WHICH SLOT THE NEWCOMER ACTUALLY TAKES, not "the last one". Slots fill left to right and
      // `grouped` sorts by seat, so a low-seat sculpt lands on the LEFT and pushes everyone
      // right. Assuming the rightmost slot pointed at the wrong ellipse whenever the dropping
      // seat was not already the highest on the tile.
      var after = queueFor(tile.concat([SEAT]));
      var nextIdx = after.indexOf(SEAT) + countsOf(tile)[SEAT];
      dutyFormation(n + 1, SPREAD, BACK, RANK, WIDE)
        .sort(function(a, b){ return a.x - b.x; })
        .forEach(function(s, j){
          h += '<div class="mark foot ' + (j === nextIdx ? "next" : "later") + '" style="left:'
             + px(CELL / 2 + s.x - FOOTW * 0.42) + ';top:'
             + px(top + FIELD - s.y - FOOTW * 0.20) + ';width:' + px(FOOTW * 0.84)
             + ';height:' + px(FOOTW * 0.30) + '"></div>';
        });
    }
    // `gild` draws no geometry at all -- the banner lights, from CSS.

    h += '<div class=figs style="top:' + px(top) + ';left:0;width:' + px(CELL) + ';height:'
       + px(FIELD) + '">';
    var q = queueFor(tile), placed;
    // Painter's order by foot, so a sculpt standing further back never covers a nearer one.
    placed = dutyFormation(n, SPREAD, BACK, RANK, WIDE)
                   .sort(function(a, b){ return a.x - b.x; })
                   .map(function(p, j){ return {x: p.x, y: p.y, seat: q[j]}; });
    placed.slice().sort(function(a, b){ return b.y - a.y || a.x - b.x; }).forEach(function(p){
      var f = dutyPose(FIG[p.seat], dutyPoseForColumn(i));
      if (!f) return;                     // no art for this seat in this set: draws empty
      h += '<div class=fig style="left:' + px(CELL / 2 + p.x - f.w / 2) + ';top:'
         + px(FIELD - f.h - p.y) + ';width:' + px(f.w) + ';height:' + px(f.h)
         + ';filter:' + figFilter(p.y) + '"><img src="' + f.uri + '"></div>';
    });
    h += '</div>';

    // Resolved by the shared rule in duty_sculpt_rules.js, not by a second copy of it here.
    // This page had its own, and its own fallback for an untuned plate; the placement sheet had
    // another. Assign a ground in the sheet and play on it here and they must be the same
    // picture, which two spellings of one rule do not guarantee.
    var gname0 = dutyGroundFor(PLAN, C.slug);
    if (!PLATES[gname0])
      h += '<div class=ground style="left:' + px(CELL / 2 - wide / 2) + ';top:'
         + px(top + FIELD) + ';width:' + px(wide) + '"></div>';

    // The frame and the plate, from the two files the placement sheet saves. Drawn behind the
    // mark and the figures so the board reads as a board rather than as a diagram of one.
    var floorY = top + FIELD;
    h += '<div class=frame style="left:' + px(CELL / 2 - FRAME.w / 2) + ';top:'
       + px(floorY + (FRAME.drop || 0) - FRAME.h) + ';width:' + px(FRAME.w) + ';height:'
       + px(FRAME.h) + '"></div>';
    var plate = PLATES[gname0];
    if (plate){
      var gs = dutyGroundSettings(PLAN, PLATES, gname0);
      var gw = FRAME.w * gs.scale / 100, gh = gw * plate.h / plate.w;
      h += '<div class=plate style="left:' + px(CELL / 2 - gw / 2) + ';top:'
         + px(floorY - LIFT - gh * gs.anchor / 100) + ';width:' + px(gw) + ';height:' + px(gh)
         + ';opacity:' + (gs.opacity / 100) + ';filter:brightness(' + (gs.dim / 100)
         + ') saturate(' + (gs.saturate / 100) + ')"><img src="' + plate.uri + '"></div>';
    }

    if (GAUGE){
      // The cell, inset by a pixel so neighbouring tiles do not draw their dashes on top of
      // each other and read as one thick line.
      h += '<div class="gauge cellbox" style="left:' + px(1) + ';top:' + px(1) + ';width:'
         + px(CELL - 2) + ';height:' + px(CELL - 2) + '"></div>';
      if (CAP)
        h += '<div class="gauge cap" style="left:' + px(CELL / 2 + CAP.left) + ';top:'
           + px(top + FIELD - CAP.top) + ';width:' + px(CAP.w) + ';height:' + px(CAP.h)
           + '"><b>' + Math.round(CAP.w) + '&#215;' + Math.round(CAP.h) + ' real px'
           + '</b></div>';
      // Everything the tile draws, banner included -- the box the wheel actually has to give
      // each tile, and so the one to measure the spare room against.
      h += '<div class="gauge foot" style="left:' + px(CELL / 2 - FOOTW / 2) + ';top:'
         + px(top) + ';width:' + px(FOOTW) + ';height:' + px(TOTALH) + '"></div>';
    }
    h += '<div class=ban style="top:' + px(top + FIELD + gapA) + ';width:' + px(banW)
       + ';height:' + px(banH) + '">' + (C.ban ? '<img src="' + C.ban + '">' : "")
       + '<b style="top:' + (BANNER_TOP * 100).toFixed(2) + '%;color:' + BANNER_INK
       + ';font-size:' + px(banH * BANNER_FS) + ';letter-spacing:'
       + px(banH * BANNER_FS * BANNER_TRACK) + '">' + C.title.toUpperCase() + '</b></div>';
    h += '</div>';
  }
  var S = document.getElementById("stage");
  S.style.width = px(BUD); S.style.height = px(BUD);
  S.innerHTML = h;
  S.querySelectorAll(".cell").forEach(function(el){
    el.onclick = function(){ tap(+el.dataset.i); };
  });
  drawHand(); say(); pressAll();
}

// ---- the hand ---------------------------------------------------------------------------------
function drawHand(){
  // THE HAND HAS NO COLUMN. It is a figure in your hand rather than a figure on a tile, so
  // there is no grid position to ask -- it shows the first pose and changes when the tile it
  // lands on decides. Anything else would promise the hand's pose predicts where it is going.
  var el = document.getElementById("hand"), f = dutyPose((FIGS[SIZE] || [])[SEAT], 0);
  el.classList.toggle("empty", HAND === 0);
  var sq = BUD / DPR, left = (innerWidth - sq) / 2;
  el.style.left = Math.max(8, left - 108) + "px";
  var h = "";
  for (var i = 0; i < HAND; i++)
    h += '<div class="held' + (i === HAND - 1 ? " top" : "") + '" style="width:' + px(f.w)
       + ';height:' + px(f.h) + '"><img src="' + f.uri + '"></div>';
  h += '<div class=lab>' + (HAND ? HAND + " in hand" : "hand") + '</div>';
  el.innerHTML = h;
  // CENTRED ON WHAT IT ACTUALLY IS. The top was computed from a fixed half-height, which was
  // about right for a hand of one 120 px sculpt and ran a hand of three 210s off the bottom of
  // the screen -- the acolytes you had not placed yet were the ones you could not see.
  var h2 = el.offsetHeight;
  el.style.top = Math.max(8, Math.min(innerHeight / 2 - h2 / 2, innerHeight - h2 - 8)) + "px";
  var topOne = el.querySelector(".held.top");
  if (topOne) topOne.onpointerdown = function(e){ lift(e, f); };
}

var GH = null;
function lift(e, f){
  GH = document.createElement("div");
  GH.className = "ghost";
  GH.style.width = px(f.w); GH.style.height = px(f.h);
  GH.innerHTML = '<img src="' + f.uri + '">';
  document.body.appendChild(GH);
  moveGhost(e);
  var mv = function(ev){ moveGhost(ev); };
  var up = function(ev){
    removeEventListener("pointermove", mv); removeEventListener("pointerup", up);
    var el = document.elementFromPoint(ev.clientX, ev.clientY);
    GH.remove(); GH = null;
    var cell = el && el.closest ? el.closest(".cell") : null;
    if (cell && cell.classList.contains("live")) drop(+cell.dataset.i);
    else build();                                   // a miss puts it back, silently
  };
  addEventListener("pointermove", mv); addEventListener("pointerup", up);
  e.preventDefault();
}
function moveGhost(e){
  if (!GH) return;
  GH.style.left = (e.clientX - GH.offsetWidth / 2) + "px";
  GH.style.top = (e.clientY - GH.offsetHeight * 0.8) + "px";
}

// ---- the moves --------------------------------------------------------------------------------
function remember(){
  HIST.push(JSON.stringify({B: BOARD, H: HAND, F: FROM, A: AT}));
}
function tap(i){
  if (HAND > 0){                                    // clicking a lit tile also drops
    if (legal().indexOf(i) >= 0) drop(i);
    return;
  }
  var mine = BOARD[i].filter(function(s){ return s === SEAT; }).length;
  if (mine <= 0) return;                            // only your own, and only if there are any
  remember();
  HAND = mine;
  BOARD[i] = BOARD[i].filter(function(s){ return s !== SEAT; });
  FROM = i; AT = i;
  build();
}
function drop(i){
  if (HAND <= 0 || BOARD[i].length >= SLOTS) return;
  remember();
  BOARD[i] = BOARD[i].concat([SEAT]);
  HAND -= 1;
  AT = i;
  if (HAND === 0){ FROM = -1; AT = -1; }            // the sow is over; nothing is lit
  build();
}
function undo(){
  if (!HIST.length) return;
  var s = JSON.parse(HIST.pop());
  BOARD = s.B; HAND = s.H; FROM = s.F; AT = s.A;
  build();
}

function say(){
  var names = legal().map(function(i){ return CELLS[i].title; });
  var mine = BOARD.reduce(function(a, t){
    return a + t.filter(function(s){ return s === SEAT; }).length; }, 0);
  var blocked = AT >= 0 && HAND > 0
    && (EDGES[POS[AT]] || []).length > names.length;
  document.getElementById("note").innerHTML =
    "SOW BY HAND, true size at <b>" + DPR.toFixed(2) + "x</b>\n"
  + "sculpt  <b>" + dutySetHeight(FIGS[SIZE] || []) + "</b> real px\n"
  + "seat    <b>p" + (SEAT + 1) + "</b>, <b>" + mine + "</b> on the wheel\n\n"
  + (HAND === 0
      ? "click one of your tiles to lift\nits acolytes into the hand."
      : "in hand <b>" + HAND + "</b>\nfrom    <b>" + (FROM >= 0 ? CELLS[FROM].title : "-")
        + "</b>\nat      <b>" + (AT >= 0 ? CELLS[AT].title : "-") + "</b>\nnext    "
        + (names.length === 0 ? "<b>nowhere</b>  (every exit is full)"
           : names.length === 1 ? "<b>" + names[0] + "</b>  (forced)"
           : "<b>" + names.join("</b> or <b>") + "</b>  (choose)")
        + (blocked && names.length ? "\n        an exit is full, so not lit" : ""))
  + "\n\norder   <b>" + ORDER + "</b>\nmark    <b>" + MARK + "</b>\ndepth   <b>"
  + (SHADE ? MODE + " " + SHADE + "%, full at " + FULL_AT : "off") + "</b>"
  + (TIGHT ? "\n\n<b>the window is " + TIGHT + " px too short</b>\nfor a tile at this sculpt "
             + "size;\nthe bottom row is clipped.\npress f for fullscreen."
           : "")
  + (GAUGE && CAP
      ? "\n\nALL IN REAL PIXELS\na full tile needs <b>" + Math.round(CAP.w) + "</b> by <b>"
        + Math.round(CAP.h) + "</b>\n  (five sculpts, widest seat)\n"
        + "with the banner it is <b>" + Math.round(TOTALH) + "</b> tall\n"
        + "the tile is <b>" + Math.round(CELL) + "</b> square\n\n"
        + "the tile draws <b>" + Math.round(Math.max(FOOTW, CAP.w)) + "</b> across\n"
        + "  (the banner is wider than\n   five sculpts are)\n\n"
        + "spare <b>" + Math.round(CELL - Math.max(FOOTW, CAP.w)) + "</b> across, <b>"
        + Math.round(CELL - TOTALH) + "</b> down\n"
        + "so the wheel could tighten by\nup to <b>"
        + Math.round(Math.min(CELL - Math.max(FOOTW, CAP.w), CELL - TOTALH))
        + "</b> real px a tile"
      : "")
  + "\n\nthe numbers are the placement\nfile's; tune them next door in\nthe placement sheet.";
}

// ---- the two controls -------------------------------------------------------------------------
function buttons(host, values, current, label, choose){
  host.innerHTML = "";
  values.forEach(function(v){
    var b = document.createElement("button");
    b.textContent = label(v);
    b.onclick = function(){ choose(v); };
    host.appendChild(b);
    b._value = v;
  });
  host._values = values; host._current = current;
}
function pressAll(){
  // The seat row is still buttons -- three of them, and which seat you are playing is worth
  // seeing without opening anything. The sculpt set is a select and carries its own state, so
  // it is moved rather than pressed; dutySetPickerShow says why that is not automatic.
  var host = document.getElementById("seatb");
  [].forEach.call(host.children, function(b){
    b.setAttribute("aria-pressed", b._value === SEAT ? "true" : "false"); });
  dutySetPickerShow(document.getElementById("szb"), SIZE);
}
dutySetPicker(document.getElementById("szb"), {
  all: SIZES, played: PLAYED, base: BASE_SET, own: OWN_SETS, value: SIZE,
  choose: function(v){ SIZE = v; applySet(SIZE); build(); }});
buttons(document.getElementById("seatb"), [0, 1, 2], null,
        function(v){ return "p" + (v + 1); },
        function(v){
          if (HAND > 0) return;                     // a seat change mid-sow would strand the hand
          SEAT = v; build();
        });
document.getElementById("breset").onclick = reset;
document.getElementById("bgauge").onclick = function(){
  GAUGE = !GAUGE;
  this.setAttribute("aria-pressed", GAUGE ? "true" : "false");
  build();
};

addEventListener("keydown", function(e){
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  if (e.key === "u") return undo();
  if (e.key === "r") return reset();
  if (e.key === "s"){ shadow = !shadow; return build(); }
  if (e.key === "x") return document.getElementById("bgauge").click();
  if (e.key === "1" || e.key === "2" || e.key === "3"){
    if (HAND > 0) return;
    SEAT = +e.key - 1; return build();
  }
  if (e.key === "f") document.fullscreenElement ? document.exitFullscreen()
                                                : document.documentElement.requestFullscreen();
});
addEventListener("resize", build);
addEventListener("fullscreenchange", build);
reset();
(async function(){ try{ await document.fonts.load('400 20px "PB"'); await document.fonts.ready;
                        build(); } catch(e){} })();
</script>
